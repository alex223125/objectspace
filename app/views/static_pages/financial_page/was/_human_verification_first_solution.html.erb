<div
  class="mt-5 rounded-2xl
                   border border-slate-200
                   bg-white p-5
                   dark:border-strokedark
                   dark:bg-boxdark"
>

  <label
    class="flex cursor-pointer items-center gap-3"
  >

    <%= check_box_tag :human_verification,
                      "1",
                      false,
                      required: true,
                      class: "h-5 w-5 rounded
                                        border-slate-300
                                        text-emerald-500
                                        focus:ring-emerald-500" %>

    <span
      class="text-xs font-bold
                       text-slate-600
                       dark:text-slate-300"
    >
                I confirm that I am a human and not an automated bot.
              </span>

  </label>

</div>