<%# ============================================================ %>
<%# FILE: app/views/static_pages/financial_page/_support_message_form.html.erb %>
<%# PURPOSE: Visitor support / financial message submission form %>
<%# ============================================================ %>

<section
  id="support-message"
  class="relative mt-16 overflow-hidden rounded-[32px]
         border-2 border-sky-100
         bg-white p-6
         shadow-[0_20px_60px_rgba(14,165,233,0.08)]
         sm:p-8
         lg:p-10
         dark:border-sky-500/20
         dark:bg-boxdark"
>
  <!-- Decorative background -->
  <div
    class="pointer-events-none absolute -right-24 -top-24
           h-64 w-64 rounded-full
           bg-sky-400/10 blur-3xl"
  ></div>

  <div
    class="pointer-events-none absolute -bottom-24 -left-24
           h-64 w-64 rounded-full
           bg-violet-400/10 blur-3xl"
  ></div>


  <div class="relative z-10">


    <!-- ======================================================== -->
    <!-- HEADER                                                    -->
    <!-- ======================================================== -->

    <div class="mx-auto max-w-3xl text-center">

      <div
        class="mx-auto flex h-14 w-14 items-center justify-center
               rounded-2xl
               border-2 border-sky-200
               bg-sky-50 text-2xl
               shadow-sm
               dark:border-sky-500/20
               dark:bg-sky-500/10"
      >
        💬
      </div>


      <div
        class="mt-5 text-[10px] font-black uppercase
               tracking-[0.25em] text-sky-500"
      >
        Financial Support & Communication
      </div>


      <h2
        class="mt-3 text-3xl font-black tracking-tight
               text-slate-800
               sm:text-4xl
               dark:text-white"
      >
        Have a question, idea or thought?
      </h2>


      <p
        class="mx-auto mt-4 max-w-2xl
               text-sm leading-7 text-slate-500
               dark:text-slate-400"
      >
        We warmly welcome your questions, suggestions, recommendations
        and thoughts about the financial details of the project.
        You can also contact us if you are interested in supporting,
        donating to or financially contributing to the project.
      </p>


      <p
        class="mt-3 text-xs font-semibold text-slate-400"
      >
        Your message will be reviewed by our team.
      </p>

    </div>


    <!-- ======================================================== -->
    <!-- FORM                                                      -->
    <!-- ======================================================== -->

    <div class="mx-auto mt-10 max-w-4xl">

      <%= form_with model: SupportMessage.new,
                    url: support_messages_path,
                    method: :post,
                    multipart: true,
                    local: true,
                    class: "space-y-7" do |f| %>


        <!-- ==================================================== -->
        <!-- PERSONAL INFORMATION                                  -->
        <!-- ==================================================== -->

        <div
          class="rounded-3xl
                 border-2 border-slate-100
                 bg-slate-50/70 p-5
                 sm:p-6
                 dark:border-strokedark
                 dark:bg-form-input/40"
        >

          <div class="mb-5">

            <h3
              class="text-sm font-black uppercase
                     tracking-widest text-slate-700
                     dark:text-white"
            >
              Your information
            </h3>

            <p class="mt-1 text-xs text-slate-400">
              Please provide your name and email so we can respond.
            </p>

          </div>


          <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">


            <!-- FIRST NAME -->

            <div>

              <%= f.label :first_name,
                          "First name",
                          class: "mb-2 block text-[10px]
                                 font-black uppercase
                                 tracking-widest
                                 text-slate-400" %>


              <%= f.text_field :first_name,
                               required: true,
                               autocomplete: "given-name",
                               placeholder: "Your first name",
                               class: "w-full rounded-2xl
                                       border-2 border-slate-100
                                       bg-white px-4 py-3.5
                                       text-sm text-slate-700
                                       outline-none transition
                                       placeholder:text-slate-300
                                       focus:border-sky-300
                                       focus:ring-4
                                       focus:ring-sky-50
                                       dark:border-strokedark
                                       dark:bg-boxdark
                                       dark:text-white
                                       dark:placeholder:text-slate-500
                                       dark:focus:border-sky-500" %>

            </div>


            <!-- LAST NAME -->

            <div>

              <%= f.label :last_name,
                          "Last name",
                          class: "mb-2 block text-[10px]
                                 font-black uppercase
                                 tracking-widest
                                 text-slate-400" %>


              <%= f.text_field :last_name,
                               required: true,
                               autocomplete: "family-name",
                               placeholder: "Your last name",
                               class: "w-full rounded-2xl
                                       border-2 border-slate-100
                                       bg-white px-4 py-3.5
                                       text-sm text-slate-700
                                       outline-none transition
                                       placeholder:text-slate-300
                                       focus:border-sky-300
                                       focus:ring-4
                                       focus:ring-sky-50
                                       dark:border-strokedark
                                       dark:bg-boxdark
                                       dark:text-white
                                       dark:placeholder:text-slate-500
                                       dark:focus:border-sky-500" %>

            </div>


            <!-- EMAIL -->

            <div class="sm:col-span-2">

              <%= f.label :email,
                          "Email address",
                          class: "mb-2 block text-[10px]
                                 font-black uppercase
                                 tracking-widest
                                 text-slate-400" %>


              <%= f.email_field :email,
                                required: true,
                                autocomplete: "email",
                                placeholder: "you@example.com",
                                class: "w-full rounded-2xl
                                        border-2 border-slate-100
                                        bg-white px-4 py-3.5
                                        text-sm text-slate-700
                                        outline-none transition
                                        placeholder:text-slate-300
                                        focus:border-emerald-300
                                        focus:ring-4
                                        focus:ring-emerald-50
                                        dark:border-strokedark
                                        dark:bg-boxdark
                                        dark:text-white
                                        dark:placeholder:text-slate-500
                                        dark:focus:border-emerald-500" %>

            </div>


            <!-- ORGANISATION -->

            <div class="sm:col-span-2">

              <%= f.label :organization_name,
                          "Name of organisation",
                          class: "mb-2 block text-[10px]
                                 font-black uppercase
                                 tracking-widest
                                 text-slate-400" %>


              <span
                class="ml-1 text-[9px] font-semibold
                       normal-case tracking-normal
                       text-slate-300"
              >
                Optional
              </span>


              <%= f.text_field :organization_name,
                               autocomplete: "organization",
                               placeholder: "Organisation, company or institution",
                               class: "mt-2 w-full rounded-2xl
                                       border-2 border-slate-100
                                       bg-white px-4 py-3.5
                                       text-sm text-slate-700
                                       outline-none transition
                                       placeholder:text-slate-300
                                       focus:border-violet-300
                                       focus:ring-4
                                       focus:ring-violet-50
                                       dark:border-strokedark
                                       dark:bg-boxdark
                                       dark:text-white
                                       dark:placeholder:text-slate-500
                                       dark:focus:border-violet-500" %>

            </div>

          </div>

        </div>


        <!-- ==================================================== -->
        <!-- SUPPORT INFORMATION                                  -->
        <!-- ==================================================== -->

        <div
          class="rounded-3xl
                 border-2 border-slate-100
                 bg-white p-5
                 sm:p-6
                 dark:border-strokedark
                 dark:bg-boxdark"
        >

          <div class="mb-5">

            <h3
              class="text-sm font-black uppercase
                     tracking-widest text-slate-700
                     dark:text-white"
            >
              What would you like to discuss?
            </h3>

            <p class="mt-1 text-xs text-slate-400">
              Select the category that best describes your message.
            </p>

          </div>


          <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">


            <!-- SUPPORT CATEGORY -->

            <div>

              <%= f.label :support_category,
                          "Support / message category",
                          class: "mb-2 block text-[10px]
                                 font-black uppercase
                                 tracking-widest
                                 text-slate-400" %>


              <%= f.select :support_category,
                           SupportMessage::SUPPORT_CATEGORIES.map {
                             |key, label|
                             [label, key]
                           },
                           {
                             include_blank: "Select a category",
                             required: true
                           },
                           class: "w-full rounded-2xl
                                   border-2 border-slate-100
                                   bg-slate-50 px-4 py-3.5
                                   text-sm text-slate-700
                                   outline-none transition
                                   focus:border-amber-300
                                   focus:bg-white
                                   focus:ring-4
                                   focus:ring-amber-50
                                   dark:border-strokedark
                                   dark:bg-form-input
                                   dark:text-white" %>

            </div>


            <!-- DISCOVERY SOURCE -->

            <div>

              <%= f.label :discovery_source,
                          "How did you hear about the project?",
                          class: "mb-2 block text-[10px]
                                 font-black uppercase
                                 tracking-widest
                                 text-slate-400" %>


              <span
                class="ml-1 text-[9px] font-semibold
                       normal-case tracking-normal
                       text-slate-300"
              >
                Optional
              </span>


              <%= f.select :discovery_source,
                           SupportMessage::DISCOVERY_SOURCES.map {
                             |key, label|
                             [label, key]
                           },
                           {
                             include_blank: "Select a source"
                           },
                           class: "mt-2 w-full rounded-2xl
                                   border-2 border-slate-100
                                   bg-slate-50 px-4 py-3.5
                                   text-sm text-slate-700
                                   outline-none transition
                                   focus:border-fuchsia-300
                                   focus:bg-white
                                   focus:ring-4
                                   focus:ring-fuchsia-50
                                   dark:border-strokedark
                                   dark:bg-form-input
                                   dark:text-white" %>

            </div>

          </div>

        </div>


        <!-- ==================================================== -->
        <!-- MESSAGE                                               -->
        <!-- ==================================================== -->

        <div
          class="rounded-3xl
                 border-2 border-slate-100
                 bg-white p-5
                 sm:p-6
                 dark:border-strokedark
                 dark:bg-boxdark"
        >

          <div class="mb-5">

            <h3
              class="text-sm font-black uppercase
                     tracking-widest text-slate-700
                     dark:text-white"
            >
              Your message
            </h3>

            <p class="mt-1 text-xs text-slate-400">
              Questions, suggestions, recommendations or thoughts
              about financial support are welcome.
            </p>

          </div>


          <%= f.label :message,
                      "Message",
                      class: "mb-2 block text-[10px]
                             font-black uppercase
                             tracking-widest
                             text-slate-400" %>


          <%= f.text_area :message,
                          rows: 10,
                          required: true,
                          placeholder:
                            "Write your message here...",
                          class: "w-full rounded-2xl
                                  border-2 border-slate-100
                                  bg-slate-50 px-4 py-4
                                  text-sm leading-7
                                  text-slate-700
                                  outline-none transition
                                  placeholder:text-slate-300
                                  focus:border-sky-300
                                  focus:bg-white
                                  focus:ring-4
                                  focus:ring-sky-50
                                  dark:border-strokedark
                                  dark:bg-form-input
                                  dark:text-white
                                  dark:placeholder:text-slate-500" %>


          <div
            class="mt-3 flex items-center gap-2
                   text-[10px] text-slate-400"
          >
            <span>✦</span>
            <span>
              You can write questions, financial suggestions,
              donation ideas or recommendations.
            </span>
          </div>

        </div>


        <!-- ==================================================== -->
        <!-- ATTACHMENTS                                           -->
        <!-- ==================================================== -->

        <div
          class="rounded-3xl
                 border-2 border-slate-100
                 bg-slate-50/70 p-5
                 sm:p-6
                 dark:border-strokedark
                 dark:bg-form-input/40"
        >

          <div class="mb-5">
            <h3
              class="text-sm font-black uppercase
                     tracking-widest text-slate-700
                     dark:text-white"
            >
              Attachments
            </h3>
            <p class="mt-1 text-xs text-slate-400">
              Optional. You may attach screenshots or images
              that help explain your message.
            </p>
          </div>


          <%= f.file_field :attachments,
                           multiple: true,
                           accept: "image/png,image/jpeg,image/webp,image/gif",
                           class: "block w-full cursor-pointer
                                   rounded-2xl
                                   border-2 border-dashed
                                   border-slate-200
                                   bg-white px-4 py-4
                                   text-xs text-slate-500
                                   transition
                                   hover:border-sky-300
                                   hover:bg-sky-50/30
                                   dark:border-strokedark
                                   dark:bg-boxdark
                                   dark:text-slate-400" %>


          <div
            class="mt-3 flex flex-wrap gap-x-5 gap-y-2
                   text-[10px] text-slate-400"
          >

            <span>✓ PNG</span>
            <span>✓ JPG / JPEG</span>
            <span>✓ WEBP</span>
            <span>✓ GIF</span>

          </div>

        </div>


        <!-- ==================================================== -->
        <!-- ANTI-ROBOT PLACEHOLDER                               -->
        <!-- ==================================================== -->

        <div
          class="rounded-3xl
                 border-2 border-slate-100
                 bg-slate-50/70 p-5
                 sm:p-6
                 dark:border-strokedark
                 dark:bg-form-input/40"
        >

          <div class="flex items-start gap-4">

            <div
              class="flex h-11 w-11 shrink-0
                     items-center justify-center
                     rounded-xl
                     bg-emerald-50
                     text-lg
                     dark:bg-emerald-500/10"
            >
              🛡️
            </div>


            <div class="min-w-0">

              <h3
                class="text-sm font-black
                       text-slate-700
                       dark:text-white"
              >
                Verify that you are human
              </h3>

              <p
                class="mt-1 text-xs leading-6
                       text-slate-400"
              >
                Please complete the human verification before
                sending your message.
              </p>

            </div>

          </div>


          <%# ================================================== %>
          <%# IMPORTANT: Replace this block with your actual     %>
          <%# CAPTCHA / puzzle Stimulus component.               %>
          <%# ================================================== %>
          <%= render "static_pages/financial_page/human_verification_puzzle" %>
        </div>


        <!-- ==================================================== -->
        <!-- EMAIL CONFIRMATION NOTICE                            -->
        <!-- ==================================================== -->

        <div
          class="rounded-2xl
                 border border-sky-100
                 bg-sky-50/70 p-4
                 dark:border-sky-500/20
                 dark:bg-sky-500/10"
        >

          <div class="flex items-start gap-3">

            <div class="text-lg">
              ✉️
            </div>

            <div>

              <div
                class="text-xs font-black
                       text-sky-700
                       dark:text-sky-300"
              >
                Email confirmation
              </div>

              <p
                class="mt-1 text-[11px] leading-5
                       text-sky-600/80
                       dark:text-sky-400"
              >
                After submitting this message, we will send a
                confirmation link to your email address. Your
                message will become confirmed after you click
                that link.
              </p>
            </div>
          </div>
        </div>


        <!-- ==================================================== -->
        <!-- SUBMIT                                                 -->
        <!-- ==================================================== -->
        <div class="flex justify-center pt-2">
          <%= f.submit "Send Message",
                       class: "inline-flex cursor-pointer
                               items-center justify-center
                               rounded-2xl
                               bg-gradient-to-r
                               from-sky-500
                               via-violet-500
                               to-emerald-500
                               px-8 py-4
                               text-xs font-black
                               uppercase tracking-widest
                               text-white
                               shadow-lg
                               shadow-sky-500/20
                               transition-all duration-300
                               hover:-translate-y-1
                               hover:shadow-xl
                               focus:outline-none
                               focus:ring-4
                               focus:ring-sky-200
                               dark:focus:ring-sky-500/20" %>

        </div>

        <p
          class="text-center text-[10px]
                 leading-5 text-slate-400"
        >
          By sending this message, you agree that we may use
          the provided email address to respond to your inquiry.
        </p>
      <% end %>
    </div>
  </div>
</section>