<!-- HERO -->
<!-- ========================================================= -->

<section class="relative">

  <div
    class="mx-auto max-w-7xl px-6 pb-20 pt-20
             lg:px-10 lg:pb-28 lg:pt-28">

    <div class="grid items-center gap-14 lg:grid-cols-[1.1fr_.9fr]">


      <!-- Hero copy -->

      <div>

        <div class="flex items-center gap-3">

          <div
            class="flex h-11 w-11 items-center justify-center
                     rounded-2xl border-2 border-emerald-200
                     bg-emerald-50 text-lg
                     shadow-sm shadow-emerald-100">

            🌱

          </div>

          <div>

            <div
              class="text-[10px] font-black uppercase
                       tracking-[0.22em] text-emerald-600">

              Support Quest · Chapter 01

            </div>

            <div
              class="mt-1 text-[11px] font-medium text-slate-400">

              Help keep the knowledge world alive

            </div>

          </div>

        </div>


        <h1
          class="mt-7 max-w-4xl text-5xl font-black
                   tracking-tight text-slate-800
                   sm:text-6xl lg:text-7xl">

          Help Us Build a

          <span
            class="bg-gradient-to-r
                     from-emerald-500
                     via-sky-500
                     to-violet-500
                     bg-clip-text text-transparent">

              Living Encyclopedia

            </span>

          of Human Development

        </h1>


        <p
          class="mt-6 max-w-2xl text-base leading-7
                   text-slate-500 sm:text-lg">

          Knowledge should not become outdated the moment
          the world changes. Help us build an ecosystem
          where problems, methods, algorithms, experiments
          and discoveries continuously evolve together.

        </p>


        <!-- Quest CTA -->

        <div class="mt-8 flex flex-col gap-3 sm:flex-row">

          <a
            href="#support"
            class="group inline-flex items-center
                     justify-center gap-3 rounded-2xl
                     border-2 border-amber-200
                     bg-gradient-to-r
                     from-amber-400 to-orange-400
                     px-6 py-4
                     text-sm font-black text-white
                     shadow-lg shadow-amber-200/50
                     transition-all duration-300
                     hover:-translate-y-1
                     hover:from-amber-500
                     hover:to-orange-500
                     hover:shadow-xl">

            <span>Join the Support Quest</span>

            <span
              class="transition-transform duration-300
                       group-hover:translate-x-1">

                →

              </span>

          </a>


          <a
            href="#mission"
            class="inline-flex items-center
                     justify-center gap-2 rounded-2xl
                     border-2 border-slate-200
                     bg-white px-6 py-4
                     text-sm font-black text-slate-600
                     shadow-sm
                     transition-all duration-300
                     hover:-translate-y-1
                     hover:border-emerald-200
                     hover:text-emerald-600">

            Explore the mission

          </a>

        </div>


        <!-- Tiny status -->

        <div
          class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-2
                   text-[10px] font-bold text-slate-400">

            <span class="flex items-center gap-2">

              <span
                class="h-2 w-2 rounded-full
                       bg-emerald-400
                       shadow-[0_0_8px_rgba(52,211,153,.6)]">
              </span>

              Ecosystem online

            </span>

          <span>•</span>

          <span>Knowledge is evolving</span>

          <span>•</span>

          <span>Development in progress</span>

        </div>

      </div>



      <!-- Hero game panel -->

      <div
        class="relative">

        <div
          class="rounded-[32px]
                   border-2 border-slate-100
                   bg-white/90 p-5
                   shadow-[0_25px_70px_rgba(15,23,42,.10)]
                   backdrop-blur">

          <!-- World status -->

          <div
            class="flex items-center justify-between
                     border-b border-slate-100 pb-4">

            <div class="flex items-center gap-3">

              <div
                class="flex h-10 w-10 items-center justify-center
                         rounded-xl border-2 border-emerald-200
                         bg-emerald-50">

                🌍

              </div>

              <div>

                <div
                  class="text-xs font-black text-slate-700">

                  Living Knowledge World

                </div>

                <div
                  class="text-[10px] font-medium text-slate-400">

                  Server status: evolving

                </div>

              </div>

            </div>


            <span
              class="rounded-full border border-emerald-100
                       bg-emerald-50 px-3 py-1
                       text-[9px] font-black uppercase
                       tracking-wider text-emerald-600">

                ONLINE

              </span>

          </div>


          <!-- Block world -->

          <div
            class="relative mt-5 overflow-hidden
                     rounded-2xl border-2 border-slate-100
                     bg-gradient-to-b
                     from-sky-100 via-sky-50 to-emerald-50
                     p-5">

            <!-- clouds -->

            <div
              class="absolute left-[12%] top-6 h-5 w-16
                       rounded-full bg-white/70">
            </div>

            <div
              class="absolute right-[12%] top-10 h-4 w-12
                       rounded-full bg-white/60">
            </div>


            <!-- pixel terrain -->

            <div
              class="relative mt-16 grid
                       grid-cols-8 gap-1">

              <div class="h-8 bg-emerald-300"></div>
              <div class="h-8 bg-emerald-400"></div>
              <div class="h-8 bg-emerald-300"></div>
              <div class="h-8 bg-emerald-500"></div>
              <div class="h-8 bg-emerald-400"></div>
              <div class="h-8 bg-emerald-300"></div>
              <div class="h-8 bg-emerald-400"></div>
              <div class="h-8 bg-emerald-300"></div>

            </div>

            <div
              class="grid grid-cols-8 gap-1">

              <div class="h-8 bg-amber-200"></div>
              <div class="h-8 bg-amber-300"></div>
              <div class="h-8 bg-amber-200"></div>
              <div class="h-8 bg-amber-300"></div>
              <div class="h-8 bg-amber-200"></div>
              <div class="h-8 bg-amber-300"></div>
              <div class="h-8 bg-amber-200"></div>
              <div class="h-8 bg-amber-300"></div>

            </div>


            <!-- knowledge blocks -->

            <div
              class="absolute left-[17%] top-[35%]
                       flex h-12 w-12 items-center
                       justify-center rounded-lg
                       border-2 border-rose-200
                       bg-rose-50 text-lg
                       shadow-md">

              ?

            </div>

            <div
              class="absolute left-[43%] top-[25%]
                       flex h-14 w-14 items-center
                       justify-center rounded-lg
                       border-2 border-sky-200
                       bg-sky-50 text-lg
                       shadow-md">

              ⚙️

            </div>

            <div
              class="absolute right-[17%] top-[37%]
                       flex h-12 w-12 items-center
                       justify-center rounded-lg
                       border-2 border-violet-200
                       bg-violet-50 text-lg
                       shadow-md">

              🧪

            </div>

          </div>


          <!-- Progress -->

          <div class="mt-5">

            <div
              class="mb-2 flex items-center justify-between">

                <span
                  class="text-[9px] font-black uppercase
                         tracking-widest text-slate-400">

                  World Development

                </span>

              <span
                class="text-[10px] font-black
                         text-emerald-500">

                  Building...

                </span>

            </div>

            <div
              class="h-3 overflow-hidden rounded-full
                       bg-slate-100">

              <div
                class="h-full w-[46%] rounded-full
                         bg-gradient-to-r
                         from-emerald-400
                         via-sky-400
                         to-violet-400
                         shadow-sm">
              </div>

            </div>

          </div>


          <!-- Quest objective -->

          <div
            class="mt-5 rounded-2xl
                     border border-amber-100
                     bg-amber-50/70 p-4">

            <div
              class="flex items-start gap-3">

              <div class="text-lg">🏆</div>

              <div>

                <div
                  class="text-xs font-black text-amber-700">

                  Current Quest

                </div>

                <p
                  class="mt-1 text-[10px]
                           leading-5 text-amber-700/70">

                  Build the team and infrastructure needed
                  to keep the encyclopedia evolving.

                </p>

              </div>

            </div>

          </div>

        </div>

      </div>

    </div>

  </div>

</section>