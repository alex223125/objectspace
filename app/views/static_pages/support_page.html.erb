<div class="relative overflow-hidden bg-white text-slate-800">

  <!-- ========================================================= -->
  <!-- LIVING ENCYCLOPEDIA / SUPPORT QUEST BACKGROUND -->
  <!-- ========================================================= -->

  <div class="pointer-events-none absolute inset-0 overflow-hidden">

    <!-- Ambient world -->

    <div
      class="absolute -left-40 -top-40 h-[500px] w-[500px]
             rounded-full bg-amber-200/40 blur-[110px]
             animate-pulse">
    </div>

    <div
      class="absolute right-[-180px] top-[10%] h-[500px] w-[500px]
             rounded-full bg-sky-200/35 blur-[120px]
             animate-pulse [animation-delay:1s]">
    </div>

    <div
      class="absolute bottom-[-220px] left-[25%] h-[550px] w-[550px]
             rounded-full bg-emerald-200/30 blur-[130px]
             animate-pulse [animation-delay:2s]">
    </div>

    <div
      class="absolute bottom-[5%] right-[15%] h-[400px] w-[400px]
             rounded-full bg-violet-200/25 blur-[110px]
             animate-pulse [animation-delay:3s]">
    </div>


    <!-- Pixel / game particles -->

    <div
      class="absolute left-[7%] top-[18%] h-2 w-2
             bg-amber-400 shadow-[0_0_14px_rgba(251,191,36,.55)]
             animate-bounce">
    </div>

    <div
      class="absolute left-[18%] top-[34%] h-1.5 w-1.5
             bg-emerald-400 shadow-[0_0_12px_rgba(52,211,153,.5)]
             animate-pulse">
    </div>

    <div
      class="absolute right-[12%] top-[23%] h-2 w-2
             bg-sky-400 shadow-[0_0_14px_rgba(56,189,248,.5)]
             animate-bounce [animation-delay:700ms]">
    </div>

    <div
      class="absolute right-[24%] bottom-[28%] h-1.5 w-1.5
             bg-violet-400 shadow-[0_0_12px_rgba(167,139,250,.5)]
             animate-pulse [animation-delay:1.2s]">
    </div>


    <!-- Tiny pixel blocks -->

    <div
      class="absolute left-[4%] bottom-[15%] h-4 w-4
             rotate-3 border border-emerald-200
             bg-emerald-100/60">
    </div>

    <div
      class="absolute right-[5%] top-[42%] h-5 w-5
             -rotate-6 border border-amber-200
             bg-amber-100/60">
    </div>

  </div>

  <%= render "static_pages/support_page/help_us_build_encyclopedia" %>

  <%= render "static_pages/support_page/explain_that_money_does" %>

  <%= render "static_pages/support_page/become_a_recurring_supporter" %>

  <%= render "static_pages/support_page/why_now" %>

  <%#= render "static_pages/support_page/the_big_loop" %>

  <%= render "static_pages/support_page/become_hero_in_superposition" %>


  <!-- ========================================================= -->
  <!-- FINAL SUPPORT QUEST -->
  <!-- ========================================================= -->

  <section class="relative">

    <div
      class="mx-auto max-w-5xl px-6 py-24 lg:px-10">

      <div
        class="relative overflow-hidden rounded-[36px]
               border-2 border-amber-200
               bg-gradient-to-br
               from-amber-50
               via-white
               to-emerald-50
               p-8 text-center
               shadow-[0_25px_70px_rgba(245,158,11,.12)]
               sm:p-12">

        <!-- decorative blocks -->

        <div
          class="absolute right-8 top-8 h-5 w-5
                 rotate-6 bg-amber-200/70">
        </div>

        <div
          class="absolute bottom-8 left-8 h-4 w-4
                 -rotate-6 bg-emerald-200/70">
        </div>


        <div
          class="relative mx-auto flex h-16 w-16
                 items-center justify-center
                 rounded-[22px]
                 border-2 border-amber-200
                 bg-amber-50 text-2xl
                 shadow-md shadow-amber-100">

          🏆

        </div>


        <div
          class="relative mt-6 text-[10px]
                 font-black uppercase tracking-[.2em]
                 text-amber-600">

          Final Quest

        </div>


        <h2
          class="relative mt-4 text-4xl font-black
                 tracking-tight text-slate-800
                 sm:text-5xl">

          Help us build the world

          <span
            class="bg-gradient-to-r
                   from-amber-500
                   via-emerald-500
                   to-sky-500
                   bg-clip-text text-transparent">

            we want to explore.

          </span>

        </h2>


        <p
          class="relative mx-auto mt-5 max-w-2xl
                 text-sm leading-7 text-slate-500">

          Every recurring supporter adds another piece to
          the infrastructure. Together, we can turn a static
          collection of information into a living ecosystem
          of knowledge, methods, experiments and adventures.

        </p>


        <div
          class="relative mt-8 flex flex-col
                 items-center justify-center gap-3
                 sm:flex-row">

          <a
            href="#support"
            class="group inline-flex items-center
                   gap-3 rounded-2xl
                   border-2 border-amber-200
                   bg-gradient-to-r
                   from-amber-400 to-orange-400
                   px-7 py-4
                   text-sm font-black text-white
                   shadow-lg shadow-amber-200/50
                   transition-all duration-300
                   hover:-translate-y-1
                   hover:from-amber-500
                   hover:to-orange-500">

            Start supporting

            <span
              class="transition-transform
                     group-hover:translate-x-1">

              →

            </span>

          </a>

        </div>


        <!-- XP -->

        <div
          class="relative mx-auto mt-9 max-w-md">

          <div
            class="mb-2 flex justify-between">

            <span
              class="text-[9px] font-black uppercase
                     tracking-widest text-slate-400">

              Community Quest

            </span>

            <span
              class="text-[9px] font-black
                     text-emerald-500">

              Building the next world

            </span>

          </div>

          <div
            class="h-3 overflow-hidden rounded-full
                   bg-white shadow-inner">

            <div
              class="h-full w-[52%] rounded-full
                     bg-gradient-to-r
                     from-emerald-400
                     via-sky-400
                     to-violet-400">
            </div>

          </div>

        </div>

      </div>

    </div>

  </section>

</div>