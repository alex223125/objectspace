<section
  id="evolution"
  class="relative overflow-hidden bg-gradient-to-b
         from-white via-sky-50/40 to-emerald-50/40">

  <!-- ========================================================= -->
  <!-- SOFT BACKGROUND -->
  <!-- ========================================================= -->

  <div class="pointer-events-none absolute inset-0 overflow-hidden">

    <div
      class="absolute left-1/4 top-0
             h-[350px] w-[350px]
             rounded-full bg-sky-200/30
             blur-[100px]">
    </div>

    <div
      class="absolute bottom-0 right-1/4
             h-[350px] w-[350px]
             rounded-full bg-emerald-200/30
             blur-[100px]">
    </div>

  </div>



  <div class="relative mx-auto max-w-7xl px-6 py-20 lg:px-10">


    <!-- ======================================================= -->
    <!-- HEADER -->
    <!-- ======================================================= -->

    <div class="mx-auto max-w-2xl text-center">

      <div
        class="text-[10px] font-black uppercase
               tracking-[0.2em] text-emerald-500">

        Continuous evolution

      </div>


      <h2
        class="mt-4 text-4xl font-black tracking-tight
               text-slate-800">

        The ecosystem learns from activity.

      </h2>


      <p
        class="mt-4 text-sm leading-6 text-slate-500">

        Real practice creates feedback.
        Feedback creates improvements.
        Improvements create new versions.

      </p>

    </div>



    <!-- ======================================================= -->
    <!-- GAMIFICATION EVOLUTION VISUAL -->
    <!-- ======================================================= -->

    <div
      class="relative mx-auto mt-12
             flex h-[260px] max-w-4xl
             items-center justify-center">


      <!-- Soft central glow -->

      <div
        class="absolute left-1/2 top-1/2
               h-[220px] w-[220px]
               -translate-x-1/2
               -translate-y-1/2
               rounded-full
               bg-amber-200/30
               blur-[60px]
               animate-pulse">
      </div>


      <!-- Orbit -->

      <div
        class="absolute left-1/2 top-1/2
               h-[190px] w-[190px]
               -translate-x-1/2
               -translate-y-1/2
               rounded-full
               border border-sky-200/70
               border-dashed
               animate-[spin_18s_linear_infinite]">

        <div
          class="absolute -top-1.5 left-1/2
                 h-3 w-3
                 -translate-x-1/2
                 rounded-full
                 bg-sky-400
                 shadow-[0_0_15px_rgba(56,189,248,0.6)]">
        </div>

      </div>


      <!-- Second orbit -->

      <div
        class="absolute left-1/2 top-1/2
               h-[145px] w-[145px]
               -translate-x-1/2
               -translate-y-1/2
               rounded-full
               border border-amber-200/70
               animate-[spin_12s_linear_infinite_reverse]">

        <div
          class="absolute -right-1.5 top-1/2
                 h-3 w-3
                 -translate-y-1/2
                 rounded-full
                 bg-amber-400
                 shadow-[0_0_15px_rgba(251,191,36,0.6)]">
        </div>

      </div>



      <!-- ===================================================== -->
      <!-- CENTRAL LEVEL UPDATED BADGE -->
      <!-- ===================================================== -->

      <div
        class="relative z-20
               flex h-[130px] w-[130px]
               flex-col items-center justify-center
               rounded-[38px]
               border-[4px] border-amber-300
               bg-gradient-to-b
               from-amber-50 to-white
               shadow-[0_20px_60px_rgba(245,158,11,0.18)]
               ring-[10px] ring-amber-100/50
               animate-[pulse_3s_ease-in-out_infinite]">


        <!-- Small sparkle -->

        <div
          class="absolute -right-3 -top-3
                 flex h-8 w-8 items-center justify-center
                 rounded-xl
                 bg-white
                 border border-amber-200
                 text-sm
                 shadow-md">

          ✦

        </div>


        <!-- Level -->

        <div
          class="text-[9px] font-black uppercase
                 tracking-[0.18em]
                 text-amber-500">

          Level updated

        </div>


        <div
          class="mt-1
                 text-4xl font-black
                 tracking-tight
                 text-slate-800">

          04

        </div>


        <!-- Progress arrow -->

        <div
          class="mt-1
                 flex items-center gap-1
                 text-[9px] font-bold
                 text-emerald-500">

          <span>↑</span>

          <span>evolved</span>

        </div>


      </div>



      <!-- ===================================================== -->
      <!-- FLOATING UPDATE PARTICLES -->
      <!-- ===================================================== -->

      <div
        class="absolute left-[34%] top-[25%]
               flex h-8 w-8 items-center justify-center
               rounded-xl
               bg-emerald-50
               border border-emerald-200
               text-xs text-emerald-500
               shadow-sm
               animate-bounce">

        ✓

      </div>


      <div
        class="absolute right-[34%] top-[22%]
               flex h-8 w-8 items-center justify-center
               rounded-xl
               bg-sky-50
               border border-sky-200
               text-xs text-sky-500
               shadow-sm
               animate-pulse">

        ↗

      </div>


      <div
        class="absolute left-[30%] bottom-[22%]
               h-3 w-3
               rounded-full
               bg-violet-400
               shadow-[0_0_12px_rgba(167,139,250,0.6)]
               animate-ping">
      </div>


      <div
        class="absolute right-[30%] bottom-[25%]
               h-2.5 w-2.5
               rounded-full
               bg-orange-400
               shadow-[0_0_12px_rgba(251,146,60,0.6)]
               animate-pulse">
      </div>


      <!-- ===================================================== -->
      <!-- FLOATING VERSION LABELS -->
      <!-- ===================================================== -->

      <div
        class="absolute left-[20%] top-1/2
               -translate-y-1/2
               rounded-xl
               border border-slate-100
               bg-white/90
               px-3 py-2
               shadow-sm
               backdrop-blur-sm
               hidden sm:block">

        <div
          class="text-[8px] font-black uppercase
                 tracking-wider text-slate-400">

          Previous

        </div>

        <div
          class="mt-0.5 text-xs font-black text-slate-600">

          v3.8

        </div>

      </div>


      <div
        class="absolute right-[20%] top-1/2
               -translate-y-1/2
               rounded-xl
               border border-emerald-100
               bg-white/90
               px-3 py-2
               shadow-sm
               backdrop-blur-sm
               hidden sm:block">

        <div
          class="text-[8px] font-black uppercase
                 tracking-wider text-emerald-500">

          New version

        </div>

        <div
          class="mt-0.5 text-xs font-black text-slate-700">

          v4.0

        </div>

      </div>


    </div>



    <!-- ======================================================= -->
    <!-- EVOLUTION FLOW -->
    <!-- ======================================================= -->

    <div class="mx-auto mt-2 max-w-4xl">

      <div class="grid gap-3 md:grid-cols-5">


        <!-- NEW PROBLEM -->

        <div
          class="group rounded-xl
                 border border-rose-100
                 bg-rose-50/80
                 p-4 text-center
                 transition-all duration-300
                 hover:-translate-y-1
                 hover:shadow-md
                 hover:shadow-rose-100">

          <div
            class="text-xl transition-transform
                   duration-300
                   group-hover:scale-110">

            ⚠

          </div>


          <div
            class="mt-2 text-xs font-black text-slate-700">

            New problem

          </div>

        </div>



        <!-- ARROW -->

        <div
          class="flex items-center justify-center
                 text-slate-300">

          <span
            class="text-lg transition-transform
                   duration-300
                   hover:translate-x-1">

            →

          </span>

        </div>



        <!-- NEW METHOD -->

        <div
          class="group rounded-xl
                 border border-blue-100
                 bg-blue-50/80
                 p-4 text-center
                 transition-all duration-300
                 hover:-translate-y-1
                 hover:shadow-md
                 hover:shadow-blue-100">

          <div
            class="text-xl transition-transform
                   duration-300
                   group-hover:scale-110">

            ◈

          </div>


          <div
            class="mt-2 text-xs font-black text-slate-700">

            New method

          </div>

        </div>



        <!-- ARROW -->

        <div
          class="flex items-center justify-center
                 text-slate-300">

          <span
            class="text-lg transition-transform
                   duration-300
                   hover:translate-x-1">

            →

          </span>

        </div>



        <!-- BETTER ECOSYSTEM -->

        <div
          class="group rounded-xl
                 border border-emerald-100
                 bg-emerald-50/80
                 p-4 text-center
                 transition-all duration-300
                 hover:-translate-y-1
                 hover:shadow-md
                 hover:shadow-emerald-100">

          <div
            class="text-xl transition-transform
                   duration-300
                   group-hover:scale-110">

            ↗

          </div>


          <div
            class="mt-2 text-xs font-black text-slate-700">

            Better ecosystem

          </div>

        </div>


      </div>

    </div>



    <!-- ======================================================= -->
    <!-- SMALL UPDATE MESSAGE -->
    <!-- ======================================================= -->

    <div
      class="mx-auto mt-8 flex max-w-xl
             items-center justify-center gap-2
             text-center">


      <span
        class="flex h-5 w-5 items-center justify-center
               rounded-full
               bg-amber-100
               text-[9px]
               font-black
               text-amber-600">

        ↑

      </span>


      <p
        class="text-[11px] font-medium
               text-slate-400">

        Every validated improvement can move
        the ecosystem to a better version.

      </p>


    </div>


  </div>

</section>