<div class="relative overflow-hidden bg-white">

  <!-- ========================================================= -->
  <!-- BRIGHT GAMIFICATION BACKGROUND -->
  <!-- ========================================================= -->

  <div class="pointer-events-none absolute inset-0 overflow-hidden">

    <!-- Soft colorful atmosphere -->
    <div
      class="absolute -left-32 -top-32 h-[420px] w-[420px]
             rounded-full bg-amber-200/40 blur-[100px]
             animate-pulse">
    </div>

    <div
      class="absolute right-[-120px] top-[15%] h-[400px] w-[400px]
             rounded-full bg-sky-200/40 blur-[100px]
             animate-pulse [animation-delay:1s]">
    </div>

    <div
      class="absolute bottom-[-180px] left-[30%] h-[450px] w-[450px]
             rounded-full bg-emerald-200/30 blur-[110px]
             animate-pulse [animation-delay:2s]">
    </div>

    <div
      class="absolute bottom-[10%] right-[20%] h-[320px] w-[320px]
             rounded-full bg-violet-200/30 blur-[100px]
             animate-pulse [animation-delay:3s]">
    </div>


    <!-- Tiny floating game particles -->

    <div
      class="absolute left-[8%] top-[25%] h-2 w-2 rounded-full
             bg-amber-400 shadow-[0_0_12px_rgba(251,191,36,0.5)]
             animate-bounce">
    </div>

    <div
      class="absolute left-[22%] top-[12%] h-1.5 w-1.5 rounded-full
             bg-sky-400 shadow-[0_0_12px_rgba(56,189,248,0.5)]
             animate-pulse">
    </div>

    <div
      class="absolute right-[14%] top-[30%] h-2 w-2 rounded-full
             bg-violet-400 shadow-[0_0_12px_rgba(167,139,250,0.5)]
             animate-bounce [animation-delay:700ms]">
    </div>

    <div
      class="absolute right-[8%] bottom-[22%] h-1.5 w-1.5 rounded-full
             bg-emerald-400 shadow-[0_0_12px_rgba(52,211,153,0.5)]
             animate-pulse [animation-delay:1.2s]">
    </div>

  </div>



  <!-- ========================================================= -->
  <!-- MAIN CONTAINER -->
  <!-- ========================================================= -->

  <div
    class="relative mx-auto max-w-7xl px-6 py-20 lg:px-10">


    <!-- ======================================================= -->
    <!-- HEADER -->
    <!-- ======================================================= -->

    <div class="max-w-2xl">

      <div class="flex items-center gap-3">

        <!-- Quest icon -->

        <div
          class="flex h-10 w-10 items-center justify-center
                 rounded-2xl border border-amber-200
                 bg-amber-50 text-lg
                 shadow-sm shadow-amber-100">

          🗺️

        </div>


        <div>

          <div
            class="text-[10px] font-black uppercase
                   tracking-[0.2em] text-amber-600">

            From knowledge to execution

          </div>

          <div
            class="mt-1 text-[11px] font-medium text-slate-400">

            Your learning quest is progressing

          </div>

        </div>

      </div>


      <h2
        class="mt-6 text-4xl font-black tracking-tight
               text-slate-800 sm:text-5xl">

        One activity.

        <span
          class="bg-gradient-to-r from-amber-500
                 via-sky-500 to-violet-500
                 bg-clip-text text-transparent">

          Multiple layers of understanding.

        </span>

      </h2>


      <p
        class="mt-4 max-w-xl text-sm leading-6 text-slate-500">

        Turn knowledge into practical skills by progressing
        through each layer of the activity ecosystem.

      </p>

    </div>



    <!-- ======================================================= -->
    <!-- QUEST PATH -->
    <!-- ======================================================= -->

    <div class="relative mt-14">


      <!-- Background pathway -->

      <div
        class="absolute left-[7%] right-[7%] top-[31px]
               hidden h-2 rounded-full
               bg-slate-100 md:block">
      </div>


      <!-- Completed / progression path -->

      <div
        class="absolute left-[7%] top-[31px]
               hidden h-2 w-[58%] rounded-full
               bg-gradient-to-r
               from-emerald-400
               via-sky-400
               to-violet-400
               shadow-sm md:block">
      </div>


      <!-- Animated path shine -->

      <div
        class="absolute left-[7%] top-[31px]
               hidden h-2 w-[20%] rounded-full
               bg-white/60 blur-[2px]
               animate-[pulse_2s_ease-in-out_infinite]
               md:block">
      </div>



      <!-- ===================================================== -->
      <!-- CARDS -->
      <!-- ===================================================== -->

      <div class="grid gap-5 md:grid-cols-4">


        <!-- ================================================= -->
        <!-- 01 PROBLEM -->
        <!-- ================================================= -->

        <div
          class="group relative rounded-[28px]
                 border-2 border-rose-100
                 bg-white p-6
                 shadow-[0_12px_35px_rgba(244,63,94,0.08)]
                 transition-all duration-300
                 hover:-translate-y-2
                 hover:border-rose-200
                 hover:shadow-[0_20px_45px_rgba(244,63,94,0.15)]">


          <!-- Number -->

          <div class="flex items-center justify-between">

            <div
              class="flex h-14 w-14 items-center justify-center
                     rounded-[22px]
                     border-[3px] border-rose-300
                     bg-rose-50
                     text-sm font-black text-rose-600
                     shadow-md shadow-rose-100
                     ring-4 ring-rose-50
                     transition-transform duration-300
                     group-hover:scale-110">

              01

            </div>


            <span
              class="rounded-full border border-rose-100
                     bg-rose-50 px-3 py-1
                     text-[9px] font-black uppercase
                     tracking-wider text-rose-500">

              Quest

            </span>

          </div>


          <div class="mt-5">

            <h3
              class="text-xl font-black text-slate-800">

              Problem

            </h3>

            <p
              class="mt-3 text-xs leading-6 text-slate-500">

              What is happening?
              What needs to be solved?
              What changed?

            </p>

          </div>


          <!-- XP -->

          <div class="mt-6">

            <div
              class="mb-2 flex items-center justify-between">

              <span
                class="text-[9px] font-black uppercase
                       tracking-wider text-slate-400">

                Discovery XP

              </span>

              <span
                class="text-[10px] font-black text-rose-500">

                +100 XP

              </span>

            </div>


            <div
              class="h-2 overflow-hidden rounded-full
                     bg-rose-50">

              <div
                class="h-full w-[35%] rounded-full
                       bg-gradient-to-r
                       from-rose-400 to-pink-400
                       shadow-sm
                       transition-all duration-700
                       group-hover:w-[70%]">
              </div>

            </div>

          </div>


          <!-- Status -->

          <div
            class="mt-5 flex items-center gap-2
                   text-[10px] font-bold text-slate-400">

            <span
              class="h-2 w-2 rounded-full bg-rose-400">
            </span>

            Identify the challenge

          </div>

        </div>



        <!-- ================================================= -->
        <!-- 02 METHOD -->
        <!-- ================================================= -->

        <div
          class="group relative rounded-[28px]
                 border-2 border-sky-100
                 bg-white p-6
                 shadow-[0_12px_35px_rgba(14,165,233,0.08)]
                 transition-all duration-300
                 hover:-translate-y-2
                 hover:border-sky-200
                 hover:shadow-[0_20px_45px_rgba(14,165,233,0.15)]">


          <div class="flex items-center justify-between">

            <div
              class="flex h-14 w-14 items-center justify-center
                     rounded-[22px]
                     border-[3px] border-sky-300
                     bg-sky-50
                     text-sm font-black text-sky-600
                     shadow-md shadow-sky-100
                     ring-4 ring-sky-50
                     transition-transform duration-300
                     group-hover:scale-110">

              02

            </div>


            <span
              class="rounded-full border border-sky-100
                     bg-sky-50 px-3 py-1
                     text-[9px] font-black uppercase
                     tracking-wider text-sky-500">

              Strategy

            </span>

          </div>


          <div class="mt-5">

            <h3
              class="text-xl font-black text-slate-800">

              Method

            </h3>

            <p
              class="mt-3 text-xs leading-6 text-slate-500">

              What approach should people use
              to solve the problem?

            </p>

          </div>


          <div class="mt-6">

            <div
              class="mb-2 flex items-center justify-between">

              <span
                class="text-[9px] font-black uppercase
                       tracking-wider text-slate-400">

                Strategy XP

              </span>

              <span
                class="text-[10px] font-black text-sky-500">

                +250 XP

              </span>

            </div>


            <div
              class="h-2 overflow-hidden rounded-full
                     bg-sky-50">

              <div
                class="h-full w-[50%] rounded-full
                       bg-gradient-to-r
                       from-sky-400 to-cyan-400
                       transition-all duration-700
                       group-hover:w-[80%]">
              </div>

            </div>

          </div>


          <div
            class="mt-5 flex items-center gap-2
                   text-[10px] font-bold text-slate-400">

            <span
              class="h-2 w-2 rounded-full bg-sky-400">
            </span>

            Choose your strategy

          </div>

        </div>



        <!-- ================================================= -->
        <!-- 03 ALGORITHM -->
        <!-- ================================================= -->

        <div
          class="group relative rounded-[28px]
                 border-2 border-violet-100
                 bg-white p-6
                 shadow-[0_12px_35px_rgba(139,92,246,0.08)]
                 transition-all duration-300
                 hover:-translate-y-2
                 hover:border-violet-200
                 hover:shadow-[0_20px_45px_rgba(139,92,246,0.15)]">


          <div class="flex items-center justify-between">

            <div
              class="flex h-14 w-14 items-center justify-center
                     rounded-[22px]
                     border-[3px] border-violet-300
                     bg-violet-50
                     text-sm font-black text-violet-600
                     shadow-md shadow-violet-100
                     ring-4 ring-violet-50
                     transition-transform duration-300
                     group-hover:scale-110">

              03

            </div>


            <span
              class="rounded-full border border-violet-100
                     bg-violet-50 px-3 py-1
                     text-[9px] font-black uppercase
                     tracking-wider text-violet-500">

              Level Up

            </span>

          </div>


          <div class="mt-5">

            <h3
              class="text-xl font-black text-slate-800">

              Algorithm

            </h3>

            <p
              class="mt-3 text-xs leading-6 text-slate-500">

              How can the method become
              a repeatable sequence of actions?

            </p>

          </div>


          <div class="mt-6">

            <div
              class="mb-2 flex items-center justify-between">

              <span
                class="text-[9px] font-black uppercase
                       tracking-wider text-slate-400">

                Mastery XP

              </span>

              <span
                class="text-[10px] font-black text-violet-500">

                +500 XP

              </span>

            </div>


            <div
              class="h-2 overflow-hidden rounded-full
                     bg-violet-50">

              <div
                class="h-full w-[65%] rounded-full
                       bg-gradient-to-r
                       from-violet-400 to-fuchsia-400
                       transition-all duration-700
                       group-hover:w-[92%]">
              </div>

            </div>

          </div>


          <div
            class="mt-5 flex items-center gap-2
                   text-[10px] font-bold text-slate-400">

            <span
              class="h-2 w-2 rounded-full bg-violet-400">
            </span>

            Build repeatability

          </div>

        </div>



        <!-- ================================================= -->
        <!-- 04 ARCHITECTURE -->
        <!-- ================================================= -->

        <div
          class="group relative rounded-[28px]
                 border-2 border-amber-100
                 bg-white p-6
                 shadow-[0_12px_35px_rgba(245,158,11,0.08)]
                 transition-all duration-300
                 hover:-translate-y-2
                 hover:border-amber-200
                 hover:shadow-[0_20px_45px_rgba(245,158,11,0.18)]">


          <div class="flex items-center justify-between">

            <div
              class="flex h-14 w-14 items-center justify-center
                     rounded-[22px]
                     border-[3px] border-amber-300
                     bg-amber-50
                     text-sm font-black text-amber-600
                     shadow-md shadow-amber-100
                     ring-4 ring-amber-50
                     transition-transform duration-300
                     group-hover:scale-110">

              04

            </div>


            <span
              class="rounded-full border border-amber-100
                     bg-amber-50 px-3 py-1
                     text-[9px] font-black uppercase
                     tracking-wider text-amber-600">

              Boss Level

            </span>

          </div>


          <div class="mt-5">

            <h3
              class="text-xl font-black text-slate-800">

              Architecture

            </h3>

            <p
              class="mt-3 text-xs leading-6 text-slate-500">

              What systems, structures and
              technologies make it possible?

            </p>

          </div>


          <div class="mt-6">

            <div
              class="mb-2 flex items-center justify-between">

              <span
                class="text-[9px] font-black uppercase
                       tracking-wider text-slate-400">

                Evolution XP

              </span>

              <span
                class="text-[10px] font-black text-amber-500">

                +1000 XP

              </span>

            </div>


            <div
              class="h-2 overflow-hidden rounded-full
                     bg-amber-50">

              <div
                class="h-full w-[80%] rounded-full
                       bg-gradient-to-r
                       from-amber-400 to-yellow-300
                       shadow-sm
                       transition-all duration-700
                       group-hover:w-full">
              </div>

            </div>

          </div>


          <div
            class="mt-5 flex items-center gap-2
                   text-[10px] font-bold text-slate-400">

            <span
              class="h-2 w-2 rounded-full bg-amber-400">
            </span>

            Build the complete system

          </div>

        </div>


      </div>

    </div>



    <!-- ======================================================= -->
    <!-- BOTTOM QUEST STATUS -->
    <!-- ======================================================= -->

    <div
      class="mt-14 rounded-[26px]
             border-2 border-slate-100
             bg-gradient-to-r
             from-white via-slate-50 to-white
             p-6 shadow-sm">


      <div
        class="flex flex-col gap-5
               md:flex-row md:items-center
               md:justify-between">


        <div class="flex items-center gap-4">

          <!-- Achievement badge -->

          <div
            class="flex h-12 w-12 shrink-0 items-center
                   justify-center rounded-2xl
                   border-2 border-emerald-200
                   bg-emerald-50 text-lg
                   shadow-sm shadow-emerald-100">

            🏆

          </div>


          <div>

            <div
              class="text-sm font-black text-slate-700">

              Your learning path is connected.

            </div>

            <p
              class="mt-1 max-w-2xl text-xs
                     leading-5 text-slate-400">

              Improving one layer unlocks new possibilities
              across the entire activity ecosystem.

            </p>

          </div>

        </div>


        <!-- CTA -->

        <button
          class="group flex shrink-0 items-center
                 gap-2 rounded-2xl
                 border-2 border-amber-200
                 bg-gradient-to-r
                 from-amber-400 to-orange-400
                 px-5 py-3
                 text-sm font-black text-white
                 shadow-md shadow-amber-200/50
                 transition-all duration-300
                 hover:-translate-y-1
                 hover:from-amber-500
                 hover:to-orange-500
                 hover:shadow-lg hover:shadow-amber-200/70">

          <span>
            View ecosystem
          </span>

          <span
            class="transition-transform duration-300
                   group-hover:translate-x-1">

            →

          </span>

        </button>


      </div>


      <!-- Overall XP -->

      <div class="mt-6">

        <div
          class="mb-2 flex items-center justify-between">

          <span
            class="text-[9px] font-black uppercase
                   tracking-widest text-slate-400">

            Ecosystem Progress

          </span>

          <span
            class="text-[10px] font-black text-emerald-500">

            Level 04 · 68%

          </span>

        </div>


        <div
          class="h-2.5 overflow-hidden rounded-full
                 bg-slate-100">

          <div
            class="h-full w-[68%] rounded-full
                   bg-gradient-to-r
                   from-emerald-400
                   via-sky-400
                   to-violet-400
                   shadow-sm">
          </div>

        </div>

      </div>


    </div>


  </div>

</div>