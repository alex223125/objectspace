<!DOCTYPE html>
<html>
<head>
  <meta name="lava-verify" content="44fbc5ba5c1f5340" />
  <title>Objectspace</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <!--    assets for bootstrap 5-->
  <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>


  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>

  <link rel="stylesheet" href="https://unpkg.com" crossorigin="anonymous" />


  <!--    assets for tinymce-->
  <%#= tinymce_assets %>
  <!--    <script type="text/javascript" src="/assets/tinymce.js"></script>-->

</head>
<body class="bg-slate-50">

<div class="flex min-h-screen">

  <%= render 'admin/shared/sidebar' %>

  <div
    class="relative flex min-h-screen flex-1
             flex-col overflow-y-auto
             overflow-x-hidden">

    <%= render 'admin/shared/header' %>

    <main class="flex-1">

      <div
        class="mx-auto max-w-screen-2xl
                 p-4 md:p-6 2xl:p-10">

        <%= yield %>

      </div>

    </main>

  </div>

</div>

</body>
<%= render "admin/shared/footer"  %>
</html>
