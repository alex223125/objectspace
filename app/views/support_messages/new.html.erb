<div class="relative mx-auto max-w-5xl px-5 py-12 sm:px-7 lg:px-10">

  <div class="mb-10 text-center">

    <div
      class="mx-auto flex h-14 w-14 items-center justify-center
             rounded-2xl border-2 border-sky-200
             bg-sky-50 text-2xl"
    >
      💬
    </div>

    <div
      class="mt-5 text-[10px] font-black uppercase
             tracking-[0.25em] text-sky-500"
    >
      Financial Support · Contact
    </div>

    <h1
      class="mt-3 text-3xl font-black tracking-tight
             text-slate-800 dark:text-white sm:text-4xl"
    >
      Have a question, suggestion,
      <span
        class="bg-gradient-to-r from-sky-500
               via-violet-500 to-emerald-500
               bg-clip-text text-transparent"
      >
        or idea?
      </span>
    </h1>

    <p
      class="mx-auto mt-4 max-w-2xl text-sm leading-6
             text-slate-500 dark:text-gray-400"
    >
      We genuinely welcome questions, recommendations and ideas
      about financial support, donations, sponsorship and the
      future of this project.
    </p>

  </div>


  <div
    class="rounded-[30px] border-2 border-slate-100
           bg-white p-6 shadow-[0_20px_60px_rgba(15,23,42,0.07)]
           dark:border-strokedark dark:bg-boxdark
           sm:p-8 lg:p-10"
  >

    <%= form_with model: @support_message,
                  url: support_messages_path,
                  multipart: true,
                  data: {
                    controller: "support-message"
                  } do |f| %>

      <% if @support_message.errors.any? %>

        <div
          class="mb-8 rounded-2xl border-2 border-rose-100
                 bg-rose-50 p-5 text-sm text-rose-600"
        >
          <div class="font-black">
            Please correct the following:
          </div>

          <ul class="mt-2 list-disc pl-5">
            <% @support_message.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>

      <% end %>


      <div class="grid gap-5 md:grid-cols-2">

        <div>
          <%= f.label :first_name,
                      "First name",
                      class: "mb-2 block text-[10px] font-black uppercase tracking-widest text-slate-400" %>

          <%= f.text_field :first_name,
                           class: "w-full rounded-2xl border-2 border-slate-100 bg-slate-50 px-4 py-3.5 text-sm outline-none focus:border-sky-300 focus:bg-white dark:border-strokedark dark:bg-form-input dark:text-white",
                           required: true %>
        </div>


        <div>
          <%= f.label :last_name,
                      "Last name",
                      class: "mb-2 block text-[10px] font-black uppercase tracking-widest text-slate-400" %>

          <%= f.text_field :last_name,
                           class: "w-full rounded-2xl border-2 border-slate-100 bg-slate-50 px-4 py-3.5 text-sm outline-none focus:border-sky-300 focus:bg-white dark:border-strokedark dark:bg-form-input dark:text-white",
                           required: true %>
        </div>

      </div>


      <div class="mt-5">

        <%= f.label :organization_name,
                    "Organisation (optional)",
                    class: "mb-2 block text-[10px] font-black uppercase tracking-widest text-slate-400" %>

        <%= f.text_field :organization_name,
                         class: "w-full rounded-2xl border-2 border-slate-100 bg-slate-50 px-4 py-3.5 text-sm outline-none focus:border-sky-300 focus:bg-white dark:border-strokedark dark:bg-form-input dark:text-white" %>

      </div>


      <div class="mt-5">

        <%= f.label :email,
                    "Email address",
                    class: "mb-2 block text-[10px] font-black uppercase tracking-widest text-slate-400" %>

        <%= f.email_field :email,
                          required: true,
                          autocomplete: "email",
                          class: "w-full rounded-2xl border-2 border-slate-100 bg-slate-50 px-4 py-3.5 text-sm outline-none focus:border-sky-300 focus:bg-white dark:border-strokedark dark:bg-form-input dark:text-white" %>

        <p class="mt-2 text-xs text-slate-400">
          We will send a confirmation link to this address.
        </p>

      </div>


      <div class="mt-5">

        <%= f.label :support_category,
                    "What are you contacting us about?",
                    class: "mb-2 block text-[10px] font-black uppercase tracking-widest text-slate-400" %>

        <%= f.select :support_category,
                     SupportMessage::SUPPORT_CATEGORIES.map { |key, label| [label, key] },
                     { include_blank: "Select a support topic" },
                     class: "w-full rounded-2xl border-2 border-slate-100 bg-slate-50 px-4 py-3.5 text-sm outline-none focus:border-amber-300 focus:bg-white dark:border-strokedark dark:bg-form-input dark:text-white",
                     required: true %>

      </div>


      <div class="mt-5">

        <%= f.label :referral_source,
                    "How did you hear about the project? (optional)",
                    class: "mb-2 block text-[10px] font-black uppercase tracking-widest text-slate-400" %>

        <%= f.select :referral_source,
                     SupportMessage::REFERRAL_SOURCES.map { |key, label| [label, key] },
                     { include_blank: "Select an option" },
                     class: "w-full rounded-2xl border-2 border-slate-100 bg-slate-50 px-4 py-3.5 text-sm outline-none focus:border-violet-300 focus:bg-white dark:border-strokedark dark:bg-form-input dark:text-white" %>

      </div>


      <div class="mt-5">

        <%= f.label :message,
                    "Your message",
                    class: "mb-2 block text-[10px] font-black uppercase tracking-widest text-slate-400" %>

        <%= f.text_area :message,
                        rows: 10,
                        data: {
                          controller: "tinymce"
                        },
                        class: "w-full rounded-2xl border-2 border-slate-100 dark:border-strokedark" %>

        <p class="mt-2 text-xs text-slate-400">
          You can format your message, add links, lists and other useful context.
        </p>

      </div>


      <div class="mt-7">

        <%= f.label :attachments,
                    "Screenshots / attachments",
                    class: "mb-2 block text-[10px] font-black uppercase tracking-widest text-slate-400" %>

        <%= f.file_field :attachments,
                         multiple: true,
                         accept: "image/png,image/jpeg,image/webp,image/gif",
                         class: "block w-full rounded-2xl border-2 border-dashed border-slate-200 bg-slate-50 p-5 text-sm dark:border-strokedark dark:bg-form-input" %>

        <p class="mt-2 text-xs text-slate-400">
          PNG, JPEG, WebP or GIF screenshots. Maximum 10 MB per file.
        </p>

      </div>





      <div
        class="mt-8 rounded-[26px] border-2 border-sky-100
               bg-sky-50/40 p-6 dark:border-sky-500/20
               dark:bg-sky-500/5"
        data-controller="human-verification"
      >

        <div class="flex items-center gap-3">

          <div
            class="flex h-11 w-11 items-center justify-center
                   rounded-xl border border-sky-200
                   bg-white text-lg"
          >
            🧩
          </div>

          <div>
            <div class="text-sm font-black text-slate-700 dark:text-white">
              Human verification
            </div>

            <div
              data-human-verification-target="status"
              class="mt-1 text-xs text-slate-400"
            >
              Reconstruct the image to continue.
            </div>
          </div>

        </div>


        <div
          data-human-verification-target="board"
          class="mx-auto mt-6 grid max-w-[300px]
                 grid-cols-3 gap-1.5"
        >

          <% @puzzle_sequence.each_with_index do |piece, index| %>

            <button
              type="button"
              data-puzzle-piece="<%= piece %>"
              data-index="<%= index %>"
              data-action="click->human-verification#select"
              class="aspect-square overflow-hidden rounded-lg
                     border-2 border-white bg-sky-100
                     bg-cover transition-all duration-200
                     hover:scale-[1.02]"
              style="
              background-image: url('/images/project-puzzle.jpg');
                background-size: 300% 300%;
                background-position:
                  <%= (piece % 3) * 50 %>%
                    <%= (piece / 3) * 50 %>%;
              "
            ></button>

          <% end %>

        </div>


        <input
          type="hidden"
          name="puzzle_order"
          data-human-verification-target="order"
        >

        <p class="mt-4 text-center text-[11px] text-slate-400">
          This verification helps protect the contact system from automated spam.
        </p>

      </div>


      <div class="mt-8 flex justify-end">

        <%= f.submit "🚀 Send Message",
                     disabled: true,
                     data: {
                       human_verification_target: "submit"
                     },
                     class: "rounded-2xl bg-gradient-to-r
                             from-sky-500 to-violet-500
                             px-7 py-3.5 text-sm font-black
                             text-white shadow-lg
                             shadow-sky-200/40
                             opacity-50 cursor-not-allowed
                             transition-all duration-300" %>

      </div>

    <% end %>

  </div>

</div>