<%# ============================================================================
RESULT HIGHLIGHT STYLES
============================================================================ %>

<style>

    @keyframes entity-template-version-results-highlight {

        0% {
            box-shadow:
                    0 0 0 0 rgba(139, 92, 246, 0);
        }

        25% {
            box-shadow:
                    0 0 0 6px rgba(139, 92, 246, 0.18);
        }

        100% {
            box-shadow:
                    0 0 0 0 rgba(139, 92, 246, 0);
        }

    }


    .entity-template-version-results-highlight {

        animation:
                entity-template-version-results-highlight
                1.2s
                ease-out;

    }


    @media (prefers-reduced-motion: reduce) {

        .entity-template-version-results-highlight {

            animation: none;

        }

    }

</style>


<%# ============================================================================
FILTER / SEARCH RESULT BEHAVIOR
============================================================================ %>

<script>

    (() => {

        const results =
            document.getElementById(
                "entity-template-version-results"
            );


        const notice =
            document.getElementById(
                "entity-template-version-filter-notice"
            );


        if (!results) {
            return;
        }


        const url =
            new URL(
                window.location.href
            );


        const params =
            url.searchParams;


        /*
         * Determine whether the current page represents
         * an applied search/filter.
         *
         * We intentionally include all supported registry
         * parameters rather than checking only `q`.
         */
        const hasFilters =
            Boolean(
                params.get("q") ||
                params.get("status") ||
                params.get("sort") ||
                params.get("direction") ||
                params.get("per_page")
            );


        /*
         * Rails submit_tag("Apply") generates:
         *
         * commit=Apply
         */
        const searchWasApplied =
            params.get("commit") === "Apply" &&
            hasFilters;


        if (!searchWasApplied) {
            return;
        }


        /*
         * Display confirmation.
         */
        if (notice) {

            notice.classList.remove(
                "hidden"
            );


            window.setTimeout(
                () => {

                    notice.classList.add(
                        "hidden"
                    );

                },
                4500
            );

        }


        /*
         * Wait until the browser has rendered the
         * server response.
         */
        window.requestAnimationFrame(
            () => {


                /*
                 * Scroll to results.
                 */
                results.scrollIntoView({

                    behavior:
                        window.matchMedia(
                            "(prefers-reduced-motion: reduce)"
                        ).matches
                            ? "auto"
                            : "smooth",

                    block: "start"

                });


                /*
                 * Give keyboard/screen-reader focus.
                 */
                try {

                    results.focus({
                        preventScroll: true
                    });

                } catch (error) {

                    results.focus();

                }


                /*
                 * Highlight result area.
                 */
                results.classList.remove(
                    "entity-template-version-results-highlight"
                );


                /*
                 * Force animation restart.
                 */
                void results.offsetWidth;


                results.classList.add(
                    "entity-template-version-results-highlight"
                );


                /*
                 * Remove highlight after animation.
                 */
                window.setTimeout(
                    () => {

                        results.classList.remove(
                            "entity-template-version-results-highlight"
                        );

                    },
                    1400
                );

            }
        );

    })();

</script>