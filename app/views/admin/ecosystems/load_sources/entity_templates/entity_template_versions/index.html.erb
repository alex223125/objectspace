<%# ============================================================================
ENTITY TEMPLATE VERSIONS — INDEX

Path:
app/views/admin/ecosystems/load_sources/entity_templates/entity_template_versions/index.html.erb

Purpose:
High-performance administrative registry for Entity Template Versions.

Partials used:

_search_form.html.erb
_pagination.html.erb

Expected controller variables:

@entity_template_versions
@total_versions
@published_versions
@draft_versions
@archived_versions

Optional controller variables:

@search
@status
@sort
@direction
@page
@per_page
@total_pages

Supported query parameters:

q
status
sort
direction
per_page
page

============================================================================ %>

<%

  # ==========================================================================
  # SAFE DEFAULTS
  # ==========================================================================

  versions =
    @entity_template_versions ||
      ::Ecosystems::LoadSources::EntityTemplates::EntityTemplateVersion
        .includes(:entity_template)
        .order(version: :desc)

  total_versions =
    if defined?(@total_versions) && !@total_versions.nil?
      @total_versions
    else
      versions.respond_to?(:total_count) ?
        versions.total_count :
        versions.count
    end

  published_versions =
    if defined?(@published_versions) && !@published_versions.nil?
      @published_versions
    else
      versions.respond_to?(:where) ?
        versions.where(status: "published").count :
        0
    end

  draft_versions =
    if defined?(@draft_versions) && !@draft_versions.nil?
      @draft_versions
    else
      versions.respond_to?(:where) ?
        versions.where(status: "draft").count :
        0
    end

  archived_versions =
    if defined?(@archived_versions) && !@archived_versions.nil?
      @archived_versions
    else
      versions.respond_to?(:where) ?
        versions.where(status: "archived").count :
        0
    end


  # ==========================================================================
  # CURRENT FILTER / SORT STATE
  # ==========================================================================

  search =
    if defined?(@search) && @search.present?
      @search.to_s
    else
      params[:q].to_s
    end

  current_status =
    if defined?(@status) && @status.present?
      @status.to_s
    else
      params[:status].to_s
    end

  current_sort =
    if defined?(@sort) && @sort.present?
      @sort.to_s
    else
      params[:sort].presence || "version"
    end

  current_direction =
    if defined?(@direction) && @direction.present?
      @direction.to_s
    else
      params[:direction].presence || "desc"
    end


  # ==========================================================================
  # PAGINATION STATE
  # ==========================================================================

  current_page =
    if defined?(@page) && @page.present?
      @page.to_i
    else
      params[:page].to_i
    end

  current_page = 1 if current_page < 1

  per_page =
    if defined?(@per_page) && @per_page.present?
      @per_page.to_i
    else
      params[:per_page].to_i
    end

  per_page = 25 if per_page <= 0

  total_pages =
    if defined?(@total_pages) && @total_pages.present?
      @total_pages.to_i
    elsif total_versions.to_i > 0
      (total_versions.to_f / per_page).ceil
    else
      1
    end

  total_pages = 1 if total_pages < 1

  current_page =
    [current_page, total_pages].min


  # ==========================================================================
  # URL HELPERS
  # ==========================================================================

  base_query =
    request.query_parameters.except("page")


  sort_direction =
    current_direction == "asc" ? "desc" : "asc"

  sort_indicator =
    current_direction == "asc" ? "↑" : "↓"


  sort_url =
    lambda do |column|

      query =
        base_query.merge(
          "sort" => column,
          "direction" =>
            column == current_sort ?
              sort_direction :
              "desc",
          "page" => 1
        )

      request.path +
        "?" +
        query.to_query

    end


  status_url =
    lambda do |status|

      query =
        base_query.merge(
          "status" => status,
          "page" => 1
        )

      query.delete("status") if status.blank?

      request.path +
        "?" +
        query.to_query

    end


  clear_filters_url =
    request.path +
      "?" +
      {
        "page" => 1,
        "per_page" => per_page
      }.to_query


  # ==========================================================================
  # RESULT RANGE
  # ==========================================================================

  first_item =
    if total_versions.to_i.zero?
      0
    else
      ((current_page - 1) * per_page) + 1
    end

  last_item =
    [
      current_page * per_page,
      total_versions.to_i
    ].min


  # ==========================================================================
  # STATUS BADGE HELPER
  # ==========================================================================

  status_badge =
    lambda do |version|

      if version.respond_to?(:published?) && version.published?

        {
          label: "Published",
          classes:
            "bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400",
          icon: "✓"
        }

      elsif version.respond_to?(:draft?) && version.draft?

        {
          label: "Draft",
          classes:
            "bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400",
          icon: "◐"
        }

      elsif version.respond_to?(:archived?) && version.archived?

        {
          label: "Archived",
          classes:
            "bg-gray-100 text-gray-600 dark:bg-gray-900 dark:text-gray-400",
          icon: "◌"
        }

      else

        {
          label:
            version.respond_to?(:status) &&
              version.status.present? ?
              version.status.to_s.humanize :
              "Unknown",

          classes:
            "bg-gray-100 text-gray-600 dark:bg-gray-900 dark:text-gray-400",

          icon: "?"
        }

      end

    end

