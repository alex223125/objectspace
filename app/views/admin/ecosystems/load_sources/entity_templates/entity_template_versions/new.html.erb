<%# ============================================================================
ENTITY TEMPLATE VERSION — NEW

Path:
app/views/admin/ecosystems/load_sources/entity_templates/entity_template_versions/new.html.erb
============================================================================ %>

<div class="mx-auto w-full max-w-6xl px-5 py-8 sm:px-7 lg:px-10" data-controller="entity_template_definition_builder" >
<%# ========================================================================
HEADER
======================================================================== %>

  <div class="mb-8"> <div class="flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between">
    <div>

      <div class="flex items-center gap-3">

        <div class="flex h-12 w-12 items-center justify-center rounded-2xl border border-violet-200 bg-violet-100 text-2xl shadow-sm">
          🧬
        </div>

        <div>

          <div class="text-[11px] font-black uppercase tracking-[0.2em] text-violet-500">
            Entity Template System
          </div>

          <h1 class="mt-1 text-3xl font-black tracking-tight text-gray-900 dark:text-white">
            Create Template Version
          </h1>

          <p class="mt-2 max-w-2xl text-sm leading-6 text-gray-500 dark:text-gray-400">
            Create a new version of an Entity Template without changing
            previously published versions.
          </p>

        </div>

      </div>

      <div class="mt-4 flex flex-wrap items-center gap-2 text-xs text-gray-400">
        <span>Ecosystems</span>
        <span>›</span>
        <span>Load Sources</span>
        <span>›</span>
        <span>Entity Templates</span>
        <span>›</span>
        <span>Versions</span>
        <span>›</span>

        <span class="font-semibold text-violet-500">
        New Version
      </span>
      </div>

    </div>

    <%= link_to(
          admin_ecosystems_load_sources_entity_templates_entity_template_versions_path,
          class: "inline-flex shrink-0 items-center justify-center gap-2 rounded-xl border border-gray-200 bg-white px-5 py-3 text-sm font-semibold text-gray-700 shadow-sm transition hover:border-violet-200 hover:bg-violet-50 hover:text-violet-700 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300"
        ) do %>
      <span>←</span>
      Back to Versions
    <% end %>

  </div>

  </div>
<%# ========================================================================
EXPLANATION
======================================================================== %>

  <div class="mb-8 rounded-[24px] border-2 border-violet-100 bg-gradient-to-r from-violet-50 via-white to-indigo-50 p-6 shadow-sm shadow-violet-100/50">
    <div class="flex items-start gap-4">

      <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl border border-violet-200 bg-violet-100 text-xl">
        💡
      </div>

      <div>

        <div class="text-[11px] font-black uppercase tracking-[0.18em] text-violet-600">
          Version Protocol
        </div>

        <p class="mt-2 text-sm leading-6 text-gray-600 dark:text-gray-300">
          A version is a preserved snapshot of a template's structure.
          When the structure changes significantly, create a new version
          instead of silently modifying the old one.
        </p>

      </div>

    </div>

  </div>
<%# ========================================================================
FORM

IMPORTANT:
The definition textarea is a real Rails form field:

entity_template_version[definition]

Stimulus keeps that field synchronized with the visual builder.
======================================================================== %>

  <%= form_with(
        model: @entity_template_version,
        scope: :entity_template_version,
        url: admin_ecosystems_load_sources_entity_templates_entity_template_versions_path,
        method: :post,
        local: true,
        class: "space-y-8",
        data: {
          action: "submit->entity_template_definition_builder#beforeSubmit"
        }
      ) do |form| %>

<%# ======================================================================
ERRORS
====================================================================== %>

    <% if @entity_template_version.errors.any? %>

      <div class="rounded-2xl border-2 border-red-100 bg-red-50 p-5 text-sm text-red-700 dark:border-red-900/50 dark:bg-red-900/20 dark:text-red-300">

        <div class="font-black">
          Please correct the following:
        </div>

        <ul class="mt-3 list-disc space-y-1 pl-5">

          <% @entity_template_version.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>

        </ul>

      </div>

    <% end %>

<%# ======================================================================
STEP 01 — ENTITY TEMPLATE
====================================================================== %>

    <div class="rounded-[24px] border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-800 dark:bg-gray-800">

      <div class="mb-6">

        <div class="text-[11px] font-black uppercase tracking-[0.18em] text-indigo-500">
          Step 01
        </div>

        <h2 class="mt-1 text-xl font-black text-gray-900 dark:text-white">
          Choose the Entity Template
        </h2>

        <p class="mt-2 text-sm leading-6 text-gray-500 dark:text-gray-400">
          Every version belongs to one Entity Template.
        </p>

      </div>

      <div>

        <%= form.label(
              :entity_template_id,
              "Entity Template",
              class: "mb-2 block text-sm font-bold text-gray-700 dark:text-gray-300"
            ) %>

        <%= form.collection_select(
              :entity_template_id,
              @entity_templates,
              :id,
              :name,
              { prompt: "Select an entity template..." },
              {
                class: "block w-full rounded-xl border border-gray-300 bg-gray-50 px-4 py-3 text-sm text-gray-900 focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500 dark:border-gray-700 dark:bg-gray-900 dark:text-white"
              }
            ) %>

        <p class="mt-2 text-xs text-gray-400">
          Select the parent Entity Template for this version.
        </p>

      </div>

    </div>

<%# ======================================================================
STEP 02 — VERSION INFORMATION
====================================================================== %>

    <div class="rounded-[24px] border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-800 dark:bg-gray-800">

      <div class="mb-6">

        <div class="text-[11px] font-black uppercase tracking-[0.18em] text-violet-500">
          Step 02
        </div>

        <h2 class="mt-1 text-xl font-black text-gray-900 dark:text-white">
          Version Identity
        </h2>

        <p class="mt-2 text-sm leading-6 text-gray-500 dark:text-gray-400">
          Define the revision number and lifecycle state of this version.
        </p>

      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">

        <div>

          <%= form.label(
                :version,
                "Version",
                class: "mb-2 block text-sm font-bold text-gray-700 dark:text-gray-300"
              ) %>

          <%= form.number_field(
                :version,
                min: 1,
                placeholder: "1",
                class: "block w-full rounded-xl border border-gray-300 bg-gray-50 px-4 py-3 text-sm font-mono text-gray-900 focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500 dark:border-gray-700 dark:bg-gray-900 dark:text-white"
              ) %>

          <p class="mt-2 text-xs text-gray-400">
            Example: 1, 2, 3.
          </p>

        </div>

        <div>

          <%= form.label(
                :status,
                "Status",
                class: "mb-2 block text-sm font-bold text-gray-700 dark:text-gray-300"
              ) %>

          <%= form.select(
                :status,
                [
                  ["Draft", "draft"],
                  ["Published", "published"],
                  ["Archived", "archived"]
                ],
                {},
                class: "block w-full rounded-xl border border-gray-300 bg-gray-50 px-4 py-3 text-sm text-gray-900 focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500 dark:border-gray-700 dark:bg-gray-900 dark:text-white"
              ) %>

          <p class="mt-2 text-xs text-gray-400">
            New versions normally begin as drafts.
          </p>

        </div>

      </div>

    </div>

<%# ======================================================================
STEP 03 — DEFINITION BUILDER
====================================================================== %>

    <div class="rounded-[24px] border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-800 dark:bg-gray-800">

      <div class="mb-6">

        <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">

          <div>

            <div class="text-[11px] font-black uppercase tracking-[0.18em] text-emerald-500">
              Step 03
            </div>

            <h2 class="mt-1 text-xl font-black text-gray-900 dark:text-white">
              Template Definition
            </h2>

            <p class="mt-2 text-sm leading-6 text-gray-500 dark:text-gray-400">
              Build the structure visually instead of writing JSON manually.
            </p>

          </div>

          <div class="flex items-center gap-3">

            <div class="rounded-xl border border-violet-200 bg-violet-50 px-4 py-2 dark:border-violet-800 dark:bg-violet-900/20">

              <div class="text-[10px] font-black uppercase tracking-wider text-violet-500">
                Fields
              </div>

              <div
                class="mt-0.5 text-lg font-black text-violet-700 dark:text-violet-300"
                data-entity_template_definition_builder-target="propertyCount"
              >
                0 properties
              </div>

            </div>

          </div>

        </div>

      </div>

      <%# ====================================================================
  BUILDER TOOLBAR
  ==================================================================== %>

      <div class="mb-6 rounded-2xl border border-violet-100 bg-violet-50/60 p-5 dark:border-violet-900/40 dark:bg-violet-900/10">

        <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">

          <div>

            <div class="text-sm font-black text-gray-900 dark:text-white">
              Build your schema
            </div>

            <p class="mt-1 text-xs leading-5 text-gray-500 dark:text-gray-400">
              Add properties and define their type, label, description,
              and required state.
            </p>

          </div>

          <div class="flex flex-wrap gap-2">

            <button
              type="button"
              data-action="click->entity_template_definition_builder#addProperty"
              data-type="text"
              class="inline-flex items-center gap-2 rounded-xl bg-violet-600 px-4 py-2.5 text-xs font-black text-white shadow-sm transition hover:bg-violet-700"
            >
              ＋ Text
            </button>

            <button
              type="button"
              data-action="click->entity_template_definition_builder#addProperty"
              data-type="number"
              class="inline-flex items-center gap-2 rounded-xl border border-gray-200 bg-white px-4 py-2.5 text-xs font-bold text-gray-700 shadow-sm transition hover:border-violet-200 hover:bg-violet-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300"
            >
              ＋ Number
            </button>

            <button
              type="button"
              data-action="click->entity_template_definition_builder#addProperty"
              data-type="boolean"
              class="inline-flex items-center gap-2 rounded-xl border border-gray-200 bg-white px-4 py-2.5 text-xs font-bold text-gray-700 shadow-sm transition hover:border-violet-200 hover:bg-violet-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300"
            >
              ＋ Boolean
            </button>

            <button
              type="button"
              data-action="click->entity_template_definition_builder#addProperty"
              data-type="date"
              class="inline-flex items-center gap-2 rounded-xl border border-gray-200 bg-white px-4 py-2.5 text-xs font-bold text-gray-700 shadow-sm transition hover:border-violet-200 hover:bg-violet-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300"
            >
              ＋ Date
            </button>

            <button
              type="button"
              data-action="click->entity_template_definition_builder#addProperty"
              data-type="select"
              class="inline-flex items-center gap-2 rounded-xl border border-gray-200 bg-white px-4 py-2.5 text-xs font-bold text-gray-700 shadow-sm transition hover:border-violet-200 hover:bg-violet-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300"
            >
              ＋ Select
            </button>

          </div>

        </div>

      </div>

      <%# ====================================================================
  BUILDER STATUS
  ==================================================================== %>

      <div
        class="mb-5 min-h-[28px] text-xs font-bold text-violet-600"
        data-entity_template_definition_builder-target="builderStatus"
      >
        Builder ready
      </div>

      <%# ====================================================================
  EMPTY STATE
  ==================================================================== %>

      <div
        data-entity_template_definition_builder-target="emptyState"
        class="rounded-2xl border-2 border-dashed border-gray-200 bg-gray-50 p-10 text-center dark:border-gray-700 dark:bg-gray-900"
      >

        <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-violet-100 text-3xl dark:bg-violet-900/30">
          🧩
        </div>

        <h3 class="mt-4 text-lg font-black text-gray-900 dark:text-white">
          Your template is empty
        </h3>

        <p class="mx-auto mt-2 max-w-md text-sm leading-6 text-gray-500 dark:text-gray-400">
          Start building your Entity Template by adding your first property.
        </p>

        <button
          type="button"
          data-action="click->entity_template_definition_builder#addProperty"
          data-type="text"
          class="mt-5 rounded-xl bg-violet-600 px-5 py-2.5 text-xs font-black text-white shadow-sm transition hover:bg-violet-700"
        >
          ＋ Add First Property
        </button>

      </div>

      <%# ====================================================================
  DYNAMIC PROPERTIES
  ==================================================================== %>

      <div
        data-entity_template_definition_builder-target="properties"
        class="mt-5 space-y-4"
      ></div>

      <%# ====================================================================
  BUILDER ACTIONS
  ==================================================================== %>

      <div class="mt-6 flex flex-col gap-3 border-t border-gray-200 pt-5 sm:flex-row sm:items-center sm:justify-between dark:border-gray-700">

        <div class="flex flex-wrap gap-2">

          <button
            type="button"
            data-action="click->entity_template_definition_builder#addProperty"
            data-type="text"
            class="inline-flex items-center gap-2 rounded-xl bg-violet-600 px-4 py-2.5 text-xs font-black text-white shadow-sm transition hover:bg-violet-700"
          >
            ＋ Add Property
          </button>

          <button
            type="button"
            data-action="click->entity_template_definition_builder#clearBuilder"
            class="inline-flex items-center gap-2 rounded-xl border border-red-200 bg-white px-4 py-2.5 text-xs font-bold text-red-600 transition hover:bg-red-50 dark:border-red-900/50 dark:bg-gray-800 dark:text-red-400"
          >
            🧹 Clear
          </button>

        </div>

      </div>

      <%# ====================================================================
  DEFINITION JSON

  IMPORTANT:
  This is the actual Rails form field.

  Stimulus writes the generated JSON into it.

  Rails receives:

  entity_template_version[definition]
  ==================================================================== %>

      <details class="mt-6 rounded-2xl border border-gray-200 dark:border-gray-700">

        <summary class="cursor-pointer px-5 py-4 text-sm font-bold text-gray-700 dark:text-gray-300">
          Advanced: View generated JSON
        </summary>

        <div class="border-t border-gray-200 p-5 dark:border-gray-700">

        <textarea
          name="entity_template_version[definition]"
          rows="18"
          spellcheck="false"
          data-entity_template_definition_builder-target="definitionInput"
          data-action="input->entity_template_definition_builder#definitionInputChanged"
          class="block w-full rounded-xl border border-gray-700 bg-gray-950 px-4 py-4 font-mono text-sm leading-6 text-green-400 shadow-inner focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-500"
        ><%= @entity_template_version.definition %></textarea>



          <div
            class="mt-3 min-h-[20px] text-xs font-bold text-emerald-500"
            data-entity_template_definition_builder-target="jsonStatus"
          >
            JSON will be generated automatically.
          </div>

          <button
            type="button"
            data-action="click->entity_template_definition_builder#importJson"
            class="mt-4 rounded-xl border border-gray-200 bg-white px-4 py-2 text-xs font-bold text-gray-700 transition hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300"
          >
            📥 Import JSON
          </button>

          <p class="mt-2 text-xs text-gray-400">
            The visual builder and JSON field stay synchronized.
          </p>

        </div>

      </details>

    </div>

<%# ======================================================================
ACTIONS
====================================================================== %>

    <div class="flex flex-col-reverse gap-3 border-t border-gray-200 pt-6 sm:flex-row sm:items-center sm:justify-between dark:border-gray-800">

      <%= link_to(
            "Cancel",
            admin_ecosystems_load_sources_entity_templates_entity_template_versions_path,
            class: "inline-flex items-center justify-center rounded-xl border border-gray-200 bg-white px-5 py-3 text-sm font-semibold text-gray-600 shadow-sm transition hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300 dark:hover:bg-gray-700"
          ) %>

      <div class="flex items-center gap-3">

        <div
          class="hidden text-xs font-bold text-violet-600"
          data-entity_template_definition_builder-target="submitStatus"
        ></div>

        <%= form.submit(
              "Create Template Version",
              class: "inline-flex items-center justify-center rounded-xl bg-violet-600 px-6 py-3 text-sm font-black text-white shadow-sm transition hover:-translate-y-0.5 hover:bg-violet-700 focus:outline-none focus:ring-2 focus:ring-violet-500 focus:ring-offset-2",
              data: {
                entity_template_definition_builder_target: "submitButton"
              }
            ) %>

      </div>

    </div>

  <% end %>

</div>