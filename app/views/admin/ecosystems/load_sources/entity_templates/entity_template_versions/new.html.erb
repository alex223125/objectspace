<%# ============================================================================
ENTITY TEMPLATE VERSION — NEW
Path:
app/views/admin/ecosystems/load_sources/entity_templates/entity_template_versions/new.html.erb
============================================================================ %>

<div class="mx-auto w-full max-w-5xl px-5 py-8 sm:px-7 lg:px-10">
<%# ================================================================ %>
<%# HEADER %>
<%# ================================================================ %>

  <div class="mb-8">
    <div class="flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between">

      <div>

        <div class="flex items-center gap-3">

          <div
            class="
          flex h-12 w-12 items-center justify-center
          rounded-2xl
          border border-violet-200
          bg-violet-100
          text-2xl
          shadow-sm
        ">
            🧬
          </div>

          <div>

            <div
              class="
            text-[11px]
            font-black
            uppercase
            tracking-[0.2em]
            text-violet-500
          ">
              Entity Template System
            </div>

            <h1
              class="
            mt-1
            text-3xl
            font-black
            tracking-tight
            text-gray-900
            dark:text-white
          ">
              Create Template Version
            </h1>

            <p
              class="
            mt-2
            max-w-2xl
            text-sm
            leading-6
            text-gray-500
            dark:text-gray-400
          ">
              Create a new version of an Entity Template without changing
              previously published versions.
            </p>

          </div>

        </div>

        <%# BREADCRUMB %>

        <div
          class="
        mt-4
        flex
        flex-wrap
        items-center
        gap-2
        text-xs
        text-gray-400
      ">

          <span>Ecosystems</span>
          <span>›</span>
          <span>Load Sources</span>
          <span>›</span>
          <span>Entity Templates</span>
          <span>›</span>
          <span>Versions</span>
          <span>›</span>

          <span class="font-semibold text-violet-500">
        New Version
      </span>

        </div>

      </div>

      <%# BACK %>

      <%= link_to(
            admin_ecosystems_load_sources_entity_templates_entity_template_versions_path,
            class: "
          inline-flex shrink-0 items-center justify-center gap-2
          rounded-xl
          border border-gray-200
          bg-white
          px-5 py-3
          text-sm font-semibold
          text-gray-700
          shadow-sm
          transition
          hover:border-violet-200
          hover:bg-violet-50
          hover:text-violet-700
          dark:border-gray-700
          dark:bg-gray-800
          dark:text-gray-300
        "
          ) do %>

        <span>←</span>
        Back to Versions

      <% end %>

    </div>

  </div>
<%# ================================================================ %>
<%# EXPLANATION %>
<%# ================================================================ %>

  <div class=" mb-8 rounded-[24px] border-2 border-violet-100 bg-gradient-to-r from-violet-50 via-white to-indigo-50 p-6 shadow-sm shadow-violet-100/50 ">
    <div class="flex items-start gap-4">

      <div
        class="
      flex h-11 w-11 shrink-0
      items-center justify-center
      rounded-2xl
      border border-violet-200
      bg-violet-100
      text-xl
    ">
        💡
      </div>

      <div>

        <div
          class="
        text-[11px]
        font-black
        uppercase
        tracking-[0.18em]
        text-violet-600
      ">
          Version Protocol
        </div>

        <p
          class="
        mt-2
        text-sm
        leading-6
        text-gray-600
        dark:text-gray-300
      ">
          A version is a preserved snapshot of a template's structure.
          When the structure changes significantly, create a new version
          instead of silently modifying the old one.
        </p>

      </div>

    </div>

  </div>
<%# ================================================================ %>
<%# FORM %>
<%# ================================================================ %>

  <%= form_with(
        model: @entity_template_version,
        url: admin_ecosystems_load_sources_entity_templates_entity_template_versions_path,
        class: "space-y-8"
      ) do |form| %>

<%# ERRORS %>

    <% if @entity_template_version.errors.any? %>

      <div
        class="
      rounded-2xl
      border-2
      border-red-100
      bg-red-50
      p-5
      text-sm
      text-red-700
    ">

        <div class="font-black">
          Please correct the following:
        </div>

        <ul class="mt-3 list-disc space-y-1 pl-5">

          <% @entity_template_version.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>

        </ul>

      </div>

    <% end %>

<%# ============================================================ %>
<%# TEMPLATE %>
<%# ============================================================ %>

    <div
      class="
    rounded-[24px]
    border
    border-gray-200
    bg-white
    p-6
    shadow-sm
    dark:border-gray-800
    dark:bg-gray-800
  ">

      <div class="mb-6">

        <div
          class="
        text-[11px]
        font-black
        uppercase
        tracking-[0.18em]
        text-indigo-500
      ">
          Step 01
        </div>

        <h2
          class="
        mt-1
        text-xl
        font-black
        text-gray-900
        dark:text-white
      ">
          Choose the Entity Template
        </h2>

        <p
          class="
        mt-2
        text-sm
        leading-6
        text-gray-500
        dark:text-gray-400
      ">
          Every version belongs to one Entity Template.
        </p>

      </div>

      <div>

        <%= form.label(
              :entity_template_id,
              "Entity Template",
              class: "
            mb-2 block
            text-sm font-bold
            text-gray-700
            dark:text-gray-300
          "
            ) %>

        <%= form.collection_select(
              :entity_template_id,
              @entity_templates,
              :id,
              :name,
              { prompt: "Select an entity template..." },
              {
                class: "
              block w-full
              rounded-xl
              border border-gray-300
              bg-gray-50
              px-4 py-3
              text-sm
              text-gray-900
              focus:border-violet-500
              focus:outline-none
              focus:ring-2
              focus:ring-violet-500
              dark:border-gray-700
              dark:bg-gray-900
              dark:text-white
            "
              }
            ) %>

      </div>

    </div>

<%# ============================================================ %>
<%# VERSION INFORMATION %>
<%# ============================================================ %>

    <div
      class="
    rounded-[24px]
    border
    border-gray-200
    bg-white
    p-6
    shadow-sm
    dark:border-gray-800
    dark:bg-gray-800
  ">

      <div class="mb-6">

        <div
          class="
        text-[11px]
        font-black
        uppercase
        tracking-[0.18em]
        text-violet-500
      ">
          Step 02
        </div>

        <h2
          class="
        mt-1
        text-xl
        font-black
        text-gray-900
        dark:text-white
      ">
          Version Identity
        </h2>

        <p
          class="
        mt-2
        text-sm
        leading-6
        text-gray-500
        dark:text-gray-400
      ">
          Give this version a clear identity so administrators can
          understand what changed.
        </p>

      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">

        <%# VERSION NUMBER %>

        <div>

          <%= form.label(
                :version,
                "Version",
                class: "
              mb-2 block
              text-sm font-bold
              text-gray-700
              dark:text-gray-300
            "
              ) %>

          <%= form.text_field(
                :version,
                placeholder: "1.0",
                class: "
              block w-full
              rounded-xl
              border border-gray-300
              bg-gray-50
              px-4 py-3
              text-sm
              font-mono
              text-gray-900
              focus:border-violet-500
              focus:outline-none
              focus:ring-2
              focus:ring-violet-500
              dark:border-gray-700
              dark:bg-gray-900
              dark:text-white
            "
              ) %>

          <p class="mt-2 text-xs text-gray-400">
            Example: 1.0, 1.1, 2.0
          </p>

        </div>


        <%# NAME %>

        <div>

          <%= form.label(
                :name,
                "Version Name",
                class: "
              mb-2 block
              text-sm font-bold
              text-gray-700
              dark:text-gray-300
            "
              ) %>

          <%= form.text_field(
                :name,
                placeholder: "Initial structure",
                class: "
              block w-full
              rounded-xl
              border border-gray-300
              bg-gray-50
              px-4 py-3
              text-sm
              text-gray-900
              focus:border-violet-500
              focus:outline-none
              focus:ring-2
              focus:ring-violet-500
              dark:border-gray-700
              dark:bg-gray-900
              dark:text-white
            "
              ) %>

        </div>

      </div>


      <%# DESCRIPTION %>

      <div class="mt-6">

        <%= form.label(
              :description,
              "Description",
              class: "
            mb-2 block
            text-sm font-bold
            text-gray-700
            dark:text-gray-300
          "
            ) %>

        <%= form.text_area(
              :description,
              rows: 5,
              placeholder: "Describe what this version represents and what changed...",
              class: "
            block w-full
            rounded-xl
            border border-gray-300
            bg-gray-50
            px-4 py-3
            text-sm
            leading-6
            text-gray-900
            focus:border-violet-500
            focus:outline-none
            focus:ring-2
            focus:ring-violet-500
            dark:border-gray-700
            dark:bg-gray-900
            dark:text-white
          "
            ) %>

      </div>

    </div>


<%# ============================================================ %>
<%# STATUS %>
<%# ============================================================ %>

    <div
      class="
    rounded-[24px]
    border
    border-gray-200
    bg-white
    p-6
    shadow-sm
    dark:border-gray-800
    dark:bg-gray-800
  ">

      <div class="flex items-start gap-4">

        <div
          class="
        flex h-11 w-11 shrink-0
        items-center justify-center
        rounded-2xl
        border border-emerald-200
        bg-emerald-50
        text-xl
      ">
          ✓
        </div>

        <div class="flex-1">

          <%= form.label(
            :active,
            class: "
              cursor-pointer
              text-sm font-black
              text-gray-800
              dark:text-white
            "
          ) do %>

        <span class="flex items-center gap-3">

          <%= form.check_box(
                :active,
                class: "
                  h-5 w-5
                  rounded
                  border-gray-300
                  text-emerald-600
                  focus:ring-emerald-500
                "
              ) %>

          Make this version active

        </span>

          <% end %>

          <p
            class="
          mt-2
          text-sm
          leading-6
          text-gray-500
          dark:text-gray-400
        ">
            Active versions are available for use by the entity system.
            Keep older versions inactive when they should remain preserved
            but no longer be the current version.
          </p>

        </div>

      </div>

    </div>


<%# ============================================================ %>
<%# ACTIONS %>
<%# ============================================================ %>

    <div
      class="
    flex
    flex-col-reverse
    gap-3
    border-t
    border-gray-200
    pt-6
    sm:flex-row
    sm:items-center
    sm:justify-between
    dark:border-gray-800
  ">

      <%= link_to(
            "Cancel",
            admin_ecosystems_load_sources_entity_templates_entity_template_versions_path,
            class: "
          inline-flex
          items-center
          justify-center
          rounded-xl
          border border-gray-200
          bg-white
          px-5 py-3
          text-sm font-semibold
          text-gray-600
          shadow-sm
          hover:bg-gray-50
          dark:border-gray-700
          dark:bg-gray-800
          dark:text-gray-300
        "
          ) %>


      <%= form.submit(
            "Create Template Version",
            class: "
          inline-flex
          items-center
          justify-center
          rounded-xl
          bg-violet-600
          px-6 py-3
          text-sm font-black
          text-white
          shadow-sm
          transition
          hover:bg-violet-700
          focus:outline-none
          focus:ring-2
          focus:ring-violet-500
          focus:ring-offset-2
        "
          ) %>

    </div>

  <% end %>

</div>
