<%
  entity_template =
    @entity_template

  version =
    @version

  entity_templates =
    @entity_templates || []

  form_url =
    admin_ecosystems_load_sources_entity_templates_entity_template_versions_path

  back_url =
    if entity_template.present?
      admin_ecosystems_load_sources_entity_templates_entity_template_versions_path(
        entity_template_id: entity_template.id
      )
    else
      admin_ecosystems_load_sources_entity_templates_entity_template_versions_path
    end

  template_name =
    if entity_template.present? &&
      entity_template.respond_to?(:name) &&
      entity_template.name.present?

      entity_template.name.to_s

    else

      "Entity Template"

    end

  next_version =
    if version.respond_to?(:version)
      version.version
    else
      1
    end
%>


<div class="mx-auto w-full max-w-5xl px-4 py-6 sm:px-6 lg:px-8">

  <%# ================================================================
      HEADER
  ================================================================= %>

  <div class="mb-8">

    <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">

      <div class="min-w-0">

        <div
          class="
            mb-2
            text-[11px]
            font-black
            uppercase
            tracking-[0.2em]
            text-violet-500
          "
        >
          Entity Template Registry
        </div>

        <h1
          class="
            text-2xl
            font-black
            tracking-tight
            text-gray-900
            sm:text-3xl
            dark:text-white
          "
        >
          Create Template Version
        </h1>

        <p
          class="
            mt-2
            max-w-2xl
            text-sm
            leading-6
            text-gray-500
            dark:text-gray-400
          "
        >
          Create a new version of the selected Entity Template.
        </p>

      </div>


      <div class="shrink-0">

        <%= link_to(
              back_url,
              class: "
                inline-flex
                items-center
                gap-2
                rounded-xl
                border
                border-gray-200
                bg-white
                px-4
                py-2.5
                text-sm
                font-semibold
                text-gray-700
                shadow-sm
                transition
                hover:border-violet-200
                hover:text-violet-600
                dark:border-gray-700
                dark:bg-gray-800
                dark:text-gray-300
              "
            ) do %>

          <span>←</span>
          Back

        <% end %>

      </div>

    </div>

  </div>


  <%# ================================================================
      SELECTED TEMPLATE
  ================================================================= %>

  <div
    class="
      mb-6
      overflow-hidden
      rounded-2xl
      border-2
      border-violet-100
      bg-gradient-to-br
      from-violet-50
      via-white
      to-indigo-50
      shadow-sm
      dark:border-violet-900/40
      dark:from-violet-950/30
      dark:via-gray-900
      dark:to-indigo-950/30
    "
  >

    <div class="p-6">

      <div class="flex items-start gap-4">

        <div
          class="
            flex
            h-12
            w-12
            shrink-0
            items-center
            justify-center
            rounded-xl
            bg-violet-100
            text-xl
            dark:bg-violet-900/40
          "
        >
          🧱
        </div>


        <div class="min-w-0 flex-1">

          <div
            class="
              text-[10px]
              font-black
              uppercase
              tracking-[0.2em]
              text-violet-500
            "
          >
            Selected Entity Template
          </div>

          <div
            class="
              mt-1
              break-words
              text-lg
              font-black
              text-gray-900
              dark:text-white
            "
          >
            <%= template_name %>
          </div>

          <% if entity_template.present? %>

            <div
              class="
                mt-1
                font-mono
                text-xs
                text-gray-400
              "
            >
              Template #<%= entity_template.id %>
            </div>

          <% end %>

        </div>


        <div class="shrink-0">

          <div
            class="
              rounded-xl
              border
              border-violet-200
              bg-violet-100
              px-4
              py-3
              text-center
              dark:border-violet-800
              dark:bg-violet-900/30
            "
          >

            <div
              class="
                text-[9px]
                font-black
                uppercase
                tracking-wider
                text-violet-500
              "
            >
              New Version
            </div>

            <div
              class="
                mt-1
                text-lg
                font-black
                text-violet-700
                dark:text-violet-300
              "
            >
              v<%= next_version %>
            </div>

          </div>

        </div>

      </div>

    </div>

  </div>


  <%# ================================================================
      VALIDATION ERRORS
  ================================================================= %>

  <% if version.respond_to?(:errors) && version.errors.any? %>

    <div
      class="
        mb-6
        rounded-2xl
        border
        border-red-200
        bg-red-50
        p-5
        dark:border-red-900/50
        dark:bg-red-950/30
      "
    >

      <div class="flex items-start gap-3">

        <div
          class="
            flex
            h-9
            w-9
            shrink-0
            items-center
            justify-center
            rounded-lg
            bg-red-100
            text-red-600
            dark:bg-red-900/40
            dark:text-red-400
          "
        >
          !
        </div>

        <div class="min-w-0">

          <div
            class="
              text-sm
              font-black
              text-red-700
              dark:text-red-300
            "
          >
            Version could not be created
          </div>

          <ul
            class="
              mt-2
              space-y-1
              text-xs
              leading-5
              text-red-600
              dark:text-red-400
            "
          >

            <% version.errors.full_messages.each do |message| %>

              <li>
                <%= message %>
              </li>

            <% end %>

          </ul>

        </div>

      </div>

    </div>

  <% end %>


  <%# ================================================================
      FORM
  ================================================================= %>

  <div
    class="
      overflow-hidden
      rounded-2xl
      border
      border-gray-200
      bg-white
      shadow-sm
      dark:border-gray-800
      dark:bg-gray-800
    "
  >

    <div
      class="
        border-b
        border-gray-100
        px-6
        py-5
        dark:border-gray-700
      "
    >

      <div
        class="
          text-[11px]
          font-black
          uppercase
          tracking-[0.2em]
          text-gray-400
        "
      >
        Version Definition
      </div>

      <h2
        class="
          mt-1
          text-xl
          font-black
          text-gray-900
          dark:text-white
        "
      >
        Version Data
      </h2>

      <p
        class="
          mt-1
          text-xs
          text-gray-400
        "
      >
        Define the version number, lifecycle status and structural definition.
      </p>

    </div>


    <div class="p-6 sm:p-8">

      <%= form_with(
            model: version,
            url: form_url,
            method: :post,
            local: true
          ) do |form| %>


        <%# ==========================================================
            ENTITY TEMPLATE
        =========================================================== %>

        <%= hidden_field_tag(
              :entity_template_id,
              entity_template.id
            ) %>


        <div class="space-y-6">


          <%# ========================================================
              VERSION NUMBER
          ========================================================= %>

          <div>

            <%= form.label(
                  :version,
                  "Version",
                  class: "
                    block
                    text-xs
                    font-black
                    uppercase
                    tracking-wider
                    text-gray-500
                    dark:text-gray-400
                  "
                ) %>

            <div class="mt-2">

              <%= form.number_field(
                    :version,
                    min: 1,
                    value: version.version,
                    class: "
                      block
                      w-full
                      rounded-xl
                      border
                      border-gray-200
                      bg-white
                      px-4
                      py-3
                      font-mono
                      text-sm
                      font-bold
                      text-gray-900
                      outline-none
                      transition
                      placeholder:text-gray-400
                      focus:border-violet-500
                      focus:ring-2
                      focus:ring-violet-500/20
                      dark:border-gray-700
                      dark:bg-gray-900
                      dark:text-white
                    "
                  ) %>

            </div>

            <p class="mt-2 text-xs text-gray-400">
              Automatically initialized to the next available version number.
            </p>

          </div>


          <%# ========================================================
              STATUS
          ========================================================= %>

          <div>

            <%= form.label(
                  :status,
                  "Status",
                  class: "
                    block
                    text-xs
                    font-black
                    uppercase
                    tracking-wider
                    text-gray-500
                    dark:text-gray-400
                  "
                ) %>

            <div class="mt-2">

              <%= form.select(
                    :status,
                    [
                      ["Draft", "draft"],
                      ["Published", "published"],
                      ["Archived", "archived"]
                    ],
                    {
                      selected: version.status.presence || "draft"
                    },
                    {
                      class: "
                        block
                        w-full
                        rounded-xl
                        border
                        border-gray-200
                        bg-white
                        px-4
                        py-3
                        text-sm
                        font-semibold
                        text-gray-900
                        outline-none
                        transition
                        focus:border-violet-500
                        focus:ring-2
                        focus:ring-violet-500/20
                        dark:border-gray-700
                        dark:bg-gray-900
                        dark:text-white
                      "
                    }
                  ) %>

            </div>

            <p class="mt-2 text-xs text-gray-400">
              New template versions normally begin as drafts.
            </p>

          </div>


          <%# ========================================================
              DEFINITION
          ========================================================= %>

          <div>

            <div class="flex items-center justify-between gap-4">

              <%= form.label(
                    :definition,
                    "Definition",
                    class: "
                      block
                      text-xs
                      font-black
                      uppercase
                      tracking-wider
                      text-gray-500
                      dark:text-gray-400
                    "
                  ) %>

              <span
                class="
                  rounded-full
                  bg-gray-100
                  px-2.5
                  py-1
                  text-[10px]
                  font-bold
                  text-gray-500
                  dark:bg-gray-900
                  dark:text-gray-400
                "
              >
                JSON
              </span>

            </div>


            <div class="mt-2">

              <%= form.text_area(
                    :definition,
                    rows: 18,
                    value:
                      if version.definition.present?

                        if version.definition.is_a?(String)

                          version.definition

                        else

                          JSON.pretty_generate(
                            version.definition
                          )

                        end

                      else

                        JSON.pretty_generate(
                          {}
                        )

                      end,
                    spellcheck: false,
                    class: "
                      block
                      w-full
                      rounded-xl
                      border
                      border-gray-200
                      bg-gray-950
                      px-4
                      py-4
                      font-mono
                      text-xs
                      leading-6
                      text-emerald-300
                      outline-none
                      transition
                      placeholder:text-gray-600
                      focus:border-violet-500
                      focus:ring-2
                      focus:ring-violet-500/20
                      dark:border-gray-700
                    "
                  ) %>

            </div>

            <p
              class="
                mt-2
                text-xs
                leading-5
                text-gray-400
              "
            >
              Enter the structural definition as valid JSON.
            </p>

          </div>


        </div>


        <%# ==========================================================
            ACTIONS
        =========================================================== %>

        <div
          class="
            mt-8
            flex
            flex-col-reverse
            gap-3
            border-t
            border-gray-100
            pt-6
            sm:flex-row
            sm:items-center
            sm:justify-between
            dark:border-gray-700
          "
        >

          <%= link_to(
                back_url,
                class: "
                  inline-flex
                  items-center
                  justify-center
                  rounded-xl
                  border
                  border-gray-200
                  bg-white
                  px-5
                  py-3
                  text-sm
                  font-semibold
                  text-gray-700
                  transition
                  hover:border-gray-300
                  hover:bg-gray-50
                  dark:border-gray-700
                  dark:bg-gray-800
                  dark:text-gray-300
                  dark:hover:bg-gray-900
                "
              ) do %>

            Cancel

          <% end %>


          <%= form.submit(
                "Create Version",
                class: "
                  inline-flex
                  items-center
                  justify-center
                  rounded-xl
                  bg-violet-600
                  px-6
                  py-3
                  text-sm
                  font-bold
                  text-white
                  shadow-sm
                  transition
                  hover:bg-violet-700
                  focus:outline-none
                  focus:ring-2
                  focus:ring-violet-500
                  focus:ring-offset-2
                "
              ) %>

        </div>


      <% end %>

    </div>

  </div>


  <%# ================================================================
      FOOTER
  ================================================================= %>

  <div
    class="
      mt-6
      flex
      items-center
      justify-between
      border-t
      border-gray-100
      pt-5
      dark:border-gray-800
    "
  >

    <div
      class="
        font-mono
        text-[10px]
        font-bold
        uppercase
        tracking-wider
        text-gray-400
      "
    >
      ENTITY_TEMPLATE_VERSION :: CREATE
    </div>

    <div
      class="
        text-[10px]
        font-black
        uppercase
        tracking-wider
        text-violet-500
      "
    >
      Draft Registry
    </div>

  </div>

</div>
