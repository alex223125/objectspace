<div class="min-h-screen bg-slate-50 p-6 lg:p-8">

  <div class="mx-auto max-w-7xl">

    <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">

      <div>
        <div class="text-[10px] font-black uppercase tracking-[0.25em] text-violet-500">
          ADMIN
        </div>

        <h1 class="mt-1 text-2xl font-black tracking-tight text-slate-800">
          Definition Library
        </h1>

        <p class="mt-1 text-sm text-slate-400">
          Manage commercial entity definitions and published versions.
        </p>
      </div>

      <%= link_to "NEW DEFINITION",
                  new_admin_definition_template_path,
                  class: "rounded-xl bg-violet-600 px-5 py-3 text-xs font-black uppercase tracking-wider text-white shadow-lg shadow-violet-200 transition hover:bg-violet-700" %>

    </div>


    <div class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm">

      <div class="overflow-x-auto">

        <table class="min-w-full">

          <thead class="border-b border-slate-100 bg-slate-50">

          <tr>

            <th class="px-5 py-4 text-left text-[9px] font-black uppercase tracking-wider text-slate-400">
              Definition
            </th>

            <th class="px-5 py-4 text-left text-[9px] font-black uppercase tracking-wider text-slate-400">
              Category
            </th>

            <th class="px-5 py-4 text-left text-[9px] font-black uppercase tracking-wider text-slate-400">
              Version
            </th>

            <th class="px-5 py-4 text-left text-[9px] font-black uppercase tracking-wider text-slate-400">
              Usage
            </th>

            <th class="px-5 py-4 text-left text-[9px] font-black uppercase tracking-wider text-slate-400">
              Status
            </th>

            <th class="px-5 py-4 text-right text-[9px] font-black uppercase tracking-wider text-slate-400">
              Actions
            </th>

          </tr>

          </thead>


          <tbody class="divide-y divide-slate-100">

          <% @definition_templates.each do |definition| %>

            <tr class="transition hover:bg-violet-50/30">

              <td class="px-5 py-4">

                <div class="flex items-center gap-3">

                  <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-violet-50 text-violet-500">
                    <%= definition.icon.presence || "✦" %>
                  </div>

                  <div>

                    <div class="font-bold text-slate-700">
                      <%= definition.name %>
                    </div>

                    <div class="text-[10px] text-slate-400">
                      <%= definition.external_id %>
                    </div>

                  </div>

                </div>

              </td>


              <td class="px-5 py-4">

                  <span class="rounded-full bg-violet-50 px-3 py-1 text-[9px] font-black uppercase text-violet-500">
                    <%= definition.category %>
                  </span>

              </td>


              <td class="px-5 py-4 text-sm font-bold text-slate-600">
                v<%= definition.current_version_number || "-" %>
              </td>


              <td class="px-5 py-4">

                <div class="font-bold text-slate-700">
                  <%= definition.usage_count %>
                </div>

                <div class="text-[9px] text-slate-400">
                  score <%= definition.popularity_score %>
                </div>

              </td>


              <td class="px-5 py-4">

                <% if definition.active? && definition.status == "published" %>

                    <span class="rounded-full bg-emerald-50 px-3 py-1 text-[9px] font-black uppercase text-emerald-500">
                      PUBLISHED
                    </span>

                <% else %>

                    <span class="rounded-full bg-slate-100 px-3 py-1 text-[9px] font-black uppercase text-slate-400">
                      <%= definition.status.upcase %>
                    </span>

                <% end %>

              </td>


              <td class="px-5 py-4 text-right">

                <div class="flex justify-end gap-2">

                  <%= link_to "EDIT",
                              edit_admin_definition_template_path(definition.external_id),
                              class: "rounded-lg border border-slate-200 px-3 py-2 text-[8px] font-black text-slate-500 hover:bg-slate-50" %>

                  <% if definition.versions.where(status: "draft").exists? %>

                    <%= button_to "PUBLISH",
                                  publish_admin_definition_template_path(definition.external_id),
                                  method: :post,
                                  class: "rounded-lg bg-emerald-500 px-3 py-2 text-[8px] font-black text-white hover:bg-emerald-600" %>

                  <% end %>

                </div>

              </td>

            </tr>

          <% end %>

          </tbody>

        </table>

      </div>

    </div>

  </div>

</div>