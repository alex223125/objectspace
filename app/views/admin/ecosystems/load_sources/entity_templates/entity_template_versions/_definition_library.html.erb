<div
  class="fixed inset-0 z-[100] hidden"
  data-controller="definition-library"
  data-definition-library-target="modal"
  data-definition-library-catalog-url-value="<%= api_v1_admin_ecosystems_load_sources_entity_templates_entity_template_version_definition_templates_path %>"
  data-definition-library-catalog-usage-url-value="/api/v1/admin/ecosystems/load_sources/entity_templates/entity_template_version/definition_templates/:id/usage"
  data-definition-library-catalog-value="[]"
  data-action="keydown.esc->definition-library#close definition-library:open->definition-library#open"
  aria-hidden="true"
>

  <!-- BACKDROP -->

  <div
    class="absolute inset-0 bg-slate-950/70 backdrop-blur-sm"
    data-definition-library-target="backdrop"
    data-action="click->definition-library#close"
    aria-hidden="true"
  ></div>


  <!-- MODAL -->

  <div
    class="
      relative z-10
      flex h-[100dvh] w-full
      items-center justify-center
      p-0 sm:p-4 lg:p-6
    "
  >

    <div
      class="
        relative flex
        h-[100dvh] max-h-[100dvh]
        w-full max-w-[1500px]
        flex-col
        overflow-hidden
        bg-white
        shadow-[0_30px_100px_rgba(76,29,149,0.30)]
        sm:h-[calc(100dvh-2rem)]
        sm:max-h-[calc(100dvh-2rem)]
        sm:rounded-[30px]
        sm:border-2
        sm:border-violet-100
        lg:h-[calc(100dvh-3rem)]
        lg:max-h-[calc(100dvh-3rem)]
      "
      role="dialog"
      aria-modal="true"
      aria-labelledby="definition-library-title"
      data-definition-library-target="dialog"
    >

      <!-- ========================================================
           HEADER
           ======================================================== -->

      <header
        class="
          shrink-0
          border-b border-slate-200
          bg-gradient-to-br
          from-violet-50
          via-white
          to-sky-50
        "
      >

        <div class="px-5 py-5 sm:px-7 sm:py-6 lg:px-8">

          <div class="flex items-start justify-between gap-5">

            <div class="flex min-w-0 items-start gap-4">

              <div
                class="
                  flex h-12 w-12 shrink-0
                  items-center justify-center
                  rounded-2xl
                  border-2 border-violet-200
                  bg-violet-100
                  text-2xl text-violet-600
                  shadow-sm
                  sm:h-14 sm:w-14
                "
                aria-hidden="true"
              >
                ✦
              </div>

              <div class="min-w-0">

                <div class="flex flex-wrap items-center gap-2">

                  <div
                    class="
                      text-[11px] font-extrabold
                      uppercase tracking-[0.22em]
                      text-violet-600
                    "
                  >
                    DEFINITION LIBRARY
                  </div>

                  <span
                    class="
                      rounded-full
                      border border-violet-200
                      bg-violet-100
                      px-2.5 py-1
                      text-[10px] font-extrabold
                      uppercase tracking-wide
                      text-violet-700
                    "
                  >
                    PRO
                  </span>

                  <span
                    class="
                      rounded-full
                      border border-emerald-200
                      bg-emerald-50
                      px-2.5 py-1
                      text-[10px] font-extrabold
                      uppercase tracking-wide
                      text-emerald-700
                    "
                    data-definition-library-target="status"
                  >
                    CONNECTED
                  </span>

                </div>

                <h2
                  id="definition-library-title"
                  class="
                    mt-2
                    text-2xl font-extrabold
                    tracking-tight text-slate-900
                    sm:text-3xl
                  "
                >
                  Start with a proven structure
                </h2>

                <p
                  class="
                    mt-2 max-w-3xl
                    text-sm leading-6
                    text-slate-500
                    sm:text-base
                  "
                >
                  Select a production-ready entity definition,
                  inspect its structure, then import it into
                  Definition Studio.
                </p>

              </div>

            </div>


            <button
              type="button"
              class="
                flex h-11 w-11 shrink-0
                items-center justify-center
                rounded-xl
                border border-slate-200
                bg-white
                text-2xl
                text-slate-400
                shadow-sm
                transition
                hover:border-slate-300
                hover:bg-slate-50
                hover:text-slate-700
                focus:outline-none
                focus:ring-4
                focus:ring-violet-100
              "
              aria-label="Close definition library"
              data-action="click->definition-library#close"
            >
              ×
            </button>

          </div>


          <!-- SEARCH -->

          <div class="mt-6 flex flex-col gap-3 xl:flex-row">

            <div class="relative min-w-0 flex-1">

              <div
                class="
                  pointer-events-none
                  absolute inset-y-0 left-4
                  flex items-center
                  text-slate-300
                "
                aria-hidden="true"
              >
                <span class="text-xl">⌕</span>
              </div>

              <input
                type="search"
                placeholder="Search definitions, fields, categories, tags..."
                autocomplete="off"
                spellcheck="false"
                class="
                  block w-full
                  rounded-2xl
                  border-2 border-slate-200
                  bg-white
                  py-4 pl-12 pr-12
                  text-sm font-semibold
                  text-slate-700
                  shadow-sm
                  outline-none
                  transition
                  placeholder:text-slate-400
                  focus:border-violet-400
                  focus:ring-4
                  focus:ring-violet-100
                "
                data-definition-library-target="search"
                data-action="
                  input->definition-library#searchChanged
                  keydown->definition-library#searchKeydown
                "
                aria-label="Search definitions"
                />

              <button
                type="button"
                class="
                  absolute right-3 top-1/2
                  hidden h-8 w-8
                  -translate-y-1/2
                  items-center justify-center
                  rounded-lg
                  bg-slate-100
                  text-base text-slate-400
                  transition
                  hover:bg-slate-200
                  hover:text-slate-700
                "
                aria-label="Clear search"
                data-definition-library-target="clearSearch"
                data-action="click->definition-library#clearSearch"
              >
                ×
              </button>

            </div>


            <!-- VIEW BUTTONS -->

            <div class="flex shrink-0 flex-wrap gap-2">

              <button
                type="button"
                class="
                  rounded-2xl
                  border-2 border-amber-200
                  bg-amber-50
                  px-4 py-3
                  text-xs font-extrabold
                  uppercase tracking-wide
                  text-amber-700
                  transition
                  hover:bg-amber-100
                "
                data-definition-library-target="favoritesButton"
                data-action="click->definition-library#showFavorites"
              >
                ★ FAVORITES
                <span data-definition-library-target="favoriteCount">
                  0
                </span>
              </button>

              <button
                type="button"
                class="
                  rounded-2xl
                  border-2 border-slate-200
                  bg-white
                  px-4 py-3
                  text-xs font-extrabold
                  uppercase tracking-wide
                  text-slate-600
                  transition
                  hover:border-violet-200
                  hover:bg-violet-50
                "
                data-definition-library-target="recentButton"
                data-action="click->definition-library#showRecent"
              >
                RECENT
                <span data-definition-library-target="recentCount">
                  0
                </span>
              </button>

              <button
                type="button"
                class="
                  rounded-2xl
                  border-2 border-violet-200
                  bg-violet-100
                  px-4 py-3
                  text-xs font-extrabold
                  uppercase tracking-wide
                  text-violet-700
                  transition
                  hover:bg-violet-200
                "
                data-definition-library-target="recommendedButton"
                data-action="click->definition-library#showRecommended"
              >
                ✦ FOR YOU
              </button>

              <button
                type="button"
                class="
                  rounded-2xl
                  border-2 border-slate-200
                  bg-white
                  px-4 py-3
                  text-xs font-extrabold
                  uppercase tracking-wide
                  text-slate-600
                  transition
                  hover:border-violet-200
                  hover:bg-violet-50
                "
                data-action="click->definition-library#showAll"
              >
                ALL
              </button>

            </div>

          </div>


          <!-- SECONDARY TOOLBAR -->

          <div
            class="
              mt-4
              flex flex-col gap-3
              lg:flex-row
              lg:items-center
              lg:justify-between
            "
          >

            <div class="flex flex-wrap items-center gap-2">

              <button
                type="button"
                class="
                  rounded-xl
                  border-2 border-violet-200
                  bg-violet-50
                  px-4 py-2.5
                  text-xs font-extrabold
                  uppercase tracking-wide
                  text-violet-700
                  transition
                  hover:bg-violet-100
                "
                data-action="click->definition-library#toggleAdvancedFilters"
                aria-controls="definition-library-advanced-filters"
              >
                ⚙ FILTERS
              </button>

              <button
                type="button"
                class="
                  rounded-xl
                  border-2 border-violet-200
                  bg-violet-50
                  px-4 py-2.5
                  text-xs font-extrabold
                  uppercase tracking-wide
                  text-violet-700
                  transition
                  hover:bg-violet-100
                "
                data-definition-library-target="sortButton"
                data-action="click->definition-library#toggleSort"
                aria-label="Change definition sorting"
              >
                POPULAR
              </button>

              <div
                class="
                  rounded-xl
                  border-2 border-slate-200
                  bg-white
                  px-4 py-2.5
                "
                aria-live="polite"
              >
                <span
                  class="
                    text-xs font-extrabold
                    uppercase tracking-wide
                    text-slate-500
                  "
                  data-definition-library-target="resultCount"
                >
                  0 DEFINITIONS
                </span>
              </div>

            </div>

            <div
              data-definition-library-target="activeFilters"
              aria-live="polite"
            ></div>

          </div>


          <!-- ADVANCED FILTERS -->

          <div
            id="definition-library-advanced-filters"
            class="
              mt-4 hidden
              rounded-2xl
              border-2 border-violet-100
              bg-white
              p-5
              shadow-sm
            "
            data-definition-library-target="advancedFilters"
          >

            <div
              class="
                grid gap-4
                sm:grid-cols-2
                lg:grid-cols-5
              "
            >

              <label class="block">

                <span
                  class="
                    mb-2 block
                    text-xs font-extrabold
                    uppercase tracking-wide
                    text-slate-500
                  "
                >
                  FIELD TYPE
                </span>

                <select
                  name="type"
                  class="
                    w-full rounded-xl
                    border-2 border-slate-200
                    bg-white px-3 py-3
                    text-sm font-bold
                    text-slate-700
                    outline-none
                    focus:border-violet-400
                    focus:ring-4
                    focus:ring-violet-100
                  "
                  data-definition-library-target="filterType"
                  data-action="change->definition-library#advancedFilterChanged"
                >
                  <option value="ALL">ALL TYPES</option>
                  <option value="string">STRING</option>
                  <option value="text">TEXT</option>
                  <option value="number">NUMBER</option>
                  <option value="integer">INTEGER</option>
                  <option value="boolean">BOOLEAN</option>
                  <option value="date">DATE</option>
                  <option value="datetime">DATETIME</option>
                  <option value="email">EMAIL</option>
                  <option value="url">URL</option>
                  <option value="select">SELECT</option>
                  <option value="reference">REFERENCE</option>
                  <option value="json">JSON</option>
                </select>

              </label>


              <label class="block">

                <span
                  class="
                    mb-2 block
                    text-xs font-extrabold
                    uppercase tracking-wide
                    text-slate-500
                  "
                >
                  STATUS
                </span>

                <select
                  name="status"
                  class="
                    w-full rounded-xl
                    border-2 border-slate-200
                    bg-white px-3 py-3
                    text-sm font-bold
                    text-slate-700
                    outline-none
                    focus:border-violet-400
                    focus:ring-4
                    focus:ring-violet-100
                  "
                  data-definition-library-target="filterStatus"
                  data-action="change->definition-library#advancedFilterChanged"
                >
                  <option value="ALL">ALL</option>
                  <option value="ACTIVE">ACTIVE</option>
                  <option value="INACTIVE">INACTIVE</option>
                  <option value="MIXED">MIXED</option>
                </select>

              </label>


              <label class="block">

                <span
                  class="
                    mb-2 block
                    text-xs font-extrabold
                    uppercase tracking-wide
                    text-slate-500
                  "
                >
                  POPULARITY
                </span>

                <select
                  name="popularity"
                  class="
                    w-full rounded-xl
                    border-2 border-slate-200
                    bg-white px-3 py-3
                    text-sm font-bold
                    text-slate-700
                    outline-none
                    focus:border-violet-400
                    focus:ring-4
                    focus:ring-violet-100
                  "
                  data-definition-library-target="filterPopularity"
                  data-action="change->definition-library#advancedFilterChanged"
                >
                  <option value="ALL">ALL</option>
                  <option value="HIGH">HIGH 80+</option>
                  <option value="MEDIUM">MEDIUM</option>
                  <option value="LOW">LOW</option>
                </select>

              </label>


              <label class="block">

                <span
                  class="
                    mb-2 block
                    text-xs font-extrabold
                    uppercase tracking-wide
                    text-slate-500
                  "
                >
                  FEATURED
                </span>

                <select
                  name="featured"
                  class="
                    w-full rounded-xl
                    border-2 border-slate-200
                    bg-white px-3 py-3
                    text-sm font-bold
                    text-slate-700
                    outline-none
                    focus:border-violet-400
                    focus:ring-4
                    focus:ring-violet-100
                  "
                  data-definition-library-target="filterFeatured"
                  data-action="change->definition-library#advancedFilterChanged"
                >
                  <option value="ALL">ALL</option>
                  <option value="YES">FEATURED</option>
                  <option value="NO">NOT FEATURED</option>
                </select>

              </label>


              <label class="flex items-end">

                <span
                  class="
                    flex w-full cursor-pointer
                    items-center gap-3
                    rounded-xl
                    border-2 border-slate-200
                    bg-white px-3 py-3
                  "
                >

                  <input
                    type="checkbox"
                    name="new"
                    class="
                      h-5 w-5 rounded
                      border-slate-300
                      text-violet-600
                      focus:ring-violet-200
                    "
                    data-definition-library-target="filterNew"
                    data-action="change->definition-library#advancedFilterChanged"
                    />

                  <span
                    class="
                      text-xs font-extrabold
                      uppercase tracking-wide
                      text-slate-600
                    "
                  >
                    NEW ONLY
                  </span>

                </span>

              </label>

            </div>


            <div class="mt-4 flex justify-end">

              <button
                type="button"
                class="
                  rounded-xl
                  border-2 border-slate-200
                  bg-white
                  px-4 py-2.5
                  text-xs font-extrabold
                  uppercase tracking-wide
                  text-slate-600
                  transition
                  hover:bg-slate-50
                "
                data-definition-library-target="clearAllFilters"
                data-action="click->definition-library#clearFilters"
              >
                RESET ALL FILTERS
              </button>

            </div>

          </div>


          <!-- CATEGORIES -->

          <div
            class="
              mt-5 flex gap-2
              overflow-x-auto
              pb-1
              scrollbar-thin
            "
            data-definition-library-target="categories"
            aria-label="Definition categories"
          ></div>

        </div>

      </header>


      <!-- ========================================================
           STATUS
           ======================================================== -->

      <div
        class="
          hidden shrink-0
          border-b border-sky-100
          bg-sky-50
          px-5 py-3
        "
        data-definition-library-target="loadingState"
        role="status"
        aria-live="polite"
      >
        <div class="flex items-center gap-3">

          <span
            class="
              h-2.5 w-2.5
              animate-pulse
              rounded-full
              bg-sky-500
            "
          ></span>

          <span
            class="
              text-xs font-extrabold
              uppercase tracking-wide
              text-sky-700
            "
          >
            LOADING DEFINITIONS...
          </span>

        </div>
      </div>


      <div
        class="
          hidden shrink-0
          border-b border-red-100
          bg-red-50
          px-5 py-3
        "
        data-definition-library-target="errorState"
        role="alert"
      >
        <div class="flex items-center gap-3">

          <span
            class="
              flex h-7 w-7
              items-center justify-center
              rounded-lg
              bg-red-100
              text-sm font-extrabold
              text-red-600
            "
          >
            !
          </span>

          <span
            class="text-sm font-semibold text-red-700"
            data-definition-library-target="errorMessage"
          >
            Unable to load definitions.
          </span>

        </div>
      </div>


      <!-- ========================================================
           SCROLLABLE CONTENT
           ======================================================== -->

      <div
        class="
          min-h-0
          flex-1
          overflow-y-auto
          overscroll-contain
        "
      >

        <div
          class="
            grid
            min-h-full
            lg:grid-cols-[minmax(0,1fr)_460px]
          "
        >

          <!-- ======================================================
               LIBRARY
               ====================================================== -->

          <section
            class="
              min-h-[500px]
              bg-slate-50
              p-5
              sm:p-6
              lg:p-7
            "
            data-definition-library-target="libraryPanel"
            aria-label="Definition library"
          >

            <div
              class="mb-6"
              data-definition-library-target="recommendations"
            ></div>


            <div
              class="
                grid
                gap-5
                sm:grid-cols-2
                xl:grid-cols-3
              "
              data-definition-library-target="grid"
              aria-live="polite"
              aria-label="Definition results"
            ></div>


            <!-- EMPTY -->

            <div
              class="
                hidden
                min-h-[400px]
                items-center
                justify-center
              "
              data-definition-library-target="emptyState"
            >

              <div class="max-w-md text-center">

                <div
                  class="
                    mx-auto flex h-20 w-20
                    items-center justify-center
                    rounded-3xl
                    border-2 border-slate-200
                    bg-white
                    text-3xl text-slate-300
                    shadow-sm
                  "
                >
                  ⌕
                </div>

                <div
                  class="
                    mt-6
                    text-lg font-extrabold
                    text-slate-800
                  "
                >
                  No definitions found
                </div>

                <p
                  class="
                    mt-2
                    text-sm leading-6
                    text-slate-500
                  "
                >
                  Try another search term, category,
                  or filter.
                </p>

                <button
                  type="button"
                  class="
                    mt-6
                    rounded-2xl
                    border-2 border-violet-200
                    bg-violet-50
                    px-5 py-3
                    text-xs font-extrabold
                    uppercase tracking-wide
                    text-violet-700
                    transition
                    hover:bg-violet-100
                  "
                  data-action="click->definition-library#clearFilters"
                >
                  RESET FILTERS
                </button>

              </div>

            </div>

          </section>


          <!-- ======================================================
               PREVIEW
               ====================================================== -->

          <aside
            class="
              border-t border-slate-200
              bg-white
              lg:border-l
              lg:border-t-0
            "
          >

            <div class="flex min-h-[600px] flex-col">


              <!-- EMPTY PREVIEW -->

              <div
                class="
                  flex
                  min-h-[600px]
                  flex-1
                  items-center
                  justify-center
                  p-8
                "
                data-definition-library-target="previewEmpty"
              >

                <div class="max-w-sm text-center">

                  <div
                    class="
                      mx-auto flex h-20 w-20
                      items-center justify-center
                      rounded-3xl
                      border-2 border-violet-100
                      bg-violet-50
                      text-3xl text-violet-300
                    "
                  >
                    ◈
                  </div>

                  <div
                    class="
                      mt-6
                      text-lg font-extrabold
                      text-slate-800
                    "
                  >
                    Choose a definition
                  </div>

                  <p
                    class="
                      mt-2
                      text-sm leading-6
                      text-slate-500
                    "
                  >
                    Select a library item to inspect
                    its fields and JSON structure.
                  </p>

                </div>

              </div>


              <!-- SELECTED PREVIEW -->

              <div
                class="
                  hidden
                  min-h-[600px]
                  flex-1
                  flex-col
                "
                data-definition-library-target="preview"
              >

                <!-- PREVIEW HEADER -->

                <div
                  class="
                    shrink-0
                    border-b border-slate-200
                    bg-gradient-to-br
                    from-white
                    via-violet-50/40
                    to-sky-50/40
                    p-5
                    sm:p-6
                  "
                >

                  <div class="flex items-start gap-4">

                    <div
                      class="
                        flex h-12 w-12 shrink-0
                        items-center justify-center
                        rounded-2xl
                        border-2 border-violet-100
                        bg-violet-50
                        text-xl text-violet-600
                      "
                      data-definition-library-target="previewIcon"
                      aria-hidden="true"
                    >
                      ✦
                    </div>

                    <div class="min-w-0">

                      <div
                        class="
                          break-words
                          text-xl font-extrabold
                          text-slate-900
                        "
                        data-definition-library-target="previewTitle"
                      >
                        Definition
                      </div>

                      <div class="mt-2 flex flex-wrap items-center gap-2">

                        <span
                          class="
                            rounded-full
                            border border-violet-200
                            bg-violet-100
                            px-3 py-1
                            text-[10px]
                            font-extrabold
                            uppercase tracking-wide
                            text-violet-700
                          "
                          data-definition-library-target="previewCategory"
                        >
                          CATEGORY
                        </span>

                        <span
                          class="
                            text-xs
                            font-semibold
                            text-slate-400
                          "
                          data-definition-library-target="previewId"
                        >
                          ID
                        </span>

                      </div>

                    </div>

                  </div>


                  <p
                    class="
                      mt-4
                      text-sm leading-6
                      text-slate-500
                    "
                    data-definition-library-target="previewDescription"
                  ></p>


                  <div class="mt-5 grid grid-cols-3 gap-3">

                    <div
                      class="
                        rounded-2xl
                        border border-violet-100
                        bg-white p-3
                      "
                    >
                      <div
                        class="
                          text-[10px]
                          font-extrabold
                          uppercase tracking-wide
                          text-slate-400
                        "
                      >
                        FIELDS
                      </div>

                      <div
                        class="
                          mt-1
                          text-2xl font-extrabold
                          text-violet-600
                        "
                        data-definition-library-target="previewFieldCount"
                      >
                        0
                      </div>
                    </div>


                    <div
                      class="
                        rounded-2xl
                        border border-orange-100
                        bg-white p-3
                      "
                    >
                      <div
                        class="
                          text-[10px]
                          font-extrabold
                          uppercase tracking-wide
                          text-slate-400
                        "
                      >
                        REQUIRED
                      </div>

                      <div
                        class="
                          mt-1
                          text-2xl font-extrabold
                          text-orange-600
                        "
                        data-definition-library-target="previewRequiredCount"
                      >
                        0
                      </div>
                    </div>


                    <div
                      class="
                        rounded-2xl
                        border border-emerald-100
                        bg-white p-3
                      "
                    >
                      <div
                        class="
                          text-[10px]
                          font-extrabold
                          uppercase tracking-wide
                          text-slate-400
                        "
                      >
                        ACTIVE
                      </div>

                      <div
                        class="
                          mt-1
                          text-2xl font-extrabold
                          text-emerald-600
                        "
                        data-definition-library-target="previewActiveCount"
                      >
                        0
                      </div>
                    </div>

                  </div>

                </div>


                <!-- TABS -->

                <div
                  class="
                    shrink-0
                    border-b border-slate-200
                    px-5 pt-4
                    sm:px-6
                  "
                >

                  <div class="flex gap-6">

                    <button
                      type="button"
                      class="
                        border-b-2 border-violet-500
                        pb-3
                        text-xs font-extrabold
                        uppercase tracking-wide
                        text-violet-600
                      "
                      data-definition-library-target="fieldsTab"
                      data-action="click->definition-library#showFields"
                      aria-selected="true"
                    >
                      Fields
                    </button>

                    <button
                      type="button"
                      class="
                        border-b-2
                        border-transparent
                        pb-3
                        text-xs font-extrabold
                        uppercase tracking-wide
                        text-slate-400
                        transition
                        hover:text-slate-700
                      "
                      data-definition-library-target="jsonTab"
                      data-action="click->definition-library#showJson"
                      aria-selected="false"
                    >
                      JSON
                    </button>

                  </div>

                </div>


                <!-- CONTENT -->

                <div class="min-h-0 flex-1 overflow-y-auto">

                  <!-- FIELDS -->

                  <div
                    class="p-5 sm:p-6"
                    data-definition-library-target="fieldsPanel"
                  >

                    <div
                      class="
                        mb-4
                        flex items-center
                        justify-between
                        gap-3
                      "
                    >

                      <div
                        class="
                          text-xs font-extrabold
                          uppercase tracking-[0.15em]
                          text-slate-500
                        "
                      >
                        STRUCTURE
                      </div>

                      <div
                        class="
                          text-xs font-semibold
                          text-slate-400
                        "
                        data-definition-library-target="previewFieldSummary"
                      ></div>

                    </div>

                    <div
                      class="
                        overflow-hidden
                        rounded-2xl
                        border-2 border-slate-100
                      "
                      data-definition-library-target="fieldList"
                    ></div>

                  </div>


                  <!-- JSON -->

                  <div
                    class="hidden p-5 sm:p-6"
                    data-definition-library-target="jsonPanel"
                  >

                    <div
                      class="
                        overflow-hidden
                        rounded-2xl
                        border-2
                        border-slate-800
                        bg-slate-950
                        shadow-lg
                      "
                    >

                      <div
                        class="
                          flex items-center
                          justify-between
                          gap-3
                          border-b
                          border-slate-800
                          bg-slate-900
                          px-4 py-3
                        "
                      >

                        <div class="flex items-center gap-3">

                          <span
                            class="
                              h-2.5 w-2.5
                              rounded-full
                              bg-emerald-400
                            "
                          ></span>

                          <span
                            class="
                              text-xs font-extrabold
                              uppercase tracking-wide
                              text-emerald-400
                            "
                          >
                            VALID JSON
                          </span>

                        </div>

                        <button
                          type="button"
                          class="
                            rounded-lg
                            border border-slate-600
                            bg-slate-800
                            px-3 py-2
                            text-xs font-extrabold
                            uppercase tracking-wide
                            text-slate-200
                            transition
                            hover:bg-slate-700
                            hover:text-white
                          "
                          data-action="click->definition-library#copyJson"
                        >
                          COPY
                        </button>

                      </div>

                      <pre
                        class="
                          max-h-[600px]
                          overflow-auto
                          whitespace-pre
                          p-5
                          font-mono
                          text-[13px]
                          leading-6
                          text-emerald-300
                          sm:text-sm
                        "
                        data-definition-library-target="previewJson"
                      ></pre>

                    </div>

                  </div>

                </div>


                <!-- FOOTER -->

                <div
                  class="
                    shrink-0
                    border-t border-slate-200
                    bg-slate-50
                    p-5
                  "
                >

                  <div class="mb-4 flex items-start gap-3">

                    <span
                      class="
                        mt-1 h-2.5 w-2.5
                        shrink-0 rounded-full
                        bg-emerald-500
                      "
                    ></span>

                    <span
                      class="
                        text-xs
                        font-semibold
                        leading-5
                        text-slate-500
                      "
                      data-definition-library-target="analyticsStatus"
                    >
                      Ready to import into Definition Studio.
                    </span>

                  </div>


                  <button
                    type="button"
                    class="
                      w-full
                      rounded-2xl
                      border
                      border-violet-400
                      bg-gradient-to-r
                      from-violet-600
                      via-fuchsia-600
                      to-violet-600
                      px-5 py-4
                      text-sm font-extrabold
                      uppercase tracking-[0.12em]
                      text-white
                      shadow-lg
                      shadow-violet-200/60
                      transition-all duration-200
                      hover:-translate-y-0.5
                      hover:shadow-xl
                      hover:shadow-violet-200/70
                      focus:outline-none
                      focus:ring-4
                      focus:ring-violet-200
                      disabled:cursor-not-allowed
                      disabled:opacity-50
                    "
                    data-definition-library-target="applyButton"
                    data-action="click->definition-library#apply"
                    disabled
                  >
                    USE THIS DEFINITION →
                  </button>

                  <div
                    class="
                      mt-3
                      text-center
                      text-xs
                      font-medium
                      text-slate-400
                    "
                  >
                    You can customize every field after importing.
                  </div>

                </div>

              </div>

            </div>

          </aside>

        </div>

      </div>


      <!-- ========================================================
           CONFIRMATION
           ======================================================== -->

      <div
        class="
          absolute inset-0 z-50
          hidden
          items-center justify-center
          bg-slate-950/50
          p-5
          backdrop-blur-sm
        "
        data-definition-library-target="confirmation"
        aria-hidden="true"
      >

        <div
          class="
            w-full max-w-md
            rounded-3xl
            border-2 border-violet-100
            bg-white
            p-7
            shadow-[0_30px_100px_rgba(76,29,149,0.35)]
          "
          role="alertdialog"
          aria-modal="true"
          aria-labelledby="definition-library-confirm-title"
        >

          <div
            class="
              flex h-14 w-14
              items-center justify-center
              rounded-2xl
              bg-violet-100
              text-2xl text-violet-600
            "
          >
            ↓
          </div>

          <h3
            class="
              mt-6
              text-xl font-extrabold
              text-slate-900
            "
            id="definition-library-confirm-title"
            data-definition-library-target="confirmationTitle"
          >
            Import definition?
          </h3>

          <p
            class="
              mt-2
              text-sm leading-6
              text-slate-500
            "
            data-definition-library-target="confirmationDescription"
          >
            This definition will be loaded into Definition Studio.
          </p>

          <div class="mt-7 flex gap-3">

            <button
              type="button"
              class="
                flex-1
                rounded-2xl
                border-2 border-slate-200
                bg-white
                px-4 py-3
                text-xs font-extrabold
                uppercase tracking-wide
                text-slate-600
                transition
                hover:bg-slate-50
              "
              data-definition-library-target="confirmationCancel"
              data-action="click->definition-library#cancelImport"
            >
              CANCEL
            </button>

            <button
              type="button"
              class="
                flex-1
                rounded-2xl
                bg-violet-600
                px-4 py-3
                text-xs font-extrabold
                uppercase tracking-wide
                text-white
                transition
                hover:bg-violet-700
                focus:outline-none
                focus:ring-4
                focus:ring-violet-200
              "
              data-definition-library-target="confirmationConfirm"
              data-action="click->definition-library#confirmImport"
            >
              IMPORT
            </button>

          </div>

        </div>

      </div>


      <!-- ========================================================
           FOOTER
           ======================================================== -->

      <footer
        class="
          shrink-0
          border-t border-slate-200
          bg-white
          px-5 py-4
          sm:px-7
          lg:px-8
        "
      >

        <div
          class="
            flex flex-col gap-3
            sm:flex-row
            sm:items-center
            sm:justify-between
          "
        >

          <div class="flex items-center gap-3">

            <span
              class="
                flex h-8 w-8
                items-center justify-center
                rounded-lg
                bg-emerald-50
                text-sm font-extrabold
                text-emerald-600
              "
            >
              ✓
            </span>

            <span
              class="
                text-xs
                font-semibold
                text-slate-500
              "
            >
              Library definitions are starting points —
              never locked structures.
            </span>

          </div>

          <button
            type="button"
            class="
              rounded-xl
              border-2 border-slate-200
              bg-white
              px-5 py-2.5
              text-xs font-extrabold
              uppercase tracking-wide
              text-slate-600
              transition
              hover:border-slate-300
              hover:bg-slate-50
            "
            data-action="click->definition-library#close"
          >
            CLOSE
          </button>

        </div>

      </footer>

    </div>

  </div>

</div>