<%# ============================================================================
ENTITY TEMPLATE VERSIONS — SEARCH FORM PARTIAL

Path:
app/views/admin/ecosystems/load_sources/entity_templates/entity_template_versions/_search_form.html.erb

Purpose:
Reusable search, filtering, sorting and pagination toolbar for the
Entity Template Versions registry.

Expected variables:

Optional:
@search
@status
@sort
@direction
@per_page

The partial is intentionally defensive so it can be rendered from the index
without requiring every controller variable to be present.
============================================================================ %>

<%
  # --------------------------------------------------------------------------
  # SAFE DEFAULTS
  # --------------------------------------------------------------------------

  current_search =
    if defined?(@search) && @search.present?
      @search.to_s
    else
      params[:q].to_s
    end

  current_status =
    if defined?(@status) && @status.present?
      @status.to_s
    else
      params[:status].to_s
    end

  current_sort =
    if defined?(@sort) && @sort.present?
      @sort.to_s
    else
      params[:sort].presence || "version"
    end

  current_direction =
    if defined?(@direction) && @direction.present?
      @direction.to_s
    else
      params[:direction].presence || "desc"
    end

  current_per_page =
    if defined?(@per_page) && @per_page.present?
      @per_page.to_i
    else
      params[:per_page].to_i
    end

  current_per_page = 25 if current_per_page <= 0

  current_page =
    if params[:page].present?
      params[:page].to_i
    else
      1
    end

  current_page = 1 if current_page < 1

  # --------------------------------------------------------------------------
  # AVAILABLE OPTIONS
  # --------------------------------------------------------------------------

  status_options = [
    ["All statuses", ""],
    ["Published", "published"],
    ["Draft", "draft"],
    ["Archived", "archived"]
  ]

  sort_options = [
    ["Version", "version"],
    ["Entity Template", "entity_template"],
    ["Status", "status"],
    ["Created", "created_at"],
    ["Updated", "updated_at"]
  ]

  per_page_options = [
    ["25 / page", 25],
    ["50 / page", 50],
    ["100 / page", 100],
    ["250 / page", 250]
  ]

  # --------------------------------------------------------------------------
  # FILTER STATE
  # --------------------------------------------------------------------------

  filters_active =
    current_search.present? ||
      current_status.present? ||
      current_sort != "version" ||
      current_direction != "desc" ||
      current_per_page != 25

  has_search =
    current_search.present?

  has_status =
    current_status.present?

  # --------------------------------------------------------------------------
  # CLEAR FILTER URL
  # --------------------------------------------------------------------------

  clear_filters_url =
    request.path +
      "?" +
      {
        "page" => 1,
        "per_page" => 25
      }.to_query

  # --------------------------------------------------------------------------
  # CURRENT SORT LABEL
  # --------------------------------------------------------------------------

  current_sort_label =
    sort_options
      .find { |option| option[1].to_s == current_sort.to_s }
      &.first ||
      "Version"

  current_direction_label =
    current_direction == "asc" ? "Ascending" : "Descending"

  # --------------------------------------------------------------------------
  # QUERY SUMMARY
  # --------------------------------------------------------------------------

  active_filter_count = 0

  active_filter_count += 1 if current_search.present?
  active_filter_count += 1 if current_status.present?
  active_filter_count += 1 if current_sort != "version"
  active_filter_count += 1 if current_direction != "desc"
  active_filter_count += 1 if current_per_page != 25
%>

