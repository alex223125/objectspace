                    items-center
                    gap-1.5
                    rounded-full
                    border
                    border-indigo-200
                    bg-white
                    px-3
                    py-1.5
                    text-xs
                    font-semibold
                    text-indigo-600
                    dark:border-indigo-800
                    dark:bg-gray-800
                    dark:text-indigo-400
                  "
                >
                  <span class="text-indigo-400">
                    Direction:
                  </span>

                  <span class="font-black">
                    Ascending
                  </span>
                </span>

              <% end %>

              <% if current_per_page != 25 %>

                <span
                  class="
                    inline-flex
                    items-center
                    gap-1.5
                    rounded-full
                    border
                    border-gray-200
                    bg-white
                    px-3
                    py-1.5
                    text-xs
                    font-semibold
                    text-gray-600
                    dark:border-gray-700
                    dark:bg-gray-800
                    dark:text-gray-300
                  "
                >
                  <span class="text-gray-400">
                    Page size:
                  </span>

                  <span class="font-black">
                    <%= current_per_page %>
                  </span>
                </span>

              <% end %>

            </div>

          </div>

          <%= link_to(
                clear_filters_url,
                class: "
                  inline-flex
                  shrink-0
                  items-center
                  justify-center
                  gap-2
                  rounded-lg
                  border
                  border-violet-200
                  bg-white
                  px-3
                  py-2
                  text-xs
                  font-semibold
                  text-violet-600
                  shadow-sm
                  transition
                  hover:border-violet-300
                  hover:bg-violet-50
                  dark:border-violet-800
                  dark:bg-gray-800
                  dark:text-violet-400
                  dark:hover:bg-violet-900/20
                "
              ) do %>
            <span>↺</span>
            Clear all
          <% end %>

        </div>

      </div>

    <% end %>

    <%# -----------------------------------------------------------------------
    HIDDEN / PAGINATION STATE
    ------------------------------------------------------------------------ %>

    <%= hidden_field_tag :page, 1 %>

  <% end %>

  <%# =========================================================================
  SEARCH HELP
  ========================================================================= %>

  <div
    class="
      border-t
      border-gray-100
      bg-gray-50/60
      px-5
      py-3
      dark:border-gray-700
      dark:bg-gray-900/30
    "
  >

    <div
      class="
        flex
        flex-col
        gap-2
        sm:flex-row
        sm:items-center
        sm:justify-between
      "
    >

      <div
        class="
          flex
          items-center
          gap-2
          text-[10px]
          text-gray-400
        "
      >
        <span
          class="
            flex
            h-5
            w-5
            items-center
            justify-center
            rounded-md
            bg-gray-200
            font-black
            text-gray-500
            dark:bg-gray-800
            dark:text-gray-400
          "
        >
          ?
        </span>

        <span>
          Search supports template names, version numbers, record IDs and
          status values.
        </span>
      </div>

      <div
        class="
          flex
          items-center
          gap-2
          text-[10px]
          font-semibold
          text-gray-400
        "
      >
        <span>
          Current:
        </span>

        <span class="font-black text-gray-600 dark:text-gray-300">
          <%= current_sort_label %>
        </span>

        <span>·</span>

        <span class="font-black text-gray-600 dark:text-gray-300">
          <%= current_direction == "asc" ? "↑" : "↓" %>
        </span>

        <span>·</span>

        <span class="font-black text-gray-600 dark:text-gray-300">
          <%= current_per_page %>
        </span>

        <span>
          / page
        </span>
      </div>

    </div>

  </div>

</div>

<script>
    (() => {
        const form =
            document.getElementById(
                "entity-template-version-search-form"
            );

        if (!form) {
            return;
        }

        const searchInput =
            form.querySelector(
                "#entity-template-version-search"
            );

        const clearSearchButton =
            form.querySelector(
                "[data-clear-version-search]"
            );

        /*
         * Clear the search field without immediately submitting.
         *
         * The user can then add another search term or press Apply.
         */
        if (clearSearchButton && searchInput) {
            clearSearchButton.addEventListener(
                "click",
                () => {
                    searchInput.value = "";
                    searchInput.focus();
                }
            );
        }

        /*
         * Pressing Escape inside the search field clears it.
         */
        if (searchInput) {
            searchInput.addEventListener(
                "keydown",
                (event) => {
                    if (
                        event.key === "Escape" &&
                        searchInput.value
                    ) {
                        searchInput.value = "";
                        event.preventDefault();
                    }
                }
            );
        }

        /*
         * Changing the status or page size does not automatically submit.
         *
         * This keeps the form predictable and lets the user combine multiple
         * filters before applying them.
         */
    })();
</script>