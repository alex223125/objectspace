                items-center
                gap-2
              "
            >

              <% if has_search %>

                <span
                  class="
                    inline-flex
                    max-w-full
                    items-center
                    gap-1.5
                    rounded-full
                    border
                    border-violet-200
                    bg-white
                    px-3
                    py-1.5
                    text-xs
                    font-semibold
                    text-violet-600
                    dark:border-violet-800
                    dark:bg-gray-800
                    dark:text-violet-400
                  "
                >
                  <span class="text-violet-400">
                    Search:
                  </span>

                  <span class="max-w-[260px] truncate font-black">
                    <%= current_search %>
                  </span>
                </span>

              <% end %>

              <% if has_status %>

                <span
                  class="
                    inline-flex
                    items-center
                    gap-1.5
                    rounded-full
                    border
                    border-gray-200
                    bg-white
                    px-3
                    py-1.5
                    text-xs
                    font-semibold
                    text-gray-600
                    dark:border-gray-700
                    dark:bg-gray-800
                    dark:text-gray-300
                  "
                >
                  <span class="text-gray-400">
                    Status:
                  </span>

                  <span class="font-black">
                    <%= current_status.humanize %>
                  </span>
                </span>

              <% end %>

              <% if current_sort != "version" %>

                <span
                  class="
                    inline-flex
                    items-center
                    gap-1.5
                    rounded-full
                    border
                    border-indigo-200
                    bg-white
                    px-3
                    py-1.5
                    text-xs
                    font-semibold
                    text-indigo-600
                    dark:border-indigo-800
