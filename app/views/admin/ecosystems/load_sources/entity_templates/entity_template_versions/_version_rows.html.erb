<% entity_template_versions.each do |version| %>

  <article
    class="
      version-row
      group
      overflow-hidden
      rounded-2xl
      border
      border-gray-200
      bg-white
      shadow-sm
      transition
      duration-200
      hover:-translate-y-0.5
      hover:border-violet-200
      hover:shadow-md
      dark:border-gray-800
      dark:bg-gray-800
      dark:hover:border-violet-800
    "
    data-version-row
    data-version-id="<%= version.id %>"
  >

    <div class="p-5 sm:p-6">

      <div class="flex flex-col gap-5 xl:flex-row xl:items-center xl:justify-between">

        <div class="min-w-0 flex-1">

          <div class="flex flex-wrap items-center gap-2">

            <span
              class="
                inline-flex
                items-center
                gap-2
                rounded-full
                border
                border-violet-200
                bg-violet-50
                px-3
                py-1.5
                text-xs
                font-black
                text-violet-700
                dark:border-violet-800
                dark:bg-violet-900/20
                dark:text-violet-300
              "
            >
              <span>🧬</span>

              v<%= version.version %>
            </span>


            <% case version.status.to_s %>

            <% when "published" %>

              <span
                class="
                  rounded-full
                  bg-emerald-100
                  px-3
                  py-1.5
                  text-xs
                  font-semibold
                  text-emerald-700
                  dark:bg-emerald-900/30
                  dark:text-emerald-400
                "
              >
                ✓ Published
              </span>

            <% when "draft" %>

              <span
                class="
                  rounded-full
                  bg-amber-100
                  px-3
                  py-1.5
                  text-xs
                  font-semibold
                  text-amber-700
                  dark:bg-amber-900/30
                  dark:text-amber-400
                "
              >
                ◐ Draft
              </span>

            <% when "archived" %>

              <span
                class="
                  rounded-full
                  bg-gray-100
                  px-3
                  py-1.5
                  text-xs
                  font-semibold
                  text-gray-600
                  dark:bg-gray-900
                  dark:text-gray-400
                "
              >
                ▣ Archived
              </span>

            <% end %>


            <% if version.latest? %>

              <span
                class="
                  rounded-full
                  bg-violet-100
                  px-3
                  py-1.5
                  text-xs
                  font-semibold
                  text-violet-700
                  dark:bg-violet-900/30
                  dark:text-violet-300
                "
              >
                ★ Latest
              </span>

            <% end %>

          </div>


          <h3
            class="
              mt-4
              truncate
              text-lg
              font-black
              text-gray-900
              dark:text-white
            "
          >
            <%= version.entity_template&.name.presence || "Entity Template ##{version.entity_template_id}" %>
          </h3>


          <div
            class="
              mt-2
              flex
              flex-wrap
              items-center
              gap-x-4
              gap-y-2
              text-xs
              text-gray-400
            "
          >

            <span class="font-mono">
              ID: <%= version.id %>
            </span>

            <span>
              Template ID: <%= version.entity_template_id %>
            </span>

            <span>
              <%= pluralize(version.section_count, "section") %>
            </span>

            <span>
              <%= pluralize(version.field_count, "field") %>
            </span>

            <span>
              Created <%= time_ago_in_words(version.created_at) %> ago
            </span>

          </div>

        </div>


        <div
          class="
            flex
            shrink-0
            flex-wrap
            items-center
            gap-2
          "
        >

          <%= link_to(
                "View",
                admin_ecosystems_load_sources_entity_templates_entity_template_version_path(version),
                class: "
                  inline-flex
                  items-center
                  justify-center
                  rounded-xl
                  border
                  border-gray-200
                  bg-white
                  px-4
                  py-2.5
                  text-sm
                  font-semibold
                  text-gray-700
                  transition
                  hover:border-violet-300
                  hover:text-violet-600
                  dark:border-gray-700
                  dark:bg-gray-800
                  dark:text-gray-300
                "
              ) %>


          <%= link_to(
                "Edit",
                edit_admin_ecosystems_load_sources_entity_templates_entity_template_version_path(version),
                class: "
                  inline-flex
                  items-center
                  justify-center
                  rounded-xl
                  bg-violet-600
                  px-4
                  py-2.5
                  text-sm
                  font-semibold
                  text-white
                  transition
                  hover:bg-violet-700
                "
              ) %>


          <%= link_to(
                "Compare",
                compare_admin_ecosystems_load_sources_entity_templates_entity_template_version_path(version),
                class: "
                  inline-flex
                  items-center
                  justify-center
                  rounded-xl
                  border
                  border-indigo-200
                  bg-indigo-50
                  px-4
                  py-2.5
                  text-sm
                  font-semibold
                  text-indigo-700
                  transition
                  hover:bg-indigo-100
                  dark:border-indigo-800
                  dark:bg-indigo-900/20
                  dark:text-indigo-300
                "
              ) %>

        </div>

      </div>


      <div
        class="
          mt-5
          border-t
          border-gray-100
          pt-5
          dark:border-gray-700
        "
      >

        <div class="flex items-center gap-3">

          <div class="flex items-center gap-2">
            <div class="h-2.5 w-2.5 rounded-full bg-gray-300 dark:bg-gray-600"></div>

            <span class="text-[10px] font-bold uppercase tracking-wider text-gray-400">
              Structure
            </span>
          </div>


          <div class="h-px flex-1 bg-gray-100 dark:bg-gray-700"></div>


          <div class="flex items-center gap-2">
            <div
              class="
                h-2.5
                w-2.5
                rounded-full
                bg-violet-400
                shadow-[0_0_8px_rgba(139,92,246,0.4)]
              "
            ></div>

            <span class="text-[10px] font-bold uppercase tracking-wider text-violet-500">
              v<%= version.version %>
            </span>
          </div>


          <div class="h-px flex-1 bg-gray-100 dark:bg-gray-700"></div>


          <div class="flex items-center gap-2">

            <div
              class="
                h-2.5
                w-2.5
                rounded-full
                <%= version.published? ? "bg-emerald-400" : "bg-gray-300 dark:bg-gray-600" %>
              "
            ></div>

            <span
              class="
                text-[10px]
                font-bold
                uppercase
                tracking-wider
                <%= version.published? ? "text-emerald-500" : "text-gray-400" %>
              "
            >
              Runtime
            </span>

          </div>

        </div>

      </div>

    </div>

  </article>

<% end %>