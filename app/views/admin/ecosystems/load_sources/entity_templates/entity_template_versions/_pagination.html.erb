<%# ============================================================================
ENTITY TEMPLATE VERSIONS — PAGINATION PARTIAL

Path:
app/views/admin/ecosystems/load_sources/entity_templates/entity_template_versions/_pagination.html.erb

Purpose:
Reusable pagination footer for the Entity Template Version registry.

Expected locals:

versions
total_versions
current_page
per_page
total_pages

Optional locals:

pagination_param
pagination_window

The partial preserves the current URL query parameters and changes only
the requested pagination parameter.

Supported query parameters:

q
status
sort
direction
per_page
page

============================================================================ %>

<%

  # --------------------------------------------------------------------------
  # SAFE DEFAULTS
  # --------------------------------------------------------------------------
  versions =
    local_assigns.key?(:versions) ?
      versions :
      (@entity_template_versions || [])

  total_versions =
    if local_assigns.key?(:total_versions)
      total_versions.to_i
    elsif defined?(@total_versions) && !@total_versions.nil?
      @total_versions.to_i
    elsif versions.respond_to?(:total_count)
      versions.total_count.to_i
    elsif versions.respond_to?(:count)
      versions.count.to_i
    else
      0
    end

  current_page =
    if local_assigns.key?(:current_page)
      current_page.to_i
    elsif defined?(@page) && !@page.nil?
      @page.to_i
    else
      params[:page].to_i
    end

  current_page = 1 if current_page < 1

  per_page =
    if local_assigns.key?(:per_page)
      per_page.to_i
    elsif defined?(@per_page) && !@per_page.nil?
      @per_page.to_i
    else
      params[:per_page].to_i
    end

  per_page = 25 if per_page <= 0

  total_pages =
    if local_assigns.key?(:total_pages)
      total_pages.to_i
    elsif defined?(@total_pages) && !@total_pages.nil?
      @total_pages.to_i
    elsif total_versions > 0
      (total_versions.to_f / per_page).ceil
    else
      1
    end

  total_pages = 1 if total_pages < 1

  current_page =
    [current_page, total_pages].min

  pagination_param =
    if local_assigns.key?(:pagination_param)
      pagination_param.to_s
    else
      "page"
    end

  pagination_window =
    if local_assigns.key?(:pagination_window)
      pagination_window.to_i
    else
      2
    end

  pagination_window = 1 if pagination_window < 1

  # --------------------------------------------------------------------------
  # RANGE
  # --------------------------------------------------------------------------
  first_item =
    if total_versions.zero?
      0
    else
      ((current_page - 1) * per_page) + 1
    end

  last_item =
    if total_versions.zero?
      0
    else
      [
        current_page * per_page,
        total_versions
      ].min
    end

  # --------------------------------------------------------------------------
  # QUERY PARAMETERS
  # Preserve everything already present in the URL except the page number.
  # This means pagination continues to respect:
  #                                      q
  # status
  # sort
  # direction
  # per_page
  # and any future query parameters.
  # --------------------------------------------------------------------------
pagination_base_query =
  request.query_parameters.except(
    pagination_param
  )

  # --------------------------------------------------------------------------
  # URL HELPER
  # --------------------------------------------------------------------------
  page_url =
    lambda do |page_number|

      query =
        pagination_base_query.merge(
          pagination_param => page_number
        )

      request.path +
        "?" +
        query.to_query

    end

  # --------------------------------------------------------------------------
  # PAGE WINDOW
  # Example:
  # Current page = 8
  # 6 7 8 9 10
  # First and last pages are handled separately.
  #   --------------------------------------------------------------------------
  page_start =
    [
      current_page - pagination_window,
      1
    ].max

  page_end =
    [
      current_page + pagination_window,
      total_pages
    ].min

  # --------------------------------------------------------------------------
  # BUILD PAGE NUMBERS
  # --------------------------------------------------------------------------
  page_numbers =
    if total_pages <= ((pagination_window * 2) + 5)

      (1..total_pages).to_a

    else

      numbers = []

      numbers << 1

      left_boundary =
        [current_page - pagination_window, 2].max

      right_boundary =
        [
          current_page + pagination_window,
          total_pages - 1
        ].min

      if left_boundary > 2
        numbers << :ellipsis_left
      end

      (left_boundary..right_boundary).each do |page_number|
        numbers << page_number
      end

      if right_boundary < (total_pages - 1)
        numbers << :ellipsis_right
      end

      numbers << total_pages

      numbers.uniq

    end

  # --------------------------------------------------------------------------
  # PREVIOUS / NEXT LABELS
  # --------------------------------------------------------------------------
  previous_page =
    current_page - 1

  next_page =
    current_page + 1

%>

<%# ==========================================================================
PAGINATION FOOTER
========================================================================== %>

<div id="entity-template-version-pagination" class=" flex flex-col gap-4 border-t border-gray-200 bg-gray-50/70 px-5 py-4 sm:flex-row sm:items-center sm:justify-between dark:border-gray-700 dark:bg-gray-900/30 " data-pagination data-current-page="<%= current_page %>" data-total-pages="<%= total_pages %>" data-per-page="<%= per_page %>" data-total-records="<%= total_versions %>" >
<%# =========================================================================
RESULTS SUMMARY
========================================================================= %>

  <div class=" flex min-w-0 flex-col gap-1 text-xs text-gray-400 sm:flex-row sm:items-center sm:gap-2 " >
    <% if total_versions > 0 %>

  <span>
    Showing
  </span>

      <strong
        class="
      font-black
      text-gray-700
      dark:text-gray-200
    "
      >
        <%= number_with_delimiter(first_item) %>
      </strong>

      <span>
    –
  </span>

      <strong
        class="
      font-black
      text-gray-700
      dark:text-gray-200
    "
      >
        <%= number_with_delimiter(last_item) %>
      </strong>

      <span>
    of
  </span>

      <strong
        class="
      font-black
      text-gray-700
      dark:text-gray-200
    "
      >
        <%= number_with_delimiter(total_versions) %>
      </strong>

      <span>
    versions
  </span>

    <% else %>

  <span>
    No matching records
  </span>

    <% end %>

  </div>
<%# =========================================================================
PAGINATION CONTROLS
========================================================================= %>

  <% if total_pages > 1 %>

    <nav
      class="
    flex
    flex-wrap
    items-center
    justify-end
    gap-1
  "
      aria-label="Entity template version pagination"
      data-pagination-navigation
    >

      <%# =====================================================================
  FIRST PAGE
  ====================================================================== %>

      <% if current_page > 1 %>

        <%= link_to(
              page_url.call(1),
              class: "
            inline-flex
            h-9
            min-w-9
            items-center
            justify-center
            rounded-lg
            border
            border-gray-200
            bg-white
            px-2
            text-xs
            font-semibold
            text-gray-600
            shadow-sm
            transition
            hover:border-violet-200
            hover:bg-violet-50
            hover:text-violet-600
            focus:outline-none
            focus:ring-2
            focus:ring-violet-200
            dark:border-gray-700
            dark:bg-gray-800
            dark:text-gray-300
            dark:hover:border-violet-700
            dark:hover:bg-violet-900/20
            dark:hover:text-violet-300
            dark:focus:ring-violet-800
          ",
              aria: {
                label: "First page"
              },
              data: {
                pagination_link: true,
                pagination_page: 1
              }
            ) do %>

      <span aria-hidden="true">
        «
      </span>

          <span class="sr-only">
        First
      </span>

        <% end %>

        <%# ===================================================================
    PREVIOUS PAGE
    ==================================================================== %>

        <%= link_to(
              page_url.call(previous_page),
              class: "
            inline-flex
            h-9
            min-w-9
            items-center
            justify-center
            rounded-lg
            border
            border-gray-200
            bg-white
            px-2
            text-xs
            font-semibold
            text-gray-600
            shadow-sm
            transition
            hover:border-violet-200
            hover:bg-violet-50
            hover:text-violet-600
            focus:outline-none
            focus:ring-2
            focus:ring-violet-200
            dark:border-gray-700
            dark:bg-gray-800
            dark:text-gray-300
            dark:hover:border-violet-700
            dark:hover:bg-violet-900/20
            dark:hover:text-violet-300
            dark:focus:ring-violet-800
          ",
              aria: {
                label: "Previous page"
              },
              data: {
                pagination_link: true,
                pagination_page: previous_page
              }
            ) do %>

      <span aria-hidden="true">
        ‹
      </span>

          <span class="sr-only">
        Previous
      </span>

        <% end %>

      <% end %>

      <%# =====================================================================
  PAGE NUMBERS
  ====================================================================== %>

      <% page_numbers.each do |page_number| %>

        <% if page_number == :ellipsis_left ||
          page_number == :ellipsis_right %>

      <span
        class="
          inline-flex
          h-9
          min-w-9
          items-center
          justify-center
          px-1
          text-xs
          font-semibold
          text-gray-400
          dark:text-gray-500
        "
        aria-hidden="true"
      >
        …
      </span>

        <% elsif page_number == current_page %>

      <span
        class="
          inline-flex
          h-9
          min-w-9
          items-center
          justify-center
          rounded-lg
          bg-violet-600
          px-2
          text-xs
          font-bold
          text-white
          shadow-sm
          ring-2
          ring-violet-100
          dark:ring-violet-900/40
        "
        aria-current="page"
        data-pagination-current
      >
        <%= page_number %>
      </span>

        <% else %>

          <%= link_to(
                page_number,
                page_url.call(page_number),
                class: "
              inline-flex
              h-9
              min-w-9
              items-center
              justify-center
              rounded-lg
              border
              border-gray-200
              bg-white
              px-2
              text-xs
              font-semibold
              text-gray-600
              shadow-sm
              transition
              hover:border-violet-200
              hover:bg-violet-50
              hover:text-violet-600
              focus:outline-none
              focus:ring-2
              focus:ring-violet-200
              dark:border-gray-700
              dark:bg-gray-800
              dark:text-gray-300
              dark:hover:border-violet-700
              dark:hover:bg-violet-900/20
              dark:hover:text-violet-300
              dark:focus:ring-violet-800
            ",
                aria: {
                  label: "Page #{page_number}"
                },
                data: {
                  pagination_link: true,
                  pagination_page: page_number
                }
              ) %>

        <% end %>

      <% end %>

      <%# =====================================================================
  NEXT PAGE
  ====================================================================== %>

      <% if current_page < total_pages %>

        <%= link_to(
              page_url.call(next_page),
              class: "
            inline-flex
            h-9
            min-w-9
            items-center
            justify-center
            rounded-lg
            border
            border-gray-200
            bg-white
            px-2
            text-xs
            font-semibold
            text-gray-600
            shadow-sm
            transition
            hover:border-violet-200
            hover:bg-violet-50
            hover:text-violet-600
            focus:outline-none
            focus:ring-2
            focus:ring-violet-200
            dark:border-gray-700
            dark:bg-gray-800
            dark:text-gray-300
            dark:hover:border-violet-700
            dark:hover:bg-violet-900/20
            dark:hover:text-violet-300
            dark:focus:ring-violet-800
          ",
              aria: {
                label: "Next page"
              },
              data: {
                pagination_link: true,
                pagination_page: next_page
              }
            ) do %>

      <span aria-hidden="true">
        ›
      </span>

          <span class="sr-only">
        Next
      </span>

        <% end %>

        <%# ===================================================================
    LAST PAGE
    ==================================================================== %>

        <%= link_to(
              page_url.call(total_pages),
              class: "
            inline-flex
            h-9
            min-w-9
            items-center
            justify-center
            rounded-lg
            border
            border-gray-200
            bg-white
            px-2
            text-xs
            font-semibold
            text-gray-600
            shadow-sm
            transition
            hover:border-violet-200
            hover:bg-violet-50
            hover:text-violet-600
            focus:outline-none
            focus:ring-2
            focus:ring-violet-200
            dark:border-gray-700
            dark:bg-gray-800
            dark:text-gray-300
            dark:hover:border-violet-700
            dark:hover:bg-violet-900/20
            dark:hover:text-violet-300
            dark:focus:ring-violet-800
          ",
              aria: {
                label: "Last page"
              },
              data: {
                pagination_link: true,
                pagination_page: total_pages
              }
            ) do %>

      <span aria-hidden="true">
        »
      </span>

          <span class="sr-only">
        Last
      </span>

        <% end %>

      <% end %>

    </nav>

  <% end %>

</div>
<%# ==========================================================================
PAGINATION ACCESSIBILITY / PROGRESSIVE ENHANCEMENT
========================================================================== %>

<script> (() => { const pagination = document.getElementById( "entity-template-version-pagination" );
    if (!pagination) {
        return;
    }

    const links =
        pagination.querySelectorAll(
            "[data-pagination-link]"
        );

    if (!links.length) {
        return;
    }

    /*
     * Prevent accidental double-clicks from sending
     * multiple navigation requests.
     */
    links.forEach((link) => {
        link.addEventListener(
            "click",
            () => {

                if (link.dataset.paginationLoading === "true") {
                    return;
                }

                link.dataset.paginationLoading = "true";

                link.classList.add(
                    "pointer-events-none",
                    "opacity-60"
                );

                /*
                 * Keep the existing label visible while
                 * navigation is occurring.
                 */
                link.setAttribute(
                    "aria-busy",
                    "true"
                );
            },
            {
                passive: true
            }
        );
    });

    /*
     * Keyboard support for users navigating with
     * assistive technology.
     */
    pagination.addEventListener(
        "keydown",
        (event) => {

            if (
                event.key !== "ArrowLeft" &&
                event.key !== "ArrowRight"
            ) {
                return;
            }

            const current =
                pagination.querySelector(
                    "[aria-current='page']"
                );

            if (!current) {
                return;
            }

            const currentPage =
                Number(
                    pagination.dataset.currentPage
                );

            const totalPages =
                Number(
                    pagination.dataset.totalPages
                );

            let targetPage =
                currentPage;

            if (event.key === "ArrowLeft") {
                targetPage = currentPage - 1;
            }

            if (event.key === "ArrowRight") {
                targetPage = currentPage + 1;
            }

            if (
                targetPage < 1 ||
                targetPage > totalPages
            ) {
                return;
            }

            const target =
                pagination.querySelector(
                    `[data-pagination-page="${targetPage}"]`
                );

            if (!target) {
                return;
            }

            event.preventDefault();

            target.focus();

        }
    );

})();
</script>
