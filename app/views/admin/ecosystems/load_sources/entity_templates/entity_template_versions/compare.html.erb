<%#
  ============================================================================
  ENTITY TEMPLATE VERSION — COMPARE
  Path:
  app/views/admin/ecosystems/load_sources/entity_templates/entity_template_versions/compare.html.erb

  Purpose:
  Compare two versions of the same EntityTemplate.

  The comparator returns fields in this structure:

    {
      name: "email",
      change_type: "changed",

      version_a: {...},
      version_b: {...},

      version_a_present: true,
      version_b_present: true,

      changes: {
        "type" => {
          from: "text",
          to: "email"
        },
        "required" => {
          from: false,
          to: true
        }
      },

      version_a_text: {...},
      version_b_text: {...}
    }

  This view intentionally renders explicit human-readable differences.
  ============================================================================
%>

<%
  # ==========================================================================
  # DEFENSIVE NORMALIZATION
  # ==========================================================================

  versions =
    Array(@versions)

  field_changes =
    Array(@field_changes)

  definition_changes =
    Array(@definition_changes)

  comparison_summary =
    @comparison_summary.is_a?(Hash) ?
      @comparison_summary :
      {}

  left_definition =
    @left_definition.is_a?(Hash) ?
      @left_definition :
      {}

  right_definition =
    @right_definition.is_a?(Hash) ?
      @right_definition :
      {}


  # ==========================================================================
  # SUMMARY HELPERS
  # ==========================================================================

  summary_value = lambda do |key|
    comparison_summary[key] ||
      comparison_summary[key.to_s] ||
      0
  end


  added_count =
    summary_value.call(:added).to_i

  removed_count =
    summary_value.call(:removed).to_i

  changed_count =
    summary_value.call(:changed).to_i

  unchanged_count =
    summary_value.call(:unchanged).to_i


  total_changes =
    added_count +
      removed_count +
      changed_count


  total_fields =
    total_changes +
      unchanged_count


  # ==========================================================================
  # GENERIC HELPERS
  # ==========================================================================

  value_for = lambda do |object, key|
    if object.is_a?(Hash)
      object[key] ||
        object[key.to_s]
    end
  end


  field_name_for = lambda do |field|
    (
      value_for.call(field, :name) ||
        value_for.call(field, :key)
    ).to_s
  end


  field_type_for = lambda do |field|
    (
      value_for.call(field, :change_type) ||
        value_for.call(field, :type)
    ).to_s.downcase
  end


  field_label_for = lambda do |field|
    (
      value_for.call(field, :label) ||
        value_for.call(field, :name)
    ).to_s
  end


  field_left_for = lambda do |field|
    value_for.call(field, :version_a)
  end


  field_right_for = lambda do |field|
    value_for.call(field, :version_b)
  end


  field_changes_for = lambda do |field|
    value =
      value_for.call(field, :changes)

    case value
    when Hash
      value.map do |key, change|
        change_hash =
          change.is_a?(Hash) ?
            change :
            {}

        {
          key: key.to_s,
          from:
            change_hash[:from] ||
              change_hash["from"],
          to:
            change_hash[:to] ||
              change_hash["to"]
        }
      end
    when Array
      value.map do |change|
        change_hash =
          change.is_a?(Hash) ?
            change :
            {}

        {
          key:
            (
              change_hash[:key] ||
                change_hash["key"] ||
                change_hash[:name] ||
                change_hash["name"]
            ).to_s,

          from:
            change_hash[:from] ||
              change_hash["from"] ||
              change_hash[:left] ||
              change_hash["left"],

          to:
            change_hash[:to] ||
              change_hash["to"] ||
              change_hash[:right] ||
              change_hash["right"]
        }
      end
    else
      []
    end
  end


  pretty_json = lambda do |value|
    begin
      JSON.pretty_generate(value)
    rescue StandardError
      value.to_s
    end
  end


  display_value = lambda do |value|
    case value
    when nil
      "—"
    when true
      "true"
    when false
      "false"
    when String
      value.present? ? value : "(empty)"
    when Array, Hash
      pretty_json.call(value)
    else
      value.to_s
    end
  end


  human_property_name = lambda do |key|
    key.to_s
       .humanize
       .split
       .map(&:capitalize)
       .join(" ")
  end
%>

<div class="mx-auto w-full max-w-7xl px-5 py-8 sm:px-7 lg:px-10">
  <%#
    ========================================================================
    PAGE HEADER
    ========================================================================
  %>

  <div class="mb-8">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-start lg:justify-between">
      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-3">
          <div
            class="
              flex h-12 w-12 shrink-0 items-center justify-center
              rounded-2xl border border-violet-200 bg-violet-100
              text-2xl shadow-sm
              dark:border-violet-800 dark:bg-violet-950/40
            "
          >
            ⚖️
          </div>

          <div class="min-w-0">
            <div
              class="
                text-[11px] font-black uppercase tracking-[0.2em]
                text-violet-500
              "
            >
              Entity Template Version
            </div>

            <h1
              class="
                mt-1 text-3xl font-black tracking-tight text-gray-900
                dark:text-white
              "
            >
              Compare Versions
            </h1>
          </div>
        </div>

        <div class="mt-4 flex flex-wrap items-center gap-2 text-xs text-gray-400">
          <span>Encyclopedia</span>
          <span>›</span>
          <span>Ecosystems</span>
          <span>›</span>
          <span>Load Sources</span>
          <span>›</span>
          <span>Entity Templates</span>
          <span>›</span>
          <span>Versions</span>
          <span>›</span>

          <span class="font-semibold text-violet-500"> Compare </span>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <% if defined?(@entity_template_version) &&
          @entity_template_version.present? %>
          <%= link_to(
                "← Version",
                admin_ecosystems_load_sources_entity_templates_entity_template_version_path(
                  @entity_template_version
                ),
                class: "
                  inline-flex items-center justify-center rounded-xl
                  border border-gray-200 bg-white px-4 py-2.5
                  text-sm font-semibold text-gray-700 shadow-sm transition
                  hover:border-gray-300 hover:bg-gray-50
                  dark:border-gray-700 dark:bg-gray-800
                  dark:text-gray-200 dark:hover:bg-gray-750
                "
              ) %>
        <% end %>

        <%= link_to(
              "All Versions",
              admin_ecosystems_load_sources_entity_templates_entity_template_versions_path,
              class: "
                inline-flex items-center justify-center rounded-xl
                border border-violet-200 bg-violet-50 px-4 py-2.5
                text-sm font-semibold text-violet-700 shadow-sm transition
                hover:bg-violet-100
                dark:border-violet-800 dark:bg-violet-950/30
                dark:text-violet-300
              "
            ) %>
      </div>
    </div>
  </div>

  <%#
    ========================================================================
    PARENT TEMPLATE
    ========================================================================
  %>

  <% if defined?(@entity_template) &&
    @entity_template.present? %>
    <div
      class="
        mb-8 overflow-hidden rounded-[24px] border-2
        border-indigo-100 bg-gradient-to-br from-indigo-50 via-white to-violet-50
        shadow-sm
        dark:border-indigo-900 dark:from-indigo-950/30
        dark:via-gray-800 dark:to-violet-950/20
      "
    >
      <div class="px-6 py-6 sm:px-7">
        <div class="text-[10px] font-black uppercase tracking-[0.18em] text-indigo-500">
          Parent Template
        </div>

        <div class="mt-2 text-2xl font-black text-gray-900 dark:text-white">
          <%= @entity_template.name %>
        </div>

        <% if @entity_template.respond_to?(:slug) &&
          @entity_template.slug.present? %>
          <div class="mt-1 font-mono text-xs text-indigo-500 dark:text-indigo-300">
            <%= @entity_template.slug %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <%#
    ========================================================================
    VERSION SELECTOR
    ========================================================================
  %>

  <div
    class="
      mb-8 rounded-[24px] border-2 border-gray-100 bg-white p-6 shadow-sm
      dark:border-gray-700 dark:bg-gray-800
    "
  >
    <div class="mb-6">
      <div class="text-[10px] font-black uppercase tracking-[0.18em] text-violet-500">
        Comparison
      </div>

      <h2 class="mt-1 text-lg font-black text-gray-900 dark:text-white">
        Select versions
      </h2>

      <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
        Choose the two versions you want to compare.
      </p>
    </div>

    <% if defined?(@entity_template_version) &&
      @entity_template_version.present? %>
      <%= form_with(
            url: compare_admin_ecosystems_load_sources_entity_templates_entity_template_version_path(
              @entity_template_version
            ),
            method: :get,
            local: true,
            class: "grid grid-cols-1 gap-5 lg:grid-cols-2"
          ) do %>
        <div>
          <label
            for="left_id"
            class="mb-2 block text-sm font-bold text-gray-700 dark:text-gray-300"
          >
            Version A
          </label>

          <select
            id="left_id"
            name="left_id"
            class="
              block w-full rounded-xl border border-gray-300
              bg-gray-50 px-4 py-3 text-sm text-gray-900
              outline-none transition focus:border-sky-500
              focus:ring-2 focus:ring-sky-500
              dark:border-gray-700 dark:bg-gray-900 dark:text-white
            "
          >
            <% versions.each do |version| %>
              <option
                value="<%= version.id %>"
                <%= "selected" if defined?(@left_version) &&
                  @left_version.present? &&
                  version.id == @left_version.id %>
              >
                Version <%= version.version.presence || version.id %> —
                <%= version.status.to_s.humanize %> —
                <%= version.created_at.strftime("%Y-%m-%d") %>
              </option>
            <% end %>
          </select>
        </div>

        <div>
          <label
            for="right_id"
            class="mb-2 block text-sm font-bold text-gray-700 dark:text-gray-300"
          >
            Version B
          </label>

          <select
            id="right_id"
            name="right_id"
            class="
              block w-full rounded-xl border border-gray-300
              bg-gray-50 px-4 py-3 text-sm text-gray-900
              outline-none transition focus:border-violet-500
              focus:ring-2 focus:ring-violet-500
              dark:border-gray-700 dark:bg-gray-900 dark:text-white
            "
          >
            <% versions.each do |version| %>
              <option
                value="<%= version.id %>"
                <%= "selected" if defined?(@right_version) &&
                  @right_version.present? &&
                  version.id == @right_version.id %>
              >
                Version <%= version.version.presence || version.id %> —
                <%= version.status.to_s.humanize %> —
                <%= version.created_at.strftime("%Y-%m-%d") %>
              </option>
            <% end %>
          </select>
        </div>

        <div class="lg:col-span-2">
          <%= submit_tag(
                "Compare Selected Versions",
                class: "
                  inline-flex items-center justify-center gap-2 rounded-xl
                  bg-violet-600 px-5 py-3 text-sm font-bold text-white
                  shadow-sm transition hover:bg-violet-700
                  focus:outline-none focus:ring-2 focus:ring-violet-500
                  focus:ring-offset-2
                "
              ) %>
        </div>
      <% end %>
    <% else %>
      <div
        class="
          rounded-xl border border-amber-200 bg-amber-50 p-4
          text-sm font-semibold text-amber-700
          dark:border-amber-900 dark:bg-amber-950/20 dark:text-amber-300
        "
      >
        No current entity template version is available for comparison.
      </div>
    <% end %>
  </div>

  <%#
    ========================================================================
    COMPARISON DIRECTION
    ========================================================================
  %>

  <% if defined?(@left_version) &&
    @left_version.present? &&
    defined?(@right_version) &&
    @right_version.present? %>
    <div
      class="
        mb-8 rounded-[24px] border-2 border-gray-100 bg-white
        p-5 shadow-sm dark:border-gray-700 dark:bg-gray-800
      "
    >
      <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
        <div>
          <div class="text-[10px] font-black uppercase tracking-[0.18em] text-gray-400">
            Comparison Direction
          </div>

          <div
            class="
              mt-2 flex flex-wrap items-center gap-3 font-mono text-sm
              font-bold
            "
          >
            <span
              class="
                rounded-lg bg-sky-50 px-3 py-2 text-sky-700
                dark:bg-sky-950/30 dark:text-sky-300
              "
            >
              Version <%= @left_version.version.presence || @left_version.id %>
            </span>

            <span class="text-gray-400"> → </span>

            <span
              class="
                rounded-lg bg-violet-50 px-3 py-2 text-violet-700
                dark:bg-violet-950/30 dark:text-violet-300
              "
            >
              Version
              <%= @right_version.version.presence || @right_version.id %>
            </span>
          </div>
        </div>

        <div class="text-xs font-semibold text-gray-400">
          <%= total_fields %> <%= total_fields == 1 ? "field" : "fields" %>
          analyzed
        </div>
      </div>
    </div>
  <% end %>

  <%#
    ========================================================================
    VERSION SUMMARY
    ========================================================================
  %>

  <% if defined?(@left_version) &&
    @left_version.present? &&
    defined?(@right_version) &&
    @right_version.present? %>
    <div class="mb-8 grid grid-cols-1 gap-5 lg:grid-cols-2">
      <%# VERSION A %>

      <div
        class="
          rounded-[24px] border-2 border-sky-100 bg-sky-50/60 p-6 shadow-sm
          dark:border-sky-900 dark:bg-sky-950/20
        "
      >
        <div class="flex items-start justify-between gap-4">
          <div>
            <div
              class="
                text-[10px] font-black uppercase tracking-[0.18em]
                text-sky-500
              "
            >
              Version A
            </div>

            <div class="mt-2 text-2xl font-black text-gray-900 dark:text-white">
              Version <%= @left_version.version.presence || @left_version.id %>
            </div>
          </div>

          <div
            class="
              rounded-xl bg-sky-100 px-3 py-2 font-mono text-[10px]
              font-bold text-sky-700 dark:bg-sky-950/40 dark:text-sky-300
            "
          >
            A
          </div>
        </div>

        <div class="mt-5">
          <span
            class="
              inline-flex items-center rounded-full border
              border-sky-200 bg-white px-3 py-1.5 text-xs
              font-black uppercase tracking-wider text-sky-700
              dark:border-sky-800 dark:bg-sky-950/30 dark:text-sky-300
            "
          >
            <%= @left_version.status.to_s.humanize.presence || "Unknown" %>
          </span>
        </div>

        <div class="mt-4 text-xs text-gray-500 dark:text-gray-400">
          Created:
          <span class="font-semibold text-gray-700 dark:text-gray-200"><%= @left_version.created_at.strftime("%Y-%m-%d %H:%M") %></span>
        </div>
      </div>

      <%# VERSION B %>

      <div
        class="
          rounded-[24px] border-2 border-violet-100 bg-violet-50/60 p-6 shadow-sm
          dark:border-violet-900 dark:bg-violet-950/20
        "
      >
        <div class="flex items-start justify-between gap-4">
          <div>
            <div
              class="
                text-[10px] font-black uppercase tracking-[0.18em]
                text-violet-500
              "
            >
              Version B
            </div>

            <div class="mt-2 text-2xl font-black text-gray-900 dark:text-white">
              Version
              <%= @right_version.version.presence || @right_version.id %>
            </div>
          </div>

          <div
            class="
              rounded-xl bg-violet-100 px-3 py-2 font-mono text-[10px]
              font-bold text-violet-700
              dark:bg-violet-950/40 dark:text-violet-300
            "
          >
            B
          </div>
        </div>

        <div class="mt-5">
          <span
            class="
              inline-flex items-center rounded-full border
              border-violet-200 bg-white px-3 py-1.5 text-xs
              font-black uppercase tracking-wider text-violet-700
              dark:border-violet-800 dark:bg-violet-950/30
              dark:text-violet-300
            "
          >
            <%= @right_version.status.to_s.humanize.presence || "Unknown" %>
          </span>
        </div>

        <div class="mt-4 text-xs text-gray-500 dark:text-gray-400">
          Created:
          <span class="font-semibold text-gray-700 dark:text-gray-200"><%= @right_version.created_at.strftime("%Y-%m-%d %H:%M") %></span>
        </div>
      </div>
    </div>
  <% end %>

  <%#
    ========================================================================
    CHANGE SUMMARY
    ========================================================================
  %>

  <div class="mb-8">
    <div class="mb-4">
      <div class="text-[10px] font-black uppercase tracking-[0.18em] text-violet-500">
        Change Overview
      </div>

      <h2 class="mt-1 text-xl font-black text-gray-900 dark:text-white">
        Schema impact
      </h2>
    </div>

    <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
      <div
        class="
          rounded-2xl border border-emerald-100 bg-emerald-50 p-5
          dark:border-emerald-900 dark:bg-emerald-950/20
        "
      >
        <div class="text-[10px] font-black uppercase tracking-wider text-emerald-500">
          Added
        </div>

        <div class="mt-2 text-3xl font-black text-emerald-600">
          <%= added_count %>
        </div>

        <div class="mt-1 text-[11px] text-emerald-700/70 dark:text-emerald-300/70">
          New fields
        </div>
      </div>

      <div
        class="
          rounded-2xl border border-red-100 bg-red-50 p-5
          dark:border-red-900 dark:bg-red-950/20
        "
      >
        <div class="text-[10px] font-black uppercase tracking-wider text-red-500">
          Removed
        </div>

        <div class="mt-2 text-3xl font-black text-red-600">
          <%= removed_count %>
        </div>

        <div class="mt-1 text-[11px] text-red-700/70 dark:text-red-300/70">
          Deleted fields
        </div>
      </div>

      <div
        class="
          rounded-2xl border border-amber-100 bg-amber-50 p-5
          dark:border-amber-900 dark:bg-amber-950/20
        "
      >
        <div class="text-[10px] font-black uppercase tracking-wider text-amber-500">
          Changed
        </div>

        <div class="mt-2 text-3xl font-black text-amber-600">
          <%= changed_count %>
        </div>

        <div class="mt-1 text-[11px] text-amber-700/70 dark:text-amber-300/70">
          Modified fields
        </div>
      </div>

      <div
        class="
          rounded-2xl border border-gray-100 bg-gray-50 p-5
          dark:border-gray-700 dark:bg-gray-900
        "
      >
        <div class="text-[10px] font-black uppercase tracking-wider text-gray-400">
          Unchanged
        </div>

        <div class="mt-2 text-3xl font-black text-gray-600 dark:text-gray-300">
          <%= unchanged_count %>
        </div>

        <div class="mt-1 text-[11px] text-gray-500 dark:text-gray-400">
          Identical fields
        </div>
      </div>
    </div>
  </div>

  <%#
    ========================================================================
    FIELD COMPARISON
    ========================================================================
  %>

  <div
    data-controller="entity-template-version-compare"
    data-entity-template-version-compare-fields-value="<%= ERB::Util.html_escape((@field_comparisons_json || field_changes).to_json) %>"
    class="
      overflow-hidden rounded-[24px] border-2 border-gray-100
      bg-white shadow-sm
      dark:border-gray-700 dark:bg-gray-800
    "
  >
    <%# HEADER %>

    <div
      class="
        border-b border-gray-100 bg-gray-50/80 px-6 py-6
        dark:border-gray-700 dark:bg-gray-900/50
      "
    >
      <div class="flex flex-col gap-5 lg:flex-row lg:items-center lg:justify-between">
        <div>
          <div
            class="
              text-[10px] font-black uppercase tracking-[0.18em]
              text-violet-500
            "
          >
            Field Comparison
          </div>

          <h2 class="mt-1 text-xl font-black text-gray-900 dark:text-white">
            Schema Changes
          </h2>

          <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
            Review exactly what was added, removed, or modified.
          </p>
        </div>

        <div
          class="
            rounded-xl border border-gray-200 bg-white px-4 py-2.5
            text-sm font-semibold text-gray-500 shadow-sm
            dark:border-gray-700 dark:bg-gray-900 dark:text-gray-300
          "
          data-entity-template-version-compare-target="count"
        >
          <%= field_changes.size %>
          <%= field_changes.size == 1 ? "field" : "fields" %>
        </div>
      </div>

      <%# SEARCH %>

      <div class="mt-6">
        <div class="relative">
          <input
            type="search"
            placeholder="Search fields, labels, types, descriptions..."
            autocomplete="off"
            data-entity-template-version-compare-target="search"
            data-action="input->entity-template-version-compare#searchChanged"
            class="
              block w-full rounded-xl border border-gray-200 bg-white
              px-4 py-3 pl-11 text-sm text-gray-900 shadow-sm outline-none
              transition placeholder:text-gray-400
              focus:border-violet-500 focus:ring-2 focus:ring-violet-500
              dark:border-gray-700 dark:bg-gray-950 dark:text-white
            "
          >

          <div
            class="
              pointer-events-none absolute inset-y-0 left-0 flex
              items-center pl-4 text-gray-400
            "
          >
            🔎
          </div>
        </div>
      </div>

      <%# FILTERS %>

      <div class="mt-4 flex flex-wrap items-center gap-2">
        <button
          type="button"
          data-filter="all"
          data-entity-template-version-compare-target="filter"
          data-action="click->entity-template-version-compare#filterChanged"
          aria-pressed="true"
          class="
            rounded-lg bg-gray-900 px-3 py-2 text-xs font-bold text-white
            transition hover:bg-gray-800
            dark:bg-white dark:text-gray-900
          "
        >
          All <%= field_changes.size %>
        </button>

        <button
          type="button"
          data-filter="added"
          data-entity-template-version-compare-target="filter"
          data-action="click->entity-template-version-compare#filterChanged"
          aria-pressed="false"
          class="
            rounded-lg border border-emerald-200 bg-emerald-50
            px-3 py-2 text-xs font-bold text-emerald-700 transition
            hover:bg-emerald-100
            dark:border-emerald-800 dark:bg-emerald-950/30
            dark:text-emerald-300
          "
        >
          + Added <%= added_count %>
        </button>

        <button
          type="button"
          data-filter="removed"
          data-entity-template-version-compare-target="filter"
          data-action="click->entity-template-version-compare#filterChanged"
          aria-pressed="false"
          class="
            rounded-lg border border-red-200 bg-red-50 px-3 py-2
            text-xs font-bold text-red-700 transition hover:bg-red-100
            dark:border-red-800 dark:bg-red-950/30 dark:text-red-300
          "
        >
          − Removed <%= removed_count %>
        </button>

        <button
          type="button"
          data-filter="changed"
          data-entity-template-version-compare-target="filter"
          data-action="click->entity-template-version-compare#filterChanged"
          aria-pressed="false"
          class="
            rounded-lg border border-amber-200 bg-amber-50 px-3 py-2
            text-xs font-bold text-amber-700 transition hover:bg-amber-100
            dark:border-amber-800 dark:bg-amber-950/30 dark:text-amber-300
          "
        >
          ~ Changed <%= changed_count %>
        </button>

        <button
          type="button"
          data-filter="unchanged"
          data-entity-template-version-compare-target="filter"
          data-action="click->entity-template-version-compare#filterChanged"
          aria-pressed="false"
          class="
            rounded-lg border border-gray-200 bg-white px-3 py-2
            text-xs font-bold text-gray-700 shadow-sm transition
            hover:bg-gray-50
            dark:border-gray-700 dark:bg-gray-900 dark:text-gray-200
          "
        >
          = Unchanged <%= unchanged_count %>
        </button>

        <div class="ml-auto flex gap-2">
          <button
            type="button"
            data-action="click->entity-template-version-compare#expandAll"
            class="
              rounded-lg border border-gray-200 bg-white px-3 py-2
              text-xs font-bold text-gray-700 transition hover:bg-gray-50
              dark:border-gray-700 dark:bg-gray-900 dark:text-gray-200
            "
          >
            Expand all
          </button>

          <button
            type="button"
            data-action="click->entity-template-version-compare#collapseAll"
            class="
              rounded-lg border border-gray-200 bg-white px-3 py-2
              text-xs font-bold text-gray-700 transition hover:bg-gray-50
              dark:border-gray-700 dark:bg-gray-900 dark:text-gray-200
            "
          >
            Collapse all
          </button>
        </div>
      </div>
    </div>

    <%#
      ======================================================================
      FIELD LIST
      ======================================================================
    %>

    <div class="divide-y divide-gray-100 dark:divide-gray-700">
      <% if field_changes.blank? %>
        <div class="p-10 text-center">
          <div
            class="
              mx-auto flex h-14 w-14 items-center justify-center
              rounded-2xl bg-emerald-50 text-2xl
              dark:bg-emerald-950/30
            "
          >
            ✓
          </div>

          <h3 class="mt-4 text-lg font-black text-gray-900 dark:text-white">
            No field changes
          </h3>

          <p class="mx-auto mt-1 max-w-md text-sm text-gray-500 dark:text-gray-400">
            The compared versions contain no fields that differ.
          </p>
        </div>
      <% else %>
        <% field_changes.each_with_index do |raw_field, index| %>
          <% field =
              raw_field.is_a?(Hash) ?
                raw_field :
                {}


            field_id =
              "compare-field-#{index}"


            field_type =
              field_type_for.call(field)

            field_type =
              "unchanged" if field_type.blank?


            field_name =
              field_name_for.call(field)


            field_label =
              field_label_for.call(field)


            left_field =
              field_left_for.call(field)


            right_field =
              field_right_for.call(field)


            property_changes =
              field_changes_for.call(field)


            field_search_text =
              [
                field_name,
                field_label,
                field_type,
                pretty_json.call(left_field),
                pretty_json.call(right_field),
                property_changes.map { |change| change[:key] }
              ].flatten.compact.join(" ").downcase %>

          <div
            id="<%= field_id %>"
            data-entity-template-version-compare-target="field"
            data-change-type="<%= field_type %>"
            data-field-name="<%= ERB::Util.html_escape(field_search_text) %>"
            class="transition"
          >
            <%#
              =================================================================
              FIELD HEADER
              =================================================================
            %>

            <div class="p-5 sm:p-6">
              <div class="flex flex-col gap-4 lg:flex-row lg:items-center">
                <%# STATUS %>

                <div class="shrink-0">
                  <% case field_type %>
                  <% when "added", "add" %>
                    <span
                      class="
                        inline-flex rounded-full border border-emerald-200
                        bg-emerald-50 px-3 py-1.5 text-[10px]
                        font-black uppercase tracking-wider text-emerald-700
                        dark:border-emerald-800 dark:bg-emerald-950/30
                        dark:text-emerald-300
                      "
                    >
                      + Added
                    </span>
                  <% when "removed", "remove", "deleted" %>
                    <span
                      class="
                        inline-flex rounded-full border border-red-200
                        bg-red-50 px-3 py-1.5 text-[10px]
                        font-black uppercase tracking-wider text-red-700
                        dark:border-red-800 dark:bg-red-950/30
                        dark:text-red-300
                      "
                    >
                      − Removed
                    </span>
                  <% when "changed", "modified" %>
                    <span
                      class="
                        inline-flex rounded-full border border-amber-200
                        bg-amber-50 px-3 py-1.5 text-[10px]
                        font-black uppercase tracking-wider text-amber-700
                        dark:border-amber-800 dark:bg-amber-950/30
                        dark:text-amber-300
                      "
                    >
                      ~ Changed
                    </span>
                  <% else %>
                    <span
                      class="
                        inline-flex rounded-full border border-gray-200
                        bg-gray-50 px-3 py-1.5 text-[10px]
                        font-black uppercase tracking-wider text-gray-500
                        dark:border-gray-700 dark:bg-gray-900
                        dark:text-gray-400
                      "
                    >
                      = Unchanged
                    </span>
                  <% end %>
                </div>

                <%# FIELD NAME %>

                <div class="min-w-0 flex-1">
                  <div
                    class="
                      truncate font-mono text-base font-black text-gray-900
                      dark:text-white
                    "
                  >
                    <%= field_name.presence || "(unnamed field)" %>
                  </div>

                  <% if field_label.present? %>
                    <div class="mt-1 truncate text-xs text-gray-400">
                      <%= field_label %>
                    </div>
                  <% end %>
                </div>

                <%# TYPE BADGES %>

                <div class="flex flex-wrap items-center gap-2">
                  <% if left_field.is_a?(Hash) %>
                    <% left_type =
                         value_for.call(left_field, :type) %>

                    <% if left_type.present? %>
                      <span
                        class="
                          rounded-lg bg-sky-50 px-2.5 py-1 font-mono
                          text-[10px] font-bold text-sky-700
                          dark:bg-sky-950/30 dark:text-sky-300
                        "
                      >
                        A: <%= left_type %>
                      </span>
                    <% end %>
                  <% end %>

                  <% if right_field.is_a?(Hash) %>
                    <% right_type =
                         value_for.call(right_field, :type) %>

                    <% if right_type.present? %>
                      <span
                        class="
                          rounded-lg bg-violet-50 px-2.5 py-1 font-mono
                          text-[10px] font-bold text-violet-700
                          dark:bg-violet-950/30 dark:text-violet-300
                        "
                      >
                        B: <%= right_type %>
                      </span>
                    <% end %>
                  <% end %>
                </div>

                <%# CHANGE COUNT %>

                <% if property_changes.any? %>
                  <div
                    class="
                      shrink-0 rounded-lg bg-amber-50 px-2.5 py-1
                      text-[10px] font-bold text-amber-700
                      dark:bg-amber-950/30 dark:text-amber-300
                    "
                  >
                    <%= property_changes.size %>
                    <%= property_changes.size == 1 ? "property changed" : "properties changed" %>
                  </div>
                <% end %>

                <%# DETAILS BUTTON %>

                <button
                  type="button"
                  data-target="<%= "#{field_id}-details" %>"
                  data-action="click->entity-template-version-compare#toggle"
                  aria-expanded="false"
                  class="
                    inline-flex shrink-0 items-center justify-center
                    rounded-lg border border-gray-200 bg-white
                    px-3 py-2 text-xs font-bold text-gray-600 shadow-sm
                    transition hover:bg-gray-50
                    dark:border-gray-700 dark:bg-gray-900
                    dark:text-gray-300
                  "
                >
                  Details
                  <span data-chevron class="ml-2 transition-transform"> ↓ </span>
                </button>
              </div>

              <%#
                =================================================================
                QUICK CHANGE SUMMARY
                =================================================================
              %>

              <% if property_changes.any? %>
                <div class="mt-5 space-y-2">
                  <% property_changes.each do |change| %>
                    <div
                      class="
                        flex flex-col gap-2 rounded-xl border
                        border-amber-100 bg-amber-50/50 p-3
                        sm:flex-row sm:items-center
                        dark:border-amber-900 dark:bg-amber-950/10
                      "
                    >
                      <div
                        class="
                          shrink-0 font-mono text-xs font-black
                          text-amber-700 dark:text-amber-300
                        "
                      >
                        <%= human_property_name.call(change[:key]) %>
                      </div>

                      <div class="hidden text-gray-400 sm:block">
                        :
                      </div>

                      <div
                        class="
                          min-w-0 flex-1 truncate font-mono text-xs
                          text-red-600 dark:text-red-300
                        "
                      >
                        <span class="mr-1 font-sans text-[10px] uppercase text-gray-400">
                          A
                        </span>

                        <%= display_value.call(change[:from]) %>
                      </div>

                      <div class="hidden text-gray-400 sm:block">
                        →
                      </div>

                      <div
                        class="
                          min-w-0 flex-1 truncate font-mono text-xs
                          text-emerald-600 dark:text-emerald-300
                        "
                      >
                        <span class="mr-1 font-sans text-[10px] uppercase text-gray-400">
                          B
                        </span>

                        <%= display_value.call(change[:to]) %>
                      </div>
                    </div>
                  <% end %>
                </div>
              <% elsif ["added", "removed"].include?(field_type) %>
                <div
                  class="
                    mt-5 rounded-xl border p-4 text-xs font-semibold
                    <%= field_type == "added" ?
                    "border-emerald-100 bg-emerald-50/60 text-emerald-700 dark:border-emerald-900 dark:bg-emerald-950/10 dark:text-emerald-300" :
                    "border-red-100 bg-red-50/60 text-red-700 dark:border-red-900 dark:bg-red-950/10 dark:text-red-300" %>
                  "
                >
                  <% if field_type == "added" %>
                    This field did not exist in Version A and was introduced in
                    Version B.
                  <% else %>
                    This field existed in Version A but was removed from Version
                    B.
                  <% end %>
                </div>
              <% end %>

              <%#
                =================================================================
                DETAILS
                =================================================================
              %>

              <div
                id="<%= "#{field_id}-details" %>"
                data-compare-details
                class="mt-6 hidden"
              >
                <%#
                  ===============================================================
                  CHANGED FIELD
                  ===============================================================
                %>

                <% if ["changed", "modified"].include?(field_type) %>
                  <div class="space-y-5">
                    <% if property_changes.any? %>
                      <div>
                        <div class="mb-3">
                          <div
                            class="
                              text-[10px] font-black uppercase
                              tracking-[0.18em] text-amber-500
                            "
                          >
                            What changed
                          </div>

                          <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
                            The following properties have different values
                            between the two versions.
                          </p>
                        </div>

                        <div class="space-y-4">
                          <% property_changes.each do |change| %>
                            <div
                              class="
                                overflow-hidden rounded-2xl border
                                border-gray-200 bg-white shadow-sm
                                dark:border-gray-700 dark:bg-gray-900
                              "
                            >
                              <%# PROPERTY HEADER %>

                              <div
                                class="
                                  flex flex-col gap-2 border-b
                                  border-gray-200 bg-gray-50 px-4 py-3
                                  sm:flex-row sm:items-center
                                  sm:justify-between
                                  dark:border-gray-700 dark:bg-gray-950
                                "
                              >
                                <div class="font-mono text-sm font-black text-gray-900 dark:text-white">
                                  <%= human_property_name.call(change[:key]) %>
                                </div>

                                <div
                                  class="
                                    rounded-lg bg-amber-100 px-2.5 py-1
                                    font-mono text-[10px] font-bold
                                    text-amber-700
                                    dark:bg-amber-950/40 dark:text-amber-300
                                  "
                                >
                                  <%= change[:key] %>
                                </div>
                              </div>

                              <%# BEFORE / AFTER %>

                              <div class="grid grid-cols-1 md:grid-cols-2">
                                <%# BEFORE %>

                                <div
                                  class="
                                    border-b border-gray-200 p-5
                                    md:border-b-0 md:border-r
                                    dark:border-gray-700
                                  "
                                >
                                  <div
                                    class="
                                      mb-3 flex items-center gap-2
                                      text-[10px] font-black uppercase
                                      tracking-wider text-red-500
                                    "
                                  >
                                    <span class="h-2 w-2 rounded-full bg-red-400"></span>
                                    Version A — Before
                                  </div>

                                  <div
                                    class="
                                      rounded-xl border border-red-100
                                      bg-red-50/60 p-4
                                      dark:border-red-900
                                      dark:bg-red-950/20
                                    "
                                  >
                                    <% if change[:from].is_a?(Hash) ||
                                      change[:from].is_a?(Array) %>
                                      <pre
                                        class="
                                          max-h-80 overflow-auto
                                          whitespace-pre-wrap break-words
                                          font-mono text-xs leading-5
                                          text-red-700
                                          dark:text-red-300
                                        "
                                      ><%= display_value.call(change[:from]) %></pre>
                                    <% else %>
                                      <div
                                        class="
                                          break-words font-mono text-sm
                                          font-semibold text-red-700
                                          dark:text-red-300
                                        "
                                      >
                                        <%= display_value.call(change[:from]) %>
                                      </div>
                                    <% end %>
                                  </div>
                                </div>

                                <%# AFTER %>

                                <div class="p-5">
                                  <div
                                    class="
                                      mb-3 flex items-center gap-2
                                      text-[10px] font-black uppercase
                                      tracking-wider text-emerald-500
                                    "
                                  >
                                    <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
                                    Version B — After
                                  </div>

                                  <div
                                    class="
                                      rounded-xl border border-emerald-100
                                      bg-emerald-50/60 p-4
                                      dark:border-emerald-900
                                      dark:bg-emerald-950/20
                                    "
                                  >
                                    <% if change[:to].is_a?(Hash) ||
                                      change[:to].is_a?(Array) %>
                                      <pre
                                        class="
                                          max-h-80 overflow-auto
                                          whitespace-pre-wrap break-words
                                          font-mono text-xs leading-5
                                          text-emerald-700
                                          dark:text-emerald-300
                                        "
                                      ><%= display_value.call(change[:to]) %></pre>
                                    <% else %>
                                      <div
                                        class="
                                          break-words font-mono text-sm
                                          font-semibold text-emerald-700
                                          dark:text-emerald-300
                                        "
                                      >
                                        <%= display_value.call(change[:to]) %>
                                      </div>
                                    <% end %>
                                  </div>
                                </div>
                              </div>

                              <%# EXPLANATION %>

                              <div
                                class="
                                  border-t border-gray-200 bg-blue-50/40
                                  px-5 py-4
                                  dark:border-gray-700
                                  dark:bg-blue-950/10
                                "
                              >
                                <div
                                  class="
                                    text-[10px] font-black uppercase
                                    tracking-wider text-blue-500
                                  "
                                >
                                  Change explanation
                                </div>

                                <p class="mt-1 text-xs leading-5 text-gray-600 dark:text-gray-300">
                                  The
                                  <span class="font-bold"><%= human_property_name.call(change[:key]) %></span>
                                  property changed from
                                  <span class="font-mono font-bold text-red-600 dark:text-red-300"><%= display_value.call(change[:from]) %></span>
                                  to
                                  <span class="font-mono font-bold text-emerald-600 dark:text-emerald-300"><%= display_value.call(change[:to]) %></span>.
                                </p>
                              </div>
                            </div>
                          <% end %>
                        </div>
                      </div>
                    <% else %>
                      <div
                        class="
                          rounded-xl border border-gray-200 bg-gray-50
                          p-5 text-sm text-gray-500
                          dark:border-gray-700 dark:bg-gray-900
                          dark:text-gray-400
                        "
                      >
                        The field is marked as changed, but no property-level
                        differences were returned by the comparator.
                      </div>
                    <% end %>

                    <%# COMPLETE FIELD A/B %>

                    <div>
                      <div class="mb-3">
                        <div
                          class="
                            text-[10px] font-black uppercase
                            tracking-[0.18em] text-violet-500
                          "
                        >
                          Complete field definitions
                        </div>

                        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
                          Full field payload before and after the change.
                        </p>
                      </div>

                      <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                        <div>
                          <div
                            class="
                              mb-2 text-[9px] font-black uppercase
                              tracking-wider text-sky-500
                            "
                          >
                            Version A
                          </div>

                          <pre
                            class="
                              max-h-96 overflow-auto rounded-xl bg-gray-950
                              p-4 font-mono text-xs leading-5 text-sky-300
                            "
                          ><%= pretty_json.call(left_field) %></pre>
                        </div>

                        <div>
                          <div
                            class="
                              mb-2 text-[9px] font-black uppercase
                              tracking-wider text-violet-500
                            "
                          >
                            Version B
                          </div>

                          <pre
                            class="
                              max-h-96 overflow-auto rounded-xl bg-gray-950
                              p-4 font-mono text-xs leading-5 text-violet-300
                            "
                          ><%= pretty_json.call(right_field) %></pre>
                        </div>
                      </div>
                    </div>
                  </div>

                  <%#
                    ===============================================================
                    ADDED FIELD
                    ===============================================================
                  %>
                <% elsif ["added", "add"].include?(field_type) %>
                  <div class="space-y-5">
                    <div
                      class="
                        rounded-2xl border border-emerald-200
                        bg-emerald-50/60 p-5
                        dark:border-emerald-900
                        dark:bg-emerald-950/20
                      "
                    >
                      <div
                        class="
                          text-[10px] font-black uppercase tracking-[0.18em]
                          text-emerald-500
                        "
                      >
                        What happened?
                      </div>

                      <h3
                        class="
                          mt-2 text-lg font-black text-emerald-800
                          dark:text-emerald-200
                        "
                      >
                        Field added
                      </h3>

                      <p
                        class="
                          mt-2 text-sm leading-6 text-emerald-700
                          dark:text-emerald-300
                        "
                      >
                        The field <strong><%= field_name %></strong> did not
                        exist in Version A and was introduced in Version B.
                      </p>
                    </div>

                    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                      <div>
                        <div
                          class="
                            mb-2 text-[9px] font-black uppercase
                            tracking-wider text-sky-500
                          "
                        >
                          Version A
                        </div>

                        <div
                          class="
                            rounded-xl border border-dashed border-red-200
                            bg-red-50/50 p-5 text-sm font-semibold
                            text-red-500
                            dark:border-red-900
                            dark:bg-red-950/20
                            dark:text-red-300
                          "
                        >
                          Field not present.
                        </div>
                      </div>

                      <div>
                        <div
                          class="
                            mb-2 text-[9px] font-black uppercase
                            tracking-wider text-emerald-500
                          "
                        >
                          Version B — New field
                        </div>

                        <pre
                          class="
                            max-h-96 overflow-auto rounded-xl
                            bg-gray-950 p-4 font-mono text-xs
                            leading-5 text-emerald-300
                          "
                        ><%= pretty_json.call(right_field) %></pre>
                      </div>
                    </div>

                    <% if right_field.is_a?(Hash) %>
                      <div
                        class="
                          rounded-2xl border border-gray-200 bg-white
                          p-5 dark:border-gray-700 dark:bg-gray-900
                        "
                      >
                        <div
                          class="
                            text-[10px] font-black uppercase
                            tracking-[0.18em] text-gray-400
                          "
                        >
                          New field configuration
                        </div>

                        <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
                          <% [
                               ["Type", value_for.call(right_field, :type)],
                               ["Label", value_for.call(right_field, :label)],
                               ["Required", value_for.call(right_field, :required)],
                               ["Description", value_for.call(right_field, :description)]
                             ].each do |property_name, property_value| %>
                            <div class="rounded-xl bg-gray-50 p-4 dark:bg-gray-950">
                              <div class="text-[9px] font-black uppercase tracking-wider text-gray-400">
                                <%= property_name %>
                              </div>

                              <div
                                class="
                                  mt-2 break-words text-sm font-semibold
                                  text-gray-800 dark:text-gray-200
                                "
                              >
                                <%= display_value.call(property_value) %>
                              </div>
                            </div>
                          <% end %>
                        </div>
                      </div>
                    <% end %>
                  </div>

                  <%#
                    ===============================================================
                    REMOVED FIELD
                    ===============================================================
                  %>
                <% elsif ["removed", "remove", "deleted"].include?(field_type) %>
                  <div class="space-y-5">
                    <div
                      class="
                        rounded-2xl border border-red-200
                        bg-red-50/60 p-5
                        dark:border-red-900
                        dark:bg-red-950/20
                      "
                    >
                      <div
                        class="
                          text-[10px] font-black uppercase tracking-[0.18em]
                          text-red-500
                        "
                      >
                        What happened?
                      </div>

                      <h3 class="mt-2 text-lg font-black text-red-800 dark:text-red-200">
                        Field removed
                      </h3>

                      <p class="mt-2 text-sm leading-6 text-red-700 dark:text-red-300">
                        The field <strong><%= field_name %></strong> existed in
                        Version A but is no longer present in Version B.
                      </p>
                    </div>

                    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                      <div>
                        <div
                          class="
                            mb-2 text-[9px] font-black uppercase
                            tracking-wider text-red-500
                          "
                        >
                          Version A — Removed field
                        </div>

                        <pre
                          class="
                            max-h-96 overflow-auto rounded-xl
                            bg-gray-950 p-4 font-mono text-xs
                            leading-5 text-red-300
                          "
                        ><%= pretty_json.call(left_field) %></pre>
                      </div>

                      <div>
                        <div
                          class="
                            mb-2 text-[9px] font-black uppercase
                            tracking-wider text-violet-500
                          "
                        >
                          Version B
                        </div>

                        <div
                          class="
                            rounded-xl border border-dashed
                            border-red-200 bg-red-50/50 p-5
                            text-sm font-semibold text-red-500
                            dark:border-red-900
                            dark:bg-red-950/20
                            dark:text-red-300
                          "
                        >
                          Field not present.
                        </div>
                      </div>
                    </div>
                  </div>

                  <%#
                    ===============================================================
                    UNCHANGED FIELD
                    ===============================================================
                  %>
                <% else %>
                  <div class="space-y-5">
                    <div
                      class="
                        rounded-2xl border border-gray-200
                        bg-gray-50 p-5
                        dark:border-gray-700 dark:bg-gray-900
                      "
                    >
                      <div
                        class="
                          text-[10px] font-black uppercase tracking-[0.18em]
                          text-gray-400
                        "
                      >
                        No changes
                      </div>

                      <p class="mt-2 text-sm leading-6 text-gray-600 dark:text-gray-300">
                        This field is identical in both versions.
                      </p>
                    </div>

                    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                      <div>
                        <div
                          class="
                            mb-2 text-[9px] font-black uppercase
                            tracking-wider text-sky-500
                          "
                        >
                          Version A
                        </div>

                        <pre
                          class="
                            max-h-96 overflow-auto rounded-xl
                            bg-gray-950 p-4 font-mono text-xs
                            leading-5 text-sky-300
                          "
                        ><%= pretty_json.call(left_field) %></pre>
                      </div>

                      <div>
                        <div
                          class="
                            mb-2 text-[9px] font-black uppercase
                            tracking-wider text-violet-500
                          "
                        >
                          Version B
                        </div>

                        <pre
                          class="
                            max-h-96 overflow-auto rounded-xl
                            bg-gray-950 p-4 font-mono text-xs
                            leading-5 text-violet-300
                          "
                        ><%= pretty_json.call(right_field) %></pre>
                      </div>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>

  <%#
    ========================================================================
    RAW DEFINITIONS
    ========================================================================
  %>

  <div class="mt-8">
    <div class="mb-4">
      <div class="text-[10px] font-black uppercase tracking-[0.18em] text-gray-400">
        Raw Definitions
      </div>

      <h2 class="mt-1 text-xl font-black text-gray-900 dark:text-white">
        Full JSON
      </h2>

      <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
        Complete definitions for advanced inspection and debugging.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
      <%# VERSION A %>

      <div
        class="
          overflow-hidden rounded-[24px] border-2 border-sky-100
          bg-white shadow-sm
          dark:border-sky-900 dark:bg-gray-800
        "
      >
        <div
          class="
            border-b border-sky-100 bg-sky-50/60 px-6 py-5
            dark:border-sky-900 dark:bg-sky-950/20
          "
        >
          <div class="text-[10px] font-black uppercase tracking-[0.18em] text-sky-500">
            Version A
          </div>

          <h2 class="mt-1 text-lg font-black text-gray-900 dark:text-white">
            Full Definition
          </h2>
        </div>

        <div class="p-5">
          <pre
            class="
              max-h-[600px] overflow-auto rounded-2xl bg-gray-950
              p-5 font-mono text-xs leading-6 text-sky-300
            "
          ><%= pretty_json.call(left_definition) %></pre>
        </div>
      </div>

      <%# VERSION B %>

      <div
        class="
          overflow-hidden rounded-[24px] border-2 border-violet-100
          bg-white shadow-sm
          dark:border-violet-900 dark:bg-gray-800
        "
      >
        <div
          class="
            border-b border-violet-100 bg-violet-50/60 px-6 py-5
            dark:border-violet-900 dark:bg-violet-950/20
          "
        >
          <div
            class="
              text-[10px] font-black uppercase tracking-[0.18em]
              text-violet-500
            "
          >
            Version B
          </div>

          <h2 class="mt-1 text-lg font-black text-gray-900 dark:text-white">
            Full Definition
          </h2>
        </div>

        <div class="p-5">
          <pre
            class="
              max-h-[600px] overflow-auto rounded-2xl bg-gray-950
              p-5 font-mono text-xs leading-6 text-violet-300
            "
          ><%= pretty_json.call(right_definition) %></pre>
        </div>
      </div>
    </div>
  </div>

  <%#
    ========================================================================
    DEFINITION LEVEL CHANGES
    ========================================================================
  %>

  <% if definition_changes.any? %>
    <div class="mt-8">
      <div class="mb-4">
        <div class="text-[10px] font-black uppercase tracking-[0.18em] text-gray-400">
          Definition Changes
        </div>

        <h2 class="mt-1 text-xl font-black text-gray-900 dark:text-white">
          Top-level JSON changes
        </h2>
      </div>

      <div
        class="
          overflow-hidden rounded-[24px] border-2 border-gray-100
          bg-white shadow-sm
          dark:border-gray-700 dark:bg-gray-800
        "
      >
        <div class="divide-y divide-gray-100 dark:divide-gray-700">
          <% definition_changes.each do |raw_change| %>
            <% change =
                raw_change.is_a?(Hash) ?
                  raw_change :
                  {}


              change_key =
                value_for.call(change, :key).to_s


              change_type =
                value_for.call(change, :type).to_s


              change_left =
                value_for.call(change, :left)


              change_right =
                value_for.call(change, :right) %>

            <div class="p-5 sm:p-6">
              <div
                class="
                  flex flex-col gap-4 lg:flex-row lg:items-center
                  lg:justify-between
                "
              >
                <div>
                  <div class="font-mono text-sm font-black text-gray-900 dark:text-white">
                    <%= change_key.presence || "(unknown key)" %>
                  </div>

                  <div class="mt-1 text-xs font-semibold text-gray-400">
                    <%= change_type.presence || "changed" %>
                  </div>
                </div>

                <span
                  class="
                    inline-flex rounded-full bg-amber-50 px-3 py-1.5
                    text-[10px] font-black uppercase text-amber-700
                  "
                >
                  <%= change_type.presence || "Changed" %>
                </span>
              </div>

              <div class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2">
                <div>
                  <div
                    class="
                      mb-2 text-[9px] font-black uppercase tracking-wider
                      text-sky-500
                    "
                  >
                    Version A
                  </div>

                  <pre
                    class="
                      max-h-72 overflow-auto rounded-xl bg-gray-950
                      p-4 font-mono text-xs leading-5 text-sky-300
                    "
                  ><%= pretty_json.call(change_left) %></pre>
                </div>

                <div>
                  <div
                    class="
                      mb-2 text-[9px] font-black uppercase tracking-wider
                      text-violet-500
                    "
                  >
                    Version B
                  </div>

                  <pre
                    class="
                      max-h-72 overflow-auto rounded-xl bg-gray-950
                      p-4 font-mono text-xs leading-5 text-violet-300
                    "
                  ><%= pretty_json.call(change_right) %></pre>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <%#
    ========================================================================
    DEBUG
    ========================================================================
  %>

  <details
    class="
      mt-8 overflow-hidden rounded-[24px] border border-gray-200
      bg-gray-50 dark:border-gray-700 dark:bg-gray-900
    "
  >
    <summary
      class="
        cursor-pointer px-6 py-4 text-xs font-black uppercase
        tracking-wider text-gray-500 hover:text-violet-500
      "
    >
      Debug comparison payload
    </summary>

    <div class="border-t border-gray-200 p-5 dark:border-gray-700">
      <div class="grid grid-cols-1 gap-5 lg:grid-cols-2">
        <div>
          <div
            class="
              mb-2 text-[10px] font-black uppercase tracking-wider
              text-gray-400
            "
          >
            Field Comparisons
          </div>

          <pre
            class="
              max-h-96 overflow-auto rounded-xl bg-gray-950
              p-4 font-mono text-xs leading-5 text-emerald-300
            "
          ><%= pretty_json.call(field_changes) %></pre>
        </div>

        <div>
          <div
            class="
              mb-2 text-[10px] font-black uppercase tracking-wider
              text-gray-400
            "
          >
            Comparison Summary
          </div>

          <pre
            class="
              max-h-96 overflow-auto rounded-xl bg-gray-950
              p-4 font-mono text-xs leading-5 text-violet-300
            "
          ><%= pretty_json.call(comparison_summary) %></pre>
        </div>
      </div>
    </div>
  </details>

  <%#
    ========================================================================
    FOOTER
    ========================================================================
  %>

  <div
    class="
      mt-8 flex flex-col gap-3 border-t-2 border-gray-100 pt-5
      sm:flex-row sm:items-center sm:justify-between
      dark:border-gray-800
    "
  >
    <div class="font-mono text-[10px] font-bold uppercase tracking-wider text-gray-400">
      ENTITY_TEMPLATE_VERSION :: COMPARE ::
      <% if defined?(@left_version) &&
        @left_version.present? %>
        <%= @left_version.id %>
      <% else %>
        —
      <% end %>
      ↔
      <% if defined?(@right_version) &&
        @right_version.present? %>
        <%= @right_version.id %>
      <% else %>
        —
      <% end %>
    </div>

    <div
      class="
        flex items-center gap-2 text-[10px] font-black uppercase
        tracking-wider text-emerald-500
      "
    >
      <span
        class="
          h-2 w-2 rounded-full bg-emerald-400
          shadow-[0_0_8px_rgba(52,211,153,0.6)]
        "
      ></span>
      Version comparison online
    </div>
  </div>
</div>
