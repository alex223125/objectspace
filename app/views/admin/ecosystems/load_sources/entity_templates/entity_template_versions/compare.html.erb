      class="
        mb-8
        overflow-hidden
        rounded-[24px]
        border-2
        border-indigo-100
        bg-gradient-to-br
        from-indigo-50
        via-white
        to-violet-50
        shadow-sm
        dark:border-indigo-900
        dark:from-indigo-950/30
        dark:via-gray-800
        dark:to-violet-950/20
