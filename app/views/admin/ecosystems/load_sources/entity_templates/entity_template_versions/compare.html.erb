<%#
  ============================================================================
  ENTITY TEMPLATE VERSION — COMPARE
  Path:
  app/views/admin/ecosystems/load_sources/entity_templates/entity_template_versions/compare.html.erb

  Purpose:
  Compare two versions of the same EntityTemplate.

  Expected controller variables:

    @entity_template
    @versions
    @entity_template_version
    @left_version
    @right_version
    @left_definition
    @right_definition
    @field_changes
    @definition_changes
    @comparison_summary

  Expected field comparison structure:

    {
      name: "email",
      type: :changed,
      left: {
        "name" => "email",
        "label" => "Email",
        "type" => "text",
        "required" => false
      },
      right: {
        "name" => "email",
        "label" => "Email",
        "type" => "email",
        "required" => false
      },
      changes: [
        {
          key: "type",
          left: "text",
          right: "email"
        }
      ]
    }
  ============================================================================
%>

<%
  # ==========================================================================
  # DEFENSIVE NORMALIZATION
  # ==========================================================================

  versions =
    Array(@versions)

  field_changes =
    Array(@field_changes)

  definition_changes =
    Array(@definition_changes)

  comparison_summary =
    @comparison_summary.is_a?(Hash) ?
      @comparison_summary :
      {}

  left_definition =
    @left_definition.is_a?(Hash) ?
      @left_definition :
      {}

  right_definition =
    @right_definition.is_a?(Hash) ?
      @right_definition :
      {}

  # Support both symbol and string keys.
  summary_value = lambda do |key|
    comparison_summary[key] ||
      comparison_summary[key.to_s] ||
      0
  end

  added_count =
    summary_value.call(:added).to_i

  removed_count =
    summary_value.call(:removed).to_i

  changed_count =
    summary_value.call(:changed).to_i

  unchanged_count =
    summary_value.call(:unchanged).to_i

  total_changes =
    added_count +
      removed_count +
      changed_count

  total_fields =
    total_changes +
      unchanged_count


  # ==========================================================================
  # HELPER LAMBDAS
  # ==========================================================================

  value_for = lambda do |object, key|
    if object.is_a?(Hash)
      object[key] ||
        object[key.to_s]
    end
  end


  field_name_for = lambda do |field|
    (
      value_for.call(field, :name) ||
        value_for.call(field, :key)
    ).to_s
  end


  field_type_for = lambda do |field|
    value =
      value_for.call(field, :type)

    value.to_s.downcase
  end


  field_label_for = lambda do |field|
    (
      value_for.call(field, :label) ||
        value_for.call(field, :name)
    ).to_s
  end


  field_left_for = lambda do |field|
    value_for.call(field, :left)
  end


  field_right_for = lambda do |field|
    value_for.call(field, :right)
  end


  field_changes_for = lambda do |field|
    value =
      value_for.call(field, :changes)

    value.is_a?(Array) ? value : []
  end


  change_key_for = lambda do |change|
    (
      value_for.call(change, :key) ||
        value_for.call(change, :name)
    ).to_s
  end


  change_left_for = lambda do |change|
    value_for.call(change, :left)
  end


  change_right_for = lambda do |change|
    value_for.call(change, :right)
  end


  pretty_json = lambda do |value|
    begin
      JSON.pretty_generate(value)
    rescue StandardError
      value.to_s
    end
  end
%>

<div class="mx-auto w-full max-w-7xl px-5 py-8 sm:px-7 lg:px-10">
  <%#
    =========================================================================
    PAGE HEADER
    =========================================================================
  %>

  <div class="mb-8">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-start lg:justify-between">
      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-3">
          <div
            class="
              flex
              h-12
              w-12
              shrink-0
              items-center
              justify-center
              rounded-2xl
              border
              border-violet-200
              bg-violet-100
              text-2xl
              shadow-sm
              dark:border-violet-800
              dark:bg-violet-950/40
            "
          >
            ⚖️
          </div>

          <div class="min-w-0">
            <div
              class="
                text-[11px] font-black uppercase tracking-[0.2em]
                text-violet-500
              "
            >
              Entity Template Version
            </div>

            <h1
              class="
                mt-1 text-3xl font-black tracking-tight text-gray-900
                dark:text-white
              "
            >
              Compare Versions
            </h1>
          </div>
        </div>

        <%# BREADCRUMB %>

        <div class="mt-4 flex flex-wrap items-center gap-2 text-xs text-gray-400">
          <span>Encyclopedia</span>
          <span>›</span>

          <span>Ecosystems</span>
          <span>›</span>

          <span>Load Sources</span>
          <span>›</span>

          <span>Entity Templates</span>
          <span>›</span>

          <span>Versions</span>
          <span>›</span>

          <span class="font-semibold text-violet-500"> Compare </span>
        </div>
      </div>

      <%# HEADER ACTIONS %>

      <div class="flex flex-wrap items-center gap-3">
        <% if defined?(@entity_template_version) &&
          @entity_template_version.present? %>
          <%= link_to(
                "← Version",
                admin_ecosystems_load_sources_entity_templates_entity_template_version_path(
                  @entity_template_version
                ),
                class: "
                  inline-flex
                  items-center
                  justify-center
                  rounded-xl
                  border
                  border-gray-200
                  bg-white
                  px-4
                  py-2.5
                  text-sm
                  font-semibold
                  text-gray-700
                  shadow-sm
                  transition
                  hover:border-gray-300
                  hover:bg-gray-50
                  dark:border-gray-700
                  dark:bg-gray-800
                  dark:text-gray-200
                  dark:hover:bg-gray-750
                "
              ) %>
        <% end %>

        <%= link_to(
              "All Versions",
              admin_ecosystems_load_sources_entity_templates_entity_template_versions_path,
              class: "
                inline-flex
                items-center
                justify-center
                rounded-xl
                border
                border-violet-200
                bg-violet-50
                px-4
                py-2.5
                text-sm
                font-semibold
                text-violet-700
                shadow-sm
                transition
                hover:bg-violet-100
                dark:border-violet-800
                dark:bg-violet-950/30
                dark:text-violet-300
              "
            ) %>
      </div>
    </div>
  </div>

  <%#
    =========================================================================
    PARENT TEMPLATE
    =========================================================================
  %>

  <% if defined?(@entity_template) &&
    @entity_template.present? %>
