<footer class="bg-gray-50 dark:bg-gray-800">
  <div class="p-4 py-6 mx-auto max-w-screen-xl md:p-8 lg:p-10">

    <div
      class="relative
         w-full
         overflow-hidden
         border-t border-slate-200
         bg-white">

      <!-- ATMOSPHERE -->

      <div
        class="pointer-events-none
           absolute inset-0 overflow-hidden">

        <div
          class="absolute -bottom-24 left-[15%]
             h-48 w-48 rounded-full
             bg-emerald-200/20
             blur-[70px]">
        </div>

        <div
          class="absolute -bottom-20 right-[20%]
             h-48 w-48 rounded-full
             bg-violet-200/20
             blur-[70px]">
        </div>

        <div
          class="absolute right-[8%] top-6
             h-2 w-2 rounded-full
             bg-amber-400/70
             animate-pulse">
        </div>

      </div>

      <!-- CONTENT -->

      <div
        class="relative mx-auto w-full
           max-w-screen-2xl
           px-4 py-6
           md:px-6
           2xl:px-10">

        <div
          class="flex flex-col gap-5
             md:flex-row
             md:items-center
             md:justify-between">

          <!-- BRAND -->

          <div class="flex items-center gap-3">

            <div
              class="flex h-10 w-10
                 items-center justify-center
                 rounded-xl
                 border border-emerald-200
                 bg-emerald-50
                 shadow-sm">

              🏆

            </div>

            <div>

              <div class="flex items-center gap-2">

            <span
              class="text-sm font-black
                     text-slate-700">

              Objectspace Admin

            </span>

                <span
                  class="rounded-full
                     border border-emerald-200
                     bg-emerald-50
                     px-2 py-0.5
                     text-[9px] font-black
                     uppercase tracking-wider
                     text-emerald-600">

              Online

            </span>

              </div>

              <p class="text-[11px] text-slate-400">
                Workspace management environment
              </p>

            </div>

          </div>

          <!-- NAV -->

          <nav class="flex flex-wrap items-center gap-5">

            <%= link_to "Dashboard",
                        admin_root_path,
                        class: "text-xs font-semibold
                            text-slate-400
                            hover:text-sky-500" %>

            <%= link_to "Articles",
                        admin_article_versions_path,
                        class: "text-xs font-semibold
                            text-slate-400
                            hover:text-violet-500" %>

          </nav>

          <!-- STATUS -->

          <div class="flex items-center gap-2">

        <span
          class="h-2 w-2 rounded-full
                 bg-emerald-400
                 shadow-[0_0_10px_rgba(52,211,153,0.5)]">
        </span>

            <span
              class="text-[10px] font-bold
                 uppercase tracking-wider
                 text-slate-400">

          System operational

        </span>

          </div>

        </div>

        <!-- BOTTOM -->

        <div
          class="mt-5 flex flex-col gap-3
             border-t border-slate-100
             pt-4
             sm:flex-row
             sm:items-center
             sm:justify-between">

          <p
            class="text-[10px] font-medium
               text-slate-400">

            © <%= Time.current.year %>
            Objectspace. All rights reserved.

          </p>

          <div class="flex items-center gap-2">

        <span
          class="text-[9px] font-black
                 uppercase tracking-widest
                 text-slate-300">

          Workspace progress

        </span>

            <div
              class="h-1.5 w-24
                 overflow-hidden rounded-full
                 bg-slate-100">

              <div
                class="h-full w-[72%]
                   rounded-full
                   bg-gradient-to-r
                   from-emerald-400
                   via-sky-400
                   to-violet-400">
              </div>

            </div>

            <span
              class="text-[9px] font-black
                 text-emerald-500">

          72%

        </span>

          </div>

        </div>

      </div>

    </div>

  </div>
</footer>