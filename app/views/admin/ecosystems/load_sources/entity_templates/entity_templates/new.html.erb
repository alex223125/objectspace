<%# FILE: app/views/admin/ecosystems/load_sources/entity_templates/entity_templates/new.html.erb %>

<div class="mx-auto w-full max-w-3xl px-5 py-8 sm:px-7 lg:px-10">

  <div class="mb-8">

    <div class="mb-2 flex items-center gap-3">

      <%= link_to(
            "←",
            admin_ecosystems_load_sources_entity_templates_entity_templates_path,
            class: "flex h-10 w-10 items-center justify-center rounded-xl
                    border border-gray-200 bg-white text-gray-600
                    hover:bg-gray-50
                    dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300"
          ) %>

      <div>
        <h1 class="text-2xl font-bold text-gray-900 dark:text-white">
          Create Entity Template
        </h1>

        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
          Create a new structure for encyclopedia entities.
        </p>
      </div>

    </div>

  </div>


  <div
    class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm
           dark:border-gray-800 dark:bg-gray-800"
  >

    <%= form_with(
          model: @entity_template,
          url: admin_ecosystems_load_sources_entity_templates_entity_templates_path,
          method: :post,
          local: true,
          class: "space-y-6"
        ) do |form| %>


      <% if @entity_template.errors.any? %>

        <div
          class="rounded-xl border border-red-200 bg-red-50 p-4
                 text-sm text-red-700
                 dark:border-red-900 dark:bg-red-950/40 dark:text-red-300"
        >

          <div class="font-semibold">
            Please fix the following errors:
          </div>

          <ul class="mt-2 list-disc pl-5">
            <% @entity_template.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>

        </div>

      <% end %>


      <!-- NAME -->

      <div>

        <%= form.label(
              :name,
              class: "block text-sm font-medium text-gray-700 dark:text-gray-300"
            ) %>

        <%= form.text_field(
              :name,
              autofocus: true,
              class: "mt-1 block w-full rounded-xl border border-gray-300
                      bg-white px-4 py-3
                      focus:border-indigo-500 focus:ring-indigo-500
                      dark:border-gray-700 dark:bg-gray-900 dark:text-white"
            ) %>

      </div>


      <!-- SLUG -->

      <div>

        <%= form.label(
              :slug,
              class: "block text-sm font-medium text-gray-700 dark:text-gray-300"
            ) %>

        <%= form.text_field(
              :slug,
              class: "mt-1 block w-full rounded-xl border border-gray-300
                      bg-white px-4 py-3
                      focus:border-indigo-500 focus:ring-indigo-500
                      dark:border-gray-700 dark:bg-gray-900 dark:text-white"
            ) %>

      </div>


      <!-- DESCRIPTION -->

      <div>

        <%= form.label(
              :description,
              class: "block text-sm font-medium text-gray-700 dark:text-gray-300"
            ) %>

        <%= form.text_area(
              :description,
              rows: 5,
              class: "mt-1 block w-full rounded-xl border border-gray-300
                      bg-white px-4 py-3
                      focus:border-indigo-500 focus:ring-indigo-500
                      dark:border-gray-700 dark:bg-gray-900 dark:text-white"
            ) %>

      </div>


      <!-- ENTITY TYPE -->

      <div>

        <%= form.label(
              :entity_type_id,
              "Entity Type",
              class: "block text-sm font-medium text-gray-700 dark:text-gray-300"
            ) %>

        <%= form.collection_select(
              :entity_type_id,
              @entity_types,
              :id,
              :name,
              { prompt: "Select entity type" },
              class: "mt-1 block w-full rounded-xl border border-gray-300
                      bg-white px-4 py-3
                      focus:border-indigo-500 focus:ring-indigo-500
                      dark:border-gray-700 dark:bg-gray-900 dark:text-white"
            ) %>

      </div>


      <!-- ACTIVE -->

      <div class="flex items-center gap-2">

        <%= form.check_box(
              :active,
              class: "rounded border-gray-300 text-indigo-600
                      focus:ring-indigo-500"
            ) %>

        <%= form.label(
              :active,
              "Active",
              class: "text-sm font-medium text-gray-700 dark:text-gray-300"
            ) %>

      </div>


      <!-- ACTIONS -->

      <div
        class="flex items-center justify-end gap-3
               border-t border-gray-200 pt-6
               dark:border-gray-700"
      >

        <%= link_to(
              "Cancel",
              admin_ecosystems_load_sources_entity_templates_entity_templates_path,
              class: "rounded-xl border border-gray-300 px-5 py-3
                      text-sm font-semibold text-gray-700
                      hover:bg-gray-50
                      dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-700"
            ) %>

        <%= form.submit(
              "Create Template",
              class: "rounded-xl bg-indigo-600 px-5 py-3
                      text-sm font-semibold text-white
                      hover:bg-indigo-700"
            ) %>

      </div>

    <% end %>

  </div>

</div>