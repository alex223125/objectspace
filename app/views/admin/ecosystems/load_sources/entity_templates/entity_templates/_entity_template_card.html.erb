<div
  class="group relative overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm transition duration-300 hover:-translate-y-1 hover:border-indigo-300 hover:shadow-xl dark:border-gray-800 dark:bg-gray-800"
>

  <div class="absolute right-0 top-0 h-24 w-24 translate-x-8 -translate-y-8 rounded-full bg-indigo-100 opacity-50 transition group-hover:scale-150 dark:bg-indigo-900/30"></div>


  <div class="relative p-6">

    <div class="flex items-start justify-between">

      <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-indigo-500 to-purple-600 text-xl text-white shadow-lg">
        🧩
      </div>

      <% if entity_template.active? %>

        <span class="rounded-full bg-emerald-100 px-3 py-1 text-xs font-semibold text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400">
          Active
        </span>

      <% else %>

        <span class="rounded-full bg-gray-100 px-3 py-1 text-xs font-semibold text-gray-500 dark:bg-gray-700">
          Inactive
        </span>

      <% end %>

    </div>


    <div class="mt-5">

      <h2 class="text-lg font-bold text-gray-900 dark:text-white">
        <%= entity_template.name %>
      </h2>

      <p class="mt-1 text-xs font-mono text-gray-400">
        <%= entity_template.slug %>
      </p>

    </div>


    <div class="mt-4">

      <span class="inline-flex items-center rounded-lg bg-indigo-50 px-3 py-1.5 text-xs font-medium text-indigo-700 dark:bg-indigo-900/30 dark:text-indigo-300">
        <%= entity_template.entity_type.name %>
      </span>

    </div>


    <% if entity_template.description.present? %>

      <p class="mt-4 line-clamp-3 text-sm leading-6 text-gray-500 dark:text-gray-400">
        <%= entity_template.description %>
      </p>

    <% else %>

      <p class="mt-4 text-sm italic text-gray-400">
        No description yet.
      </p>

    <% end %>


    <div class="mt-6 grid grid-cols-2 gap-3">

      <div class="rounded-xl bg-gray-50 p-3 dark:bg-gray-900">

        <div class="text-xs text-gray-400">
          Versions
        </div>

        <div class="mt-1 text-lg font-bold text-gray-900 dark:text-white">
          <%= entity_template.versions_count %>
        </div>

      </div>


      <div class="rounded-xl bg-gray-50 p-3 dark:bg-gray-900">

        <div class="text-xs text-gray-400">
          Latest
        </div>

        <div class="mt-1 text-lg font-bold text-gray-900 dark:text-white">

          <% if entity_template.latest_version.present? %>
            v<%= entity_template.latest_version.version %>
          <% else %>
            —
          <% end %>

        </div>

      </div>

    </div>


    <div class="mt-6 flex items-center justify-between border-t border-gray-100 pt-5 dark:border-gray-700">

      <%= link_to "Open",
                  admin_ecosystems_load_sources_entity_templates_entity_template_path(entity_template),
                  class: "text-sm font-semibold text-indigo-600 transition hover:text-indigo-800 dark:text-indigo-400" %>


      <%= link_to "Edit",
                  edit_admin_ecosystems_load_sources_entity_templates_entity_template_path(entity_template),
                  class: "text-sm font-medium text-gray-500 hover:text-gray-900 dark:hover:text-white" %>

    </div>

  </div>

</div>
