<div class="max-w-7xl mx-auto my-10 p-8
            bg-gradient-to-b from-white via-orange-50/20 to-slate-50/50
            border-2 border-orange-100
            rounded-[38px]
            shadow-md shadow-orange-100/40">

  <!-- Header -->

  <div class="flex flex-col gap-5
              lg:flex-row lg:items-center lg:justify-between
              mb-8 pb-6
              border-b-2 border-orange-100">

    <div class="flex items-center gap-4">

      <div class="w-12 h-12 rounded-2xl
                  bg-orange-100
                  border border-orange-200
                  flex items-center justify-center
                  text-xl">
        🧩
      </div>

      <div>
        <div class="text-[11px] font-black uppercase
                    tracking-[0.2em] text-orange-500">
          Template Field Manual
        </div>

        <h1 class="mt-1 text-2xl font-black text-slate-800">
          <%= @entity_template_version.entity_template.name %>
        </h1>

        <p class="mt-1 text-xs text-slate-400">
          Version <%= @entity_template_version.version %>
          · <%= @entity_template_version.status.titleize %>
        </p>
      </div>

    </div>

    <%= link_to "＋ Add Field",
                new_entity_template_entity_template_version_entity_template_field_path(
                  @entity_template_version.entity_template,
                  @entity_template_version
                ),
                class: "rounded-2xl
                bg-gradient-to-r from-orange-400 to-amber-400
                px-5 py-3
                text-sm font-black text-white
                shadow-md shadow-orange-200/60
                hover:-translate-y-0.5
                transition" %>

  </div>


  <!-- Field progression -->

  <div class="mb-8
              rounded-[28px]
              border-2 border-orange-100
              bg-white/70
              p-6">

    <div class="flex items-center justify-between">

      <div>
        <div class="text-sm font-black text-slate-700">
          Schema Construction
        </div>

        <p class="mt-1 text-xs text-slate-400">
          Define the attributes this template version expects.
        </p>
      </div>

      <div class="rounded-full
                  bg-orange-50
                  border border-orange-200
                  px-4 py-2
                  text-xs font-black
                  text-orange-600">

        <%= @entity_template_version.entity_template_fields.count %>
        fields

      </div>

    </div>

  </div>


  <!-- Fields -->

  <div class="space-y-4">

    <% @entity_template_fields.each_with_index do |field, index| %>

      <div class="group
                  rounded-[26px]
                  border-2 border-slate-100
                  bg-white
                  p-5
                  shadow-sm
                  hover:border-orange-200
                  hover:shadow-md
                  transition">

        <div class="flex flex-col gap-5
                    lg:flex-row lg:items-center
                    lg:justify-between">

          <div class="flex items-center gap-4">

            <div class="w-11 h-11
                        rounded-2xl
                        bg-slate-50
                        border border-slate-200
                        flex items-center justify-center
                        text-sm font-black
                        text-slate-500">

              <%= index + 1 %>

            </div>

            <div>

              <div class="flex flex-wrap items-center gap-2">

                <h2 class="text-sm font-black text-slate-800">
                  <%= field.label %>
                </h2>

                <span class="rounded-full
                             bg-sky-50
                             border border-sky-200
                             px-2.5 py-1
                             text-[10px]
                             font-black
                             uppercase
                             tracking-wider
                             text-sky-600">

                  <%= field.field_type %>

                </span>

                <% if field.required? %>
                  <span class="rounded-full
                               bg-red-50
                               border border-red-200
                               px-2.5 py-1
                               text-[10px]
                               font-black
                               text-red-500">
                    Required
                  </span>
                <% end %>

              </div>

              <p class="mt-1 text-[11px] text-slate-400">
                <%= field.slug %>
              </p>

            </div>

          </div>


          <div class="flex items-center gap-2">

            <%= link_to "Edit",
                        edit_entity_template_entity_template_version_entity_template_field_path(
                          @entity_template_version.entity_template,
                          @entity_template_version,
                          field
                        ),
                        class: "rounded-xl
                        border border-slate-200
                        bg-white
                        px-4 py-2
                        text-xs font-black
                        text-slate-600
                        hover:border-orange-200
                        hover:text-orange-600" %>

          </div>

        </div>

      </div>

    <% end %>

  </div>

</div>