<%= render "admin/ecosystems/load_sources/entity_templates/entity_template_fields/field_manual" %>

<%# ============================================================================
ENTITY TEMPLATE FIELDS — FIELD MANUAL

Partial/Page:
app/views/admin/ecosystems/load_sources/entity_templates/entity_template_fields/index.html.erb

Purpose:
Beginner-friendly visual explanation of what Template Fields are,
why they exist, how they fit into Entity Templates, and how to
understand the fields listed on this page.

This page sits one level below Entity Templates:

Entity Type
↓
Entity Template
↓
Template Fields
↓
Entity Records

============================================================================ %>

<div class="max-w-7xl mx-auto my-10 overflow-hidden rounded-[38px] border-2 border-orange-100 bg-gradient-to-b from-white via-orange-50/20 to-slate-50/50 shadow-md shadow-orange-100/40">
  <!-- ======================================================================== ACTUAL TEMPLATE FIELD PAGE ========================================================================== -->
  <section class="p-6 sm:p-8 lg:p-10">
  <!-- ======================================================================
       HEADER
  ==================================================================== -->

  <div
    class="
    mb-8
    flex
    flex-col
    gap-5
    border-b-2
    border-orange-100
    pb-6
    lg:flex-row
    lg:items-center
    lg:justify-between
  ">

    <div class="flex items-center gap-4">

      <div
        class="
        flex
        h-12
        w-12
        items-center
        justify-center
        rounded-2xl
        border
        border-orange-200
        bg-orange-100
        text-xl
      ">
        🧩
      </div>

      <div>

        <div
          class="
          text-[11px]
          font-black
          uppercase
          tracking-[0.2em]
          text-orange-500
        ">
          Template Field Manual
        </div>

        <h1 class="mt-1 text-2xl font-black text-slate-800">
          <%= @entity_template_version.entity_template.name %>
        </h1>

        <p class="mt-1 text-xs text-slate-400">
          Version <%= @entity_template_version.version %>
          · <%= @entity_template_version.status.titleize %>
        </p>

      </div>

    </div>

    <%= link_to(
          "＋ Add Field",
          new_admin_ecosystems_load_sources_entity_templates_entity_template_version_entity_template_field_path(
            @entity_template_version
          ),
          class: "
          rounded-2xl
          bg-gradient-to-r
          from-orange-400
          to-amber-400
          px-5
          py-3
          text-sm
          font-black
          text-white
          shadow-md
          shadow-orange-200/60
          transition
          hover:-translate-y-0.5
          hover:shadow-lg
        "
        ) %>

  </div>

  <!-- ======================================================================
       FIELD PROGRESSION
  ==================================================================== -->

  <div
    class="
    mb-8
    rounded-[28px]
    border-2
    border-orange-100
    bg-white/70
    p-6
  ">

    <div class="flex items-center justify-between gap-4">

      <div>

        <div class="text-sm font-black text-slate-700">
          Schema Construction
        </div>

        <p class="mt-1 text-xs text-slate-400">
          Define the attributes this template version expects.
        </p>

      </div>

      <div
        class="
        shrink-0
        rounded-full
        border
        border-orange-200
        bg-orange-50
        px-4
        py-2
        text-xs
        font-black
        text-orange-600
      ">
        <%= @entity_template_version.entity_template_fields.count %>
        fields
      </div>

    </div>

  </div>

  <!-- ======================================================================
       FIELDS
  ==================================================================== -->

  <div class="space-y-4">

    <% @entity_template_fields.each_with_index do |field, index| %>

      <div
        class="
        group
        rounded-[26px]
        border-2
        border-slate-100
        bg-white
        p-5
        shadow-sm
        transition
        hover:border-orange-200
        hover:shadow-md
      ">

        <div
          class="
          flex
          flex-col
          gap-5
          lg:flex-row
          lg:items-center
          lg:justify-between
        ">

          <!-- FIELD IDENTITY -->

          <div class="flex items-center gap-4">

            <div
              class="
              flex
              h-11
              w-11
              items-center
              justify-center
              rounded-2xl
              border
              border-slate-200
              bg-slate-50
              text-sm
              font-black
              text-slate-500
            ">
              <%= index + 1 %>
            </div>

            <div>

              <div class="flex flex-wrap items-center gap-2">

                <h2 class="text-sm font-black text-slate-800">
                  <%= field.label %>
                </h2>

                <span
                  class="
                  rounded-full
                  border
                  border-sky-200
                  bg-sky-50
                  px-2.5
                  py-1
                  text-[10px]
                  font-black
                  uppercase
                  tracking-wider
                  text-sky-600
                ">
                <%= field.field_type %>
              </span>

                <% if field.required? %>

                <span
                  class="
                    rounded-full
                    border
                    border-red-200
                    bg-red-50
                    px-2.5
                    py-1
                    text-[10px]
                    font-black
                    text-red-500
                  ">
                  Required
                </span>

                <% end %>

              </div>

              <p class="mt-1 text-[11px] text-slate-400">
                <%= field.slug %>
              </p>

            </div>

          </div>

          <!-- FIELD ACTIONS -->

          <div class="flex items-center gap-2">

            <%= link_to(
                  "Edit",
                  edit_admin_ecosystems_load_sources_entity_templates_entity_template_version_entity_template_field_path(
                    @entity_template_version,
                    field
                  ),
                  class: "
                  inline-flex
                  items-center
                  justify-center
                  rounded-lg
                  border
                  border-gray-200
                  bg-white
                  px-3
                  py-2
                  text-xs
                  font-semibold
                  text-gray-700
                  transition
                  hover:border-orange-300
                  hover:bg-orange-50
                  hover:text-orange-600
                  dark:border-gray-700
                  dark:bg-gray-800
                  dark:text-gray-200
                  dark:hover:border-orange-700
                  dark:hover:bg-orange-900/20
                  dark:hover:text-orange-400
                "
                ) %>

          </div>

        </div>

      </div>

    <% end %>

  </div>

</section> </div>
