<div
  class="mx-auto w-full max-w-7xl px-5 pt-8 sm:px-7 lg:px-10"
  data-controller="entity_template_configuration"
>

  <!-- HEADER -->
  <div class="mb-8">
    <div class="flex flex-col gap-5 lg:flex-row lg:items-center lg:justify-between">
      <div>
        <div class="mb-3 flex items-center gap-3">
          <div class="flex h-12 w-12 items-center justify-center rounded-2xl
                      bg-violet-100 text-xl text-violet-600
                      shadow-sm dark:bg-violet-900/30 dark:text-violet-300">
            ⚙️
          </div>
          <div>
            <div class="text-[10px] font-black uppercase tracking-[0.2em]
                        text-violet-500">
              Template Control Center
            </div>
            <h1 class="text-2xl font-black text-gray-900 dark:text-white">
              Entity Template Configuration
            </h1>
          </div>
        </div>

        <p class="max-w-2xl text-sm leading-6 text-gray-500 dark:text-gray-400">
          Control which entity templates are used by each ecosystem,
          activity, and load source.
        </p>
      </div>


      <!-- GAMIFICATION -->

      <div class="flex items-center gap-3">

        <div class="rounded-2xl border border-amber-100 bg-amber-50 px-4 py-3">
          <div class="text-[9px] font-black uppercase tracking-wider text-amber-500">
            Configuration XP
          </div>

          <div class="mt-1 text-lg font-black text-amber-600">
            <%= @configurations.size * 50 %>
          </div>
        </div>

        <div class="rounded-2xl border border-emerald-100 bg-emerald-50 px-4 py-3">
          <div class="text-[9px] font-black uppercase tracking-wider text-emerald-500">
            Active
          </div>

          <div class="mt-1 text-lg font-black text-emerald-600">
            <%= @configurations.count(&:active?) %>
          </div>
        </div>

      </div>

    </div>

  </div>


  <!-- STATISTICS -->

  <div class="mb-8 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">

    <div class="rounded-2xl border border-gray-200 bg-white p-5 shadow-sm
                dark:border-gray-800 dark:bg-gray-800">

      <div class="text-xs font-semibold uppercase tracking-wider text-gray-400">
        Templates
      </div>

      <div class="mt-2 text-3xl font-black text-gray-900 dark:text-white">
        <%= @templates.count %>
      </div>

      <div class="mt-1 text-xs text-gray-400">
        Available structures
      </div>

    </div>


    <div class="rounded-2xl border border-gray-200 bg-white p-5 shadow-sm
                dark:border-gray-800 dark:bg-gray-800">

      <div class="text-xs font-semibold uppercase tracking-wider text-gray-400">
        Entity Types
      </div>

      <div class="mt-2 text-3xl font-black text-indigo-600">
        <%= @entity_types.count %>
      </div>

      <div class="mt-1 text-xs text-gray-400">
        Abstract entity types
      </div>

    </div>


    <div class="rounded-2xl border border-gray-200 bg-white p-5 shadow-sm
                dark:border-gray-800 dark:bg-gray-800">

      <div class="text-xs font-semibold uppercase tracking-wider text-gray-400">
        Configurations
      </div>

      <div class="mt-2 text-3xl font-black text-violet-600">
        <%= @configurations.count %>
      </div>

      <div class="mt-1 text-xs text-gray-400">
        Template assignments
      </div>

    </div>


    <div class="rounded-2xl border border-emerald-100 bg-emerald-50 p-5 shadow-sm
                dark:border-emerald-900/30 dark:bg-emerald-900/10">

      <div class="text-xs font-semibold uppercase tracking-wider text-emerald-500">
        System Status
      </div>

      <div class="mt-2 flex items-center gap-2 text-lg font-black text-emerald-600">

        <span class="h-2.5 w-2.5 animate-pulse rounded-full bg-emerald-400"></span>

        Operational

      </div>

      <div class="mt-1 text-xs text-emerald-600/70">
        Configuration engine ready
      </div>

    </div>

  </div>


  <!-- CONFIGURATION BUILDER -->

  <div class="mb-8 rounded-3xl border border-indigo-100
              bg-gradient-to-br from-indigo-50 via-white to-violet-50
              p-6 shadow-sm
              dark:border-gray-800 dark:bg-gray-800">

    <div class="mb-6">

      <div class="flex items-center gap-3">

        <div class="flex h-10 w-10 items-center justify-center rounded-xl
                    bg-indigo-600 text-white shadow-lg shadow-indigo-200">
          +
        </div>

        <div>

          <h2 class="text-lg font-black text-gray-900 dark:text-white">
            Assign Template
          </h2>

          <p class="text-xs text-gray-500">
            Connect an entity type to a template inside a specific context.
          </p>

        </div>

      </div>

    </div>


    <%= form_with model: @configuration,
                  url: admin_ecosystems_load_sources_entity_templates_configuration_path,
                  class: "space-y-5" do |form| %>


      <div class="grid grid-cols-1 gap-4 lg:grid-cols-12">

        <!-- ENTITY TYPE -->

        <div class="lg:col-span-3">

          <%= form.label :entity_type_id,
                         "Entity Type",
                         class: "mb-2 block text-xs font-black uppercase tracking-wider text-gray-500" %>

          <%= form.collection_select :entity_type_id,
                                     @entity_types,
                                     :id,
                                     :name,
                                     { prompt: "Choose entity type" },
                                     {
                                       class: "block w-full rounded-xl border border-gray-300
                      bg-white px-4 py-3 text-sm
                      focus:border-indigo-500 focus:ring-indigo-500
                      dark:border-gray-700 dark:bg-gray-900 dark:text-white",
                                       data: {
                                         action: "change->entity_template_configuration#entityTypeChanged"
                                       }
                                     } %>

        </div>


        <!-- TEMPLATE -->

        <div class="lg:col-span-3">

          <%= form.label :entity_template_id,
                         "Template",
                         class: "mb-2 block text-xs font-black uppercase tracking-wider text-gray-500" %>

          <%= form.collection_select :entity_template_id,
                                     @templates,
                                     :id,
                                     :name,
                                     { prompt: "Choose template" },
                                     {
                                       class: "block w-full rounded-xl border border-gray-300
                      bg-white px-4 py-3 text-sm
                      focus:border-indigo-500 focus:ring-indigo-500
                      dark:border-gray-700 dark:bg-gray-900 dark:text-white",
                                       data: {
                                         entity_template_configuration_target: "template"
                                       }
                                     } %>

        </div>


        <!-- CONTEXT TYPE -->

        <div class="lg:col-span-2">

          <%= form.label :context_type,
                         "Context",
                         class: "mb-2 block text-xs font-black uppercase tracking-wider text-gray-500" %>

          <%= form.select :context_type,
                          [
                            ["Ecosystem", "Ecosystem"],
                            ["Activity", "Activity"],
                            ["Load Source", "LoadSource"]
                          ],
                          { prompt: "Context" },
                          {
                            class: "block w-full rounded-xl border border-gray-300
                      bg-white px-4 py-3 text-sm
                      focus:border-indigo-500 focus:ring-indigo-500
                      dark:border-gray-700 dark:bg-gray-900 dark:text-white",
                            data: {
                              action: "change->entity_template_configuration#contextTypeChanged"
                            }
                          } %>

        </div>


        <!-- CONTEXT -->

        <div class="lg:col-span-2">

          <%= form.label :context_id,
                         "Target",
                         class: "mb-2 block text-xs font-black uppercase tracking-wider text-gray-500" %>

          <%= form.select :context_id,
                          [],
                          {},
                          {
                            class: "block w-full rounded-xl border border-gray-300
                      bg-white px-4 py-3 text-sm
                      focus:border-indigo-500 focus:ring-indigo-500
                      dark:border-gray-700 dark:bg-gray-900 dark:text-white",
                            data: {
                              entity_template_configuration_target: "context"
                            }
                          } %>

        </div>


        <!-- PRIORITY -->

        <div class="lg:col-span-2">

          <%= form.label :priority,
                         "Priority",
                         class: "mb-2 block text-xs font-black uppercase tracking-wider text-gray-500" %>

          <%= form.number_field :priority,
                                value: 0,
                                min: 0,
                                class: "block w-full rounded-xl border border-gray-300
                    bg-white px-4 py-3 text-sm
                    focus:border-indigo-500 focus:ring-indigo-500
                    dark:border-gray-700 dark:bg-gray-900 dark:text-white" %>

        </div>

      </div>


      <!-- ACTIVE -->

      <div class="flex flex-col gap-4 border-t border-indigo-100 pt-5
                  sm:flex-row sm:items-center sm:justify-between">

        <label class="flex cursor-pointer items-center gap-3">

          <%= form.check_box :active,
                             class: "h-5 w-5 rounded border-gray-300 text-indigo-600
                    focus:ring-indigo-500" %>

          <span>

            <span class="block text-sm font-bold text-gray-700 dark:text-gray-200">
              Activate configuration
            </span>

            <span class="block text-xs text-gray-400">
              This template will be used by the entity builder.
            </span>

          </span>

        </label>


        <%= form.submit "Save Configuration",
                        class: "inline-flex cursor-pointer items-center justify-center
                  rounded-xl bg-indigo-600 px-6 py-3
                  text-sm font-bold text-white shadow-sm
                  transition hover:-translate-y-0.5 hover:bg-indigo-700" %>

      </div>

    <% end %>

  </div>


  <!-- FILTER -->

  <div class="mb-6 rounded-2xl border border-gray-200 bg-white p-5 shadow-sm
              dark:border-gray-800 dark:bg-gray-800">

    <div class="grid grid-cols-1 gap-4 md:grid-cols-4">

      <div class="md:col-span-2">

        <label class="mb-2 block text-xs font-black uppercase tracking-wider text-gray-400">
          Search configuration
        </label>

        <div class="relative">

          <input
            type="search"
            placeholder="Search templates, entity types or contexts..."
            class="w-full rounded-xl border border-gray-300 bg-gray-50
                   px-4 py-3 pl-11 text-sm
                   focus:border-indigo-500 focus:ring-indigo-500
                   dark:border-gray-700 dark:bg-gray-900 dark:text-white"
            data-entity_template_configuration-target="search"
            data-action="input->entity_template_configuration#filter"
          >

          <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400">
            🔎
          </span>

        </div>

      </div>


      <div>

        <label class="mb-2 block text-xs font-black uppercase tracking-wider text-gray-400">
          Context
        </label>

        <select
          class="w-full rounded-xl border border-gray-300 bg-gray-50
                 px-4 py-3 text-sm
                 dark:border-gray-700 dark:bg-gray-900 dark:text-white"
          data-entity_template_configuration-target="contextFilter"
          data-action="change->entity_template_configuration#filter"
        >
          <option value="">All contexts</option>
          <option value="Ecosystem">Ecosystems</option>
          <option value="Activity">Activities</option>
          <option value="LoadSource">Load Sources</option>
        </select>

      </div>


      <div>

        <label class="mb-2 block text-xs font-black uppercase tracking-wider text-gray-400">
          Status
        </label>

        <select
          class="w-full rounded-xl border border-gray-300 bg-gray-50
                 px-4 py-3 text-sm
                 dark:border-gray-700 dark:bg-gray-900 dark:text-white"
          data-entity_template_configuration-target="statusFilter"
          data-action="change->entity_template_configuration#filter"
        >
          <option value="">All statuses</option>
          <option value="active">Active</option>
          <option value="inactive">Inactive</option>
        </select>

      </div>

    </div>

  </div>


  <!-- CONFIGURATION CARDS -->

  <div
    class="grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-3"
    data-entity_template_configuration-target="list"
  >

    <% @configurations.each do |configuration| %>

      <article
        class="configuration-card group rounded-2xl border border-gray-200
               bg-white p-5 shadow-sm transition
               hover:-translate-y-1 hover:border-indigo-200 hover:shadow-lg
               dark:border-gray-800 dark:bg-gray-800"
        data-context="<%= configuration.context_type %>"
        data-status="<%= configuration.active? ? 'active' : 'inactive' %>"
        data-search="
          <%= [
                                     configuration.entity_template.name,
                                     configuration.entity_type.name,
                                     configuration.context.try(:name),
                                     configuration.context_type
                                   ].compact.join(' ').downcase %>
        "
      >

        <!-- TOP -->

        <div class="flex items-start justify-between gap-3">

          <div class="flex items-center gap-3">

            <div class="flex h-11 w-11 items-center justify-center rounded-xl
                        bg-indigo-50 text-lg text-indigo-600
                        dark:bg-indigo-900/30 dark:text-indigo-300">
              🧩
            </div>

            <div>

              <div class="text-[9px] font-black uppercase tracking-wider text-gray-400">
                Entity Type
              </div>

              <div class="text-sm font-black text-gray-900 dark:text-white">
                <%= configuration.entity_type.name %>
              </div>

            </div>

          </div>


          <% if configuration.active? %>

            <span class="rounded-full border border-emerald-200
                         bg-emerald-50 px-2.5 py-1
                         text-[9px] font-black uppercase tracking-wider
                         text-emerald-600">
              Active
            </span>

          <% else %>

            <span class="rounded-full border border-gray-200
                         bg-gray-50 px-2.5 py-1
                         text-[9px] font-black uppercase tracking-wider
                         text-gray-400">
              Inactive
            </span>

          <% end %>

        </div>


        <!-- TEMPLATE -->

        <div class="mt-5 rounded-xl bg-slate-50 p-4 dark:bg-gray-900">

          <div class="text-[9px] font-black uppercase tracking-wider text-gray-400">
            Template
          </div>

          <div class="mt-1 text-base font-black text-indigo-600 dark:text-indigo-400">
            <%= configuration.entity_template.name %>
          </div>

          <% if configuration.entity_template.respond_to?(:description) %>

            <div class="mt-1 text-xs leading-5 text-gray-500">
              <%= truncate(configuration.entity_template.description, length: 100) %>
            </div>

          <% end %>

        </div>


        <!-- CONTEXT -->

        <div class="mt-4">

          <div class="text-[9px] font-black uppercase tracking-wider text-gray-400">
            Applied To
          </div>

          <div class="mt-2 flex items-center gap-2">

            <span class="rounded-lg bg-violet-50 px-2.5 py-1 text-[10px]
                         font-bold text-violet-600">
              <%= configuration.context_type %>
            </span>

            <span class="text-sm font-bold text-gray-700 dark:text-gray-200">
              <%= configuration.context.try(:name) || "Unknown context" %>
            </span>

          </div>

        </div>


        <!-- FOOTER -->

        <div class="mt-5 flex items-center justify-between
                    border-t border-gray-100 pt-4
                    dark:border-gray-700">

          <div>

            <div class="text-[9px] font-black uppercase tracking-wider text-gray-400">
              Priority
            </div>

            <div class="mt-1 text-sm font-black text-gray-700 dark:text-gray-200">
              #<%= configuration.priority %>
            </div>

          </div>


          <%= button_to "Remove",
                        admin_ecosystems_load_sources_entity_templates_delete_configuration_path(configuration),
                        method: :delete,
                        data: {
                          turbo_confirm: "Remove this template configuration?"
                        },
                        class: "rounded-lg px-3 py-2 text-xs font-bold
                    text-rose-500 transition
                    hover:bg-rose-50 hover:text-rose-600" %>

        </div>

      </article>

    <% end %>


    <% if @configurations.empty? %>

      <div class="md:col-span-2 xl:col-span-3">

        <div class="rounded-3xl border border-dashed border-gray-300
                    bg-white p-14 text-center
                    dark:border-gray-700 dark:bg-gray-800">

          <div class="mx-auto mb-5 flex h-16 w-16 items-center justify-center
                      rounded-2xl bg-violet-50 text-3xl
                      dark:bg-violet-900/20">
            ⚙️
          </div>

          <h3 class="text-lg font-black text-gray-900 dark:text-white">
            Configuration layer is empty
          </h3>

          <p class="mx-auto mt-2 max-w-md text-sm text-gray-500">
            Assign your first entity template to an ecosystem,
            activity, or load source.
          </p>

        </div>

      </div>

    <% end %>

  </div>

</div>
