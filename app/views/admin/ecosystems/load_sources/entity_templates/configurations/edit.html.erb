      ">
        <span>🧩</span>
        <span>Entity Types</span>
      </a>

      <a
        href="#"
        class="
        flex items-center gap-3 rounded-xl
        bg-indigo-50
        px-4 py-3
        text-sm font-semibold
        text-indigo-700
        dark:bg-indigo-900/20
        dark:text-indigo-300
      ">
        <span>⚙️</span>

        <span>
        Configuration
      </span>

        <span class="
        ml-auto
        rounded-full
        bg-indigo-100
