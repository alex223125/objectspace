      </span>

      </a>

    </nav>

    <div class="border-t border-slate-200 p-4 dark:border-gray-800">

      <a
        href="/admin"
        class="
        flex items-center gap-3 rounded-xl px-4 py-3
        text-sm font-medium
        text-gray-500
        transition
        hover:bg-slate-100
        hover:text-gray-900
        dark:text-gray-400
        dark:hover:bg-gray-800
        dark:hover:text-white
      ">
        <span>←</span>
        <span>Back to Admin</span>
      </a>

    </div>

  </div>

</aside> <!-- ================================================================ MAIN ================================================================= --> <div class="min-h-screen pl-72">
  <!-- HEADER -->

  <header class="
  sticky top-0 z-30
  flex w-full
  border-b border-slate-200
  bg-white/90
  backdrop-blur-xl
">

    <div class="
    flex w-full flex-grow
    items-center justify-between
    px-4 py-3
    md:px-6
    2xl:px-10
  ">

      <div class="flex items-center gap-4">

        <button
          type="button"
          class="
          flex h-10 w-10 items-center justify-center
          rounded-xl
          border border-slate-200
          bg-white
          text-slate-500
          shadow-sm
          hover:bg-slate-50
          lg:hidden
        ">
          ☰
        </button>

        <div>

          <div class="
          hidden text-[9px]
          font-black uppercase
          tracking-[0.2em]
          text-amber-500
          sm:block
        ">
            Admin Command Center
          </div>

          <div class="text-sm font-black text-slate-700">
            Entity Template Configuration
          </div>

        </div>

      </div>

      <div class="flex items-center gap-3">

        <div class="
        hidden items-center gap-2
        rounded-full
        border border-emerald-100
        bg-emerald-50
        px-3 py-1.5
        md:flex
      ">

        <span class="
          h-2 w-2
          animate-pulse
          rounded-full
          bg-emerald-400
          shadow-[0_0_8px_rgba(52,211,153,0.6)]
        "></span>

          <span class="
          text-[9px]
          font-black
          uppercase
          tracking-wider
          text-emerald-600
        ">
          System Online
        </span>

        </div>

        <div class="
        hidden items-center gap-2
        rounded-xl
        border border-violet-100
        bg-violet-50
        px-3 py-2
        sm:flex
      ">

        <span class="text-sm">
          ⚡
        </span>

          <div>

            <div class="
            text-[9px]
            font-black
            uppercase
            tracking-wider
            text-violet-400
          ">
              XP
            </div>

            <div class="
            text-xs
            font-black
            text-violet-600
          ">
              6,800
            </div>

          </div>

        </div>

        <div class="flex items-center gap-3">

          <div class="hidden text-right sm:block">

            <div class="
            text-xs
            font-black
            text-slate-700
          ">
              FirstName SecondName
            </div>

            <div class="
            mt-0.5
            text-[9px]
            font-bold
            uppercase
            tracking-wider
            text-slate-400
          ">
              System Administrator
            </div>

          </div>

          <div class="
          flex h-10 w-10
          items-center justify-center
          overflow-hidden
          rounded-2xl
          border-2 border-white
          bg-gradient-to-br
          from-violet-400
          to-sky-400
          text-white
          shadow-md
          shadow-violet-100
        ">
          <span class="text-sm font-black">
            F
          </span>
          </div>

          <a
            data-turbo-method="delete"
            title="Sign out"
            href="/admin_users/sign_out"
            class="
            group
            flex h-10 w-10
            items-center justify-center
            rounded-xl
            border border-rose-100
            bg-rose-50
            text-rose-500
            transition
            hover:bg-rose-100
            hover:text-rose-600
          ">

            <svg
              class="h-4 w-4 transition-transform group-hover:translate-x-0.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a2 2 0 01-2 2H6a2 2 0 01-2-2V7a2 2 0 012-2h5a2 2 0 012 2v1" />
            </svg>

          </a>

        </div>

      </div>

    </div>

  </header>

  <!-- ================================================================
       PAGE CONTENT
  ================================================================= -->

  <main class="min-h-[calc(100vh-160px)]">

    <div class="
    mx-auto
    w-full
    max-w-7xl
    px-5
    pt-8
    pb-12
    sm:px-7
    lg:px-10
  ">

      <!-- BREADCRUMB -->

      <div class="
      mb-6
      flex flex-wrap
      items-center
      gap-2
      text-xs
      text-gray-400
    ">

        <a
          href="<%= admin_ecosystems_load_sources_entity_templates_entity_templates_path %>"
          class="hover:text-indigo-600">
          Entity Templates
        </a>

        <span>›</span>

        <span>
        Configuration
      </span>

        <span>›</span>

        <span class="font-medium text-indigo-500">
        <%= @entity_type&.name || "Entity Type" %>
      </span>

      </div>


      <!-- HERO -->

      <div class="mb-8">

        <div class="
        flex flex-col
        gap-6
        lg:flex-row
        lg:items-end
        lg:justify-between
      ">

          <div>

            <div class="mb-3 flex items-center gap-3">

              <div class="
              flex h-12 w-12
              items-center justify-center
              rounded-2xl
              bg-gradient-to-br
              from-indigo-500
              to-violet-500
              text-2xl
              text-white
              shadow-lg
              shadow-indigo-200
            ">
                ⚙️
              </div>

              <div>

                <div class="
                text-[10px]
                font-black
                uppercase
                tracking-[0.18em]
                text-indigo-500
              ">
                  Template Architecture
                </div>

                <h1 class="
                mt-0.5
                text-2xl
                font-black
                tracking-tight
                text-gray-900
                dark:text-white
              ">
                  Entity Configuration
                </h1>

              </div>

            </div>


            <p class="
            max-w-3xl
            text-sm
            leading-6
            text-gray-500
            dark:text-gray-400
          ">
              Define how this abstract entity is structured, which template
              powers it, which fields are visible, and how the resulting
              entity should appear throughout the encyclopedia.
            </p>

          </div>


          <!-- ACTIONS -->

          <div class="flex flex-wrap items-center gap-3">

            <a
              href="<%= admin_ecosystems_load_sources_entity_templates_entity_templates_path %>"
              class="
              inline-flex
              items-center
              justify-center
              gap-2
              rounded-xl
              border
              border-gray-200
              bg-white
              px-4
              py-2.5
              text-sm
              font-semibold
              text-gray-600
              shadow-sm
              transition
              hover:border-gray-300
              hover:bg-gray-50
            ">
              ← Back
            </a>


            <button
              type="button"
              data-action="click->entity_template_configuration#preview"
              class="
              inline-flex
              items-center
              justify-center
              gap-2
              rounded-xl
              border
              border-violet-200
              bg-violet-50
              px-4
              py-2.5
              text-sm
              font-semibold
              text-violet-700
              transition
              hover:bg-violet-100
            ">
              👁 Preview
            </button>


            <button
              type="submit"
              form="entity-template-configuration-form"
              class="
              inline-flex
              items-center
              justify-center
              gap-2
              rounded-xl
              bg-indigo-600
              px-5
              py-2.5
              text-sm
              font-semibold
              text-white
              shadow-sm
              shadow-indigo-200
              transition
              hover:-translate-y-0.5
              hover:bg-indigo-700
            ">
              💾 Save Configuration
            </button>

          </div>

        </div>

      </div>


      <!-- HEALTH CARDS -->

      <div class="mb-8 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">


        <!-- TEMPLATE -->

        <div class="
        rounded-2xl
        border border-gray-200
        bg-white
        p-5
        shadow-sm
      ">

          <div class="flex items-center justify-between">

            <div class="
            text-xs
            font-semibold
            uppercase
            tracking-wider
            text-gray-400
          ">
              Template
            </div>

            <span class="text-lg">
            🧱
          </span>

          </div>

          <div class="
          mt-2
          truncate
          text-lg
          font-black
          text-gray-900
        ">
            <%= @entity_template&.name || "Not selected" %>
          </div>

          <div class="mt-1 text-xs text-gray-400">
            Rendering structure
          </div>

        </div>


        <!-- FIELDS -->

        <div class="
        rounded-2xl
        border border-gray-200
        bg-white
        p-5
        shadow-sm
      ">

          <div class="flex items-center justify-between">

            <div class="
            text-xs
            font-semibold
            uppercase
            tracking-wider
            text-gray-400
          ">
              Fields
            </div>

            <span class="text-lg">
            🏷️
          </span>

          </div>

          <div
            class="mt-2 text-3xl font-black text-gray-900"
            data-entity_template_configuration-target="fieldCount">
            <%= @fields&.size || 0 %>
          </div>

          <div class="mt-1 text-xs text-gray-400">
            Configured attributes
          </div>

        </div>


        <!-- REQUIRED -->

        <div class="
        rounded-2xl
        border border-gray-200
        bg-white
        p-5
        shadow-sm
      ">

          <div class="flex items-center justify-between">

            <div class="
            text-xs
            font-semibold
            uppercase
            tracking-wider
            text-gray-400
          ">
              Required
            </div>

            <span class="text-lg">
            🔐
          </span>

          </div>

          <div
            class="mt-2 text-3xl font-black text-gray-900"
            data-entity_template_configuration-target="requiredCount">
            0
          </div>

          <div class="mt-1 text-xs text-gray-400">
            Mandatory fields
          </div>

        </div>


        <!-- COMPLETION -->

        <div class="
        rounded-2xl
        border border-emerald-200
        bg-gradient-to-br
        from-emerald-50
        to-white
        p-5
        shadow-sm
      ">

          <div class="flex items-center justify-between">

            <div class="
            text-xs
            font-semibold
            uppercase
            tracking-wider
            text-emerald-500
          ">
              Configuration Health
            </div>

            <span class="text-lg">
            🏆
          </span>

          </div>

          <div class="mt-2 flex items-end gap-2">

            <div
              class="
              text-3xl
              font-black
              text-emerald-600
            "
              data-entity_template_configuration-target="completion">
              0%
            </div>

          </div>

          <div class="
          mt-2
          h-1.5
          overflow-hidden
          rounded-full
          bg-emerald-100
        ">

            <div
              class="
              h-full
              w-0
              rounded-full
              bg-gradient-to-r
              from-emerald-400
              to-sky-400
              transition-all
              duration-500
            "
              data-entity_template_configuration-target="completionBar"></div>

          </div>

        </div>

      </div>


      <!-- MAIN GRID -->

      <div class="
      grid
      grid-cols-1
      gap-6
      xl:grid-cols-12
    ">


        <!-- LEFT -->

        <div class="space-y-6 xl:col-span-8">


          <!-- BASIC CONFIGURATION -->

          <section class="
          overflow-hidden
          rounded-2xl
          border border-gray-200
          bg-white
          shadow-sm
        ">

            <div class="
            border-b
            border-gray-100
            bg-gradient-to-r
            from-indigo-50
            to-white
            px-6
            py-5
          ">

              <div class="flex items-start justify-between gap-4">

                <div>

                  <div class="
                  text-[10px]
                  font-black
                  uppercase
                  tracking-[0.16em]
                  text-indigo-500
                ">
                    Step 01
                  </div>

                  <h2 class="
                  mt-1
                  text-lg
                  font-black
                  text-gray-900
                ">
                    Identity & Template
                  </h2>

                  <p class="
                  mt-1
                  text-xs
                  leading-5
                  text-gray-500
                ">
                    Decide which template controls the entity and how the
                    entity identifies itself.
                  </p>

                </div>

                <span class="
                rounded-full
                bg-indigo-100
                px-3
                py-1
                text-[10px]
                font-black
                uppercase
                tracking-wider
                text-indigo-600
              ">
                Core
              </span>

              </div>

            </div>


            <div class="space-y-6 p-6">


              <!-- ENTITY TYPE -->

              <div>

                <label
                  for="entity_type_id"
                  class="
                  mb-2
                  block
                  text-sm
                  font-semibold
                  text-gray-700
                ">
                  Entity Type
                </label>

                <select
                  id="entity_type_id"
                  name="configuration[entity_type_id]"
                  class="
                  block
                  w-full
                  rounded-xl
                  border border-gray-300
                  bg-gray-50
                  px-4
                  py-3
                  text-sm
                  focus:border-indigo-500
                  focus:ring-indigo-500
                ">

                  <option value="">
                    Select entity type
                  </option>

                  <% Array(@entity_types).each do |entity_type| %>

                    <option
                      value="<%= entity_type.id %>"
                      <%= "selected" if @entity_type&.id == entity_type.id %>>
                      <%= entity_type.name %>
                    </option>

                  <% end %>

                </select>

                <p class="mt-2 text-xs text-gray-400">
                  The abstract entity category this configuration belongs to.
                </p>

              </div>


              <!-- TEMPLATE -->

              <div>

                <label
                  for="entity_template_id"
                  class="
                  mb-2
                  block
                  text-sm
                  font-semibold
                  text-gray-700
                ">
                  Entity Template
                </label>

                <select
                  id="entity_template_id"
                  name="configuration[entity_template_id]"
                  data-action="change->entity_template_configuration#templateChanged"
                  class="
                  block
                  w-full
                  rounded-xl
                  border border-gray-300
                  bg-gray-50
                  px-4
                  py-3
                  text-sm
                  focus:border-indigo-500
                  focus:ring-indigo-500
                ">

                  <option value="">
                    Select a template
                  </option>

                  <% Array(@entity_templates).each do |template| %>

                    <option
                      value="<%= template.id %>"
                      <%= "selected" if @entity_template&.id == template.id %>>
                      <%= template.name %>
                    </option>

                  <% end %>

                </select>

                <p class="mt-2 text-xs text-gray-400">
                  The structural template used to render this abstract entity.
                </p>

              </div>


              <!-- DISPLAY NAME / SLUG -->

              <div class="
              grid
              grid-cols-1
              gap-5
              md:grid-cols-2
            ">

                <div>

                  <label
                    for="display_name"
                    class="
                    mb-2
                    block
                    text-sm
                    font-semibold
                    text-gray-700
                  ">
                    Display Name Field
                  </label>

                  <input
                    id="display_name"
                    name="configuration[display_name_field]"
                    value="<%= @configuration&.display_name_field %>"
                    placeholder="name"
                    class="
                    block
                    w-full
                    rounded-xl
                    border border-gray-300
                    bg-gray-50
                    px-4
                    py-3
                    text-sm
                    focus:border-indigo-500
                    focus:ring-indigo-500
                  ">

                  <p class="mt-2 text-xs text-gray-400">
                    Field used as the primary entity title.
                  </p>

                </div>


                <div>

                  <label
                    for="slug_field"
                    class="
                    mb-2
                    block
                    text-sm
                    font-semibold
                    text-gray-700
                  ">
                    Slug Field
                  </label>

                  <input
                    id="slug_field"
                    name="configuration[slug_field]"
                    value="<%= @configuration&.slug_field %>"
                    placeholder="slug"
                    class="
                    block
                    w-full
                    rounded-xl
                    border border-gray-300
                    bg-gray-50
                    px-4
                    py-3
                    text-sm
                    focus:border-indigo-500
                    focus:ring-indigo-500
                  ">

                  <p class="mt-2 text-xs text-gray-400">
                    Field used for URLs and stable identifiers.
                  </p>

                </div>

              </div>


              <!-- STATUS -->

              <div class="
              flex
              items-center
              justify-between
              rounded-xl
              border
              border-emerald-100
              bg-emerald-50
              p-4
            ">

                <div class="flex items-start gap-3">

                <span class="text-lg">
                  🟢
                </span>

                  <div>

                    <div class="
                    text-sm
                    font-bold
                    text-gray-900
                  ">
                      Configuration active
                    </div>

                    <div class="
                    mt-1
                    text-xs
                    text-gray-500
                  ">
                      This configuration can be used when building entities.
                    </div>

                  </div>

                </div>


                <label class="relative inline-flex cursor-pointer items-center">

                  <input
                    type="checkbox"
                    name="configuration[active]"
                    value="1"
                    class="peer sr-only"
                    <%= "checked" unless @configuration.respond_to?(:active) && !@configuration.active %>>

                  <div class="
                  h-6
                  w-11
                  rounded-full
                  bg-gray-200
                  after:absolute
                  after:left-[2px]
                  after:top-[2px]
                  after:h-5
                  after:w-5
                  after:rounded-full
                  after:border
                  after:border-gray-300
                  after:bg-white
                  after:transition-all
                  peer-checked:bg-emerald-500
                  peer-checked:after:translate-x-full
                  peer-checked:after:border-white
                "></div>

                </label>

              </div>

            </div>

          </section>


          <!-- FIELD CONFIGURATION -->

          <section class="
          overflow-hidden
          rounded-2xl
          border border-gray-200
          bg-white
          shadow-sm
        ">

            <div class="
            border-b
            border-gray-100
            bg-gradient-to-r
            from-violet-50
            to-white
            px-6
            py-5
          ">

              <div class="
              flex
              flex-col
              gap-4
              sm:flex-row
              sm:items-center
              sm:justify-between
            ">

                <div>

                  <div class="
                  text-[10px]
                  font-black
                  uppercase
                  tracking-[0.16em]
                  text-violet-500
                ">
                    Step 02
                  </div>

                  <h2 class="
                  mt-1
                  text-lg
                  font-black
                  text-gray-900
                ">
                    Entity Fields
                  </h2>

                  <p class="
                  mt-1
                  text-xs
                  leading-5
                  text-gray-500
                ">
                    Choose which attributes appear on the entity and control
                    their order and validation.
                  </p>

                </div>


                <button
                  type="button"
                  data-action="click->entity_template_configuration#addField"
                  class="
                  inline-flex
                  items-center
                  justify-center
                  gap-2
                  rounded-xl
                  bg-violet-600
                  px-4
                  py-2.5
                  text-sm
                  font-semibold
                  text-white
                  transition
                  hover:bg-violet-700
                ">
                  <span>+</span>
                  Add Field
                </button>

              </div>

            </div>


            <!-- SEARCH / SORT -->

            <div class="
            border-b
            border-gray-100
            bg-gray-50/70
            p-4
          ">

              <div
                class="
                grid
                grid-cols-1
                gap-3
                md:grid-cols-12
              ">

                <div class="relative md:col-span-6">

                  <input
                    type="search"
                    placeholder="Search configured fields..."
                    data-action="input->entity_template_configuration#searchFields"
                    data-entity_template_configuration-target="fieldSearch"
                    class="
                    w-full
                    rounded-xl
                    border border-gray-200
                    bg-white
                    px-4
                    py-2.5
                    pl-10
                    text-sm
                    focus:border-violet-500
                    focus:ring-violet-500
                  ">

                  <span class="
                  pointer-events-none
                  absolute
                  left-3
                  top-1/2
