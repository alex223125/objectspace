============================================================================ %>

<body class="bg-slate-50 dark:bg-gray-900"> <div class="min-h-screen" data-controller="entity_template_configuration" data-entity_template_configuration-preview-url-value="<%= request.path %>"> <!-- ================================================================ SIDEBAR ================================================================= --> <aside class=" fixed inset-y-0 left-0 z-40 w-72 border-r border-slate-200 bg-white dark:border-gray-800 dark:bg-gray-900 ">
