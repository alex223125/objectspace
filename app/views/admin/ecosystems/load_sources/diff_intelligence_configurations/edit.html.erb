<div
  class="max-w-6xl mx-auto my-10 px-4"
  data-controller="diff-intelligence-configuration"
>

  <!-- ========================================================= -->
  <!-- HEADER -->
  <!-- ========================================================= -->

  <div
    class="
      overflow-hidden
      rounded-[38px]
      border-2 border-orange-100
      bg-gradient-to-b
      from-white
      via-orange-50/20
      to-slate-50/50
      shadow-md
      shadow-orange-100/40
    "
  >

    <div class="p-8">

      <!-- ======================================================= -->
      <!-- TITLE -->
      <!-- ======================================================= -->

      <div
        class="
          flex flex-col gap-5
          lg:flex-row
          lg:items-center
          lg:justify-between
          mb-8
          pb-6
          border-b-2 border-orange-100
        "
      >

        <div class="flex items-start gap-4">

          <div
            class="
              flex
              h-12 w-12
              shrink-0
              items-center justify-center
              rounded-2xl
              border border-orange-200/70
              bg-orange-100
              text-xl
              shadow-sm
            "
          >
            🧠
          </div>

          <div>

            <div
              class="
                text-[11px]
                font-black
                uppercase
                tracking-[0.18em]
                text-orange-500
              "
            >
              Diff Intelligence
            </div>

            <h1
              class="
                mt-1
                text-2xl
                font-black
                tracking-tight
                text-slate-800
              "
            >
              Identity Configuration
            </h1>

            <p
              class="
                mt-2
                max-w-2xl
                text-sm
                leading-6
                font-medium
                text-slate-400
              "
            >
              Teach the semantic comparison engine how to recognize
              objects inside arrays without relying on their position.
            </p>

          </div>

        </div>


        <!-- Status -->

        <div
          class="
            inline-flex
            w-fit
            items-center
            gap-2
            rounded-full
            border
            border-emerald-200
            bg-emerald-50
            px-4 py-2
            text-xs
            font-black
            text-emerald-700
            shadow-sm
          "
        >

          <span
            class="
              h-2 w-2
              rounded-full
              bg-emerald-400
              shadow-[0_0_8px_rgba(52,211,153,0.7)]
            "
          ></span>

          Read-only comparison

        </div>

      </div>


      <!-- ======================================================= -->
      <!-- FLASH -->
      <!-- ======================================================= -->

      <% if flash[:notice].present? %>

        <div
          class="
            mb-6
            rounded-2xl
            border-2 border-emerald-100
            bg-emerald-50
            px-5 py-4
            text-sm
            font-bold
            text-emerald-700
          "
        >
          <div class="flex items-center gap-3">

            <span class="text-lg">✨</span>

            <span>
              <%= flash[:notice] %>
            </span>

          </div>
        </div>

      <% end %>


      <% if flash[:alert].present? %>

        <div
          class="
            mb-6
            rounded-2xl
            border-2 border-red-100
            bg-red-50
            px-5 py-4
            text-sm
            font-bold
            text-red-700
          "
        >
          <div class="flex items-center gap-3">

            <span class="text-lg">⚠️</span>

            <span>
              <%= flash[:alert] %>
            </span>

          </div>
        </div>

      <% end %>


      <!-- ======================================================= -->
      <!-- CONFIGURATION EXPLANATION -->
      <!-- ======================================================= -->

      <div
        class="
          mb-8
          rounded-[28px]
          border-2 border-orange-100
          bg-gradient-to-r
          from-orange-50/80
          via-white
          to-sky-50/50
          p-6
          shadow-sm
        "
      >

        <div class="flex items-start gap-4">

          <div
            class="
              flex
              h-11 w-11
              shrink-0
              items-center justify-center
              rounded-2xl
              border border-orange-200
              bg-orange-100
              text-lg
            "
          >
            🎯
          </div>

          <div>

            <div
              class="
                text-sm
                font-black
                text-slate-700
              "
            >
              Teach the engine object identity
            </div>

            <p
              class="
                mt-2
                max-w-4xl
                text-xs
                leading-6
                font-medium
                text-slate-400
              "
            >
              Configure the field that uniquely identifies each object
              inside an array. Once configured, the comparison engine can
              match objects across versions even when their array positions
              change.
            </p>

          </div>

        </div>


        <!-- Example -->

        <div
          class="
            mt-5
            grid
            gap-3
            md:grid-cols-3
          "
        >

          <div
            class="
              rounded-2xl
              border border-sky-100
              bg-sky-50/70
              p-4
            "
          >

            <div
              class="
                text-[9px]
                font-black
                uppercase
                tracking-widest
                text-sky-500
              "
            >
              Array
            </div>

            <div
              class="
                mt-2
                font-mono
                text-xs
                font-bold
                text-slate-700
              "
            >
              metadata.sources
            </div>

          </div>


          <div
            class="
              flex
              items-center
              justify-center
              text-slate-300
            "
          >
            →

          </div>


          <div
            class="
              rounded-2xl
              border border-emerald-100
              bg-emerald-50/70
              p-4
            "
          >

            <div
              class="
                text-[9px]
                font-black
                uppercase
                tracking-widest
                text-emerald-500
              "
            >
              Identity field
            </div>

            <div
              class="
                mt-2
                font-mono
                text-xs
                font-black
                text-slate-700
              "
            >
              uuid
            </div>

          </div>

        </div>

      </div>


      <!-- ======================================================= -->
      <!-- CONFIGURATION CARD -->
      <!-- ======================================================= -->

      <div
        class="
          rounded-[30px]
          border-2 border-slate-100
          bg-white
          shadow-sm
          overflow-hidden
        "
      >

        <!-- Card header -->

        <div
          class="
            flex
            flex-col
            gap-4
            border-b
            border-slate-100
            bg-slate-50/70
            px-6 py-5
            sm:flex-row
            sm:items-center
            sm:justify-between
          "
        >

          <div>

            <div
              class="
                flex
                items-center
                gap-3
              "
            >

              <span
                class="
                  flex
                  h-9 w-9
                  items-center
                  justify-center
                  rounded-xl
                  bg-violet-100
                  text-violet-600
                "
              >
                🔑
              </span>

              <div>

                <div
                  class="
                    text-sm
                    font-black
                    text-slate-700
                  "
                >
                  Array identity rules
                </div>

                <div
                  class="
                    mt-0.5
                    text-[11px]
                    font-medium
                    text-slate-400
                  "
                >
