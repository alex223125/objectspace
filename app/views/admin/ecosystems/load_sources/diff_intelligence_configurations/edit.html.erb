              h-2.5
              overflow-hidden
              rounded-full
              border
              border-violet-100
              bg-white
            "
          >

            <div
              class="
                h-full
                w-[72%]
                rounded-full
                bg-gradient-to-r
                from-orange-400
                via-violet-400
                to-emerald-400
                shadow-sm
              "
            ></div>

          </div>

        </div>

      </div>


