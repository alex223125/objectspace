              mb-2
              flex
              items-center
              justify-between
            "
          >

            <span
              class="
                text-[9px]
                font-black
                uppercase
                tracking-widest
                text-slate-400
              "
            >
              Semantic capability
            </span>

            <span
              class="
                text-[10px]
                font-black
                text-violet-500
              "
