<div class="rounded-2xl border border-white/10 bg-white/[0.02] p-5">

  <div class="flex items-start gap-4">

    <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-cyan-400/10 text-lg">
      <%= annotation_icon(annotation.annotation_type) %>
    </div>

    <div class="min-w-0 flex-1">

      <div class="flex flex-wrap items-center gap-2">

        <h4 class="font-bold text-white">
          <%= annotation.title %>
        </h4>

        <span class="rounded-full bg-white/5 px-2 py-1 text-[10px] font-bold uppercase tracking-wider text-slate-500">
          <%= annotation.annotation_type.humanize %>
        </span>

        <span class="rounded-full px-2 py-1 text-[10px] font-bold <%= confidence_badge_class(annotation.confidence) %>">
          <%= annotation.confidence %>% confidence
        </span>

        <% if annotation.status_approved? %>
          <span class="rounded-full bg-emerald-400/10 px-2 py-1 text-[10px] font-bold text-emerald-300">
            Approved
          </span>
        <% elsif annotation.status_reviewed? %>
          <span class="rounded-full bg-blue-400/10 px-2 py-1 text-[10px] font-bold text-blue-300">
            Reviewed
          </span>
        <% end %>

      </div>

      <p class="mt-3 whitespace-pre-line text-sm leading-6 text-slate-400">
        <%= annotation.body %>
      </p>

      <% if annotation.reviewer_name.present? %>
        <div class="mt-3 text-xs text-slate-600">
          Reviewed by
          <span class="font-semibold text-slate-400">
            <%= annotation.reviewer_name %>
          </span>
        </div>
      <% end %>

      <% if annotation.reviewer_notes.present? %>
        <div class="mt-3 rounded-xl bg-black/20 p-3 text-xs leading-5 text-slate-500">
          <strong class="text-slate-400">
            Reviewer notes:
          </strong>

          <%= annotation.reviewer_notes %>
        </div>
      <% end %>

      <% if annotation.research_evidences.active.any? %>

        <div class="mt-5 space-y-2">

          <div class="text-[10px] font-bold uppercase tracking-wider text-slate-600">
            Supporting evidence
          </div>

          <% annotation.research_evidences.active.recent.each do |evidence| %>

            <div class="rounded-xl border border-white/5 bg-black/20 p-3">

              <div class="flex items-start gap-3">

                <div class="text-base">
                  <%= evidence_icon(evidence.evidence_type) %>
                </div>

                <div class="min-w-0 flex-1">

                  <div class="font-semibold text-slate-300">
                    <%= evidence.title %>
                  </div>

                  <% if evidence.source_url.present? %>
                    <%= link_to evidence.display_source,
                                evidence.source_url,
                                target: "_blank",
                                rel: "noopener noreferrer",
                                class: "mt-1 block text-xs text-cyan-400 hover:text-cyan-300" %>
                  <% elsif evidence.source_name.present? %>
                    <div class="mt-1 text-xs text-slate-600">
                      <%= evidence.source_name %>
                    </div>
                  <% end %>

                  <% if evidence.excerpt.present? %>
                    <blockquote class="mt-3 border-l-2 border-white/10 pl-3 text-xs leading-5 text-slate-500">
                      <%= evidence.excerpt %>
                    </blockquote>
                  <% end %>

                  <div class="mt-3 flex flex-wrap gap-2 text-[10px] text-slate-600">

                    <span>
                      <%= evidence.confidence %>% confidence
                    </span>

                    <% if evidence.published_on.present? %>
                      <span>
                        Published <%= evidence.published_on.strftime("%b %d, %Y") %>
                      </span>
                    <% end %>

                  </div>

                </div>

              </div>

            </div>

          <% end %>

        </div>

      <% end %>

    </div>

    <div class="shrink-0">

      <%= button_to "×",
                    admin_research_workspace_item_annotation_path(
                      workspace,
                      annotation.research_workspace_item,
                      annotation
                    ),
                    method: :delete,
                    data: {
                      turbo_confirm: "Remove this annotation?"
                    },
                    class: "rounded-lg px-2 py-1 text-slate-600 hover:bg-rose-500/10 hover:text-rose-300" %>

    </div>

  </div>

</div>