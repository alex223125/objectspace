<div class="mx-auto max-w-7xl px-6 py-10">
  <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <div class="text-xs font-bold uppercase tracking-[0.2em] text-orange-400">
        Research
      </div>

      <h1 class="mt-2 text-4xl font-black tracking-tight text-white">
        Saved investigations
      </h1>

      <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-500">
        Resume active investigations, review completed research, and inspect
        historical research checkpoints.
      </p>
    </div>

    <%= link_to "Research workspaces",
                admin_research_workspaces_path,
                class: "rounded-2xl bg-white/5 px-5 py-3 text-sm font-bold text-slate-300 hover:bg-white/10 hover:text-white" %>
  </div>

  <div class="mt-8 grid gap-4 sm:grid-cols-3">
    <div class="rounded-3xl border border-white/10 bg-white/[0.03] p-5">
      <div class="text-3xl font-black text-emerald-300">
        <%= @active_workspaces.length %>
      </div>

      <div class="mt-1 text-xs font-bold uppercase tracking-wider text-slate-600">
        Active
      </div>
    </div>

    <div class="rounded-3xl border border-white/10 bg-white/[0.03] p-5">
      <div class="text-3xl font-black text-sky-300">
        <%= @completed_workspaces.length %>
      </div>

      <div class="mt-1 text-xs font-bold uppercase tracking-wider text-slate-600">
        Completed
      </div>
    </div>

    <div class="rounded-3xl border border-white/10 bg-white/[0.03] p-5">
      <div class="text-3xl font-black text-slate-300">
        <%= @archived_workspaces.length %>
      </div>

      <div class="mt-1 text-xs font-bold uppercase tracking-wider text-slate-600">
        Archived
      </div>
    </div>
  </div>

  <div class="mt-10">
    <div class="mb-4 flex items-center justify-between">
      <div>
        <h2 class="text-xl font-black text-white">
          All investigations
        </h2>

        <p class="mt-1 text-sm text-slate-600">
          Your saved research work and its current lifecycle state.
        </p>
      </div>
    </div>

    <% if @workspaces.any? %>
      <div class="grid gap-4">
        <%= render partial: "investigation",
                   collection: @workspaces,
                   as: :workspace %>
      </div>
    <% else %>
      <div class="rounded-3xl border border-dashed border-white/10 bg-white/[0.02] p-10 text-center">
        <div class="text-4xl">🔬</div>

        <h3 class="mt-4 font-bold text-white">
          No saved investigations yet
        </h3>

        <p class="mt-2 text-sm text-slate-600">
          Start a research workspace and it will appear here.
        </p>
      </div>
    <% end %>
  </div>
</div>