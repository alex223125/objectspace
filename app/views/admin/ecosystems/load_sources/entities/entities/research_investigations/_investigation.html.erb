<div class="rounded-3xl border border-white/10 bg-white/[0.03] p-5 transition hover:border-white/20">
  <div class="flex flex-col gap-5 lg:flex-row lg:items-center lg:justify-between">
    <div class="min-w-0">
      <div class="flex flex-wrap items-center gap-2">
        <span class="rounded-full px-2.5 py-1 text-[10px] font-black uppercase tracking-wider <%= workspace_status_color(workspace.status) %>">
          <%= workspace_status_icon(workspace.status) %>
          <%= workspace.status %>
        </span>

        <% if workspace.snapshot_count.positive? %>
          <span class="rounded-full bg-purple-500/10 px-2.5 py-1 text-[10px] font-bold text-purple-300">
            <%= workspace.snapshot_count %> checkpoints
          </span>
        <% end %>
      </div>

      <h3 class="mt-3 truncate text-xl font-black text-white">
        <%= workspace.title %>
      </h3>

      <p class="mt-1 text-xs text-slate-600">
        /<%= workspace.slug %>
      </p>

      <div class="mt-4 flex flex-wrap gap-4 text-xs text-slate-500">
        <span>
          <strong class="text-slate-300">
            <%= workspace.items.size %>
          </strong>
          items
        </span>

        <span>
          <strong class="text-slate-300">
            <%= workspace.annotation_count %>
          </strong>
          annotations
        </span>

        <span>
          <strong class="text-slate-300">
            <%= workspace.evidence_count %>
          </strong>
          evidence
        </span>

        <span>
          <strong class="text-orange-300">
            <%= workspace.research_strength %>%
          </strong>
          strength
        </span>
      </div>
    </div>

    <div class="flex flex-wrap gap-2">
      <%= link_to "Open",
                  admin_research_workspace_path(workspace),
                  class: "rounded-xl bg-orange-500 px-4 py-2.5 text-xs font-black text-white hover:bg-orange-400" %>

      <%= link_to "History",
                  admin_research_investigation_path(workspace),
                  class: "rounded-xl bg-white/5 px-4 py-2.5 text-xs font-bold text-slate-400 hover:bg-white/10 hover:text-white" %>

      <% if workspace.archived? %>
        <%= button_to "Resume",
                      resume_admin_research_investigation_path(workspace),
                      method: :patch,
                      class: "rounded-xl bg-emerald-500/10 px-4 py-2.5 text-xs font-bold text-emerald-300 hover:bg-emerald-500/20" %>
      <% elsif workspace.active? %>
        <%= button_to "Complete",
                      complete_admin_research_investigation_path(workspace),
                      method: :patch,
                      data: {
                        turbo_confirm: "Mark this investigation as completed?"
                      },
                      class: "rounded-xl bg-sky-500/10 px-4 py-2.5 text-xs font-bold text-sky-300 hover:bg-sky-500/20" %>
      <% elsif workspace.completed? %>
        <%= button_to "Reopen",
                      reopen_admin_research_investigation_path(workspace),
                      method: :patch,
                      class: "rounded-xl bg-emerald-500/10 px-4 py-2.5 text-xs font-bold text-emerald-300 hover:bg-emerald-500/20" %>
      <% end %>
    </div>
  </div>
</div>