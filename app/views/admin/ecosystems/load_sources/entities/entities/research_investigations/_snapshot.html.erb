<div class="rounded-3xl border border-white/10 bg-white/[0.03] p-5">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <div class="flex flex-wrap items-center gap-2">
        <span class="rounded-full px-2.5 py-1 text-[10px] font-black uppercase tracking-wider <%= snapshot_reason_color(snapshot.reason) %>">
          <%= snapshot.reason_label %>
        </span>

        <span class="text-xs text-slate-600">
          <%= snapshot.created_at.strftime("%Y-%m-%d %H:%M") %>
        </span>
      </div>

      <h3 class="mt-3 font-black text-white">
        <%= snapshot.name %>
      </h3>

      <% if snapshot.description.present? %>
        <p class="mt-1 text-sm leading-6 text-slate-500">
          <%= snapshot.description %>
        </p>
      <% end %>
    </div>

    <%= link_to "Inspect",
                admin_research_workspace_snapshot_path(
                  @workspace,
                  snapshot
                ),
                class: "rounded-xl bg-white/5 px-4 py-2.5 text-xs font-bold text-slate-400 hover:bg-white/10 hover:text-white" %>
  </div>

  <div class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-5">
    <div>
      <div class="text-lg font-black text-white">
        <%= snapshot.item_count %>
      </div>
      <div class="text-[10px] font-bold uppercase tracking-wider text-slate-600">
        Items
      </div>
    </div>

    <div>
      <div class="text-lg font-black text-white">
        <%= snapshot.annotation_count %>
      </div>
      <div class="text-[10px] font-bold uppercase tracking-wider text-slate-600">
        Notes
      </div>
    </div>

    <div>
      <div class="text-lg font-black text-white">
        <%= snapshot.evidence_count %>
      </div>
      <div class="text-[10px] font-bold uppercase tracking-wider text-slate-600">
        Evidence
      </div>
    </div>

    <div>
      <div class="text-lg font-black text-emerald-300">
        <%= snapshot.verified_evidence_count %>
      </div>
      <div class="text-[10px] font-bold uppercase tracking-wider text-slate-600">
        Verified
      </div>
    </div>

    <div>
      <div class="text-lg font-black text-orange-300">
        <%= snapshot.research_strength %>%
      </div>
      <div class="text-[10px] font-bold uppercase tracking-wider text-slate-600">
        Strength
      </div>
    </div>
  </div>
</div>