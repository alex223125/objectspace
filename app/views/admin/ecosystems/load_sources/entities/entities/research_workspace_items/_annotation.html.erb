<div class="rounded-3xl border border-white/10 bg-white/[0.03] p-5">

  <div class="flex items-start justify-between gap-4">

    <div class="min-w-0">

      <div class="flex flex-wrap items-center gap-2">

        <span class="rounded-full bg-orange-400/10 px-2 py-1 text-[10px] font-bold uppercase tracking-wider text-orange-300">
          <%= annotation.kind.humanize %>
        </span>

        <span class="rounded-full bg-white/5 px-2 py-1 text-[10px] font-bold uppercase tracking-wider text-slate-500">
          <%= annotation.confidence.humanize %> confidence
        </span>

        <% if annotation.verified? %>
          <span class="rounded-full bg-emerald-400/10 px-2 py-1 text-[10px] font-bold text-emerald-300">
            Verified
          </span>
        <% end %>

      </div>

      <h3 class="mt-3 font-black">
        <%= annotation.title %>
      </h3>

    </div>

    <%= button_to "Delete",
                  admin_research_workspace_item_annotation_path(
                    workspace,
                    item,
                    annotation
                  ),
                  method: :delete,
                  data: {
                    turbo_confirm: "Delete this annotation?"
                  },
                  class: "shrink-0 text-xs font-bold text-slate-600 transition hover:text-red-400" %>

  </div>

  <p class="mt-3 whitespace-pre-line text-sm leading-6 text-slate-400">
    <%= annotation.body %>
  </p>

  <% if annotation.reviewer_name.present? %>
    <div class="mt-4 border-t border-white/5 pt-3 text-xs text-slate-600">
      Reviewed by
      <span class="font-semibold text-slate-400">
        <%= annotation.reviewer_name %>
      </span>

      <% if annotation.reviewed_at.present? %>
        on
        <%= l(annotation.reviewed_at, format: :short) %>
      <% end %>
    </div>
  <% end %>

  <% if annotation.reviewer_note.present? %>
    <div class="mt-3 rounded-2xl bg-black/20 p-3 text-xs leading-5 text-slate-500">
      <span class="font-bold text-slate-400">
        Reviewer note:
      </span>

      <%= annotation.reviewer_note %>
    </div>
  <% end %>

  <% if annotation.research_evidences.exists? %>
    <div class="mt-4 text-xs font-bold text-cyan-400">
      <%= annotation.research_evidences.count %>
      supporting
      <%= "source".pluralize(annotation.research_evidences.count) %>
    </div>
  <% end %>

</div>