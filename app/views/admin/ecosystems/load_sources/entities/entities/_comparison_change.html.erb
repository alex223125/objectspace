<article
  data-comparison-change
  data-change-type="<%= change[:type] || change["type"] %>"
  data-path="<%= change[:path] || change["path"] %>"
  class="
    group
    relative
    overflow-hidden
    rounded-[24px]
    border
    border-slate-200
    bg-white
    p-5
    shadow-sm
    transition-all
    duration-300
    hover:-translate-y-0.5
    hover:shadow-lg
  ">

  <div class="flex items-start justify-between gap-4">

    <div class="min-w-0">

      <div class="flex flex-wrap items-center gap-2">

        <span
          class="
            rounded-full
            bg-slate-100
            px-2.5
            py-1
            text-[9px]
            font-black
            uppercase
            tracking-widest
            text-slate-500
          ">
          <%= change[:type] || change["type"] || "changed" %>
        </span>

        <% if change[:path].present? || change["path"].present? %>

          <code
            class="
              max-w-full
              truncate
              rounded-lg
              bg-slate-50
              px-2
              py-1
              text-[10px]
              font-semibold
              text-slate-500
            ">
            <%= change[:path] || change["path"] %>
          </code>

        <% end %>

      </div>


      <div class="mt-4">

        <div class="text-sm font-black text-slate-700">
          <%= change[:label] || change["label"] || "Comparison change" %>
        </div>

        <% description = change[:description] || change["description"] %>

        <% if description.present? %>

          <p class="mt-1 text-xs leading-5 text-slate-400">
            <%= description %>
          </p>

        <% end %>

      </div>

    </div>


    <button
      type="button"
      data-comparison-review-button
      aria-pressed="false"
      class="
        shrink-0
        rounded-xl
        border
        border-slate-200
        bg-white
        px-3
        py-2
        text-[10px]
        font-black
        text-slate-500
        shadow-sm
        transition-all
        hover:border-violet-200
        hover:bg-violet-50
        hover:text-violet-600
      ">
      Review
    </button>

  </div>


  <% if change[:identity_warning] || change["identity_warning"] %>

    <div
      data-identity-warning
      data-risk="high"
      class="
        mt-4
        rounded-xl
        border
        border-amber-200
        bg-amber-50
        px-4
        py-3
      ">

      <div class="flex items-center gap-2">

        <span>⚠️</span>

        <span class="text-[10px] font-black text-amber-700">
          Identity warning
        </span>

      </div>

      <p class="mt-1 text-[11px] leading-5 text-amber-600">
        This change may affect entity identity or source matching.
      </p>

    </div>

  <% end %>


  <div class="mt-5 grid grid-cols-2 gap-3">

    <div class="rounded-xl bg-slate-50 p-3">

      <div class="text-[9px] font-black uppercase tracking-widest text-slate-400">
        Previous
      </div>

      <div class="mt-1 break-words text-xs font-semibold text-slate-600">
        <%= change[:old_value] || change["old_value"] || "—" %>
      </div>

    </div>


    <div class="rounded-xl bg-violet-50 p-3">

      <div class="text-[9px] font-black uppercase tracking-widest text-violet-400">
        Current
      </div>

      <div class="mt-1 break-words text-xs font-semibold text-violet-700">
        <%= change[:new_value] || change["new_value"] || "—" %>
      </div>

    </div>

  </div>

</article>