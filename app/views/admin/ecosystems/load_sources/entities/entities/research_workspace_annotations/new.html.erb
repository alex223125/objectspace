<div class="mx-auto max-w-3xl px-6 py-10">

  <div class="mb-8">
    <div class="text-xs font-bold uppercase tracking-[0.2em] text-orange-400">
      Evidence / provenance
    </div>

    <h1 class="mt-2 text-3xl font-black text-white">
      Add evidence
    </h1>

    <p class="mt-2 text-sm leading-6 text-slate-500">
      Record the source, publication, dataset, interview, document, or internal
      material supporting this research item.
    </p>
  </div>

  <div class="rounded-3xl border border-white/10 bg-white/[0.03] p-6">
    <%= render "form" %>
  </div>

</div>