<div class="rounded-3xl border border-white/10 bg-white/[0.03] p-5">
  <div class="flex items-start gap-4">
    <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-white/5 text-lg <%= snapshot_event_color(snapshot.event_type) %>">
      <%= snapshot_event_icon(snapshot.event_type) %>
    </div>

    <div class="min-w-0 flex-1">
      <div class="flex flex-wrap items-center gap-2">
        <h3 class="font-bold text-white">
          <%= snapshot.title %>
        </h3>

        <span class="rounded-full bg-white/5 px-2 py-1 text-[10px] font-bold uppercase tracking-wider <%= snapshot_event_color(snapshot.event_type) %>">
          <%= snapshot.event_label %>
        </span>
      </div>

      <div class="mt-2 text-xs text-slate-600">
        Snapshot #<%= snapshot.sequence %>
        ·
        <%= snapshot.created_label %>
      </div>

      <% if snapshot.description.present? %>
        <p class="mt-3 text-sm leading-6 text-slate-500">
          <%= snapshot.description %>
        </p>
      <% end %>

      <div class="mt-4 flex flex-wrap gap-3 text-xs text-slate-600">
        <span>
          <strong class="text-slate-400">
            <%= snapshot.item_count %>
          </strong>
          items
        </span>

        <span>
          <strong class="text-slate-400">
            <%= snapshot.annotation_count %>
          </strong>
          annotations
        </span>

        <span>
          <strong class="text-slate-400">
            <%= snapshot.evidence_count %>
          </strong>
          evidence
        </span>
      </div>

      <div class="mt-5 flex flex-wrap gap-2">
        <%= link_to "Inspect",
                    admin_research_workspace_snapshot_path(
                      workspace,
                      snapshot
                    ),
                    class: "rounded-xl bg-white/5 px-3 py-2 text-xs font-bold text-slate-400 hover:bg-white/10 hover:text-white" %>

        <%= button_to "Restore",
                      restore_admin_research_workspace_snapshot_path(
                        workspace,
                        snapshot
                      ),
                      method: :post,
                      data: {
                        turbo_confirm: "Restore this snapshot? Current workspace records will be replaced by the snapshot."
                      },
                      class: "rounded-xl bg-purple-500/10 px-3 py-2 text-xs font-bold text-purple-300 hover:bg-purple-500/20" %>
      </div>
    </div>
  </div>
</div>