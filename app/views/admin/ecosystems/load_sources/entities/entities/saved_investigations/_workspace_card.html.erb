<div class="rounded-3xl border border-white/10 bg-white/[0.03] p-6 transition hover:border-white/20">
  <div class="flex items-start justify-between gap-4">
    <div class="min-w-0">
      <div class="flex flex-wrap items-center gap-2">
        <span class="rounded-full border px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider <%= investigation_status_color(workspace.status) %>">
          <%= investigation_status_icon(workspace.status) %>
          <%= workspace.lifecycle_label %>
        </span>

        <% if workspace.snapshot_count.positive? %>
          <span class="rounded-full bg-white/5 px-2.5 py-1 text-[10px] font-bold text-slate-500">
            <%= workspace.snapshot_count %> snapshots
          </span>
        <% end %>
      </div>

      <h2 class="mt-3 truncate text-xl font-black text-white">
        <%= workspace.title %>
      </h2>

      <p class="mt-2 text-xs text-slate-600">
        <%= workspace.slug %>
      </p>
    </div>

    <div class="shrink-0 text-right">
      <div class="text-2xl font-black text-orange-300">
        <%= workspace.research_strength %>%
      </div>

      <div class="text-[10px] font-bold uppercase tracking-wider text-slate-600">
        strength
      </div>
    </div>
  </div>

  <div class="mt-6 grid grid-cols-2 gap-2 sm:grid-cols-4">
    <%= render "metric",
               value: workspace.items.count,
               label: "Items" %>

    <%= render "metric",
               value: workspace.annotation_count,
               label: "Notes" %>

    <%= render "metric",
               value: workspace.evidence_count,
               label: "Evidence" %>

    <%= render "metric",
               value: "#{workspace.progress}%",
               label: "Progress" %>
  </div>

  <div class="mt-6">
    <div class="mb-2 flex justify-between text-xs">
      <span class="text-slate-600">
        Research progress
      </span>

      <strong class="text-slate-400">
        <%= workspace.progress %>%
      </strong>
    </div>

    <div class="h-2 overflow-hidden rounded-full bg-white/5">
      <div
        class="h-full rounded-full bg-orange-500"
        style="width: <%= workspace.progress %>%">
      </div>
    </div>
  </div>

  <div class="mt-6 flex flex-wrap gap-2">
    <%= link_to "Open investigation",
                admin_saved_investigation_path(workspace),
                class: "rounded-xl bg-orange-500 px-4 py-2.5 text-xs font-bold text-white hover:bg-orange-400" %>

    <%= link_to "Workspace",
                admin_research_workspace_path(workspace),
                class: "rounded-xl bg-white/5 px-4 py-2.5 text-xs font-bold text-slate-400 hover:bg-white/10 hover:text-white" %>
  </div>

  <% if workspace.last_resumed_at.present? %>
    <div class="mt-4 text-[11px] text-slate-700">
      Last resumed
      <%= time_ago_in_words(workspace.last_resumed_at) %> ago
    </div>
  <% end %>
</div>