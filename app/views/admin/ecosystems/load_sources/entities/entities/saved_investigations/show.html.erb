<div class="mx-auto max-w-7xl px-6 py-10">
  <div class="flex flex-col gap-6 lg:flex-row lg:items-start lg:justify-between">
    <div>
      <div class="flex flex-wrap items-center gap-2">
        <span class="rounded-full border px-3 py-1 text-[10px] font-bold uppercase tracking-wider <%= investigation_status_color(@workspace.status) %>">
          <%= investigation_status_icon(@workspace.status) %>
          <%= @workspace.lifecycle_label %>
        </span>

        <span class="rounded-full bg-white/5 px-3 py-1 text-[10px] font-bold uppercase tracking-wider text-slate-500">
          <%= @workspace.snapshot_count %> snapshots
        </span>
      </div>

      <h1 class="mt-4 text-3xl font-black text-white">
        <%= @workspace.title %>
      </h1>

      <p class="mt-2 text-sm text-slate-600">
        Saved research investigation
      </p>
    </div>

    <div class="flex flex-wrap gap-2">
      <%= link_to "Open workspace",
                  admin_research_workspace_path(@workspace),
                  class: "rounded-2xl bg-orange-500 px-5 py-3 text-sm font-bold text-white hover:bg-orange-400" %>

      <%= button_to "Save checkpoint",
                    snapshot_admin_saved_investigation_path(@workspace),
                    method: :post,
                    class: "rounded-2xl bg-white/5 px-5 py-3 text-sm font-bold text-slate-300 hover:bg-white/10 hover:text-white" %>
    </div>
  </div>

  <%= render "lifecycle_panel",
             workspace: @workspace %>

  <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-5">
    <%= render "metric",
               value: @workspace.items.count,
               label: "Items" %>

    <%= render "metric",
               value: @workspace.annotation_count,
               label: "Annotations" %>

    <%= render "metric",
               value: @workspace.evidence_count,
               label: "Evidence" %>

    <%= render "metric",
               value: @workspace.verified_evidence_count,
               label: "Verified" %>

    <%= render "metric",
               value: "#{@workspace.research_strength}%",
               label: "Strength" %>
  </div>

  <div class="mt-10">
    <div class="mb-5">
      <div class="text-xs font-bold uppercase tracking-[0.2em] text-orange-400">
        Research history
      </div>

      <h2 class="mt-2 text-xl font-black text-white">
        Investigation timeline
      </h2>
    </div>

    <% if @snapshots.any? %>
      <div class="space-y-4">
        <% @snapshots.each do |snapshot| %>
          <%= render "snapshot_card",
                     workspace: @workspace,
                     snapshot: snapshot %>
        <% end %>
      </div>
    <% else %>
      <div class="rounded-3xl border border-dashed border-white/10 p-8 text-center text-sm text-slate-600">
        No snapshots have been created yet.
      </div>
    <% end %>
  </div>
</div>