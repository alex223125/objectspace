<%
  summary =
    @diff_payload&.dig(:summary) ||
      @diff_payload&.dig("summary") ||
      {}

  total =
    summary[:total] ||
      summary["total"] ||
      0

  changes =
    summary[:changes] ||
      summary[:changed] ||
      summary["changes"] ||
      summary["changed"] ||
      0

  movements =
    summary[:movements] ||
      summary[:moved] ||
      summary["movements"] ||
      summary["moved"] ||
      0

  additions =
    summary[:additions] ||
      summary[:added] ||
      summary["additions"] ||
      summary["added"] ||
      0

  removals =
    summary[:removals] ||
      summary[:removed] ||
      summary["removals"] ||
      summary["removed"] ||
      0

  warnings =
    summary[:warnings] ||
      summary["warnings"] ||
      0
%>

<div class="space-y-6">

  <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">

    <div
      class="rounded-[24px]
             border border-slate-100
             bg-white
             p-5 shadow-sm">

      <div
        class="text-[9px] font-black
               uppercase tracking-widest
               text-slate-400">

        Facts discovered

      </div>

      <div
        class="mt-2 text-3xl
               font-black text-slate-700">

        <%= total %>

      </div>

    </div>


    <div
      class="rounded-[24px]
             border border-sky-100
             bg-sky-50/50
             p-5">

      <div
        class="text-[9px] font-black
               uppercase tracking-widest
               text-sky-500">

        Changed

      </div>

      <div
        class="mt-2 text-3xl
               font-black text-sky-600">

        <%= changes %>

      </div>

    </div>


    <div
      class="rounded-[24px]
             border border-emerald-100
             bg-emerald-50/50
             p-5">

      <div
        class="text-[9px] font-black
               uppercase tracking-widest
               text-emerald-500">

        Added

      </div>

      <div
        class="mt-2 text-3xl
               font-black text-emerald-600">

        <%= additions %>

      </div>

    </div>


    <div
      class="rounded-[24px]
             border border-amber-100
             bg-amber-50/50
             p-5">

      <div
        class="text-[9px] font-black
               uppercase tracking-widest
               text-amber-500">

        Signals

      </div>

      <div
        class="mt-2 text-3xl
               font-black text-amber-600">

        <%= warnings %>

      </div>

    </div>

  </div>


  <%= render(
        "comparison_achievement",
        total: total,
        changes: changes,
        warnings: warnings
      ) %>


  <%= render(
        "comparison_filters"
      ) %>


  <div class="space-y-4">

    <% facts =
         @diff_payload&.dig(:facts) ||
           @diff_payload&.dig("facts") ||
           [] %>

    <% if facts.any? %>

      <% facts.each do |fact| %>

        <%= render(
              "comparison_fact",
              fact: fact
            ) %>

      <% end %>

    <% else %>

      <div
        class="rounded-[28px]
               border-2 border-dashed
               border-slate-200
               bg-white
               p-12 text-center">

        <div
          class="text-3xl">

          ✨

        </div>

        <div
          class="mt-4 text-sm
                 font-black text-slate-700">

          This comparison is clean.

        </div>

        <p
          class="mx-auto mt-2 max-w-md
                 text-xs leading-6
                 text-slate-400">

          No differences were detected between
          the selected entity versions.

        </p>

      </div>

    <% end %>

  </div>

</div>