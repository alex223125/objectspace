<div
  class="mb-6 rounded-[26px]
         border border-slate-200
         bg-white
         p-4
         shadow-sm">

  <div class="flex flex-col gap-4 xl:flex-row xl:items-center xl:justify-between">

    <div class="flex flex-1 flex-col gap-3 md:flex-row">

      <div class="relative flex-1">

        <span
          class="pointer-events-none absolute left-4 top-1/2
                 -translate-y-1/2
                 text-slate-400">

          ⌕

        </span>

        <input
          type="search"
          data-comparison-search
          placeholder="Search paths, identities, values..."
          class="w-full rounded-2xl
                 border border-slate-200
                 bg-slate-50
                 py-3 pl-10 pr-4
                 text-sm font-medium
                 text-slate-700
                 outline-none
                 transition
                 placeholder:text-slate-400
                 focus:border-violet-300
                 focus:bg-white
                 focus:ring-4
                 focus:ring-violet-100"
        >

      </div>


      <select
        data-comparison-type-filter
        class="rounded-2xl
               border border-slate-200
               bg-slate-50
               px-4 py-3
               text-sm
               font-bold
               text-slate-600
               outline-none
               focus:border-violet-300
               focus:ring-4
               focus:ring-violet-100">

        <option value="all">
          All changes
        </option>

        <option value="content_change">
          Content changes
        </option>

        <option value="semantic_movement">
          Movements
        </option>

        <option value="added_entity">
          Additions
        </option>

        <option value="removed_entity">
          Removals
        </option>

        <option value="identity_warning">
          Identity warnings
        </option>

      </select>

    </div>


    <div class="flex items-center gap-3">

      <div
        class="rounded-2xl
               border border-violet-100
               bg-violet-50/70
               px-4 py-2.5
               text-center">

        <div
          data-comparison-visible-count
          class="text-sm font-black text-violet-700">

          0

        </div>

        <div
          class="text-[9px]
                 font-black
                 uppercase
                 tracking-widest
                 text-violet-400">

          visible

        </div>

      </div>


      <button
        type="button"
        data-comparison-reset
        class="rounded-2xl
               border border-slate-200
               bg-white
               px-4 py-3
               text-xs
               font-black
               text-slate-500
               shadow-sm
               transition
               hover:border-orange-200
               hover:bg-orange-50
               hover:text-orange-700">

        Reset filters

      </button>

    </div>

  </div>


  <div class="mt-4 flex flex-wrap items-center gap-2">

    <span
      class="text-[9px]
             font-black
             uppercase
             tracking-widest
             text-slate-400">

      Review mode

    </span>

    <span
      class="rounded-full
             border border-emerald-200
             bg-emerald-50
             px-3 py-1
             text-[10px]
             font-black
             text-emerald-700">

      ● Interactive

    </span>

    <span
      class="rounded-full
             border border-violet-200
             bg-violet-50
             px-3 py-1
             text-[10px]
             font-black
             text-violet-700">

      ✦ Progress tracking

    </span>

    <span
      class="rounded-full
             border border-orange-200
             bg-orange-50
             px-3 py-1
             text-[10px]
             font-black
             text-orange-700">

      ⚡ Keyboard navigation

    </span>

  </div>

</div>

<button
  type="button"
  class="group inline-flex items-center gap-2 rounded-2xl border border-violet-200 bg-violet-50 px-4 py-2.5 text-[11px] font-black text-violet-700 shadow-sm transition-all duration-300 hover:-translate-y-0.5 hover:border-violet-300 hover:bg-violet-100 hover:shadow-md"
  onclick="document.querySelector('[data-controller~=&quot;comparison-intelligence&quot;]')?.scrollIntoView({ behavior: 'smooth', block: 'start' })">

  <span class="transition-transform duration-300 group-hover:scale-110">
    🧠
  </span>

  <span>
    Intelligence
  </span>

  <span class="text-violet-400">
    →
  </span>

</button>
