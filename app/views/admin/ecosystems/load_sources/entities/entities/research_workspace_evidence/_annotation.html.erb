<div class="rounded-2xl border border-white/10 bg-black/10 p-4">

  <div class="flex items-start gap-3">

    <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-orange-500/10 text-orange-300">
      🧠
    </div>

    <div class="min-w-0 flex-1">

      <div class="flex flex-wrap items-center gap-2">

        <span class="text-[10px] font-bold uppercase tracking-wider text-orange-300">
          <%= annotation.type_label %>
        </span>

        <span class="rounded-full bg-white/5 px-2 py-1 text-[10px] font-bold text-slate-500">
          <%= annotation.confidence_label %> confidence
        </span>

        <% if annotation.important? %>
          <span class="rounded-full bg-amber-400/10 px-2 py-1 text-[10px] font-bold text-amber-300">
            Important
          </span>
        <% end %>

      </div>

      <% if annotation.title.present? %>
        <h5 class="mt-2 font-bold text-white">
          <%= annotation.title %>
        </h5>
      <% end %>

      <p class="mt-2 whitespace-pre-line text-sm leading-6 text-slate-400">
        <%= annotation.body %>
      </p>

      <% if annotation.author_name.present? %>
        <div class="mt-3 text-xs text-slate-600">
          <span class="font-semibold text-slate-400">
            <%= annotation.author_name %>
          </span>

          <% if annotation.author_role.present? %>
            · <%= annotation.author_role %>
          <% end %>
        </div>
      <% end %>

    </div>

    <%= button_to "×",
                  admin_research_workspace_item_annotation_path(
                    workspace,
                    item,
                    annotation
                  ),
                  method: :delete,
                  class: "shrink-0 text-lg text-slate-600 transition hover:text-red-400",
                  form: {
                    data: {
                      turbo_confirm: "Remove this annotation?"
                    }
                  } %>

  </div>

</div>