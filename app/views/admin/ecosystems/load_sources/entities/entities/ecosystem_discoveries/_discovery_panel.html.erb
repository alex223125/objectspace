<section
  class="relative overflow-hidden rounded-[36px] border border-orange-200/70 bg-gradient-to-br from-orange-50 via-white to-violet-50 p-6 shadow-sm"
  data-controller="discovery"
>
  <div class="absolute -right-20 -top-20 h-48 w-48 rounded-full bg-orange-200/30 blur-3xl"></div>
  <div class="absolute -bottom-20 -left-20 h-48 w-48 rounded-full bg-violet-200/30 blur-3xl"></div>

  <div class="relative">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <div class="mb-2 flex items-center gap-2">
          <span class="rounded-full bg-orange-100 px-3 py-1 text-xs font-bold uppercase tracking-[0.18em] text-orange-700">
            Discovery
          </span>

          <span class="rounded-full bg-emerald-100 px-3 py-1 text-xs font-semibold text-emerald-700">
            Ecosystem Active
          </span>
        </div>

        <h2 class="text-2xl font-black tracking-tight text-slate-900">
          Discover what connects next
        </h2>

        <p class="mt-1 max-w-2xl text-sm text-slate-600">
          Follow meaningful relationships through your knowledge ecosystem.
        </p>
      </div>

      <%= link_to "Explore ecosystem →",
                  admin_ecosystem_discovery_path(@entity),
                  class: "rounded-2xl bg-slate-950 px-5 py-3 text-sm font-bold text-white shadow-lg transition hover:-translate-y-0.5 hover:bg-slate-800" %>
    </div>

    <div class="mt-6 grid gap-4 md:grid-cols-3">
      <div class="rounded-3xl bg-white/80 p-5 ring-1 ring-slate-200">
        <div class="text-xs font-bold uppercase tracking-wider text-slate-500">
          Recommendations
        </div>

        <div class="mt-2 text-3xl font-black text-slate-900">
          <%= @discovery[:recommendations].length %>
        </div>
      </div>

      <div class="rounded-3xl bg-white/80 p-5 ring-1 ring-slate-200">
        <div class="text-xs font-bold uppercase tracking-wider text-slate-500">
          Strong connections
        </div>

        <div class="mt-2 text-3xl font-black text-orange-600">
          <%= @discovery[:stats][:strong_connections] %>
        </div>
      </div>

      <div class="rounded-3xl bg-white/80 p-5 ring-1 ring-slate-200">
        <div class="text-xs font-bold uppercase tracking-wider text-slate-500">
          Explorer XP
        </div>

        <div class="mt-2 text-3xl font-black text-violet-600">
          <%= @profile.xp %>
        </div>
      </div>
    </div>

    <div class="mt-6">
      <div class="mb-3 flex items-center justify-between">
        <h3 class="text-sm font-black uppercase tracking-[0.16em] text-slate-700">
          Recommended discoveries
        </h3>

        <span class="text-xs font-semibold text-slate-500">
          Follow the strongest signal first
        </span>
      </div>

      <div class="grid gap-3">
        <% @discovery[:recommendations].each do |recommendation| %>
          <div class="group rounded-3xl bg-white p-5 ring-1 ring-slate-200 transition hover:-translate-y-0.5 hover:shadow-lg">
            <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="rounded-full bg-violet-100 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-violet-700">
                    <%= recommendation[:type] %>
                  </span>

                  <span class="rounded-full bg-slate-100 px-2.5 py-1 text-[10px] font-bold text-slate-600">
                    <%= recommendation[:relationship] %>
                  </span>
                </div>

                <h4 class="mt-2 truncate text-lg font-black text-slate-900">
                  <%= recommendation[:title] %>
                </h4>

                <div class="mt-2 flex flex-wrap gap-2">
                  <% recommendation[:reasons].each do |reason| %>
                    <span class="rounded-xl bg-slate-50 px-2.5 py-1 text-xs text-slate-600">
                      <%= reason %>
                    </span>
                  <% end %>
                </div>
              </div>

              <div class="shrink-0 text-right">
                <div class="text-xs font-bold uppercase tracking-wider text-slate-400">
                  Signal
                </div>

                <div class="text-2xl font-black text-orange-600">
                  <%= recommendation[:score] %>%
                </div>
              </div>
            </div>

            <div class="mt-4 h-2 overflow-hidden rounded-full bg-slate-100">
              <div
                class="h-full rounded-full bg-gradient-to-r from-orange-400 to-violet-500 transition-all"
                style="width: <%= recommendation[:score] %>%"
              ></div>
            </div>
          </div>
        <% end %>

        <% if @discovery[:recommendations].empty? %>
          <div class="rounded-3xl border border-dashed border-slate-300 bg-white/60 p-8 text-center">
            <div class="text-3xl">🧭</div>

            <h4 class="mt-3 font-black text-slate-900">
              No discovery signals yet
            </h4>

            <p class="mt-1 text-sm text-slate-500">
              Add or confirm ecosystem relationships to unlock recommendations.
            </p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</section>