<div class="min-h-screen bg-slate-50">
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">

    <div class="mb-8">
      <div class="flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
        <div>
          <div class="mb-3 flex items-center gap-2">
            <span class="rounded-full bg-orange-100 px-3 py-1 text-xs font-black uppercase tracking-[0.18em] text-orange-700">
              Step 12
            </span>

            <span class="rounded-full bg-violet-100 px-3 py-1 text-xs font-bold text-violet-700">
              Discovery Engine
            </span>
          </div>

          <h1 class="text-4xl font-black tracking-tight text-slate-950">
            Ecosystem Discovery
          </h1>

          <p class="mt-2 max-w-2xl text-slate-600">
            Turn relationship intelligence into a guided research journey.
          </p>
        </div>

        <%= button_to "Generate missions",
                      admin_generate_ecosystem_discovery_path(@entity),
                      method: :post,
                      class: "rounded-2xl bg-orange-500 px-5 py-3 text-sm font-black text-white shadow-lg transition hover:bg-orange-600" %>
      </div>
    </div>

    <div class="grid gap-6 lg:grid-cols-[1fr_340px]">

      <main>
        <%= render "discovery_panel" %>
      </main>

      <aside class="space-y-5">

        <section class="rounded-[32px] bg-slate-950 p-6 text-white shadow-xl">
          <div class="text-xs font-bold uppercase tracking-[0.18em] text-orange-300">
            Explorer
          </div>

          <div class="mt-3 flex items-end justify-between">
            <div>
              <div class="text-4xl font-black">
                Level <%= @profile.level %>
              </div>

              <div class="mt-1 text-sm text-slate-400">
                <%= @profile.xp %> XP
              </div>
            </div>

            <div class="text-3xl">
              🧭
            </div>
          </div>

          <div class="mt-5">
            <div class="mb-2 flex justify-between text-xs font-bold">
              <span class="text-slate-400">Progress</span>
              <span class="text-orange-300">
                <%= @profile.level_progress %>%
              </span>
            </div>

            <div class="h-3 overflow-hidden rounded-full bg-white/10">
              <div
                class="h-full rounded-full bg-gradient-to-r from-orange-400 to-violet-400"
                style="width: <%= @profile.level_progress %>%"
              ></div>
            </div>
          </div>
        </section>

        <section class="rounded-[32px] bg-white p-6 shadow-sm ring-1 ring-slate-200">
          <div class="flex items-center justify-between">
            <div>
              <div class="text-xs font-bold uppercase tracking-[0.16em] text-slate-400">
                Missions
              </div>

              <h2 class="mt-1 text-xl font-black text-slate-900">
                Discovery quests
              </h2>
            </div>

            <span class="text-2xl">🎯</span>
          </div>

          <div class="mt-5 space-y-3">
            <% @missions.each do |mission| %>
              <div class="rounded-2xl bg-slate-50 p-4">
                <div class="flex items-start justify-between gap-3">
                  <div>
                    <div class="font-bold text-slate-900">
                      <%= mission.title %>
                    </div>

                    <div class="mt-1 text-xs leading-5 text-slate-500">
                      <%= mission.description %>
                    </div>
                  </div>

                  <span class="shrink-0 rounded-lg bg-orange-100 px-2 py-1 text-xs font-black text-orange-700">
                    +<%= mission.xp_reward %> XP
                  </span>
                </div>

                <%= button_to "Complete",
                              admin_complete_ecosystem_discovery_mission_path(
                                @entity,
                                mission_id: mission.id
                              ),
                              method: :post,
                              class: "mt-3 w-full rounded-xl bg-slate-900 px-3 py-2 text-xs font-bold text-white hover:bg-slate-700" %>
              </div>
            <% end %>

            <% if @missions.empty? %>
              <p class="rounded-2xl bg-slate-50 p-4 text-sm text-slate-500">
                Generate discovery missions to begin exploring.
              </p>
            <% end %>
          </div>
        </section>

        <section class="rounded-[32px] bg-white p-6 shadow-sm ring-1 ring-slate-200">
          <div class="text-xs font-bold uppercase tracking-[0.16em] text-slate-400">
            Discovery activity
          </div>

          <div class="mt-4 grid grid-cols-2 gap-3">
            <div class="rounded-2xl bg-orange-50 p-4">
              <div class="text-2xl font-black text-orange-600">
                <%= @profile.discoveries_count %>
              </div>

              <div class="mt-1 text-xs font-semibold text-slate-500">
                Discoveries
              </div>
            </div>

            <div class="rounded-2xl bg-violet-50 p-4">
              <div class="text-2xl font-black text-violet-600">
                <%= @profile.comparisons_count %>
              </div>

              <div class="mt-1 text-xs font-semibold text-slate-500">
                Comparisons
              </div>
            </div>

            <div class="rounded-2xl bg-emerald-50 p-4">
              <div class="text-2xl font-black text-emerald-600">
                <%= @profile.investigations_count %>
              </div>

              <div class="mt-1 text-xs font-semibold text-slate-500">
                Investigations
              </div>
            </div>

            <div class="rounded-2xl bg-sky-50 p-4">
              <div class="text-2xl font-black text-sky-600">
                <%= @profile.current_streak %>
              </div>

              <div class="mt-1 text-xs font-semibold text-slate-500">
                Streak
              </div>
            </div>
          </div>
        </section>

      </aside>
    </div>
  </div>
</div>