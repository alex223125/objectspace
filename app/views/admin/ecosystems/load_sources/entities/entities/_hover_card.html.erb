
<%
  health = entity.health_summary
  checks = health[:checks] || {}
  flags = entity.quality_issues

  outgoing = entity.outgoing_relationships
                   .active
                   .includes(:target_entity)
                   .limit(5)

  incoming = entity.incoming_relationships
                   .active
                   .includes(:source_entity)
                   .limit(5)

  related = (
    outgoing.map(&:target_entity) +
      incoming.map(&:source_entity)
  ).compact.uniq

  metadata = entity.metadata.is_a?(Hash) ? entity.metadata : {}
%>

<div class="w-[min(560px,calc(100vw-24px))]
            max-h-[min(80vh,720px)] overflow-y-auto
            rounded-2xl border border-gray-200 bg-white
            text-gray-800 shadow-2xl
            dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100">

  <%# Header %>
  <div class="border-b border-gray-100
              bg-gradient-to-br from-violet-50 to-sky-50
              p-5 dark:border-gray-800 dark:from-violet-950/40
              dark:to-sky-950/30">

    <div class="flex items-start justify-between gap-4">
      <div class="min-w-0">
        <div class="text-[9px] font-black uppercase
                    tracking-[0.2em] text-violet-600">
          Entity intelligence · #<%= entity.id %>
        </div>

        <h3 class="mt-1 break-words text-lg font-black">
          <%= entity.name %>
        </h3>

        <p class="mt-1 break-all text-xs text-gray-500
                  dark:text-gray-400">
          <%= entity.slug %>
        </p>
      </div>

      <span class="shrink-0 rounded-full border px-3 py-1
                   text-[10px] font-bold">
        <%= entity.status.to_s.humanize %>
      </span>
    </div>

    <p class="mt-3 text-sm leading-relaxed text-gray-700
              dark:text-gray-300">
      <%= entity.summary.presence ||
            "No summary has been written for this entity yet." %>
    </p>

    <div class="mt-4 grid grid-cols-3 gap-2">
      <div class="rounded-xl border border-white/80
                  bg-white/80 p-3 dark:border-gray-700
                  dark:bg-gray-900/80">
        <div class="text-[9px] font-bold uppercase
                    tracking-wider text-gray-400">
          Health
        </div>
        <div class="mt-1 text-xl font-black">
          <%= health[:score] %>%
        </div>
      </div>

      <div class="rounded-xl border border-white/80
                  bg-white/80 p-3 dark:border-gray-700
                  dark:bg-gray-900/80">
        <div class="text-[9px] font-bold uppercase
                    tracking-wider text-gray-400">
          Relationships
        </div>
        <div class="mt-1 text-xl font-black">
          <%= entity.relationship_count %>
        </div>
      </div>

      <div class="rounded-xl border border-white/80
                  bg-white/80 p-3 dark:border-gray-700
                  dark:bg-gray-900/80">
        <div class="text-[9px] font-bold uppercase
                    tracking-wider text-gray-400">
          Quality issues
        </div>
        <div class="mt-1 text-xl font-black">
          <%= flags.size %>
        </div>
      </div>
    </div>
  </div>

  <div class="space-y-5 p-5">

    <%# Identity and classification %>
    <section>
      <h4 class="mb-2 text-[10px] font-black uppercase
                 tracking-widest text-gray-400">
        Identity and classification
      </h4>

      <dl class="grid grid-cols-2 gap-3 text-xs">
        <div>
          <dt class="text-gray-400">Entity type</dt>
          <dd class="mt-1 font-bold">
            <%= entity.entity_type&.name || "Not assigned" %>
          </dd>
        </div>

        <div>
          <dt class="text-gray-400">Scope</dt>
          <dd class="mt-1 font-bold">
            <%= entity.scope.to_s.humanize.presence || "Unknown" %>
          </dd>
        </div>

        <div>
          <dt class="text-gray-400">Template</dt>
          <dd class="mt-1 font-bold">
            <%= entity.entity_template&.name || "Not assigned" %>
          </dd>
        </div>

        <div>
          <dt class="text-gray-400">Template version</dt>
          <dd class="mt-1 font-bold">
            <%= entity.entity_template_version&.version_number ||
                  entity.entity_template_version_id ||
                  "Not assigned" %>
          </dd>
        </div>
      </dl>
    </section>

    <%# Editorial state %>
    <section>
      <h4 class="mb-2 text-[10px] font-black uppercase
                 tracking-widest text-gray-400">
        Editorial workflow
      </h4>

      <div class="flex flex-wrap gap-2">
        <% [entity.workflow_state, entity.scope, health[:level]].each do |value| %>
          <span class="rounded-lg border border-gray-200
                       bg-gray-50 px-2.5 py-1 text-[10px]
                       font-bold dark:border-gray-700
                       dark:bg-gray-800">
            <%= value.to_s.humanize %>
          </span>
        <% end %>
      </div>

      <dl class="mt-3 grid grid-cols-2 gap-3 text-xs">
        <div>
          <dt class="text-gray-400">Assigned reviewer</dt>
          <dd class="mt-1 font-semibold">
            <%= entity.reviewer&.try(:email) || "Unassigned" %>
          </dd>
        </div>

        <div>
          <dt class="text-gray-400">Review requested</dt>
          <dd class="mt-1 font-semibold">
            <%= entity.review_requested_at&.strftime("%b %d, %Y %H:%M") ||
                  "Not requested" %>
          </dd>
        </div>

        <div>
          <dt class="text-gray-400">Created</dt>
          <dd class="mt-1 font-semibold">
            <%= entity.created_at&.strftime("%b %d, %Y %H:%M") || "Unknown" %>
          </dd>
        </div>

        <div>
          <dt class="text-gray-400">Last updated</dt>
          <dd class="mt-1 font-semibold">
            <%= entity.updated_at&.strftime("%b %d, %Y %H:%M") || "Unknown" %>
          </dd>
        </div>

        <div>
          <dt class="text-gray-400">Published</dt>
          <dd class="mt-1 font-semibold">
            <%= entity.published_at&.strftime("%b %d, %Y %H:%M") || "Not published" %>
          </dd>
        </div>

        <div>
          <dt class="text-gray-400">Scheduled publication</dt>
          <dd class="mt-1 font-semibold">
            <%= entity.publish_at&.strftime("%b %d, %Y %H:%M") || "Not scheduled" %>
          </dd>
        </div>
      </dl>
    </section>

    <%# Health checks %>
    <section>
      <h4 class="mb-3 text-[10px] font-black uppercase
                 tracking-widest text-gray-400">
        Completeness checks
      </h4>

      <div class="space-y-2">
        <% checks.each do |_key, check| %>
          <div class="flex items-center justify-between gap-3 text-xs">
            <span class="text-gray-600 dark:text-gray-300">
              <%= check[:label] %>
            </span>

            <span class="<%= check[:complete] ?
                               'text-emerald-600' : 'text-amber-600' %>
              font-bold">
              <%= check[:complete] ? "Complete" : "Missing" %>
            </span>
          </div>
        <% end %>
      </div>

      <% if flags.any? %>
        <div class="mt-3 rounded-xl border border-amber-200
                    bg-amber-50 p-3 dark:border-amber-900
                    dark:bg-amber-950/20">
          <div class="text-xs font-black text-amber-700
                      dark:text-amber-400">
            Needs attention
          </div>

          <ul class="mt-2 list-inside list-disc space-y-1
                     text-xs text-amber-800 dark:text-amber-300">
            <% flags.each do |flag| %>
              <li><%= flag %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </section>

    <%# Ecosystem relationships %>
    <section>
      <h4 class="mb-2 text-[10px] font-black uppercase
                 tracking-widest text-gray-400">
        Connected entities
      </h4>

      <% if related.any? %>
        <div class="space-y-2">
          <% related.first(8).each do |related_entity| %>
            <div class="flex items-center justify-between gap-3
                        rounded-xl border border-gray-100
                        p-3 dark:border-gray-800">
              <div class="min-w-0">
                <div class="truncate text-xs font-bold">
                  <%= related_entity.name %>
                </div>

                <div class="mt-1 text-[10px] text-gray-400">
                  <%= related_entity.entity_type&.name || "Unknown type" %>
                </div>
              </div>

              <%= link_to(
                    "Open",
                    admin_ecosystems_load_sources_entity_path(related_entity),
                    class: "shrink-0 text-xs font-bold text-violet-600"
                  ) %>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-xs text-gray-500">
          No active connected entities found.
        </p>
      <% end %>
    </section>

    <%# Metadata %>
    <section>
      <h4 class="mb-2 text-[10px] font-black uppercase
                 tracking-widest text-gray-400">
        Additional metadata
      </h4>

      <% if metadata.any? %>
        <pre class="max-h-40 overflow-auto rounded-xl
                    bg-gray-50 p-3 text-[10px]
                    dark:bg-gray-950"><%= JSON.pretty_generate(metadata) %></pre>
      <% else %>
        <p class="text-xs text-gray-500">
          No additional metadata recorded.
        </p>
      <% end %>
    </section>

    <%= link_to(
          "Open full entity record →",
          admin_ecosystems_load_sources_entity_path(entity),
          class: "block rounded-xl bg-violet-600 px-4 py-3
                  text-center text-xs font-black text-white
                  hover:bg-violet-700"
        ) %>

  </div>
</div>