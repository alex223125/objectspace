<%
  intelligence =
    Comparisons::EvolutionTimeline
      .new(
        versions: versions,
        current_version: local_assigns[:current_version]
      )
      .call

  timeline_versions = intelligence[:versions]
  current_index = intelligence[:current_index]
%>

<section
  data-controller="evolution-timeline"
  class="mt-10 overflow-hidden rounded-[38px]
         border-2 border-violet-100
         bg-gradient-to-b
         from-white
         via-violet-50/20
         to-slate-50/60
         shadow-xl shadow-violet-100/30"
  aria-labelledby="evolution-intelligence-title">

  <!-- ======================================================= -->
  <!-- HEADER -->
  <!-- ======================================================= -->

  <div
    class="border-b border-violet-100
           px-6 py-6
           md:px-8">

    <div
      class="flex flex-col gap-5
             lg:flex-row
             lg:items-center
             lg:justify-between">

      <div class="flex items-start gap-4">

        <div
          class="flex h-12 w-12 shrink-0
                 items-center justify-center
                 rounded-[18px]
                 border-2 border-violet-200
                 bg-violet-50
                 text-xl
                 shadow-sm shadow-violet-100">

          🧠

        </div>

        <div>

          <div
            class="flex flex-wrap items-center gap-2">

            <h2
              id="evolution-intelligence-title"
              class="text-base font-black
                     tracking-tight text-slate-800">

              Evolution Intelligence

            </h2>

            <span
              class="rounded-full
                     border border-violet-200
                     bg-violet-50
                     px-2.5 py-1
                     text-[9px]
                     font-black
                     uppercase
                     tracking-widest
                     text-violet-700">

              Premium intelligence

            </span>

          </div>

          <p
            class="mt-1 max-w-2xl
                   text-xs leading-5
                   text-slate-400">

            Understand how this knowledge changed,
            where activity concentrated, and what deserves attention next.

          </p>

        </div>

      </div>

      <div
        class="flex items-center gap-2">

        <button
          type="button"
          data-action="evolution-timeline#previous"
          class="rounded-xl
                 border border-slate-200
                 bg-white
                 px-3 py-2
                 text-xs font-black
                 text-slate-600
                 shadow-sm
                 transition
                 hover:-translate-y-0.5
                 hover:border-violet-200
                 hover:text-violet-700">

          ←

        </button>

        <button
          type="button"
          data-action="evolution-timeline#next"
          class="rounded-xl
                 border border-slate-200
                 bg-white
                 px-3 py-2
                 text-xs font-black
                 text-slate-600
                 shadow-sm
                 transition
                 hover:-translate-y-0.5
                 hover:border-violet-200
                 hover:text-violet-700">

          →

        </button>

        <button
          type="button"
          data-action="evolution-timeline#focusHighestActivity"
          class="rounded-xl
                 border-2 border-violet-200
                 bg-violet-50
                 px-3 py-2
                 text-xs font-black
                 text-violet-700
                 shadow-sm
                 transition
                 hover:-translate-y-0.5
                 hover:bg-violet-100">

          Focus hotspot

        </button>

      </div>

    </div>

  </div>


  <!-- ======================================================= -->
  <!-- SCORE STRIP -->
  <!-- ======================================================= -->

  <div
    class="grid grid-cols-2
           border-b border-violet-100
           sm:grid-cols-4">

    <div
      class="border-b border-r border-violet-100
             px-5 py-5
             sm:border-b-0">

      <div
        class="text-[9px]
               font-black
               uppercase
               tracking-[0.18em]
               text-slate-400">

        Evolution

      </div>

      <div
        class="mt-1 text-2xl
               font-black
               <%= evolution_score_color(intelligence[:evolution_score]) %>">

        <%= intelligence[:evolution_score] %>

      </div>

      <div
        class="mt-1 text-[10px]
               font-bold text-slate-400">

        structural impact

      </div>

    </div>


    <div
      class="border-b border-violet-100
             px-5 py-5
             sm:border-b-0 sm:border-r">

      <div
        class="text-[9px]
               font-black
               uppercase
               tracking-[0.18em]
               text-slate-400">

        Momentum

      </div>

      <div
        class="mt-1 text-2xl
               font-black text-violet-600">

        <%= intelligence[:momentum_score] %>

      </div>

      <div
        class="mt-1 text-[10px]
               font-bold text-slate-400">

        recent activity

      </div>

    </div>


    <div
      class="border-r border-violet-100
             px-5 py-5">

      <div
        class="text-[9px]
               font-black
               uppercase
               tracking-[0.18em]
               text-slate-400">

        Density

      </div>

      <div
        class="mt-1 text-2xl
               font-black text-sky-600">

        <%= intelligence[:change_density] %>%

      </div>

      <div
        class="mt-1 text-[10px]
               font-bold text-slate-400">

        active versions

      </div>

    </div>


    <div
      class="px-5 py-5">

      <div
        class="text-[9px]
               font-black
               uppercase
               tracking-[0.18em]
               text-slate-400">

        Review debt

      </div>

      <div
        class="mt-1 text-2xl
               font-black
               <%= intelligence[:review_debt] >= 30 ? 'text-rose-600' : 'text-emerald-600' %>">

        <%= intelligence[:review_debt] %>%

      </div>

      <div
        class="mt-1 text-[10px]
               font-bold text-slate-400">

        unresolved attention

      </div>

    </div>

  </div>


  <!-- ======================================================= -->
  <!-- SIGNALS -->
  <!-- ======================================================= -->

  <% if intelligence[:signals].any? %>

    <div class="grid gap-3 px-6 py-6 md:grid-cols-2 lg:grid-cols-4">

      <% intelligence[:signals].each do |signal| %>

        <%= render "comparisons/evolution_signal",
                   signal: signal %>

      <% end %>

    </div>

  <% end %>


  <!-- ======================================================= -->
  <!-- TIMELINE -->
  <!-- ======================================================= -->

  <div
    class="px-6 pb-8 md:px-8">

    <div
      class="mb-5
             flex flex-col gap-2
             sm:flex-row
             sm:items-end
             sm:justify-between">

      <div>

        <div
          class="text-sm
                 font-black text-slate-700">

          Version evolution

        </div>

        <p
          class="mt-1 text-[11px]
                 font-medium text-slate-400">

          Select a version to inspect its evolution signal.

        </p>

      </div>

      <div
        class="text-[10px]
               font-black uppercase
               tracking-widest
               text-slate-400">

        <span data-evolution-timeline-target="selectedVersion">
          Version <%= current_index + 1 %>
        </span>

      </div>

    </div>


    <div
      class="relative">

      <!-- Timeline rail -->

      <div
        class="absolute
               left-5 right-5 top-[26px]
               hidden h-2
               overflow-hidden
               rounded-full
               bg-violet-100
               md:block">

        <div
          data-evolution-timeline-target="progress"
          class="h-full
                 w-0
                 rounded-full
                 bg-gradient-to-r
                 from-orange-400
                 via-violet-400
                 to-emerald-400
                 shadow-sm
                 shadow-violet-200
                 transition-all duration-500">
        </div>

      </div>


      <div
        class="relative
               grid gap-5
               md:grid-flow-col
               md:auto-cols-[minmax(130px,1fr)]
               md:overflow-x-auto
               md:pb-5">

        <% timeline_versions.each do |version| %>

          <%= render "comparisons/evolution_timeline_version",
                     version: version %>

        <% end %>

      </div>

    </div>


    <!-- ===================================================== -->
    <!-- SELECTED VERSION DETAIL -->
    <!-- ===================================================== -->

    <div
      class="mt-5
             rounded-[26px]
             border-2 border-violet-100
             bg-white/80
             p-5
             shadow-sm">

      <div
        class="flex flex-col gap-4
               md:flex-row
               md:items-center
               md:justify-between">

        <div>

          <div
            class="text-[9px]
                   font-black uppercase
                   tracking-[0.18em]
                   text-violet-500">

            Selected evolution

          </div>

          <div
            data-evolution-timeline-target="detail"
            class="mt-1 text-xs
                   font-medium
                   leading-6 text-slate-500">

            Select a version to inspect its activity.

          </div>

        </div>

        <button
          type="button"
          data-action="evolution-timeline#focusCurrent"
          class="shrink-0
                 rounded-2xl
                 border-2 border-orange-200
                 bg-gradient-to-r
                 from-orange-400
                 to-amber-400
                 px-4 py-2.5
                 text-xs
                 font-black
                 text-white
                 shadow-md
                 shadow-orange-100
                 transition
                 hover:-translate-y-0.5
                 hover:shadow-lg">

          Focus selected version →

        </button>

      </div>

    </div>


    <!-- ===================================================== -->
    <!-- HOTSPOTS -->
    <!-- ===================================================== -->

    <% if intelligence[:hotspots].any? %>

      <div class="mt-6">

        <div
          class="mb-3 text-[9px]
                 font-black uppercase
                 tracking-[0.18em]
                 text-slate-400">

          Structural hotspots

        </div>

        <div class="grid gap-3 md:grid-cols-2 lg:grid-cols-3">

          <% intelligence[:hotspots].each_with_index do |hotspot, index| %>

            <div
              class="rounded-2xl
                     border border-slate-200
                     bg-white
                     p-4
                     shadow-sm
                     transition
                     hover:-translate-y-0.5
                     hover:border-violet-200
                     hover:shadow-md">

              <div
                class="flex items-center
                       justify-between gap-3">

                <span
                  class="truncate text-xs
                         font-black text-slate-700">

                  <%= hotspot[:path] %>

                </span>

                <span
                  class="shrink-0
                         rounded-full
                         bg-violet-50
                         px-2 py-1
                         text-[9px]
                         font-black
                         text-violet-700">

                  #<%= index + 1 %>

                </span>

              </div>

              <div
                class="mt-3 h-2
                       overflow-hidden
                       rounded-full
                       bg-slate-100">

                <div
                  class="h-full rounded-full
                         bg-gradient-to-r
                         from-violet-400
                         to-sky-400"
                  style="width: <%= evolution_intensity_width((hotspot[:activity].to_f / [timeline_versions.length, 1].max) * 100) %>%">
                </div>

              </div>

              <div
                class="mt-2 text-[9px]
                       font-bold text-slate-400">

                Active in <%= hotspot[:activity] %>
                version<%= "s" unless hotspot[:activity] == 1 %>

              </div>

            </div>

          <% end %>

        </div>

      </div>

    <% end %>


    <!-- ===================================================== -->
    <!-- KEYBOARD HELP -->
    <!-- ===================================================== -->

    <div
      class="mt-6
             flex flex-wrap
             items-center gap-2
             text-[9px]
             font-bold text-slate-400">

      <span
        class="rounded-lg
               border border-slate-200
               bg-white px-2 py-1">

        ← →

      </span>

      Navigate versions

      <span
        class="ml-2 rounded-lg
               border border-slate-200
               bg-white px-2 py-1">

        F

      </span>

      Find hotspot

      <span
        class="ml-2 rounded-lg
               border border-slate-200
               bg-white px-2 py-1">

        Home / End

      </span>

      Jump through timeline

    </div>

  </div>

</section>