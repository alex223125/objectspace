<%
  signal = local_assigns.fetch(:signal)
%>

<div
  class="group rounded-[22px]
         border-2
         <%= evolution_signal_classes(signal[:type]).split.first(2).join(' ') %>
         p-4
         transition-all duration-300
         hover:-translate-y-1
         hover:shadow-md">

  <div class="flex items-start gap-3">

    <div
      class="flex h-9 w-9 shrink-0
             items-center justify-center
             rounded-xl
             bg-white/80
             text-base
             shadow-sm">

      <%= signal[:icon] %>

    </div>

    <div class="min-w-0">

      <div
        class="text-[10px]
               font-black
               uppercase
               tracking-wider">

        <%= signal[:title] %>

      </div>

      <p
        class="mt-1 text-[10px]
               font-medium
               leading-5
               opacity-70">

        <%= signal[:description] %>

      </p>

    </div>

  </div>

</div>