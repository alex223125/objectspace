<%
  milestone = local_assigns.fetch(:milestone)
%>

<div
  class="flex items-start gap-3
         rounded-2xl
         border border-slate-200
         bg-white
         p-3
         shadow-sm">

  <div
    class="flex h-8 w-8 shrink-0
           items-center justify-center
           rounded-xl
           bg-orange-50
           text-sm">

    <%=
      case milestone[:type]
      when "peak"
        "🔥"
      when "structural"
        "↗"
      when "current"
        "●"
      else
        "✦"
      end
    %>

  </div>

  <div>

    <div
      class="text-[10px]
             font-black text-slate-700">

      <%= milestone[:label] %>

    </div>

    <div
      class="mt-1 text-[9px]
             font-medium text-slate-400">

      <%= milestone[:description] %>

    </div>

  </div>

</div>