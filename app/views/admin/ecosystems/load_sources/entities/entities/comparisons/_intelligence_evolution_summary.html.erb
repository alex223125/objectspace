<%
  timeline_versions =
    comparison_evolution_versions(comparison)

  maximum_changes =
    comparison_timeline_max_changes(timeline_versions)

  total_changes =
    timeline_versions.sum { |version| version[:change_count].to_i }

  major_versions =
    timeline_versions.count do |version|
      comparison_timeline_intensity(
        version[:change_count],
        maximum_changes
      ) >= 75
    end

  reviewed_versions =
    timeline_versions.count { |version| version[:reviewed] }

  review_percentage =
    if timeline_versions.any?
      ((reviewed_versions.to_f / timeline_versions.length) * 100).round
    else
      0
    end
%>

<div
  class="
    rounded-[30px]
    border-2 border-violet-100
    bg-gradient-to-r
    from-violet-50/50
    via-white
    to-orange-50/30
    p-5
    shadow-sm
  "
>

  <div
    class="
      flex
      flex-col
      gap-5
      lg:flex-row
      lg:items-center
      lg:justify-between
    "
  >

    <div class="flex items-start gap-3">

      <div
        class="
          flex
          h-10
          w-10
          shrink-0
          items-center
          justify-center
          rounded-2xl
          bg-violet-100
          text-violet-600
        "
      >
        ✦
      </div>

      <div>

        <div
          class="
            text-xs
            font-black
            uppercase
            tracking-wider
            text-slate-700
          "
        >
          Evolution signal
        </div>

        <p
          class="
            mt-1
            text-[11px]
            leading-5
            text-slate-400
          "
        >
          Historical activity is being transformed into
          reviewable evolution signals.
        </p>

      </div>

    </div>


    <div
      class="
        grid
        grid-cols-2
        gap-2
        sm:grid-cols-4
      "
    >

      <div
        class="
          rounded-xl
          border
          border-violet-100
          bg-white
          px-3
          py-2
          text-center
        "
      >

        <div
          class="
            text-[8px]
            font-black
            uppercase
            tracking-widest
            text-slate-400
          "
        >
          Changes
        </div>

        <div
          class="
            mt-0.5
            text-sm
            font-black
            text-violet-600
          "
        >
          <%= total_changes %>
        </div>

      </div>


      <div
        class="
          rounded-xl
          border
          border-orange-100
          bg-white
          px-3
          py-2
          text-center
        "
      >

        <div
          class="
            text-[8px]
            font-black
            uppercase
            tracking-widest
            text-slate-400
          "
        >
          Major
        </div>

        <div
          class="
            mt-0.5
            text-sm
            font-black
            text-orange-500
          "
        >
          <%= major_versions %>
        </div>

      </div>


      <div
        class="
          rounded-xl
          border
          border-emerald-100
          bg-white
          px-3
          py-2
          text-center
        "
      >

        <div
          class="
            text-[8px]
            font-black
            uppercase
            tracking-widest
            text-slate-400
          "
        >
          Reviewed
        </div>

        <div
          class="
            mt-0.5
            text-sm
            font-black
            text-emerald-500
          "
        >
          <%= review_percentage %>%
        </div>

      </div>


      <div
        class="
          rounded-xl
          border
          border-sky-100
          bg-white
          px-3
          py-2
          text-center
        "
      >

        <div
          class="
            text-[8px]
            font-black
            uppercase
            tracking-widest
            text-slate-400
          "
        >
          Versions
        </div>

        <div
          class="
            mt-0.5
            text-sm
            font-black
            text-sky-500
          "
        >
          <%= timeline_versions.length %>
        </div>

      </div>

    </div>

  </div>

</div>