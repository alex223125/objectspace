<%
  version = local_assigns.fetch(:version)
  detail =
    [
      "#{version[:changes_count]} total changes.",
      version[:added_count].positive? ? "#{version[:added_count]} added." : nil,
      version[:removed_count].positive? ? "#{version[:removed_count]} removed." : nil,
      version[:moved_count].positive? ? "#{version[:moved_count]} moved." : nil,
      version[:warning_count].positive? ? "#{version[:warning_count]} warning signals." : nil
    ].compact.join(" ")
%>

<button
  type="button"
  tabindex="0"
  role="option"
  aria-selected="false"
  data-evolution-timeline-target="version"
  data-action="click->evolution-timeline#select"
  data-index="<%= version[:index] %>"
  data-current="<%= version[:is_current] %>"
  data-title="Version <%= version[:number] %>"
  data-activity="<%= version[:changes_count] %>"
  data-detail="<%= ERB::Util.html_escape(detail) %>"
  class="group relative z-10
         flex w-full
         flex-col items-center
         rounded-[24px]
         border-2
         border-transparent
         bg-white/70
         px-3 py-4
         text-center
         outline-none
         transition-all duration-300
         hover:-translate-y-1
         hover:border-violet-200
         hover:bg-white
         hover:shadow-lg
         focus-visible:ring-4
         focus-visible:ring-violet-100
         md:min-w-[130px]">

  <!-- Node -->

  <div
    data-timeline-marker
    class="flex h-12 w-12
           items-center justify-center
           rounded-[18px]
           border-[3px]
           <%= version[:is_current] ?
                            'border-orange-400 bg-orange-50 text-orange-700 ring-4 ring-orange-100/70' :
                            'border-violet-300 bg-violet-50 text-violet-700' %>
           text-xs font-black
           shadow-md
           transition-all duration-300
           group-hover:scale-110">

    <%= version[:number] %>

  </div>


  <!-- Current badge -->

  <% if version[:is_current] %>

    <span
      class="mt-2
             rounded-full
             border border-orange-200
             bg-orange-50
             px-2 py-1
             text-[8px]
             font-black uppercase
             tracking-wider
             text-orange-700">

      Current

    </span>

  <% else %>

    <span
      class="mt-2
             text-[8px]
             font-black uppercase
             tracking-wider
             text-slate-300">

      Version

    </span>

  <% end %>


  <!-- Activity -->

  <div
    class="mt-3 text-xl
           font-black
           text-slate-700">

    <%= version[:changes_count] %>

  </div>

  <div
    class="text-[8px]
           font-black uppercase
           tracking-widest
           text-slate-400">

    changes

  </div>


  <!-- Activity bar -->

  <div
    class="mt-3 h-2 w-full
           overflow-hidden
           rounded-full
           bg-slate-100">

    <div
      class="h-full
             rounded-full
             bg-gradient-to-r
             from-violet-400
             to-sky-400
             transition-all duration-500"
      style="width: <%= version[:intensity] %>%">
    </div>

  </div>


  <!-- Signals -->

  <div
    class="mt-3 flex
           min-h-5
           flex-wrap
           justify-center
           gap-1">

    <% if version[:added_count].positive? %>

      <span
        class="rounded-full
               bg-emerald-50
               px-2 py-1
               text-[8px]
               font-black
               text-emerald-700">

        +<%= version[:added_count] %>

      </span>

    <% end %>


    <% if version[:removed_count].positive? %>

      <span
        class="rounded-full
               bg-rose-50
               px-2 py-1
               text-[8px]
               font-black
               text-rose-700">

        −<%= version[:removed_count] %>

      </span>

    <% end %>


    <% if version[:moved_count].positive? %>

      <span
        class="rounded-full
               bg-violet-50
               px-2 py-1
               text-[8px]
               font-black
               text-violet-700">

        ↗<%= version[:moved_count] %>

      </span>

    <% end %>


    <% if version[:warning_count].positive? %>

      <span
        class="rounded-full
               bg-amber-50
               px-2 py-1
               text-[8px]
               font-black
               text-amber-700">

        ⚠ <%= version[:warning_count] %>

      </span>

    <% end %>

  </div>


  <!-- Date -->

  <% if version[:created_at].present? %>

    <div
      class="mt-3 text-[9px]
             font-medium text-slate-400">

      <%= evolution_date_label(version[:created_at]) %>

    </div>

  <% end %>

</button>