<%
  color = evolution_timeline_color(version_data[:intensity])
  current = version_data[:current]
  reviewed = version_data[:reviewed]
  milestone = version_data[:milestone]

  color_classes = {
    "sky" => {
      node: "bg-sky-50 border-sky-300 text-sky-700",
      glow: "ring-sky-100",
      bar: "bg-sky-400",
      text: "text-sky-600"
    },
    "violet" => {
      node: "bg-violet-50 border-violet-300 text-violet-700",
      glow: "ring-violet-100",
      bar: "bg-violet-400",
      text: "text-violet-600"
    },
    "orange" => {
      node: "bg-orange-50 border-orange-400 text-orange-700",
      glow: "ring-orange-100",
      bar: "bg-orange-400",
      text: "text-orange-600"
    },
    "emerald" => {
      node: "bg-emerald-50 border-emerald-400 text-emerald-700",
      glow: "ring-emerald-100",
      bar: "bg-emerald-400",
      text: "text-emerald-600"
    }
  }

  palette = color_classes[color]
%>

<div
  class="relative min-w-[150px] md:min-w-[175px] snap-center"
  data-version-evolution-target="card">

  <button
    type="button"
    class="
      group
      relative
      w-full
      rounded-[26px]
      border-2
      <%= palette[:node] %>
      bg-white
      p-4
      text-left
      shadow-sm
      transition-all
      duration-300
      hover:-translate-y-1
      hover:shadow-lg
      focus:outline-none
      focus:ring-4
      focus:ring-orange-100
    "
    data-version-evolution-target="node"
    data-action="click->version-evolution#select"
    data-index="<%= version_data[:index] %>"
    data-id="<%= version_data[:id] %>"
    data-label="<%= version_data[:label] %>"
    data-date="<%= version_data[:date_label] %>"
    data-changes="<%= version_data[:changes_count] %>"
    data-intensity="<%= version_data[:intensity] %>"
    data-intensity-label="<%= evolution_intensity_label(version_data[:intensity]) %>"
    data-status-label="<%= version_data[:status].humanize %>"
    data-review-label="<%= version_data[:review_label] %>"
    data-summary="<%= version_data[:summary] %>"
    data-compare-url="<%= version_data[:compare_url] %>"
    data-current="<%= current %>"
    data-reviewed="<%= reviewed %>"
    data-milestone="<%= milestone %>"
    aria-selected="<%= current ? "true" : "false" %>"
    aria-label="<%= version_data[:label] %>, <%= version_data[:changes_count] %> changes"
  >

    <% if current %>
      <span
        class="
          absolute
          -top-2
          left-1/2
          -translate-x-1/2
          rounded-full
          border
          border-orange-200
          bg-orange-100
          px-2.5
          py-1
          text-[9px]
          font-black
          uppercase
          tracking-widest
          text-orange-700
          shadow-sm
        ">
        Current
      </span>
    <% end %>

    <% if milestone %>
      <span
        class="
          absolute
          right-3
          top-3
          text-sm
        "
        title="Evolution milestone"
        aria-label="Evolution milestone">
        ✦
      </span>
    <% end %>

    <div class="flex items-center justify-between gap-2">

      <span
        class="
          inline-flex
          h-10
          w-10
          items-center
          justify-center
          rounded-2xl
          border-2
          <%= palette[:node] %>
          text-xs
          font-black
          shadow-sm
          ring-4
          <%= palette[:glow] %>
        ">
        <%= version_data[:short_label] %>
      </span>

      <% if reviewed %>
        <span
          class="
            rounded-full
            border
            border-emerald-200
            bg-emerald-50
            px-2
            py-1
            text-[8px]
            font-black
            uppercase
            tracking-wider
            text-emerald-700
          ">
          ✓ Reviewed
        </span>
      <% end %>

    </div>

    <div class="mt-4">

      <div class="truncate text-xs font-black text-slate-700">
        <%= version_data[:label] %>
      </div>

      <div class="mt-1 text-[10px] font-medium text-slate-400">
        <%= version_data[:date_label] %>
      </div>

    </div>

    <div class="mt-4">

      <div class="mb-1.5 flex items-center justify-between">

        <span
          class="
            text-[9px]
            font-black
            uppercase
            tracking-widest
            text-slate-400
          ">
          Change activity
        </span>

        <span
          class="
            text-[10px]
            font-black
            <%= palette[:text] %>
          ">
          <%= version_data[:changes_count] %>
        </span>

      </div>

      <div
        class="
          h-2
          overflow-hidden
          rounded-full
          border
          border-slate-100
          bg-slate-50
        ">

        <div
          class="
            h-full
            rounded-full
            <%= palette[:bar] %>
            shadow-sm
            transition-all
            duration-500
          "
          style="width: <%= version_data[:intensity] %>%">
        </div>

      </div>

    </div>

    <div class="mt-4 flex items-center justify-between">

      <span
        class="
          text-[9px]
          font-bold
          <%= palette[:text] %>
        ">
        <%= evolution_intensity_label(version_data[:intensity]) %>
      </span>

      <span
        class="
          text-slate-300
          transition-transform
          duration-300
          group-hover:translate-x-1
        ">
        →
      </span>

    </div>

  </button>

</div>