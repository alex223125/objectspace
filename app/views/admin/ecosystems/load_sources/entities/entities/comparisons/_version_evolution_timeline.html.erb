<%
  versions = Array(local_assigns[:versions])

  if versions.empty?
    render partial: "comparisons/version_evolution_empty"
    return
  end

  max_changes =
    versions.map { |version| evolution_change_count(version) }.max.to_i

  version_data = versions.each_with_index.map do |version, index|
    evolution_version_data(
      version,
      index: index,
      total: versions.length,
      max_changes: max_changes
    ).merge(
      current: index == versions.length - 1,
      compare_url:
        if local_assigns[:compare_url_template].present?
          compare_url_template.to_s.gsub(
            "__VERSION_ID__",
            evolution_version_id(version).to_s
          )
        else
          evolution_version_path(version)
        end
    )
  end

  version_data.each_with_index do |item, index|
    item[:current] = index == version_data.length - 1
  end
%>

<section
  class="
    relative
    my-10
    overflow-hidden
    rounded-[38px]
    border-2
    border-orange-100
    bg-gradient-to-b
    from-white
    via-orange-50/20
    to-violet-50/20
    p-5
    shadow-md
    shadow-orange-100/40
    md:p-8
  "
  data-controller="version-evolution"
  tabindex="0"
  aria-label="Version evolution timeline">


  <!-- Ambient glow -->

  <div
    class="
      pointer-events-none
      absolute
      -right-32
      -top-32
      h-72
      w-72
      rounded-full
      bg-orange-100/40
      blur-3xl
    ">
  </div>

  <div
    class="
      pointer-events-none
      absolute
      -bottom-40
      -left-40
      h-80
      w-80
      rounded-full
      bg-violet-100/30
      blur-3xl
    ">
  </div>


  <!-- Header -->

  <div
    class="
      relative
      z-10
      flex
      flex-col
      gap-5
      border-b-2
      border-orange-100
      pb-6
      lg:flex-row
      lg:items-center
      lg:justify-between
    ">

    <div class="flex items-start gap-4">

      <div
        class="
          flex
          h-12
          w-12
          shrink-0
          items-center
          justify-center
          rounded-2xl
          border
          border-orange-200
          bg-orange-100
          text-xl
          shadow-sm
          shadow-orange-100
        ">
        🧬
      </div>

      <div>

        <div
          class="
            text-[9px]
            font-black
            uppercase
            tracking-[0.2em]
            text-orange-500
          ">
          Step 08 · Evolution intelligence
        </div>

        <h3
          class="
            mt-1
            text-xl
            font-black
            tracking-tight
            text-slate-800
            md:text-2xl
          ">
          Version Evolution Timeline
        </h3>

        <p
          class="
            mt-1
            max-w-2xl
            text-xs
            font-medium
            leading-6
            text-slate-400
          ">
          Follow how this knowledge changed over time,
          identify major evolution points, and jump directly
          into the versions that deserve deeper investigation.
        </p>

      </div>

    </div>


    <div
      class="
        flex
        shrink-0
        items-center
        gap-2
      ">

      <span
        class="
          rounded-full
          border
          border-violet-200
          bg-violet-50
          px-3
          py-1.5
          text-[10px]
          font-black
          uppercase
          tracking-wider
          text-violet-700
        ">
        ✦ Intelligence layer
      </span>

      <span
        class="
          rounded-full
          border
          border-orange-200
          bg-orange-50
          px-3
          py-1.5
          text-[10px]
          font-black
          text-orange-600
        ">
        <%= versions.length %> versions
      </span>

    </div>

  </div>


  <!-- Timeline summary -->

  <div
    class="
      relative
      z-10
      mt-6
      grid
      gap-3
      sm:grid-cols-3
    ">

    <div
      class="
        rounded-2xl
        border
        border-orange-100
        bg-white/80
        p-4
      ">

      <div
        class="
          text-[9px]
          font-black
          uppercase
          tracking-widest
          text-slate-400
        ">
        Total evolution
      </div>

      <div
        class="
          mt-1
          text-2xl
          font-black
          text-orange-600
        ">
        <%= versions.length %>
      </div>

      <div
        class="
          text-[10px]
          font-bold
          text-slate-400
        ">
        recorded versions
      </div>

    </div>


    <div
      class="
        rounded-2xl
        border
        border-violet-100
        bg-white/80
        p-4
      ">

      <div
        class="
          text-[9px]
          font-black
          uppercase
          tracking-widest
          text-slate-400
        ">
        Change volume
      </div>

      <div
        class="
          mt-1
          text-2xl
          font-black
          text-violet-600
        ">
        <%= version_data.sum { |item| item[:changes_count] } %>
      </div>

      <div
        class="
          text-[10px]
          font-bold
          text-slate-400
        ">
        tracked changes
      </div>

    </div>


    <div
      class="
        rounded-2xl
        border
        border-emerald-100
        bg-white/80
        p-4
      ">

      <div
        class="
          text-[9px]
          font-black
          uppercase
          tracking-widest
          text-slate-400
        ">
        Review coverage
      </div>

      <%
        reviewed_count = version_data.count { |item| item[:reviewed] }

        review_percentage =
          if version_data.empty?
            0
          else
            ((reviewed_count.to_f / version_data.length) * 100).round
          end
      %>

      <div
        class="
          mt-1
          text-2xl
          font-black
          text-emerald-600
        ">
        <%= review_percentage %>%
      </div>

      <div
        class="
          text-[10px]
          font-bold
          text-slate-400
        ">
        history reviewed
      </div>

    </div>

  </div>


  <!-- Navigation -->

  <div
    class="
      relative
      z-10
      mt-8
      flex
      flex-col
      gap-3
      md:flex-row
      md:items-center
      md:justify-between
    ">

    <div
      class="
        flex
        items-center
        gap-2
      ">

      <button
        type="button"
        data-version-evolution-target="previousButton"
        data-action="version-evolution#previous"
        class="
          rounded-xl
          border
          border-slate-200
          bg-white
          px-3
          py-2
          text-xs
          font-black
          text-slate-600
          shadow-sm
          transition
          hover:border-orange-200
          hover:text-orange-600
          disabled:cursor-not-allowed
          disabled:opacity-40
        ">
        ← Previous
      </button>

      <button
        type="button"
        data-version-evolution-target="nextButton"
        data-action="version-evolution#next"
        class="
          rounded-xl
          border
          border-slate-200
          bg-white
          px-3
          py-2
          text-xs
          font-black
          text-slate-600
          shadow-sm
          transition
          hover:border-orange-200
          hover:text-orange-600
          disabled:cursor-not-allowed
          disabled:opacity-40
        ">
        Next →
      </button>

    </div>


    <div
      class="
        flex
        items-center
        gap-3
      ">

      <span
        class="
          text-[9px]
          font-black
          uppercase
          tracking-widest
          text-slate-400
        ">
        Timeline position
      </span>

      <span
        data-version-evolution-target="position"
        class="
          rounded-full
          bg-slate-100
          px-3
          py-1
          text-[10px]
          font-black
          text-slate-600
        ">
        <%= versions.length %> / <%= versions.length %>
      </span>

    </div>

  </div>


  <!-- Timeline -->

  <div
    class="
      relative
      z-10
      mt-8
    ">

    <div
      data-version-evolution-scroll
      class="
        overflow-x-auto
        overscroll-x-contain
        pb-4
        scrollbar-thin
        scrollbar-track-orange-50
        scrollbar-thumb-orange-200
      ">

      <div
        class="
          relative
          min-w-max
          px-4
          pb-3
          pt-6
        ">

        <!-- Base timeline -->

        <div
          class="
            absolute
            left-12
            right-12
            top-[53px]
            h-2
            rounded-full
            bg-slate-100
          ">
        </div>


        <!-- Evolution progress -->

        <div
          class="
            absolute
            left-12
            top-[53px]
            h-2
            rounded-full
            bg-gradient-to-r
            from-orange-400
            via-violet-400
            to-emerald-400
            shadow-sm
            shadow-orange-200
            transition-all
            duration-700
          "
          data-version-evolution-target="progress"
          style="width: 100%;">
        </div>


        <!-- Nodes -->

        <div
          class="
            relative
            flex
            items-start
            gap-5
          ">

          <% version_data.each do |item| %>

            <%= render(
                  partial: "comparisons/version_evolution_node",
                  locals: {
                    version_data: item
                  }
                ) %>

          <% end %>

        </div>

      </div>

    </div>

  </div>


  <!-- Inspector -->

  <%= render(
        partial: "comparisons/version_evolution_inspector"
      ) %>


  <!-- Legend -->

  <%= render(
        partial: "comparisons/version_evolution_legend"
      ) %>


  <!-- Accessibility -->

  <div
    class="sr-only"
    aria-live="polite"
    data-version-evolution-target="liveRegion">
  </div>


  <div
    class="
      mt-5
      text-center
      text-[9px]
      font-medium
      text-slate-400
    ">
    Use
    <kbd class="font-black">←</kbd>
    <span class="mx-1">/</span>
    <kbd class="font-black">→</kbd>
    to navigate evolution history
  </div>

</section>