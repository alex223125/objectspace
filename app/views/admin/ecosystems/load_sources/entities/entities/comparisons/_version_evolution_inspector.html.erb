<div
  data-version-evolution-target="inspector"
  class="
    mt-8
    rounded-[30px]
    border-2
    border-orange-100
    bg-gradient-to-br
    from-white
    via-orange-50/30
    to-violet-50/30
    p-5
    shadow-sm
  ">

  <div
    class="
      flex
      flex-col
      gap-5
      lg:flex-row
      lg:items-center
      lg:justify-between
    ">

    <div class="flex items-start gap-4">

      <div
        class="
          flex
          h-12
          w-12
          shrink-0
          items-center
          justify-center
          rounded-2xl
          border
          border-orange-200
          bg-orange-100
          text-xl
          shadow-sm
        ">
        🔎
      </div>

      <div>

        <div
          class="
            text-[9px]
            font-black
            uppercase
            tracking-[0.18em]
            text-orange-500
          ">
          Selected evolution point
        </div>

        <h4
          data-version-evolution-target="selectedLabel"
          class="
            mt-1
            text-lg
            font-black
            tracking-tight
            text-slate-800
          ">
          Version
        </h4>

        <div
          class="
            mt-1
            flex
            flex-wrap
            items-center
            gap-x-3
            gap-y-1
            text-[10px]
            font-medium
            text-slate-400
          ">

          <span data-version-evolution-target="selectedDate">
            Date unavailable
          </span>

          <span class="text-slate-200">•</span>

          <span data-version-evolution-target="selectedChanges">
            0 changes
          </span>

        </div>

      </div>

    </div>


    <div
      class="
        flex
        flex-wrap
        items-center
        gap-2
      ">

      <span
        data-version-evolution-target="selectedIntensity"
        class="
          rounded-full
          border
          border-violet-200
          bg-violet-50
          px-3
          py-1.5
          text-[10px]
          font-black
          uppercase
          tracking-wider
          text-violet-700
        ">
        Evolution activity
      </span>

      <span
        data-version-evolution-target="selectedReview"
        class="
          rounded-full
          border
          border-slate-200
          bg-white
          px-3
          py-1.5
          text-[10px]
          font-bold
          text-slate-500
        ">
        Needs review
      </span>

    </div>

  </div>


  <div
    class="
      mt-5
      grid
      gap-4
      lg:grid-cols-[1fr_auto]
      lg:items-end
    ">

    <div
      class="
        rounded-2xl
        border
        border-slate-100
        bg-white/80
        p-4
      ">

      <div
        class="
          text-[9px]
          font-black
          uppercase
          tracking-[0.16em]
          text-slate-400
        ">
        Evolution summary
      </div>

      <p
        data-version-evolution-target="selectedSummary"
        class="
          mt-2
          max-w-3xl
          text-xs
          font-medium
          leading-6
          text-slate-500
        ">
        No change summary has been recorded for this version.
      </p>

    </div>


    <a
      data-version-evolution-target="compareButton"
      href="#"
      class="
        inline-flex
        items-center
        justify-center
        gap-2
        rounded-2xl
        border-2
        border-orange-200
        bg-gradient-to-r
        from-orange-400
        to-amber-400
        px-5
        py-3
        text-xs
        font-black
        text-white
        shadow-md
        shadow-orange-200/50
        transition-all
        duration-300
        hover:-translate-y-0.5
        hover:from-orange-500
        hover:to-amber-500
        hover:shadow-lg
      "
      aria-disabled="true">

      <span>Compare this version</span>
      <span>→</span>

    </a>

  </div>

</div>