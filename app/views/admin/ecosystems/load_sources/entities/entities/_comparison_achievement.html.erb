<%
  total =
    local_assigns.fetch(:total, 0).to_i

  changes =
    local_assigns.fetch(:changes, 0).to_i

  warnings =
    local_assigns.fetch(:warnings, 0).to_i

  level =
    if total >= 100
      "Comparison Master"
    elsif total >= 50
      "Deep Explorer"
    elsif total >= 20
      "Pattern Hunter"
    elsif total > 0
      "Explorer"
    else
      "Ready to explore"
    end

  xp =
    [total * 10, 1000].min

  progress =
    [xp, 1000].min
%>

<div
  class="rounded-[28px]
         border border-violet-100
         bg-gradient-to-br
         from-violet-50
         via-white
         to-orange-50/60
         p-5
         shadow-sm">

  <div
    class="flex flex-col gap-5
           sm:flex-row sm:items-center
           sm:justify-between">

    <div class="flex items-start gap-4">

      <div
        class="flex h-12 w-12 shrink-0
               items-center justify-center
               rounded-2xl
               border border-violet-200
               bg-violet-100
               text-lg
               shadow-sm">

        🏆

      </div>

      <div>

        <div
          class="text-[9px]
                 font-black uppercase
                 tracking-widest
                 text-violet-500">

          Comparison achievement

        </div>

        <div
          class="mt-1 text-base
                 font-black text-slate-700">

          <%= level %>

        </div>

        <p
          class="mt-1 text-xs
                 leading-5 text-slate-400">

          <%= total %> discovered facts ·
          <%= changes %> content changes ·
          <%= warnings %> identity signals

        </p>

      </div>

    </div>


    <div class="text-right">

      <div
        class="text-2xl font-black
               text-violet-600">

        +<%= xp %>

      </div>

      <div
        class="text-[9px]
               font-black uppercase
               tracking-widest
               text-slate-400">

        XP earned

      </div>

    </div>

  </div>


  <div class="mt-5">

    <div
      class="mb-2 flex items-center
             justify-between">

      <span
        class="text-[9px]
               font-black uppercase
               tracking-widest
               text-slate-400">

        Next level

      </span>

      <span
        class="text-[10px]
               font-black
               text-violet-500">

        <%= progress %>%

      </span>

    </div>

    <div
      class="h-2 overflow-hidden
             rounded-full
             bg-white
             border border-violet-100">

      <div
        class="h-full rounded-full
               bg-gradient-to-r
               from-violet-400
               to-fuchsia-400
               transition-all duration-700"
        style="width: <%= progress %>%;">
      </div>

    </div>

  </div>

</div>