<section
  class="
    mt-8
    overflow-hidden
    rounded-[34px]
    border-2 border-orange-100
    bg-gradient-to-br
    from-white
    via-orange-50/20
    to-violet-50/30
    shadow-xl shadow-orange-100/20
  "
  data-controller="entity-comparison-insights"
>

  <!-- ====================================================== -->
  <!-- HEADER -->
  <!-- ====================================================== -->

  <div
    class="
      border-b border-orange-100
      px-6 py-7
      md:px-7
    "
  >

    <div
      class="
        flex flex-col gap-5
        lg:flex-row
        lg:items-center
        lg:justify-between
      "
    >

      <div class="flex items-start gap-4">

        <div
          class="
            flex h-13 w-13 shrink-0
            items-center justify-center
            rounded-[20px]
            border border-orange-200
            bg-orange-100
            text-xl
            shadow-sm
          "
        >
          ✨
        </div>

        <div>

          <div
            class="
              text-[10px]
              font-black
              uppercase
              tracking-[0.2em]
              text-orange-500
            "
          >
            Evolution intelligence
          </div>

          <h3
            class="
              mt-1
              text-xl
              font-black
              tracking-tight
              text-slate-800
            "
          >
            What changed — and why it matters
          </h3>

          <p
            class="
              mt-2
              max-w-2xl
              text-xs
              leading-6
              text-slate-400
            "
          >
            Transforming comparison signals into
            human-readable insights so reviewers can
            understand the evolution faster.
          </p>

        </div>

      </div>

      <div
        class="
          flex w-fit items-center gap-2
          rounded-full
          border border-orange-200
          bg-orange-50
          px-3.5 py-2
          text-[10px]
          font-black
          uppercase
          tracking-wider
          text-orange-600
        "
      >
        <span
          class="
            h-2 w-2
            rounded-full
            bg-emerald-400
            shadow-[0_0_8px_rgba(52,211,153,0.7)]
          "
        ></span>

        Live analysis

      </div>

    </div>

  </div>


  <!-- ====================================================== -->
  <!-- SCORE STRIP -->
  <!-- ====================================================== -->

  <div
    class="
      grid
      grid-cols-2
      gap-3
      border-b border-orange-100
      p-5
      md:grid-cols-4
    "
  >

    <!-- Attention -->

    <div
      class="
        rounded-2xl
        border border-amber-100
        bg-amber-50/50
        p-4
      "
    >

      <div
        class="
          text-[9px]
          font-black
          uppercase
          tracking-widest
          text-amber-500
        "
      >
        Attention
      </div>

      <div
        class="
          mt-2
          text-2xl
          font-black
          text-amber-700
        "
        data-entity-comparison-insights-target="attention"
      >
        0
      </div>

      <div
        class="
          mt-3
          h-1.5
          overflow-hidden
          rounded-full
          bg-white
        "
        data-insight-progress
      >

        <div
          data-insight-bar
          class="
            h-full
            w-0
            rounded-full
            bg-gradient-to-r
            from-amber-400
            to-orange-400
            transition-all
            duration-700
          "
        ></div>

      </div>

    </div>


    <!-- Impact -->

    <div
      class="
        rounded-2xl
        border border-orange-100
        bg-orange-50/50
        p-4
      "
    >

      <div
        class="
          text-[9px]
          font-black
          uppercase
          tracking-widest
          text-orange-500
        "
      >
        Impact
      </div>

      <div
        class="
          mt-2
          text-2xl
          font-black
          text-orange-700
        "
        data-entity-comparison-insights-target="impact"
      >
        0
      </div>

      <div
        class="
          mt-3
          h-1.5
          overflow-hidden
          rounded-full
          bg-white
        "
        data-insight-progress
      >

        <div
          data-insight-bar
          class="
            h-full
            w-0
            rounded-full
            bg-gradient-to-r
            from-orange-400
            to-rose-400
            transition-all
            duration-700
          "
        ></div>

      </div>

    </div>


    <!-- Structure -->

    <div
      class="
        rounded-2xl
        border border-violet-100
        bg-violet-50/50
        p-4
      "
    >

      <div
        class="
          text-[9px]
          font-black
          uppercase
          tracking-widest
          text-violet-500
        "
      >
        Structure
      </div>

      <div
        class="
          mt-2
          text-2xl
          font-black
          text-violet-700
        "
        data-entity-comparison-insights-target="structure"
      >
        0
      </div>

      <div
        class="
          mt-3
          h-1.5
          overflow-hidden
          rounded-full
          bg-white
        "
        data-insight-progress
      >

        <div
          data-insight-bar
          class="
            h-full
            w-0
            rounded-full
            bg-gradient-to-r
            from-violet-400
            to-indigo-400
            transition-all
            duration-700
          "
        ></div>

      </div>

    </div>


    <!-- Review -->

    <div
      class="
        rounded-2xl
        border border-emerald-100
        bg-emerald-50/50
        p-4
      "
    >

      <div
        class="
          text-[9px]
          font-black
          uppercase
          tracking-widest
          text-emerald-500
        "
      >
        Reviewed
      </div>

      <div
        class="
          mt-2
          text-2xl
          font-black
          text-emerald-700
        "
        data-entity-comparison-insights-target="review"
      >
        0
      </div>

      <div
        class="
          mt-3
          h-1.5
          overflow-hidden
          rounded-full
          bg-white
        "
        data-insight-progress
      >

        <div
          data-insight-bar
          class="
            h-full
            w-0
            rounded-full
            bg-gradient-to-r
            from-sky-400
            to-emerald-400
            transition-all
            duration-700
          "
        ></div>

      </div>

    </div>

  </div>


  <!-- ====================================================== -->
  <!-- SUMMARY -->
  <!-- ====================================================== -->

  <div class="px-5 pt-5 md:px-6">

    <div
      class="
        rounded-[24px]
        border border-slate-100
        bg-white
        px-5 py-4
        shadow-sm
      "
    >

      <div
        class="
          flex
          items-start
          gap-3
        "
      >

        <div
          class="
            flex h-9 w-9 shrink-0
            items-center justify-center
            rounded-xl
            bg-slate-100
            text-sm
          "
        >
          💡
        </div>

        <p
          class="
            text-xs
            leading-6
            font-semibold
            text-slate-500
          "
          data-entity-comparison-insights-target="summary"
        >
          Analyzing comparison...
        </p>

      </div>

    </div>

  </div>


  <!-- ====================================================== -->
  <!-- INSIGHT CARDS -->
  <!-- ====================================================== -->

  <div class="px-5 py-5 md:px-6">

    <div
      class="
        mb-4
        flex
        items-center
        justify-between
      "
    >

      <div>

        <div
          class="
            text-xs
            font-black
            text-slate-700
          "
        >
          Insight cards
        </div>

        <div
          class="
            mt-1
            text-[11px]
            text-slate-400
          "
        >
          High-level interpretation of the current version evolution.
        </div>

      </div>

      <span
        class="
          hidden
          rounded-full
          bg-slate-100
          px-3 py-1
          text-[9px]
          font-black
          uppercase
          tracking-widest
          text-slate-500
          md:block
        "
      >
        Automated
      </span>

    </div>


    <div
      class="
        grid
        gap-4
        md:grid-cols-2
      "
      data-entity-comparison-insights-target="grid"
    >
    </div>

  </div>


  <!-- ====================================================== -->
  <!-- EVOLUTION FLOW -->
  <!-- ====================================================== -->

  <div
    class="
      border-t
      border-orange-100
      px-5 py-6
      md:px-6
    "
  >

    <div class="mb-5">

      <div
        class="
          text-xs
          font-black
          text-slate-700
        "
      >
        Evolution flow
      </div>

      <div
        class="
          mt-1
          text-[11px]
          text-slate-400
        "
      >
        A compact narrative of the structural changes detected.
      </div>

    </div>

    <div
      class="space-y-1"
      data-entity-comparison-insights-target="timeline"
    >
    </div>

  </div>

</section>