<%# ============================================================================
ENTITY — SHOW

Path:
app/views/admin/ecosystems/load_sources/entities/entities/show.html.erb

Purpose:
Administrative detail view for an Entity.

Important structural resolution:

Entity belongs to EntityTemplateVersion
EntityTemplateVersion has_many EntityTemplateFields
EntityTemplateField belongs_to EntityTemplateVersion
Entity values are resolved from the persisted entity payload/attributes
Template fields are used as the structural definition
This view is intentionally defensive so it can work while the underlying
Entity storage evolves.
============================================================================ %>

<%
  # ==========================================================================
  # SAFE DEFAULTS
  # ==========================================================================
  entity = @entity

  template =
    if entity.respond_to?(:entity_template)
      entity.entity_template
    elsif entity.respond_to?(:entity_template_version) &&
      entity.entity_template_version.present? &&
      entity.entity_template_version.respond_to?(:entity_template)
      entity.entity_template_version.entity_template
    end

  template_version =
    if entity.respond_to?(:entity_template_version)
      entity.entity_template_version
    elsif entity.respond_to?(:template_version)
      entity.template_version
    end

  entity_id =
    if entity.respond_to?(:id)
      entity.id
    else
      "—"
    end

  entity_name =
    if entity.respond_to?(:name) && entity.name.present?
      entity.name.to_s
    elsif entity.respond_to?(:title) && entity.title.present?
      entity.title.to_s
    elsif entity.respond_to?(:label) && entity.label.present?
      entity.label.to_s
    else
      "Entity ##{entity_id}"
    end

  entity_status =
    if entity.respond_to?(:status) && entity.status.present?
      entity.status.to_s
    else
      "unknown"
    end

  entity_identifier =
    if entity.respond_to?(:identifier) && entity.identifier.present?
      entity.identifier.to_s
    elsif entity.respond_to?(:slug) && entity.slug.present?
      entity.slug.to_s
    elsif entity.respond_to?(:external_id) && entity.external_id.present?
      entity.external_id.to_s
    else
      nil
    end

  entity_description =
    if entity.respond_to?(:description) && entity.description.present?
      entity.description.to_s
    elsif entity.respond_to?(:summary) && entity.summary.present?
      entity.summary.to_s
    else
      nil
    end

  version_number =
    if template_version.respond_to?(:version)
      template_version.version
    elsif entity.respond_to?(:version)
      entity.version
    elsif entity.respond_to?(:version_number)
      entity.version_number
    end

  created_at =
    if entity.respond_to?(:created_at)
      entity.created_at
    end

  updated_at =
    if entity.respond_to?(:updated_at)
      entity.updated_at
    end

  published_at =
    if entity.respond_to?(:published_at)
      entity.published_at
    end

  # ==========================================================================
  # STATUS PRESENTATION
  # ==========================================================================
  status_badge =
    case entity_status.downcase

    when "published"

      {
        label: "Published",
        classes:
          "bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400",
        icon: "✓"
      }

    when "draft"

      {
        label: "Draft",
        classes:
          "bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400",
        icon: "◐"
      }

    when "archived"

      {
        label: "Archived",
        classes:
          "bg-gray-100 text-gray-600 dark:bg-gray-900 dark:text-gray-400",
        icon: "◌"
      }

    when "active"

      {
        label: "Active",
        classes:
          "bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400",
        icon: "●"
      }

    else

      {
        label: entity_status.humanize,
        classes:
          "bg-gray-100 text-gray-600 dark:bg-gray-900 dark:text-gray-400",
        icon: "?"
      }

    end

#   ==========================================================================
#   ENTITY PAYLOAD
#   Do NOT use entity.attributes directly as the displayed entity data.
#     ActiveRecord's attributes contains database columns and would therefore
# expose id/status/timestamps/etc.
# We first look for dedicated payload columns such as data and
# attributes_data.
# ==========================================================================
entity_payload = {}

if entity.respond_to?(:data)

candidate = entity.data

if candidate.respond_to?(:to_h)
  candidate = candidate.to_h
end

entity_payload = candidate if candidate.is_a?(Hash)

end

if entity_payload.blank? && entity.respond_to?(:attributes_data)

candidate = entity.attributes_data

if candidate.respond_to?(:to_h)
  candidate = candidate.to_h
end

entity_payload = candidate if candidate.is_a?(Hash)

end

# ==========================================================================
# FALLBACK PAYLOAD RESOLUTION
# Some Entity implementations may expose the dynamic values through
# methods such as entity_attributes or fields.
# ==========================================================================
if entity_payload.blank? && entity.respond_to?(:entity_attributes)

candidate = entity.entity_attributes

if candidate.respond_to?(:to_h)
  candidate = candidate.to_h
end

entity_payload = candidate if candidate.is_a?(Hash)

end

if entity_payload.blank? && entity.respond_to?(:fields)

candidate = entity.fields

if candidate.respond_to?(:to_h)
  candidate = candidate.to_h
end

entity_payload = candidate if candidate.is_a?(Hash)

end

entity_payload =
{} unless entity_payload.is_a?(Hash)

# Normalize keys so lookup works regardless of string/symbol JSON keys.
normalized_entity_payload = {}

entity_payload.each do |key, value|
normalized_entity_payload[key.to_s] = value
end

# ==========================================================================
# TEMPLATE FIELDS
# THIS IS THE IMPORTANT FIX.
# EntityTemplateVersion has_many :entity_template_fields.
# Therefore the fields displayed under "Entity Data" should be resolved
# from the entity's template version.
#   ==========================================================================
                                              template_fields = []

  if template_version.present? &&
    template_version.respond_to?(:entity_template_fields)

    candidate_fields =
      template_version.entity_template_fields

    template_fields =
      candidate_fields.to_a

  end

  # ==========================================================================
  # FIELD HELPERS
  # ==========================================================================
  field_name_for =
    lambda do |field|

      if field.respond_to?(:name) && field.name.present?
        field.name.to_s
      elsif field.respond_to?(:key) && field.key.present?
        field.key.to_s
      elsif field.respond_to?(:identifier) && field.identifier.present?
        field.identifier.to_s
      elsif field.respond_to?(:slug) && field.slug.present?
        field.slug.to_s
      else
        "field_#{field.respond_to?(:id) ? field.id : "unknown"}"
      end

    end

  field_label_for =
    lambda do |field|

      if field.respond_to?(:label) && field.label.present?
        field.label.to_s
      elsif field.respond_to?(:display_name) && field.display_name.present?
        field.display_name.to_s
      elsif field.respond_to?(:title) && field.title.present?
        field.title.to_s
      elsif field.respond_to?(:name) && field.name.present?
        field.name.to_s.humanize
      elsif field.respond_to?(:key) && field.key.present?
        field.key.to_s.humanize
      elsif field.respond_to?(:identifier) && field.identifier.present?
        field.identifier.to_s.humanize
      else
        field_name_for.call(field).humanize
      end

    end

  field_type_for =
    lambda do |field|

      if field.respond_to?(:field_type) && field.field_type.present?
        field.field_type.to_s
      elsif field.respond_to?(:data_type) && field.data_type.present?
        field.data_type.to_s
      elsif field.respond_to?(:type) && field.type.present?
        field.type.to_s
      elsif field.respond_to?(:kind) && field.kind.present?
        field.kind.to_s
      else
        "value"
      end

    end

  # ==========================================================================
  # VALUE RESOLUTION
  # Try several common key forms:
  #                          field.name
  # field.key
  # field.identifier
  # field.slug
  # This lets the template definition and persisted JSON remain compatible
  # even if they use different naming conventions.
  #   ==========================================================================
                                      value_for_field =
                                        lambda do |field|

    possible_keys = []

    %i[name key identifier slug].each do |attribute_name|

      if field.respond_to?(attribute_name)

        candidate =
          field.public_send(attribute_name)

        if candidate.present?
          possible_keys << candidate.to_s
        end

      end

    end

    possible_keys =
      possible_keys.uniq

    found = false
    value = nil

    possible_keys.each do |key|

      if normalized_entity_payload.key?(key)

        value = normalized_entity_payload[key]
        found = true
        break

      end

    end

    unless found

      # Also support nested string/symbol keys in case the original payload

      # was not normalized deeply.

      possible_keys.each do |key|

        symbol_key =
          begin
            key.to_sym
          rescue
            nil
          end

        if symbol_key && entity_payload.key?(symbol_key)

          value = entity_payload[symbol_key]
          found = true
          break

        end

      end

    end

    [found, value]

  end

  # ==========================================================================
  #   RESOLVED ENTITY DATA
  # Each item contains:
  #             field
  # key
  # label
  # type
  # value
  # present
  # This allows the view to show the structural definition even when a field
  # currently has no persisted value.
  #   ==========================================================================
                               resolved_fields = []

  template_fields.each do |field|

    key =
      field_name_for.call(field)

    label =
      field_label_for.call(field)

    type =
      field_type_for.call(field)

    present_value, value =
      value_for_field.call(field)

    resolved_fields << {
      field: field,
      key: key,
      label: label,
      type: type,
      value: value,
      present: present_value
    }

  end

  # ==========================================================================
  # EXTRA PAYLOAD VALUES
  # If the entity contains persisted values that are NOT currently represented
  # by the template version, show them under "Additional persisted values".
  # ==========================================================================
                                             defined_field_keys =
                                               resolved_fields.map { |item| item[:key].to_s }

  extra_payload =
    normalized_entity_payload.reject do |key, _value|

      key.to_s.in?(defined_field_keys) ||
        key.to_s.in?(%w[
      id
      created_at
      updated_at
      deleted_at
    ])

    end

  # ==========================================================================
  # DISPLAY COUNTS
  # ==========================================================================
  field_count =
    if template_fields.present?

      template_fields.size

    elsif entity.respond_to?(:field_count) &&
      entity.field_count.present?

      entity.field_count

    elsif entity_payload.present?

      entity_payload.size

    else

      0
    end

  section_count =
    if entity.respond_to?(:section_count)

      entity.section_count

    elsif entity.respond_to?(:sections) &&
      entity.sections.respond_to?(:size)

      entity.sections.size

    end

  # ==========================================================================
  # URLS
  # ==========================================================================
  entities_path =
    admin_ecosystems_load_sources_entities_path

  entity_path =
    admin_ecosystems_load_sources_entity_path(@entity)

  edit_entity_path =
    edit_admin_ecosystems_load_sources_entity_path(@entity)

  clone_entity_path =
    clone_admin_ecosystems_load_sources_entity_path(@entity)

  archive_entity_path =
    archive_admin_ecosystems_load_sources_entity_path(@entity)

  restore_entity_path =
    restore_admin_ecosystems_load_sources_entity_path(@entity)

  publish_entity_path =
    publish_admin_ecosystems_load_sources_entity_path(@entity)

  deprecate_entity_path =
    deprecate_admin_ecosystems_load_sources_entity_path(@entity)

  compare_entity_path =
    compare_admin_ecosystems_load_sources_entity_path(@entity)

  template_path =
    if template.present?

      begin

        admin_ecosystems_load_sources_entity_templates_entity_template_path(template)

      rescue

        nil

      end

    end

  version_path =
    if template_version.present?

      begin

        admin_ecosystems_load_sources_entity_templates_entity_template_version_path(template_version)

      rescue

        nil

      end

    end
%>

