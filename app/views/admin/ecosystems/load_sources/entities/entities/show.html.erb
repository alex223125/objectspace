            <% resolved_fields.each_with_index do |item, index| %>

              <% field = item[:field] %>
              <% key = item[:key] %>
              <% label = item[:label] %>
              <% type = item[:type] %>
              <% value = item[:value] %>
              <% has_value = item[:present] %>

              <div
                class="entity-field-row px-6 py-5 transition hover:bg-violet-50/40 dark:hover:bg-violet-950/10"
