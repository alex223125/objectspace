<%# ============================================================================
ENTITY — SHOW

Path:
app/views/admin/ecosystems/load_sources/entities/entities/show.html.erb

Purpose:
Administrative detail view for an Entity.
============================================================================ %>

<%
  # ============================================================================
  # SAFE DEFAULTS
  # ============================================================================

  entity = @entity

  template =
    if entity.respond_to?(:entity_template)
      entity.entity_template
    elsif entity.respond_to?(:entity_template_version) &&
      entity.entity_template_version.present? &&
      entity.entity_template_version.respond_to?(:entity_template)
      entity.entity_template_version.entity_template
    end

  template_version =
    if entity.respond_to?(:entity_template_version)
      entity.entity_template_version
    elsif entity.respond_to?(:template_version)
      entity.template_version
    end

  entity_id =
    if entity.respond_to?(:id)
      entity.id
    else
      "—"
    end

  entity_name =
    if entity.respond_to?(:name) && entity.name.present?
      entity.name.to_s
    elsif entity.respond_to?(:title) && entity.title.present?
      entity.title.to_s
    elsif entity.respond_to?(:label) && entity.label.present?
      entity.label.to_s
    else
      "Entity ##{entity_id}"
    end

  entity_status =
    if entity.respond_to?(:status) && entity.status.present?
      entity.status.to_s
    else
      "unknown"
    end

  normalized_status = entity_status.to_s.downcase

  entity_identifier =
    if entity.respond_to?(:identifier) && entity.identifier.present?
      entity.identifier.to_s
    elsif entity.respond_to?(:slug) && entity.slug.present?
      entity.slug.to_s
    elsif entity.respond_to?(:external_id) && entity.external_id.present?
      entity.external_id.to_s
    end

  entity_description =
    if entity.respond_to?(:description) && entity.description.present?
      entity.description.to_s
    elsif entity.respond_to?(:summary) && entity.summary.present?
      entity.summary.to_s
    end

  version_number =
    if template_version.respond_to?(:version)
      template_version.version
    elsif entity.respond_to?(:version)
      entity.version
    elsif entity.respond_to?(:version_number)
      entity.version_number
    end

  created_at =
    entity.created_at if entity.respond_to?(:created_at)

  updated_at =
    entity.updated_at if entity.respond_to?(:updated_at)

  published_at =
    entity.published_at if entity.respond_to?(:published_at)

  # ============================================================================
  # STATUS PRESENTATION
  # ============================================================================

  status_badge =
    case normalized_status
    when "published"
      {
        label: "Published",
        classes: "bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400",
        icon: "✓"
      }
    when "draft"
      {
        label: "Draft",
        classes: "bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400",
        icon: "◐"
      }
    when "archived"
      {
        label: "Archived",
        classes: "bg-gray-100 text-gray-600 dark:bg-gray-900 dark:text-gray-400",
        icon: "◌"
      }
    when "deprecated"
      {
        label: "Deprecated",
        classes: "bg-rose-100 text-rose-700 dark:bg-rose-900/30 dark:text-rose-400",
        icon: "!"
      }
    when "active"
      {
        label: "Active",
        classes: "bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400",
        icon: "●"
      }
    else
      {
        label: entity_status.to_s.humanize,
        classes: "bg-gray-100 text-gray-600 dark:bg-gray-900 dark:text-gray-400",
        icon: "?"
      }
    end

  # ============================================================================
  # ENTITY PAYLOAD
  #
  # Do NOT use entity.attributes directly as displayed entity data.
  # ActiveRecord's attributes contains database columns.
  # ============================================================================

  entity_payload = {}

  if entity.respond_to?(:data)
    candidate = entity.data
    candidate = candidate.to_h if candidate.respond_to?(:to_h)

    entity_payload = candidate if candidate.is_a?(Hash)
  end

  if entity_payload.blank? && entity.respond_to?(:attributes_data)
    candidate = entity.attributes_data
    candidate = candidate.to_h if candidate.respond_to?(:to_h)

    entity_payload = candidate if candidate.is_a?(Hash)
  end

  # ============================================================================
  # FALLBACK PAYLOAD RESOLUTION
  # ============================================================================

  if entity_payload.blank? && entity.respond_to?(:entity_attributes)
    candidate = entity.entity_attributes
    candidate = candidate.to_h if candidate.respond_to?(:to_h)

    entity_payload = candidate if candidate.is_a?(Hash)
  end

  if entity_payload.blank? && entity.respond_to?(:fields)
    candidate = entity.fields
    candidate = candidate.to_h if candidate.respond_to?(:to_h)

    entity_payload = candidate if candidate.is_a?(Hash)
  end

  entity_payload = {} unless entity_payload.is_a?(Hash)

  normalized_entity_payload = {}

  entity_payload.each do |key, value|
    normalized_entity_payload[key.to_s] = value
  end

  # ============================================================================
  # TEMPLATE FIELDS
  # ============================================================================

  template_fields = []

  if template_version.present? &&
    template_version.respond_to?(:entity_template_fields)

    template_fields = template_version.entity_template_fields.to_a
  end

  # ============================================================================
  # FIELD HELPERS
  # ============================================================================

  field_name_for =
    lambda do |field|
      if field.respond_to?(:name) && field.name.present?
        field.name.to_s
      elsif field.respond_to?(:key) && field.key.present?
        field.key.to_s
      elsif field.respond_to?(:identifier) && field.identifier.present?
        field.identifier.to_s
      elsif field.respond_to?(:slug) && field.slug.present?
        field.slug.to_s
      else
        "field_#{field.respond_to?(:id) ? field.id : "unknown"}"
      end
    end

  field_label_for =
    lambda do |field|
      if field.respond_to?(:label) && field.label.present?
        field.label.to_s
      elsif field.respond_to?(:display_name) && field.display_name.present?
        field.display_name.to_s
      elsif field.respond_to?(:title) && field.title.present?
        field.title.to_s
      elsif field.respond_to?(:name) && field.name.present?
        field.name.to_s.humanize
      elsif field.respond_to?(:key) && field.key.present?
        field.key.to_s.humanize
      elsif field.respond_to?(:identifier) && field.identifier.present?
        field.identifier.to_s.humanize
      else
        field_name_for.call(field).humanize
      end
    end

  field_type_for =
    lambda do |field|
      if field.respond_to?(:field_type) && field.field_type.present?
        field.field_type.to_s
      elsif field.respond_to?(:data_type) && field.data_type.present?
        field.data_type.to_s
      elsif field.respond_to?(:type) && field.type.present?
        field.type.to_s
      elsif field.respond_to?(:kind) && field.kind.present?
        field.kind.to_s
      else
        "value"
      end
    end

  # ============================================================================
  # VALUE RESOLUTION
  # ============================================================================

  value_for_field =
    lambda do |field|
      possible_keys = []

      %i[name key identifier slug].each do |attribute_name|
        if field.respond_to?(attribute_name)
          candidate = field.public_send(attribute_name)
          possible_keys << candidate.to_s if candidate.present?
        end
      end

      possible_keys = possible_keys.uniq

      found = false
      value = nil

      possible_keys.each do |key|
        if normalized_entity_payload.key?(key)
          value = normalized_entity_payload[key]
          found = true
          break
        end
      end

      unless found
        possible_keys.each do |key|
          symbol_key =
            begin
              key.to_sym
            rescue StandardError
              nil
            end

          if symbol_key && entity_payload.key?(symbol_key)
            value = entity_payload[symbol_key]
            found = true
            break
          end
        end
      end

      [found, value]
    end

  # ============================================================================
  # RESOLVED ENTITY DATA
  # ============================================================================

  resolved_fields = []

  template_fields.each do |field|
    key = field_name_for.call(field)
    label = field_label_for.call(field)
    type = field_type_for.call(field)

    present_value, value = value_for_field.call(field)

    resolved_fields << {
      field: field,
      key: key,
      label: label,
      type: type,
      value: value,
      present: present_value
    }
  end

  # ============================================================================
  # EXTRA PAYLOAD VALUES
  # ============================================================================

  defined_field_keys =
    resolved_fields.map { |item| item[:key].to_s }

  extra_payload =
    normalized_entity_payload.reject do |key, _value|
      key.to_s.in?(defined_field_keys) ||
        key.to_s.in?(%w[
        id
        created_at
        updated_at
        deleted_at
      ])
    end

  # ============================================================================
  # DISPLAY COUNTS
  # ============================================================================

  field_count =
    if template_fields.present?
      template_fields.size
    elsif entity.respond_to?(:field_count) && entity.field_count.present?
      entity.field_count
    elsif entity_payload.present?
      entity_payload.size
    else
      0
    end

  section_count =
    if entity.respond_to?(:section_count)
      entity.section_count
    elsif entity.respond_to?(:sections) &&
      entity.sections.respond_to?(:size)
      entity.sections.size
    end

  # ============================================================================
  # URLS
  # ============================================================================

  entities_path =
    admin_ecosystems_load_sources_entities_path

  entity_path =
    admin_ecosystems_load_sources_entity_path(@entity)

  edit_entity_path =
    edit_admin_ecosystems_load_sources_entity_path(@entity)

  clone_entity_path =
    clone_admin_ecosystems_load_sources_entity_path(@entity)

  archive_entity_path =
    archive_admin_ecosystems_load_sources_entity_path(@entity)

  restore_entity_path =
    restore_admin_ecosystems_load_sources_entity_path(@entity)

  publish_entity_path =
    publish_admin_ecosystems_load_sources_entity_path(@entity)

  deprecate_entity_path =
    deprecate_admin_ecosystems_load_sources_entity_path(@entity)

  compare_entity_path =
    compare_admin_ecosystems_load_sources_entity_path(@entity)

  template_path =
    if template.present?
      begin
        admin_ecosystems_load_sources_entity_templates_entity_template_path(template)
      rescue StandardError
        nil
      end
    end

  version_path =
    if template_version.present?
      begin
        admin_ecosystems_load_sources_entity_templates_entity_template_version_path(template_version)
      rescue StandardError
        nil
      end
    end
%>

<div class="mx-auto w-full max-w-[1600px] px-4 py-6 sm:px-6 lg:px-8">

  <%# =========================================================================
  HEADER
  ========================================================================= %>

  <div class="mb-8">

    <div class="flex flex-col gap-5 xl:flex-row xl:items-center xl:justify-between">

      <div class="min-w-0">

        <div class="flex items-center gap-4">

          <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-violet-100 text-2xl shadow-sm dark:bg-violet-900/40">
            ◈
          </div>

          <div class="min-w-0">

            <div class="mb-1 text-[11px] font-black uppercase tracking-[0.2em] text-violet-500">
              Entity Registry
            </div>

            <h1
              class="truncate text-2xl font-black tracking-tight text-gray-900 sm:text-3xl dark:text-white"
              title="<%= entity_name %>">
              <%= entity_name %>
            </h1>

            <p class="mt-1 max-w-3xl text-sm text-gray-500 dark:text-gray-400">
              Inspect the entity record, structural definition, version lineage
              and persisted attributes.
            </p>

          </div>

        </div>

        <div class="mt-4 flex flex-wrap items-center gap-2 text-xs text-gray-400">
          <span>Encyclopedia</span>
          <span>›</span>
          <span>Ecosystems</span>
          <span>›</span>
          <span>Load Sources</span>
          <span>›</span>
          <span>Entities</span>
          <span>›</span>

          <span class="font-semibold text-violet-500">
            <%= entity_name %>
          </span>
        </div>

      </div>

      <%# HEADER ACTIONS %>

      <div class="flex shrink-0 flex-wrap items-center gap-2">

        <%= link_to entities_path,
                    class: "inline-flex items-center justify-center gap-2 rounded-xl border border-gray-200 bg-white px-4 py-3 text-sm font-semibold text-gray-700 shadow-sm transition hover:border-violet-200 hover:text-violet-600 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300" do %>
          <span>←</span>
          Back to Entities
        <% end %>

        <%= link_to edit_entity_path,
                    class: "inline-flex items-center justify-center gap-2 rounded-xl bg-violet-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-violet-700 focus:outline-none focus:ring-2 focus:ring-violet-500 focus:ring-offset-2" do %>
          <span>✎</span>
          Edit Entity
        <% end %>

        <%= link_to(
              "History",
              history_admin_ecosystems_load_sources_entity_path(@entity)
            ) %>

        <% if @entity.current_version %>

          <p>
            Current version:
            <strong>
              Version <%= @entity.current_version.version_number %>
            </strong>
          </p>

        <% end %>

        <p>
          Versions:
          <strong>
            <%= @entity.versions.count %>
          </strong>
        </p>




      </div>

    </div>

  </div>

  <%# =========================================================================
  ENTITY IDENTITY PANEL
  ========================================================================= %>

  <div class="mb-8 overflow-hidden rounded-2xl border-2 border-violet-100 bg-gradient-to-br from-violet-50 via-white to-indigo-50 shadow-sm dark:border-violet-900/40 dark:from-violet-950/30 dark:via-gray-900 dark:to-indigo-950/30">

    <div class="relative p-6 sm:p-8">

      <div class="pointer-events-none absolute -right-16 -top-16 h-48 w-48 rounded-full bg-violet-200/30 blur-3xl dark:bg-violet-500/10"></div>

      <div class="relative">

        <div class="flex flex-col gap-6 lg:flex-row lg:items-start lg:justify-between">

          <div class="min-w-0">

            <div class="text-[11px] font-black uppercase tracking-[0.2em] text-violet-500">
              Entity Identity
            </div>

            <div class="mt-2 break-words text-2xl font-black text-gray-900 dark:text-white">
              <%= entity_name %>
            </div>

            <% if entity_identifier.present? %>

              <div class="mt-2 inline-flex max-w-full items-center gap-2 rounded-lg border border-gray-200 bg-white px-3 py-2 font-mono text-xs text-gray-500 shadow-sm dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400">
                <span class="text-violet-500">#</span>

                <span class="truncate">
                  <%= entity_identifier %>
                </span>
              </div>

            <% end %>

            <% if entity_description.present? %>

              <p class="mt-4 max-w-3xl text-sm leading-6 text-gray-500 dark:text-gray-400">
                <%= entity_description %>
              </p>

            <% end %>

          </div>

          <div class="shrink-0">

            <span class="inline-flex items-center gap-2 rounded-full px-4 py-2 text-sm font-bold <%= status_badge[:classes] %>">
              <span><%= status_badge[:icon] %></span>
              <%= status_badge[:label] %>
            </span>

          </div>

        </div>

        <%# ACTION TOOLBAR %>

        <div class="mt-7 rounded-2xl border border-gray-200 bg-white/80 p-4 shadow-sm backdrop-blur dark:border-gray-700 dark:bg-gray-900/50">

          <div class="mb-3 flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">

            <div>

              <div class="text-[10px] font-black uppercase tracking-[0.2em] text-gray-400">
                Entity Actions
              </div>

              <div class="mt-1 text-xs text-gray-500 dark:text-gray-400">
                Manage lifecycle, create a copy, or inspect differences.
              </div>

            </div>

            <div class="text-[10px] font-bold uppercase tracking-wider text-gray-400">
              ID #<%= entity_id %>
            </div>

          </div>

          <div class="flex flex-wrap gap-2">

            <% unless normalized_status == "published" %>

              <%= link_to publish_entity_path,
                          method: :post,
                          class: "inline-flex items-center gap-2 rounded-xl bg-emerald-600 px-4 py-2.5 text-xs font-bold text-white shadow-sm transition hover:bg-emerald-700" do %>
                <span>✓</span>
                Publish
              <% end %>

            <% end %>

            <% unless normalized_status == "archived" %>

              <%= link_to archive_entity_path,
                          class: "inline-flex items-center gap-2 rounded-xl border border-gray-200 bg-white px-4 py-2.5 text-xs font-bold text-gray-700 shadow-sm transition hover:border-gray-300 hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300 dark:hover:bg-gray-700" do %>
                <span>◌</span>
                Archive
              <% end %>

            <% end %>

            <% if normalized_status == "archived" %>

              <%= link_to restore_entity_path,
                          class: "inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-4 py-2.5 text-xs font-bold text-white shadow-sm transition hover:bg-indigo-700" do %>
                <span>↺</span>
                Restore
              <% end %>

            <% end %>

            <% unless normalized_status == "deprecated" %>

              <%= link_to deprecate_entity_path,
                          class: "inline-flex items-center gap-2 rounded-xl border border-rose-200 bg-rose-50 px-4 py-2.5 text-xs font-bold text-rose-700 shadow-sm transition hover:bg-rose-100 dark:border-rose-900/40 dark:bg-rose-950/20 dark:text-rose-400" do %>
                <span>!</span>
                Deprecate
              <% end %>

            <% end %>

            <%= link_to clone_entity_path,
                        class: "inline-flex items-center gap-2 rounded-xl border border-violet-200 bg-violet-50 px-4 py-2.5 text-xs font-bold text-violet-700 shadow-sm transition hover:bg-violet-100 dark:border-violet-800 dark:bg-violet-900/20 dark:text-violet-300" do %>
              <span>⧉</span>
              Clone
            <% end %>

            <%= link_to compare_entity_path,
                        class: "inline-flex items-center gap-2 rounded-xl border border-indigo-200 bg-indigo-50 px-4 py-2.5 text-xs font-bold text-indigo-700 shadow-sm transition hover:bg-indigo-100 dark:border-indigo-800 dark:bg-indigo-900/20 dark:text-indigo-300" do %>
              <span>⇄</span>
              Compare
            <% end %>

          </div>

        </div>

        <%# IDENTITY METRICS %>

        <div class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">

          <div class="rounded-xl border border-gray-200 bg-white p-4 dark:border-gray-700 dark:bg-gray-800">
            <div class="text-xl">◈</div>

            <div class="mt-2 text-[10px] font-black uppercase tracking-wider text-gray-400">
              Entity ID
            </div>

            <div class="mt-1 font-mono text-sm font-bold text-gray-800 dark:text-gray-200">
              #<%= entity_id %>
            </div>
          </div>

          <div class="rounded-xl border border-violet-200 bg-violet-50 p-4 dark:border-violet-800 dark:bg-violet-900/20">
            <div class="text-xl">🧬</div>

            <div class="mt-2 text-[10px] font-black uppercase tracking-wider text-violet-500">
              Template Version
            </div>

            <div class="mt-1 text-sm font-bold text-violet-700 dark:text-violet-300">
              <%= version_number.present? ? "v#{version_number}" : "—" %>
            </div>
          </div>

          <div class="rounded-xl border border-indigo-200 bg-indigo-50 p-4 dark:border-indigo-800 dark:bg-indigo-900/20">
            <div class="text-xl">🧱</div>

            <div class="mt-2 text-[10px] font-black uppercase tracking-wider text-indigo-500">
              Template
            </div>

            <div class="mt-1 truncate text-sm font-bold text-indigo-700 dark:text-indigo-300">
              <% if template.present? && template.respond_to?(:name) %>
                <%= template.name %>
              <% else %>
                —
              <% end %>
            </div>
          </div>

          <div class="rounded-xl border border-emerald-200 bg-emerald-50 p-4 dark:border-emerald-800 dark:bg-emerald-900/20">
            <div class="text-xl">●</div>

            <div class="mt-2 text-[10px] font-black uppercase tracking-wider text-emerald-500">
              Fields
            </div>

            <div class="mt-1 text-sm font-bold text-emerald-700 dark:text-emerald-300">
              <%= number_with_delimiter(field_count) %>
            </div>
          </div>

        </div>

      </div>

    </div>

  </div>

  <%# =========================================================================
  MAIN CONTENT
  ========================================================================= %>

  <div class="grid grid-cols-1 gap-6 xl:grid-cols-3">

    <%# =========================================================================
    LEFT / PRIMARY CONTENT
    ========================================================================= %>

    <div class="space-y-6 xl:col-span-2">

      <%# STRUCTURAL DEFINITION / ENTITY DATA %>

      <div class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm dark:border-gray-800 dark:bg-gray-800">

        <div class="border-b border-gray-100 px-6 py-5 dark:border-gray-700">

          <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">

            <div>

              <div class="text-[11px] font-black uppercase tracking-[0.2em] text-gray-400">
                Structural Definition
              </div>

              <h2 class="mt-1 text-xl font-black text-gray-900 dark:text-white">
                Entity Data
              </h2>

              <p class="mt-1 text-xs text-gray-400">
                Persisted entity values resolved against the fields defined by
                template version
                <% if version_number.present? %>
                  v<%= version_number %>
                <% end %>.
              </p>

            </div>

            <% if template_fields.present? %>

              <div class="flex w-full flex-col gap-2 sm:flex-row lg:w-auto">

                <div class="relative">

                  <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-gray-400">
                    ⌕
                  </span>

                  <input
                    id="entity-field-search"
                    type="search"
                    placeholder="Search fields..."
                    autocomplete="off"
                    class="w-full rounded-xl border border-gray-200 bg-white py-2.5 pl-9 pr-3 text-xs font-semibold text-gray-700 outline-none transition focus:border-violet-400 focus:ring-2 focus:ring-violet-100 sm:w-52 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-300 dark:focus:ring-violet-900/30"
                  >

                </div>

                <select
                  id="entity-field-type-filter"
                  class="rounded-xl border border-gray-200 bg-white px-3 py-2.5 text-xs font-bold text-gray-600 outline-none transition focus:border-violet-400 focus:ring-2 focus:ring-violet-100 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-300">

                  <option value="">All field types</option>

                  <% resolved_fields.map { |item| item[:type].to_s }.uniq.sort.each do |type| %>
                    <option value="<%= type.downcase %>">
                      <%= type.humanize %>
                    </option>
                  <% end %>

                </select>

                <select
                  id="entity-field-value-filter"
                  class="rounded-xl border border-gray-200 bg-white px-3 py-2.5 text-xs font-bold text-gray-600 outline-none transition focus:border-violet-400 focus:ring-2 focus:ring-violet-100 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-300">

                  <option value="">All values</option>
                  <option value="present">With value</option>
                  <option value="missing">Missing value</option>

                </select>

              </div>

            <% end %>

          </div>

          <% if template_fields.present? %>

            <div class="mt-4 flex flex-wrap items-center justify-between gap-2">

              <div
                id="entity-field-result-count"
                class="text-[10px] font-bold uppercase tracking-wider text-gray-400">
                <%= template_fields.size %> fields
              </div>

