        <% elsif template_fields.blank? %>

          <%# TEMPLATE VERSION EXISTS BUT HAS NO FIELDS %>

          <div class="px-6 py-14 text-center">

            <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-violet-50 text-3xl dark:bg-violet-900/20">
