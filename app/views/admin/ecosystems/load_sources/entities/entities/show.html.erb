
<%# app/views/admin/ecosystems/load_sources/entities/entities/show.html.erb %>

<%
  # Resolve optional routes without crashing the entire page.
  safe_entity_route = lambda do |helper_name, *args|
    if respond_to?(helper_name, true)
      begin
        public_send(helper_name, *args)
      rescue StandardError => e
        Rails.logger.warn(
          "[Entity Show] Route #{helper_name} unavailable: " \
            "#{e.class}: #{e.message}"
        )
        nil
      end
    end
  end

  entities_path =
    safe_entity_route.call(
      :admin_ecosystems_load_sources_entities_path
    )

  edit_entity_path =
    safe_entity_route.call(
      :edit_admin_ecosystems_load_sources_entity_path,
      @entity
    )

  clone_entity_path =
    safe_entity_route.call(
      :admin_ecosystems_load_sources_clone_entity_path,
      @entity
    )

  archive_entity_path =
    safe_entity_route.call(
      :archive_admin_ecosystems_load_sources_entity_path,
      @entity
    )

  restore_entity_path =
    safe_entity_route.call(
      :reopen_admin_ecosystems_load_sources_entity_path,
      @entity
    )

  publish_entity_path =
    safe_entity_route.call(
      :complete_admin_ecosystems_load_sources_entity_path,
      @entity
    )

  deprecate_entity_path =
    safe_entity_route.call(
      :deprecate_admin_ecosystems_load_sources_entity_path,
      @entity
    )

  compare_entity_path =
    safe_entity_route.call(
      :compare_admin_ecosystems_load_sources_entity_path,
      @entity
    )

  intelligence_path =
    safe_entity_route.call(
      :intelligence_admin_ecosystems_load_sources_entity_path,
      @entity
    )

  relationships_path =
    safe_entity_route.call(
      :admin_ecosystems_load_sources_entity_relationships_path,
      @entity
    )

  history_path =
    safe_entity_route.call(
      :history_admin_ecosystems_load_sources_entity_path,
      @entity
    )

  research_workspaces_path =
    safe_entity_route.call(:admin_research_workspaces_path)

  entity_title =
    if defined?(entity_name) && entity_name.present?
      entity_name.to_s
    elsif @entity.respond_to?(:name) && @entity.name.present?
      @entity.name.to_s
    else
      "Entity ##{@entity.id}"
    end

  entity_identifier_value =
    if defined?(entity_identifier)
      entity_identifier
    elsif @entity.respond_to?(:identifier)
      @entity.identifier
    end

  entity_description_value =
    if defined?(entity_description)
      entity_description
    elsif @entity.respond_to?(:description)
      @entity.description
    end

  entity_status =
    if defined?(normalized_status)
      normalized_status.to_s
    elsif @entity.respond_to?(:status)
      @entity.status.to_s
    else
      "unknown"
    end

  entity_status_label = entity_status.humanize

  entity_id_value =
    if defined?(entity_id)
      entity_id
    else
      @entity.id
    end

  entity_version_value =
    defined?(version_number) ? version_number : nil

  entity_field_count =
    if defined?(@field_count) && !@field_count.nil?
      @field_count
    elsif defined?(resolved_fields) && resolved_fields.respond_to?(:size)
      resolved_fields.size
    else
      nil
    end

  entity_template =
    defined?(template) ? template : nil

  entity_template_version =
    defined?(template_version) ? template_version : nil

  entity_status_classes =
    case entity_status.downcase
    when "published"
      "bg-emerald-100 text-emerald-800 dark:bg-emerald-900/30 dark:text-emerald-300"
    when "archived"
      "bg-gray-200 text-gray-700 dark:bg-gray-700 dark:text-gray-300"
    when "deprecated"
      "bg-rose-100 text-rose-800 dark:bg-rose-900/30 dark:text-rose-300"
    when "draft"
      "bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-300"
    else
      "bg-violet-100 text-violet-800 dark:bg-violet-900/30 dark:text-violet-300"
    end
%>

<%= render(
      "admin/ecosystems/load_sources/entities/entities/entity_lifecycle_panel",
      entity: @entity
    ) %>


<div class="mx-auto w-full max-w-[1600px] px-4 py-6 sm:px-6 lg:px-8">

  <%# HEADER %>

  <header class="mb-8">
    <div class="flex flex-col gap-5 xl:flex-row xl:items-center xl:justify-between">
      <div class="min-w-0">
        <div class="flex items-center gap-4">
          <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-violet-100 text-2xl shadow-sm dark:bg-violet-900/40">
            ◈
          </div>

          <div class="min-w-0">
            <p class="text-[11px] font-black uppercase tracking-[0.2em] text-violet-500">
              Entity Registry
            </p>

            <h1 class="mt-1 break-words text-2xl font-black tracking-tight text-gray-900 dark:text-white sm:text-3xl">
              <%= entity_title %>
            </h1>

            <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
              Inspect the entity, persisted attributes, template definition,
              lifecycle and relationship intelligence.
            </p>
          </div>
        </div>

        <nav aria-label="Breadcrumb" class="mt-4 flex flex-wrap items-center gap-2 text-xs text-gray-400">
          <span>Encyclopedia</span>
          <span aria-hidden="true">›</span>
          <span>Ecosystems</span>
          <span aria-hidden="true">›</span>
          <span>Load Sources</span>
          <span aria-hidden="true">›</span>
          <% if entities_path.present? %>
            <%= link_to "Entities", entities_path,
                        class: "hover:text-violet-600" %>
          <% else %>
            <span>Entities</span>
          <% end %>
          <span aria-hidden="true">›</span>
          <span class="font-semibold text-violet-500"><%= entity_title %></span>
        </nav>
      </div>

      <div class="flex flex-wrap gap-2">
        <% if entities_path.present? %>
          <%= link_to "← Back to Entities", entities_path,
                      class: "inline-flex items-center rounded-xl border border-gray-200 bg-white px-4 py-3 text-sm font-semibold text-gray-700 shadow-sm hover:border-violet-300 hover:text-violet-600 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300" %>
        <% end %>

        <% if edit_entity_path.present? %>
          <%= link_to "Edit Entity", edit_entity_path,
                      class: "inline-flex items-center rounded-xl bg-violet-600 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-violet-700" %>
        <% end %>

        <% if history_path.present? %>
          <%= link_to "History", history_path,
                      class: "inline-flex items-center rounded-xl border border-gray-200 bg-white px-4 py-3 text-sm font-semibold text-gray-700 hover:border-violet-300 hover:text-violet-600 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300" %>
        <% end %>
      </div>
    </div>
  </header>

  <%# ENTITY IDENTITY %>

  <section class="mb-8 overflow-hidden rounded-2xl border border-violet-200 bg-gradient-to-br from-violet-50 via-white to-indigo-50 shadow-sm dark:border-violet-900/40 dark:from-violet-950/30 dark:via-gray-900 dark:to-indigo-950/30">
    <div class="p-6 sm:p-8">
      <div class="flex flex-col gap-5 lg:flex-row lg:items-start lg:justify-between">
        <div class="min-w-0">
          <p class="text-[11px] font-black uppercase tracking-[0.2em] text-violet-500">
            Entity Identity
          </p>

          <h2 class="mt-2 break-words text-2xl font-black text-gray-900 dark:text-white">
            <%= entity_title %>
          </h2>

          <% if entity_identifier_value.present? %>
            <p class="mt-3 inline-flex max-w-full items-center rounded-lg border border-gray-200 bg-white px-3 py-2 font-mono text-xs text-gray-600 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300">
              #<%= entity_identifier_value %>
            </p>
          <% end %>

          <% if entity_description_value.present? %>
            <p class="mt-4 max-w-3xl whitespace-pre-line text-sm leading-6 text-gray-600 dark:text-gray-300">
              <%= entity_description_value %>
            </p>
          <% end %>
        </div>

        <span class="inline-flex w-fit shrink-0 items-center gap-2 rounded-full px-4 py-2 text-sm font-bold <%= entity_status_classes %>">
          <span aria-hidden="true">●</span>
          <%= entity_status_label %>
        </span>
      </div>

      <%# LIFECYCLE ACTIONS %>

      <div class="mt-7 rounded-2xl border border-gray-200 bg-white/80 p-4 shadow-sm dark:border-gray-700 dark:bg-gray-900/50">
        <div class="mb-3">
          <h3 class="text-[10px] font-black uppercase tracking-[0.2em] text-gray-400">
            Entity Actions
          </h3>
          <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">
            Available actions depend on the routes configured in your application.
          </p>
        </div>

        <div class="flex flex-wrap gap-2">
          <% if entity_status.downcase != "published" && publish_entity_path.present? %>
            <%= button_to "✓ Publish", publish_entity_path,
                          method: :post,
                          class: "rounded-xl bg-emerald-600 px-4 py-2.5 text-xs font-bold text-white hover:bg-emerald-700" %>
          <% end %>

          <% if entity_status.downcase != "archived" && archive_entity_path.present? %>
            <%= button_to "Archive", archive_entity_path,
                          method: :post,
                          class: "rounded-xl border border-gray-200 bg-white px-4 py-2.5 text-xs font-bold text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300" %>
          <% end %>

          <% if entity_status.downcase == "archived" && restore_entity_path.present? %>
            <%= button_to "↺ Restore", restore_entity_path,
                          method: :post,
                          class: "rounded-xl bg-indigo-600 px-4 py-2.5 text-xs font-bold text-white hover:bg-indigo-700" %>
          <% end %>

          <% if entity_status.downcase != "deprecated" && deprecate_entity_path.present? %>
            <%= button_to "Deprecate", deprecate_entity_path,
                          method: :post,
                          class: "rounded-xl border border-rose-200 bg-rose-50 px-4 py-2.5 text-xs font-bold text-rose-700 hover:bg-rose-100 dark:border-rose-900/40 dark:bg-rose-950/20 dark:text-rose-300" %>
          <% end %>

          <% if clone_entity_path.present? %>
            <%= link_to "⧉ Clone", clone_entity_path,
                        class: "rounded-xl border border-violet-200 bg-violet-50 px-4 py-2.5 text-xs font-bold text-violet-700 hover:bg-violet-100 dark:border-violet-800 dark:bg-violet-900/20 dark:text-violet-300" %>
          <% end %>

          <% if compare_entity_path.present? %>
            <%= link_to "⇄ Compare Entity", compare_entity_path,
                        class: "rounded-xl border border-gray-200 bg-white px-4 py-2.5 text-xs font-bold text-gray-700 hover:border-indigo-300 hover:text-indigo-700 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300" %>
          <% end %>

          <% if research_workspaces_path.present? %>
            <%= link_to "🧭 Start Investigation", research_workspaces_path,
                        class: "rounded-xl bg-orange-500 px-4 py-2.5 text-xs font-bold text-white hover:bg-orange-600" %>
          <% end %>
        </div>
      </div>

      <%# SUMMARY METRICS %>

      <div class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-xl border border-gray-200 bg-white p-4 dark:border-gray-700 dark:bg-gray-800">
          <p class="text-[10px] font-black uppercase tracking-wider text-gray-400">Entity ID</p>
          <p class="mt-2 font-mono text-lg font-bold text-gray-800 dark:text-gray-200">
            #<%= entity_id_value %>
          </p>
        </div>

        <div class="rounded-xl border border-violet-200 bg-violet-50 p-4 dark:border-violet-800 dark:bg-violet-900/20">
          <p class="text-[10px] font-black uppercase tracking-wider text-violet-500">Template Version</p>
          <p class="mt-2 text-lg font-bold text-violet-700 dark:text-violet-300">
            <%= entity_version_value.present? ? "v#{entity_version_value}" : "—" %>
          </p>
        </div>

        <div class="rounded-xl border border-indigo-200 bg-indigo-50 p-4 dark:border-indigo-800 dark:bg-indigo-900/20">
          <p class="text-[10px] font-black uppercase tracking-wider text-indigo-500">Template</p>
          <p class="mt-2 truncate text-sm font-bold text-indigo-700 dark:text-indigo-300">
            <%= entity_template.respond_to?(:name) ? entity_template.name : "—" %>
          </p>
        </div>

        <div class="rounded-xl border border-emerald-200 bg-emerald-50 p-4 dark:border-emerald-800 dark:bg-emerald-900/20">
          <p class="text-[10px] font-black uppercase tracking-wider text-emerald-600">Defined Fields</p>
          <p class="mt-2 text-lg font-bold text-emerald-700 dark:text-emerald-300">
            <%= entity_field_count.present? ? number_with_delimiter(entity_field_count) : "—" %>
          </p>
        </div>
      </div>
    </div>
  </section>

  <%# MAIN CONTENT %>

  <div class="grid grid-cols-1 gap-6 xl:grid-cols-3">
    <main class="min-w-0 space-y-6 xl:col-span-2">

      <%# ENTITY DATA %>

      <section class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm dark:border-gray-800 dark:bg-gray-800">
        <div class="border-b border-gray-100 px-6 py-5 dark:border-gray-700">
          <p class="text-[11px] font-black uppercase tracking-[0.2em] text-violet-500">
            Structural Definition
          </p>
          <h2 class="mt-1 text-xl font-black text-gray-900 dark:text-white">
            Entity Data
          </h2>
          <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">
            Values persisted for this entity.
          </p>
        </div>

        <div class="divide-y divide-gray-100 dark:divide-gray-700">
          <% if defined?(resolved_fields) && resolved_fields.present? %>
            <% resolved_fields.each do |item| %>
              <% field_key = item[:key] %>
              <% field_label = item[:label] %>
              <% field_type = item[:type] %>
              <% field_value = item[:value] %>
              <% field_present = item[:present] %>

              <article class="px-6 py-5 transition hover:bg-violet-50/40 dark:hover:bg-violet-950/10">
                <div class="flex flex-col gap-3 sm:flex-row">
                  <div class="w-full shrink-0 sm:w-56">
                    <h3 class="text-sm font-bold text-gray-900 dark:text-white">
                      <%= field_label %>
                    </h3>
                    <p class="mt-1 break-all font-mono text-xs text-violet-600 dark:text-violet-400">
                      <%= field_key %>
                    </p>
                    <span class="mt-2 inline-flex rounded-full bg-gray-100 px-2 py-1 text-[10px] font-bold text-gray-500 dark:bg-gray-900 dark:text-gray-400">
                      <%= field_type.to_s.humanize %>
                    </span>
                  </div>

                  <div class="min-w-0 flex-1">
                    <% if field_present %>
                      <% if field_value.is_a?(Hash) || field_value.is_a?(Array) %>
                        <pre class="max-h-80 overflow-auto whitespace-pre-wrap break-words rounded-xl border border-gray-200 bg-gray-50 p-4 font-mono text-xs leading-5 text-gray-700 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-300"><%= JSON.pretty_generate(field_value) rescue field_value.inspect %></pre>
                      <% elsif field_value.nil? %>
                        <span class="inline-flex rounded-lg bg-gray-100 px-3 py-2 text-xs text-gray-500 dark:bg-gray-900 dark:text-gray-400">null</span>
                      <% elsif field_value == true || field_value == false %>
                        <span class="inline-flex rounded-lg bg-gray-100 px-3 py-2 text-sm font-bold text-gray-700 dark:bg-gray-900 dark:text-gray-300"><%= field_value %></span>
                      <% else %>
                        <div class="whitespace-pre-wrap break-words rounded-xl border border-gray-200 bg-white px-4 py-3 text-sm text-gray-700 dark:border-gray-700 dark:bg-gray-900/40 dark:text-gray-300"><%= field_value %></div>
                      <% end %>
                    <% else %>
                      <div class="rounded-xl border border-dashed border-gray-200 bg-gray-50 px-4 py-3 text-xs text-gray-500 dark:border-gray-700 dark:bg-gray-900/40 dark:text-gray-400">
                        No persisted value
                      </div>
                    <% end %>
                  </div>
                </div>
              </article>
            <% end %>
          <% else %>
            <div class="px-6 py-12 text-center">
              <h3 class="font-bold text-gray-900 dark:text-white">No resolved fields</h3>
              <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">
                This entity has no resolved template fields to display.
              </p>
            </div>
          <% end %>
        </div>
      </section>

      <%# TEMPLATE LINEAGE %>

      <section class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-800 dark:bg-gray-800">
        <p class="text-[11px] font-black uppercase tracking-[0.2em] text-violet-500">
          Structural Lineage
        </p>
        <h2 class="mt-1 text-xl font-black text-gray-900 dark:text-white">
          Template Resolution
        </h2>

        <div class="mt-5 space-y-3">
          <div class="rounded-xl border border-gray-200 bg-gray-50 p-4 dark:border-gray-700 dark:bg-gray-900/40">
            <p class="text-[10px] font-bold uppercase tracking-wider text-gray-400">Entity Template</p>
            <p class="mt-1 font-bold text-gray-900 dark:text-white">
              <%= entity_template.respond_to?(:name) ? entity_template.name : "No template association" %>
            </p>
          </div>

          <div class="rounded-xl border border-violet-200 bg-violet-50 p-4 dark:border-violet-800 dark:bg-violet-900/20">
            <p class="text-[10px] font-bold uppercase tracking-wider text-violet-500">Template Version</p>
            <p class="mt-1 font-bold text-violet-800 dark:text-violet-300">
              <% if entity_template_version.present? %>
                <%= entity_version_value.present? ? "Version v#{entity_version_value}" : "Version ##{entity_template_version.id}" %>
              <% else %>
                No version association
              <% end %>
            </p>
          </div>

          <div class="rounded-xl border border-emerald-200 bg-emerald-50 p-4 dark:border-emerald-800 dark:bg-emerald-900/20">
            <p class="text-[10px] font-bold uppercase tracking-wider text-emerald-600">Current Entity</p>
            <p class="mt-1 font-bold text-emerald-800 dark:text-emerald-300"><%= entity_title %></p>
            <p class="mt-1 font-mono text-xs text-emerald-700 dark:text-emerald-400">Entity #<%= entity_id_value %></p>
          </div>
        </div>
      </section>

      <%# INTELLIGENCE %>

      <section class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-800 dark:bg-gray-800">
        <p class="text-[11px] font-black uppercase tracking-[0.2em] text-orange-500">
          Intelligence
        </p>
        <h2 class="mt-1 text-xl font-black text-gray-900 dark:text-white">
          Recommendations
        </h2>
        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
          Suggested next actions and related investigations.
        </p>
        <div class="mt-4" data-recommendation-list>
          <p class="rounded-xl border border-dashed border-gray-200 bg-gray-50 p-4 text-sm text-gray-500 dark:border-gray-700 dark:bg-gray-900/40 dark:text-gray-400">
            Recommendations will appear here when provided by the intelligence layer.
          </p>
        </div>
      </section>
    </main>

    <%# SIDEBAR %>

    <aside class="min-w-0 space-y-6">
      <section class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-800 dark:bg-gray-800">
        <h2 class="text-[11px] font-black uppercase tracking-[0.2em] text-gray-400">
          Record Information
        </h2>

        <dl class="mt-5 space-y-4">
          <div>
            <dt class="text-[10px] font-bold uppercase tracking-wider text-gray-400">Entity ID</dt>
            <dd class="mt-1 font-mono text-sm font-bold text-gray-700 dark:text-gray-300">#<%= entity_id_value %></dd>
          </div>

          <% if entity_identifier_value.present? %>
            <div>
              <dt class="text-[10px] font-bold uppercase tracking-wider text-gray-400">Identifier</dt>
              <dd class="mt-1 break-all font-mono text-sm text-gray-700 dark:text-gray-300"><%= entity_identifier_value %></dd>
            </div>
          <% end %>

          <div>
            <dt class="text-[10px] font-bold uppercase tracking-wider text-gray-400">Status</dt>
            <dd class="mt-2">
              <span class="inline-flex rounded-full px-3 py-1.5 text-xs font-bold <%= entity_status_classes %>"><%= entity_status_label %></span>
            </dd>
          </div>

          <div>
            <dt class="text-[10px] font-bold uppercase tracking-wider text-gray-400">Template Version</dt>
            <dd class="mt-1 text-sm font-bold text-gray-700 dark:text-gray-300"><%= entity_version_value.present? ? "v#{entity_version_value}" : "—" %></dd>
          </div>

          <div>
            <dt class="text-[10px] font-bold uppercase tracking-wider text-gray-400">Defined Fields</dt>
            <dd class="mt-1 text-sm font-bold text-gray-700 dark:text-gray-300"><%= entity_field_count.present? ? number_with_delimiter(entity_field_count) : "—" %></dd>
          </div>
        </dl>
      </section>

      <section class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-800 dark:bg-gray-800">
        <h2 class="text-[11px] font-black uppercase tracking-[0.2em] text-gray-400">Quick Actions</h2>
        <div class="mt-4 space-y-2">
          <% [
               ["Edit Entity", edit_entity_path, "violet"],
               ["Clone Entity", clone_entity_path, "violet"],
               ["Compare Entity", compare_entity_path, "indigo"],
               ["Intelligence", intelligence_path, "indigo"],
               ["Ecosystem Intelligence", relationships_path, "violet"],
               ["Start Investigation", research_workspaces_path, "orange"]
             ].each do |label, path, color| %>
            <% if path.present? %>
              <%= link_to path,
                          class: "flex items-center justify-between rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 text-xs font-bold text-gray-700 transition hover:border-#{color}-300 hover:bg-white dark:border-gray-700 dark:bg-gray-900/50 dark:text-gray-300" do %>
                <span><%= label %></span>
                <span aria-hidden="true">→</span>
              <% end %>
            <% end %>
          <% end %>
        </div>
      </section>

      <section class="rounded-2xl border border-emerald-200 bg-emerald-50 p-6 dark:border-emerald-800 dark:bg-emerald-900/20">
        <h2 class="text-sm font-black text-emerald-800 dark:text-emerald-300">
          Entity Registry
        </h2>
        <p class="mt-2 text-xs leading-5 text-emerald-700 dark:text-emerald-400">
          This page displays the current entity record and any available structural information.
        </p>
      </section>
    </aside>
  </div>

  <footer class="mt-8 border-t border-gray-100 pt-5 dark:border-gray-800">
    <p class="font-mono text-[10px] font-bold uppercase tracking-wider text-gray-400">
      ENTITY_PROTOCOL :: ENTITY_DETAIL_LAYER
    </p>
  </footer>
</div>

<%# EXISTING INTELLIGENCE PARTIALS %>

<%= render(
      "admin/ecosystems/load_sources/entities/entities/entity_intelligence",
      entity: @entity
    ) %>

<%= render(
      "admin/ecosystems/load_sources/entities/entities/relationship_intelligence",
      entity: @entity,
