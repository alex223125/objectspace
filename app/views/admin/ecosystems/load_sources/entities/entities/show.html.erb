                                                                                                                                                                                                                      JSON.pretty_generate(value)
                                                                                                                                                                                                                    rescue StandardError
                                                                                                                                                                                                                      value.inspect
                                                                                                                                                                                                                    end %></pre>

                      <% elsif value == true %>

                        <span class="inline-flex items-center gap-2 rounded-lg bg-emerald-50 px-3 py-2 text-sm font-bold text-emerald-700 dark:bg-emerald-900/20 dark:text-emerald-300">
