<%# ============================================================================
CLIENT-SIDE FIELD SEARCH / FILTER / PAGINATION

This intentionally operates only on the already-rendered template fields.
No existing server-side functionality is removed.
============================================================================ %>

<% if template_fields.present? %>

  <script>
      (() => {
          const initializeEntityFieldControls = () => {
              const rows = Array.from(
                  document.querySelectorAll(".entity-field-row")
              );

              const searchInput =
                  document.getElementById("entity-field-search");

              const typeFilter =
                  document.getElementById("entity-field-type-filter");

              const valueFilter =
                  document.getElementById("entity-field-value-filter");

              const emptyState =
                  document.getElementById("entity-fields-empty");

              const resultCount =
                  document.getElementById("entity-field-result-count");

              const pagination =
                  document.getElementById("entity-fields-pagination");

              const paginationSummary =
                  document.getElementById("entity-pagination-summary");

              const pagesContainer =
                  document.getElementById("entity-fields-pages");

              const previousButton =
                  document.getElementById("entity-fields-prev");

              const nextButton =
                  document.getElementById("entity-fields-next");

              if (!rows.length) return;

              const pageSize = 10;

              let currentPage = 1;
              let filteredRows = rows.slice();

              const normalize = (value) =>
                  String(value || "")
                      .trim()
                      .toLowerCase();

              const matchesFilters = (row) => {
                  const searchTerm =
                      normalize(searchInput ? searchInput.value : "");

                  const type =
                      normalize(typeFilter ? typeFilter.value : "");

                  const valueState =
                      normalize(valueFilter ? valueFilter.value : "");

                  const searchableText = [
                      row.dataset.fieldKey,
                      row.dataset.fieldLabel,
                      row.dataset.fieldType
                  ]
                      .map(normalize)
                      .join(" ");

                  const searchMatches =
                      !searchTerm ||
                      searchableText.includes(searchTerm);

                  const typeMatches =
                      !type ||
                      normalize(row.dataset.fieldType) === type;

                  const valueMatches =
                      !valueState ||
                      normalize(row.dataset.fieldValueState) === valueState;

                  return searchMatches && typeMatches && valueMatches;
              };

              const createPageButton = (page) => {
                  const button =
                      document.createElement("button");

                  button.type = "button";
                  button.textContent = page;

                  button.className =
                      "inline-flex h-9 min-w-9 items-center justify-center rounded-lg border px-2.5 text-xs font-bold transition";

                  if (page === currentPage) {
                      button.className +=
                          " border-violet-600 bg-violet-600 text-white";
                  } else {
                      button.className +=
                          " border-gray-200 bg-white text-gray-600 hover:border-violet-300 hover:text-violet-600 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300";
                  }

                  button.addEventListener("click", () => {
                      currentPage = page;
                      render();
                  });

                  return button;
              };

              const renderPagination = (totalPages) => {
                  if (!pagesContainer) return;

                  pagesContainer.innerHTML = "";

                  if (totalPages <= 1) {
                      if (pagination) {
                          pagination.classList.add("hidden");
                      }

                      return;
                  }

                  if (pagination) {
                      pagination.classList.remove("hidden");
                  }

                  const pages = [];

                  if (totalPages <= 7) {
                      for (let page = 1; page <= totalPages; page += 1) {
                          pages.push(page);
                      }
                  } else {
                      pages.push(1);

                      if (currentPage > 4) {
                          const spacer =
                              document.createElement("span");

                          spacer.className =
                              "px-1 text-xs text-gray-400";

                          spacer.textContent = "…";

                          pagesContainer.appendChild(spacer);
                      }

                      const start =
                          Math.max(2, currentPage - 1);

                      const end =
                          Math.min(totalPages - 1, currentPage + 1);

                      for (let page = start; page <= end; page += 1) {
                          pages.push(page);
                      }

                      if (currentPage < totalPages - 3) {
                          const spacer =
                              document.createElement("span");

                          spacer.className =
                              "px-1 text-xs text-gray-400";

                          spacer.textContent = "…";

                          pagesContainer.appendChild(spacer);
                      }

                      pages.push(totalPages);
                  }

                  pages.forEach((page) => {
                      pagesContainer.appendChild(
                          createPageButton(page)
                      );
                  });

                  if (previousButton) {
                      previousButton.disabled =
                          currentPage <= 1;
                  }

                  if (nextButton) {
                      nextButton.disabled =
                          currentPage >= totalPages;
                  }
              };

              const render = () => {
                  filteredRows =
                      rows.filter(matchesFilters);

                  const total =
                      filteredRows.length;

                  const totalPages =
                      Math.max(1, Math.ceil(total / pageSize));

                  if (currentPage > totalPages) {
                      currentPage = totalPages;
                  }

                  rows.forEach((row) => {
                      row.classList.add("hidden");
                  });

                  const start =
                      (currentPage - 1) * pageSize;

                  const end =
                      start + pageSize;

                  filteredRows
                      .slice(start, end)
                      .forEach((row) => {
                          row.classList.remove("hidden");
                      });

                  if (emptyState) {
                      if (total === 0) {
                          emptyState.classList.remove("hidden");
                      } else {
                          emptyState.classList.add("hidden");
                      }
                  }

                  if (resultCount) {
                      resultCount.textContent =
                          `${total} ${total === 1 ? "field" : "fields"}`;
                  }

                  if (paginationSummary) {
                      if (total === 0) {
                          paginationSummary.textContent =
                              "No matching fields";
                      } else {
                          const visibleStart =
                              start + 1;

                          const visibleEnd =
                              Math.min(end, total);

                          paginationSummary.textContent =
                              `Showing ${visibleStart}–${visibleEnd} of ${total} fields`;
                      }
                  }

                  renderPagination(totalPages);
              };

              searchInput?.addEventListener("input", () => {
                  currentPage = 1;
                  render();
              });

              typeFilter?.addEventListener("change", () => {
                  currentPage = 1;
                  render();
              });

              valueFilter?.addEventListener("change", () => {
                  currentPage = 1;
                  render();
              });

              previousButton?.addEventListener("click", () => {
                  if (currentPage > 1) {
                      currentPage -= 1;
                      render();
                  }
              });

              nextButton?.addEventListener("click", () => {
                  const totalPages =
                      Math.max(
                          1,
                          Math.ceil(filteredRows.length / pageSize)
                      );

                  if (currentPage < totalPages) {
                      currentPage += 1;
                      render();
                  }
              });

              render();
          };

          if (document.readyState === "loading") {
              document.addEventListener(
                  "DOMContentLoaded",
                  initializeEntityFieldControls
              );
          } else {
              initializeEntityFieldControls();
          }
      })();
  </script>

<% end %>