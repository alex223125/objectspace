<div
  class="group flex items-center gap-3 rounded-2xl border border-slate-100 bg-white p-3 shadow-sm transition-all duration-300 hover:-translate-y-0.5 hover:border-orange-200 hover:shadow-md"
  data-intelligence-priority-id="<%= local_assigns[:id] %>">

  <div
    class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-orange-50 text-[10px] font-black text-orange-600">
    <%= local_assigns[:position] || "!" %>
  </div>

  <div class="min-w-0 flex-1">

    <div class="truncate text-xs font-black text-slate-700">
      <%= local_assigns[:label] || "Priority change" %>
    </div>

    <div class="mt-0.5 truncate text-[10px] font-medium text-slate-400">
      <%= local_assigns[:path] || "Unknown path" %>
    </div>

  </div>

  <div
    class="shrink-0 rounded-full bg-orange-50 px-2 py-1 text-[9px] font-black text-orange-600">
    <%= local_assigns[:score] || 0 %>
  </div>

</div>