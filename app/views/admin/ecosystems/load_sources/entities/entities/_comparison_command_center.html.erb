<div
  class="mb-8 overflow-hidden rounded-[32px]
         border border-slate-200/80
         bg-white
         shadow-[0_18px_60px_rgba(15,23,42,0.08)]"
  data-comparison-command-center>

  <!-- ========================================================= -->
  <!-- TOP COMMAND BAR -->
  <!-- ========================================================= -->

  <div
    class="border-b border-slate-100
           bg-gradient-to-r
           from-white
           via-orange-50/30
           to-violet-50/30
           px-5 py-5
           sm:px-7">

    <div
      class="flex flex-col gap-5
             xl:flex-row xl:items-center xl:justify-between">

      <div class="flex items-start gap-4">

        <div
          class="flex h-12 w-12 shrink-0 items-center justify-center
                 rounded-2xl
                 border border-orange-200
                 bg-gradient-to-br from-orange-100 to-amber-50
                 text-xl
                 shadow-sm shadow-orange-100">

          ⚡

        </div>

        <div>

          <div
            class="flex flex-wrap items-center gap-2">

            <h3
              class="text-sm font-black tracking-wide text-slate-800">

              Comparison Command Center

            </h3>

            <span
              class="rounded-full
                     border border-emerald-200
                     bg-emerald-50
                     px-2.5 py-1
                     text-[9px]
                     font-black
                     uppercase
                     tracking-widest
                     text-emerald-600">

              Live

            </span>

          </div>

          <p
            class="mt-1 max-w-2xl
                   text-xs leading-5
                   text-slate-400">

            Explore every detected change, movement and identity signal
            across the selected versions.

          </p>

        </div>

      </div>

      <div
        class="flex items-center gap-3">

        <span
          data-entity-version-comparison-target="xp"
          class="rounded-full
                 border border-violet-200
                 bg-violet-50
                 px-3 py-1.5
                 text-[10px]
                 font-black
                 tracking-wide
                 text-violet-600">

          +0 XP

        </span>

        <span
          data-entity-version-comparison-target="status"
          class="hidden rounded-full
                 border border-slate-200
                 bg-slate-50
                 px-3 py-1.5
                 text-[10px]
                 font-bold
                 text-slate-500
                 sm:inline-flex">

          Exploring comparison

        </span>

      </div>

    </div>

  </div>


  <!-- ========================================================= -->
  <!-- SEARCH -->
  <!-- ========================================================= -->

  <div class="px-5 pt-5 sm:px-7">

    <div class="relative">

      <div
        class="pointer-events-none absolute
               inset-y-0 left-4
               flex items-center
               text-slate-400">

        🔎

      </div>

      <input
        type="search"
        autocomplete="off"
        placeholder="Search paths, identities, old values or new values..."
        data-entity-version-comparison-target="search"
        data-action="input->entity-version-comparison#searchChanged"
        class="w-full rounded-2xl
               border border-slate-200
               bg-slate-50/70
               py-3.5 pl-11 pr-24
               text-sm font-medium
               text-slate-700
               outline-none
               transition
               placeholder:text-slate-400
               focus:border-orange-300
               focus:bg-white
               focus:ring-4
               focus:ring-orange-100">

      <button
        type="button"
        hidden
        data-entity-version-comparison-target="clearSearch"
        data-action="click->entity-version-comparison#clearSearch"
        class="absolute right-3 top-1/2
               -translate-y-1/2
               rounded-xl
               px-2.5 py-1.5
               text-[10px]
               font-black
               text-slate-400
               transition
               hover:bg-slate-100
               hover:text-slate-700">

        Clear

      </button>

      <div
        data-entity-version-comparison-target="commandHint"
        class="pointer-events-none absolute
               right-4 top-1/2
               hidden -translate-y-1/2
               items-center gap-1
               text-[9px]
               font-bold
               text-slate-400
               lg:flex">

        <kbd
          class="rounded-md
                 border border-slate-200
                 bg-white
                 px-1.5 py-0.5
                 font-mono
                 shadow-sm">

          /

        </kbd>

        Search

      </div>

    </div>

  </div>


  <!-- ========================================================= -->
  <!-- FILTER CHIPS -->
  <!-- ========================================================= -->

  <div class="px-5 pt-4 sm:px-7">

    <div
      class="flex flex-wrap items-center gap-2">

      <button
        type="button"
        data-filter="all"
        data-entity-version-comparison-target="filterChip"
        data-action="click->entity-version-comparison#selectFilter"
        aria-pressed="true"
        class="rounded-xl
               bg-slate-900
               px-3.5 py-2
               text-[10px]
               font-black
               text-white
               shadow-md
               transition
               hover:-translate-y-0.5">

        All changes

      </button>

      <button
        type="button"
        data-filter="content_change"
        data-entity-version-comparison-target="filterChip"
        data-action="click->entity-version-comparison#selectFilter"
        aria-pressed="false"
        class="rounded-xl
               border border-slate-200
               bg-white
               px-3.5 py-2
               text-[10px]
               font-black
               text-slate-500
               transition
               hover:-translate-y-0.5
               hover:border-orange-200
               hover:text-orange-600">

        Changes

      </button>

      <button
        type="button"
        data-filter="semantic_movement"
        data-entity-version-comparison-target="filterChip"
        data-action="click->entity-version-comparison#selectFilter"
        aria-pressed="false"
        class="rounded-xl
               border border-slate-200
               bg-white
               px-3.5 py-2
               text-[10px]
               font-black
               text-slate-500
               transition
               hover:-translate-y-0.5
               hover:border-violet-200
               hover:text-violet-600">

        Movements

      </button>

      <button
        type="button"
        data-filter="added_entity"
        data-entity-version-comparison-target="filterChip"
        data-action="click->entity-version-comparison#selectFilter"
        aria-pressed="false"
        class="rounded-xl
               border border-slate-200
               bg-white
               px-3.5 py-2
               text-[10px]
               font-black
               text-slate-500
               transition
               hover:-translate-y-0.5
               hover:border-emerald-200
               hover:text-emerald-600">

        Additions

      </button>

      <button
        type="button"
        data-filter="removed_entity"
        data-entity-version-comparison-target="filterChip"
        data-action="click->entity-version-comparison#selectFilter"
        aria-pressed="false"
        class="rounded-xl
               border border-slate-200
               bg-white
               px-3.5 py-2
               text-[10px]
               font-black
               text-slate-500
               transition
               hover:-translate-y-0.5
               hover:border-rose-200
               hover:text-rose-600">

        Removals

      </button>

      <button
        type="button"
        data-filter="identity_warning"
        data-entity-version-comparison-target="filterChip"
        data-action="click->entity-version-comparison#selectFilter"
        aria-pressed="false"
        class="rounded-xl
               border border-slate-200
               bg-white
               px-3.5 py-2
               text-[10px]
               font-black
               text-slate-500
               transition
               hover:-translate-y-0.5
               hover:border-amber-200
               hover:text-amber-600">

        Warnings

      </button>

    </div>

  </div>


  <!-- ========================================================= -->
  <!-- PROGRESS -->
  <!-- ========================================================= -->

  <div class="px-5 pb-6 pt-5 sm:px-7">

    <div
      class="mb-2 flex items-center justify-between">

      <span
        class="text-[9px]
               font-black
               uppercase
               tracking-[0.18em]
               text-slate-400">

        Exploration progress

      </span>

      <span
        data-entity-version-comparison-target="progressLabel"
        class="text-[10px]
               font-black
               text-orange-500">

        100% visible

      </span>

    </div>

    <div
      class="h-2 overflow-hidden
             rounded-full
             border border-orange-100
             bg-orange-50">

      <div
        data-entity-version-comparison-target="progress"
        class="h-full w-full rounded-full
               bg-gradient-to-r
               from-orange-400
               via-amber-400
               via-violet-400
               to-emerald-400
               shadow-sm
               transition-all duration-500">

      </div>

    </div>

    <div
      class="mt-3 flex items-center justify-between">

      <span
        data-entity-version-comparison-target="resultsLabel"
        class="text-[10px]
               font-bold
               text-slate-400">

        0 results

      </span>

      <span
        class="text-[9px]
               font-bold
               text-slate-400">

        / search · ⌘K focus · R reset

      </span>

    </div>

  </div>

</div>