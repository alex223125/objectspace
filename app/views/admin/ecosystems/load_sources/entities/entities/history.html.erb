<%# frozen_string_literal: true %>

<div
  class="entity-version-history"
  data-controller="entity-version-history"
>
  <% versions =
       if defined?(@versions) && @versions.present?
         @versions.to_a
       else
         []
       end
  %>

  <% newest_version = versions.first %>
  <% previous_version = versions.second %>
  <% oldest_version = versions.last %>

  <header class="entity-version-history__header">
    <div>
      <h1>
        Version history
      </h1>

      <p>
        Review entity versions and select two versions to compare.
      </p>
    </div>

    <div class="entity-version-history__actions">
      <%= link_to(
            "Back to entity",
            admin_ecosystems_load_sources_entity_path(@entity),
            class: "entity-comparison__button"
          ) %>
    </div>
  </header>

  <% if versions.present? %>

    <!-- ========================================================
         QUICK COMPARISON ACTIONS
         ======================================================== -->

    <section
      class="entity-version-history__quick-actions"
      aria-label="Quick comparisons"
    >
      <div>
        <strong>
          Quick comparison
        </strong>

        <p>
          Start with a commonly useful version comparison.
        </p>
      </div>

      <div class="entity-version-history__quick-actions-buttons">

        <% if previous_version && newest_version %>

          <%= link_to(
                "Compare previous / current",
                compare_admin_ecosystems_load_sources_entity_path(
                  @entity,
                  from_version: previous_version.id,
                  to_version: newest_version.id
                ),
                class: "entity-comparison__button"
              ) %>

        <% end %>

        <% if oldest_version &&
          newest_version &&
          oldest_version.id.to_s != newest_version.id.to_s %>

          <%= link_to(
                "Compare oldest / newest",
                compare_admin_ecosystems_load_sources_entity_path(
                  @entity,
                  from_version: oldest_version.id,
                  to_version: newest_version.id
                ),
                class: "entity-comparison__button"
              ) %>

        <% end %>

      </div>
    </section>

    <!-- ========================================================
         MANUAL SELECTION
         ======================================================== -->

    <form
      method="get"
      action="<%= compare_admin_ecosystems_load_sources_entity_path(@entity) %>"
      data-entity-version-history-target="form"
      data-action="submit->entity-version-history#submit"
    >

      <section
        class="entity-version-history__selection"
        aria-label="Select versions to compare"
      >
        <div class="entity-version-history__toolbar">

          <div>
            <strong>
              Select versions
            </strong>

            <p>
              Select one version as the old version and another
              as the new version.
            </p>
          </div>

          <button
            type="submit"
            class="entity-comparison__button"
            data-entity-version-history-target="compareButton"
            disabled
          >
            Compare selected versions
          </button>
        </div>

        <div
          class="entity-version-history__error"
          data-entity-version-history-target="error"
          role="alert"
          aria-live="assertive"
          hidden
        >
          Please select two different versions.
        </div>

        <!-- ======================================================
             TABLE
             ====================================================== -->

        <div class="entity-version-history__table-wrapper">
          <table class="entity-version-history__table">
            <thead>
            <tr>
              <th scope="col">
                Version
              </th>

              <th scope="col">
                Created
              </th>

              <th scope="col">
                Status
              </th>

              <th scope="col">
                Old
              </th>

              <th scope="col">
                New
              </th>

              <th scope="col">
                View
              </th>
            </tr>
            </thead>

            <tbody>

            <% versions.each do |version| %>

              <% is_newest =
                   newest_version &&
                     version.id.to_s == newest_version.id.to_s
              %>

              <% is_previous =
                   previous_version &&
                     version.id.to_s == previous_version.id.to_s
              %>

              <% is_oldest =
                   oldest_version &&
                     version.id.to_s == oldest_version.id.to_s
              %>

              <tr
                data-entity-version-history-row
                data-version-id="<%= version.id %>"
                class="<%= "entity-version-history__row--newest" if is_newest %>"
              >

                <!-- VERSION -->

                <td>
                  <strong>
                    <%= comparison_version_label(version) %>
                  </strong>

                  <% if is_newest %>

                      <span class="entity-version-history__marker">
                        Current / newest
                      </span>

                  <% elsif is_previous %>

                      <span class="entity-version-history__marker">
                        Previous
                      </span>

                  <% elsif is_oldest %>

                      <span class="entity-version-history__marker">
                        Oldest
                      </span>

                  <% end %>
                </td>

                <!-- CREATED -->

                <td>
                  <% if version.respond_to?(:created_at) &&
                    version.created_at.present? %>

                    <%= version.created_at %>

                  <% else %>

                    —

                  <% end %>
                </td>

                <!-- STATUS -->

                <td>
                  <% if version.respond_to?(:status) &&
                    version.status.present? %>

                    <%= version.status %>

                  <% else %>

                    —

                  <% end %>
                </td>

                <!-- OLD -->

                <td>
                  <input
                    type="radio"
                    name="history_old_version"
                    value="<%= version.id %>"
                    aria-label="Select <%= comparison_version_label(version) %> as old version"
                    data-entity-version-history-target="oldVersion"
                    data-action="change->entity-version-history#oldVersionChanged"
                    <%= "checked" if is_previous && previous_version.present? %>
                  >
                </td>

                <!-- NEW -->

                <td>
                  <input
                    type="radio"
                    name="history_new_version"
                    value="<%= version.id %>"
                    aria-label="Select <%= comparison_version_label(version) %> as new version"
                    data-entity-version-history-target="newVersion"
                    data-action="change->entity-version-history#newVersionChanged"
                    <%= "checked" if is_newest %>
                  >
                </td>

                <!-- VIEW -->

                <td>
                  <%= link_to(
                        "View",
                        version_admin_ecosystems_load_sources_entity_path(
                          @entity,
                          version.id
                        ),
                        class: "entity-comparison__button"
                      ) %>
                </td>

              </tr>

            <% end %>

            </tbody>
          </table>
        </div>

        <!-- ======================================================
             SUBMISSION VALUES
             ====================================================== -->

        <input
          type="hidden"
          name="from_version"
          value=""
          data-entity-version-history-target="fromVersion"
        >

        <input
          type="hidden"
          name="to_version"
          value=""
          data-entity-version-history-target="toVersion"
        >

      </section>

    </form>

  <% else %>

    <div class="entity-comparison__empty">
      This entity has no versions yet.
    </div>

  <% end %>

</div>