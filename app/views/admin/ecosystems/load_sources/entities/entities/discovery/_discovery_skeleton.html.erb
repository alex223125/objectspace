<div class="grid gap-4 md:grid-cols-2">

  <% 4.times do %>
    <div class="animate-pulse rounded-[26px] border border-white/10 bg-white/[0.025] p-5">
      <div class="flex items-start justify-between">
        <div class="w-2/3">
          <div class="h-5 w-24 rounded bg-white/10"></div>
          <div class="mt-4 h-5 w-40 rounded bg-white/10"></div>
          <div class="mt-2 h-3 w-20 rounded bg-white/5"></div>
        </div>

        <div class="h-10 w-12 rounded bg-white/10"></div>
      </div>

      <div class="mt-6 h-1.5 rounded bg-white/5"></div>

      <div class="mt-5 flex gap-2">
        <div class="h-6 w-24 rounded-full bg-white/5"></div>
        <div class="h-6 w-20 rounded-full bg-white/5"></div>
      </div>

      <div class="mt-5 grid grid-cols-2 gap-2">
        <div class="h-10 rounded-xl bg-white/10"></div>
        <div class="h-10 rounded-xl bg-white/5"></div>
      </div>
    </div>
  <% end %>

</div>