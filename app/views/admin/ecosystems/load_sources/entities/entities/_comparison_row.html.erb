<% fact = local_assigns.fetch(:fact) %>

<%
  type = fact[:type].to_s

  type_styles =
    case type
    when "content_change"
      {
        badge: "bg-sky-50 text-sky-600 border-sky-100",
        icon: "✦",
        icon_bg: "bg-sky-100 text-sky-600"
      }
    when "semantic_movement"
      {
        badge: "bg-violet-50 text-violet-600 border-violet-100",
        icon: "↗",
        icon_bg: "bg-violet-100 text-violet-600"
      }
    when "added_entity"
      {
        badge: "bg-emerald-50 text-emerald-600 border-emerald-100",
        icon: "+",
        icon_bg: "bg-emerald-100 text-emerald-600"
      }
    when "removed_entity"
      {
        badge: "bg-rose-50 text-rose-600 border-rose-100",
        icon: "−",
        icon_bg: "bg-rose-100 text-rose-600"
      }
    when "identity_warning"
      {
        badge: "bg-amber-50 text-amber-600 border-amber-100",
        icon: "!",
        icon_bg: "bg-amber-100 text-amber-600"
      }
    else
      {
        badge: "bg-slate-50 text-slate-600 border-slate-100",
        icon: "•",
        icon_bg: "bg-slate-100 text-slate-600"
      }
    end

  label =
    case type
    when "content_change"
      "Changed"
    when "semantic_movement"
      "Moved"
    when "added_entity"
      "Added"
    when "removed_entity"
      "Removed"
    when "identity_warning"
      "Identity warning"
    else
      type.humanize
    end

  path =
    Array(fact[:path])
      .map(&:to_s)
      .join(" › ")

  identity =
    fact[:identity].presence

  old_value =
    fact[:old_value]

  new_value =
    fact[:new_value]
%>

<article
  data-admin--ecosystems--load-sources--entities--entity-comparison-workspace-target="row"
  data-comparison-row
  data-change-type="<%= type %>"
  data-comparison-path="<%= path %>"
  data-comparison-identity="<%= identity %>"
  data-comparison-old-value="<%= old_value.to_json %>"
  data-comparison-new-value="<%= new_value.to_json %>"
  class="group relative overflow-hidden
         rounded-[24px]
         border border-slate-200/80
         bg-white
         p-5
         shadow-sm
         transition-all duration-300
         hover:-translate-y-0.5
         hover:border-violet-200
         hover:shadow-[0_18px_45px_-30px_rgba(91,33,182,0.35)]">

  <!-- Hover accent -->

  <div
    class="absolute inset-y-0 left-0 w-1
           <%= type_styles[:icon_bg] %>
           opacity-0
           transition-opacity duration-300
           group-hover:opacity-100">
  </div>

  <div
    class="flex flex-col gap-4
           lg:flex-row
           lg:items-start
           lg:justify-between">

    <!-- Main -->

    <div class="min-w-0 flex-1">

      <div
        class="flex flex-wrap
               items-center gap-2">

        <span
          class="flex h-8 w-8
                 items-center justify-center
                 rounded-xl
                 <%= type_styles[:icon_bg] %>
                 text-sm font-black">
          <%= type_styles[:icon] %>
        </span>

        <span
          class="rounded-full
                 border
                 px-2.5 py-1
                 text-[9px]
                 font-black
                 uppercase
                 tracking-widest
                 <%= type_styles[:badge] %>">
          <%= label %>
        </span>

        <% if identity.present? %>

          <span
            class="rounded-full
                   border border-slate-100
                   bg-slate-50
                   px-2.5 py-1
                   text-[9px]
                   font-bold
                   text-slate-400">
            Identity tracked
          </span>

        <% end %>

      </div>

      <!-- Path -->

      <div
        class="mt-4 flex items-center gap-2">

        <span
          class="text-[9px]
                 font-black
                 uppercase
                 tracking-widest
                 text-slate-300">
          Path
        </span>

        <code
          class="min-w-0 truncate
                 rounded-lg
                 bg-slate-50
                 px-2.5 py-1
                 text-[11px]
                 font-bold
                 text-slate-600">
          <%= path.presence || "Root" %>
        </code>

      </div>

      <% if identity.present? %>

        <div
          class="mt-2 text-[10px]
                 text-slate-400">

          Identity:
          <code
            class="font-bold text-slate-500">
            <%= identity %>
          </code>

        </div>

      <% end %>

    </div>

    <!-- Movement -->

    <% if type == "semantic_movement" %>

      <div
        class="flex shrink-0
               items-center gap-3
               rounded-2xl
               bg-violet-50
               px-4 py-3">

        <div class="text-center">

          <div
            class="text-[9px]
                   font-black
                   uppercase
                   tracking-widest
                   text-violet-300">
            Old
          </div>

          <div
            class="mt-1 text-lg
                   font-black
                   text-violet-600">
            <%= fact[:old_index] %>
          </div>

        </div>

        <span
          class="text-violet-300">
          →
        </span>

        <div class="text-center">

          <div
            class="text-[9px]
                   font-black
                   uppercase
                   tracking-widest
                   text-violet-300">
            New
          </div>

          <div
            class="mt-1 text-lg
                   font-black
                   text-violet-600">
            <%= fact[:new_index] %>
          </div>

        </div>

      </div>

    <% end %>

  </div>

  <!-- Values -->

  <% unless type == "semantic_movement" %>

    <div
      class="mt-5 grid gap-3
             lg:grid-cols-2">

      <div
        class="rounded-2xl
               border border-rose-100
               bg-rose-50/40
               p-4">

        <div
          class="mb-2 flex items-center
                 justify-between">

          <span
            class="text-[9px]
                   font-black
                   uppercase
                   tracking-widest
                   text-rose-400">
            Previous
          </span>

          <span
            class="rounded-full
                   bg-white
                   px-2 py-0.5
                   text-[8px]
                   font-black
                   text-rose-400">
            OLD
          </span>

        </div>

        <pre
          class="max-h-56
                 overflow-auto
                 whitespace-pre-wrap
                 break-words
                 text-[11px]
                 leading-5
                 text-slate-600"><%= old_value.nil? ? "—" : old_value.is_a?(Hash) || old_value.is_a?(Array) ? JSON.pretty_generate(old_value) : old_value.to_s %></pre>

      </div>

      <div
        class="rounded-2xl
               border border-emerald-100
               bg-emerald-50/40
               p-4">

        <div
          class="mb-2 flex items-center
                 justify-between">

          <span
            class="text-[9px]
                   font-black
                   uppercase
                   tracking-widest
                   text-emerald-500">
            Current
          </span>

          <span
            class="rounded-full
                   bg-white
                   px-2 py-0.5
                   text-[8px]
                   font-black
                   text-emerald-500">
            NEW
          </span>

        </div>

        <pre
          class="max-h-56
                 overflow-auto
                 whitespace-pre-wrap
                 break-words
                 text-[11px]
                 leading-5
                 text-slate-600"><%= new_value.nil? ? "—" : new_value.is_a?(Hash) || new_value.is_a?(Array) ? JSON.pretty_generate(new_value) : new_value.to_s %></pre>

      </div>

    </div>

  <% end %>

  <!-- Footer -->

  <div
    class="mt-4 flex flex-wrap
           items-center gap-3
           border-t border-slate-100
           pt-3">

    <span
      class="text-[9px]
             font-bold
             text-slate-300">
      Comparison signal
    </span>

    <span
      class="h-1 w-1
             rounded-full
             bg-slate-200">
    </span>

    <span
      class="text-[9px]
             font-bold
             text-slate-400">
      <%= label %>
    </span>

  </div>

</article>