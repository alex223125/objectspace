<%
  timeline_versions =
    if defined?(@versions) && @versions.present?
      @versions.map.with_index do |version, index|
        {
          id: version.respond_to?(:id) ? version.id : index,
          version: (
            if version.respond_to?(:version)
              version.version
            elsif version.respond_to?(:number)
              version.number
            else
              "Version #{index + 1}"
            end
          ),
          date: (
            if version.respond_to?(:created_at)
              version.created_at
            else
              nil
            end
          ),
          changes: (
            if version.respond_to?(:change_count)
              version.change_count
            elsif version.respond_to?(:changes_count)
              version.changes_count
            else
              0
            end
          ),
          current: (
            if defined?(@new_version) && @new_version
              version.respond_to?(:id) &&
                version.id == @new_version.id
            else
              false
            end
          )
        }
      end
    else
      []
    end
%>

<section
  class="
    mt-8
    overflow-hidden
    rounded-[32px]
    border
    border-violet-100
    bg-white
    shadow-md
    shadow-violet-100/30
  "
  data-controller="entity-evolution-timeline"
  data-entity-evolution-timeline-versions-value="<%= ERB::Util.html_escape(timeline_versions.to_json) %>">

  <div
    class="
      border-b
      border-violet-100
      bg-gradient-to-r
      from-violet-50/80
      via-white
      to-indigo-50/50
      px-6
      py-5
    ">

    <div
      class="
        flex
        flex-col
        gap-4
        lg:flex-row
        lg:items-center
        lg:justify-between
      ">

      <div
        class="
          flex
          items-start
          gap-4
        ">

        <div
          class="
            flex
            h-11
            w-11
            shrink-0
            items-center
            justify-center
            rounded-2xl
            border
            border-violet-200
            bg-violet-50
            text-lg
          ">

          ◌

        </div>

        <div>

          <div
            class="
              text-[10px]
              font-black
              uppercase
              tracking-[0.18em]
              text-violet-500
            ">

            Evolution timeline

          </div>

          <h3
            class="
              mt-1
              text-lg
              font-black
              tracking-tight
              text-slate-800
            ">

            How this entity evolved

          </h3>

          <p
            class="
              mt-1
              max-w-2xl
              text-xs
              leading-5
              text-slate-400
            ">

            Follow structural activity across versions
            and identify important transition points.

          </p>

        </div>

      </div>


      <div
        class="
          flex
          items-center
          gap-2
        ">

        <button
          type="button"
          data-entity-evolution-timeline-target="previous"
          data-action="click->entity-evolution-timeline#previous"
          class="
            rounded-xl
            border
            border-slate-200
            bg-white
            px-3
            py-2
            text-xs
            font-black
            text-slate-500
            transition
            hover:border-violet-200
            hover:text-violet-600
            disabled:cursor-not-allowed
            disabled:opacity-30
          ">

          ←

        </button>

        <button
          type="button"
          data-entity-evolution-timeline-target="next"
          data-action="click->entity-evolution-timeline#next"
          class="
            rounded-xl
            border
            border-slate-200
            bg-white
            px-3
            py-2
            text-xs
            font-black
            text-slate-500
            transition
            hover:border-violet-200
            hover:text-violet-600
            disabled:cursor-not-allowed
            disabled:opacity-30
          ">

          →

        </button>

      </div>

    </div>

  </div>


  <div class="px-6 pt-6">

    <div
      data-entity-evolution-timeline-target="summary">
    </div>

  </div>


  <div
    class="
      relative
      mt-6
      overflow-x-auto
      px-6
      pb-8
    ">

    <div
      class="
        absolute
        left-10
        right-10
        top-[22px]
        h-px
        bg-gradient-to-r
        from-slate-100
        via-violet-200
        to-slate-100
      ">
    </div>

    <div
      data-entity-evolution-timeline-target="timeline"
      class="
        relative
        flex
        min-w-max
        items-start
      ">

    </div>

  </div>

</section>