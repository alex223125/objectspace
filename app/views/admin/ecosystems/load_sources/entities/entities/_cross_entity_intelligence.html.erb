<%
  intelligence_service =
    Ecosystems::LoadSources::Entity::CrossEntityIntelligence.new(entities)

  dashboard = intelligence_service.dashboard

  metrics = dashboard[:metrics] || {}
  relationships = dashboard[:relationships] || []
  signals = dashboard[:signals] || []
  clusters = dashboard[:clusters] || []
%>

<section class="overflow-hidden rounded-[28px] border border-violet-200 bg-white shadow-sm dark:border-violet-900/50 dark:bg-gray-900">
  <div class="border-b border-violet-100 bg-gradient-to-br from-violet-50 via-white to-sky-50 px-5 py-5 dark:border-violet-900/50 dark:from-violet-950/40 dark:via-gray-900 dark:to-sky-950/30">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
      <div>
        <div class="text-[9px] font-black uppercase tracking-[0.25em] text-violet-500 dark:text-violet-400">
          Step 9 // Ecosystem Intelligence
        </div>

        <h2 class="mt-1 text-lg font-black tracking-tight text-gray-900 dark:text-white">
          Cross-Entity Intelligence
        </h2>

        <p class="mt-1 max-w-2xl text-xs leading-relaxed text-gray-500 dark:text-gray-400">
          Structural relationships and review signals discovered across the entity registry.
        </p>
      </div>

      <span class="rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1.5 text-[9px] font-black uppercase tracking-widest text-emerald-600 dark:border-emerald-900 dark:bg-emerald-950/30 dark:text-emerald-400">
        LIVE ANALYSIS
      </span>
    </div>
  </div>

  <div class="grid grid-cols-2 border-b border-gray-100 dark:border-gray-800 lg:grid-cols-4">
    <div class="border-r border-gray-100 p-4 dark:border-gray-800">
      <div class="text-[9px] font-black uppercase tracking-widest text-gray-400">Entities</div>
      <div class="mt-1 text-2xl font-black text-gray-900 dark:text-white">
        <%= number_with_delimiter(metrics[:entities] || 0) %>
      </div>
    </div>

    <div class="border-r border-gray-100 p-4 dark:border-gray-800">
      <div class="text-[9px] font-black uppercase tracking-widest text-gray-400">Relationships</div>
      <div class="mt-1 text-2xl font-black text-violet-600">
        <%= number_with_delimiter(metrics[:relationships] || 0) %>
      </div>
    </div>

    <div class="border-r border-gray-100 p-4 dark:border-gray-800">
      <div class="text-[9px] font-black uppercase tracking-widest text-gray-400">Confirmed</div>
      <div class="mt-1 text-2xl font-black text-emerald-600">
        <%= number_with_delimiter(metrics[:confirmed_relationships] || 0) %>
      </div>
    </div>

    <div class="p-4">
      <div class="text-[9px] font-black uppercase tracking-widest text-gray-400">Review Queue</div>
      <div class="mt-1 text-2xl font-black text-amber-600">
        <%= number_with_delimiter(metrics[:review_queue] || 0) %>
      </div>
    </div>
  </div>

  <div class="grid gap-5 p-5 xl:grid-cols-2">
    <div>
      <h3 class="mb-3 text-xs font-black uppercase tracking-widest text-gray-500 dark:text-gray-400">
        Relationship Hotspots
      </h3>

      <% hotspots = dashboard[:hotspots] || [] %>

      <% if hotspots.any? %>
        <div class="space-y-2">
          <% hotspots.each do |item| %>
            <% entity = item[:entity] %>
            <% next unless entity %>

            <div class="flex items-center justify-between gap-3 rounded-xl border border-gray-100 bg-gray-50 p-3 dark:border-gray-800 dark:bg-gray-950">
              <%= link_to(
                    entity.name,
                    admin_ecosystems_load_sources_entity_path(entity),
                    class: "truncate text-xs font-bold text-gray-800 hover:text-violet-600 dark:text-gray-100"
                  ) %>

              <span class="shrink-0 rounded-full bg-violet-100 px-2.5 py-1 text-[9px] font-black text-violet-700 dark:bg-violet-950 dark:text-violet-300">
                <%= item[:relationship_count] %> links
              </span>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="rounded-xl border border-dashed border-gray-200 p-5 text-center text-xs text-gray-500 dark:border-gray-700">
          No relationship hotspots found yet.
        </div>
      <% end %>
    </div>

    <div>
      <h3 class="mb-3 text-xs font-black uppercase tracking-widest text-gray-500 dark:text-gray-400">
        Review Opportunities
      </h3>

      <% opportunities = dashboard[:review_opportunities] || [] %>

      <% if opportunities.any? %>
        <div class="space-y-2">
          <% opportunities.each do |entity| %>
            <div class="rounded-xl border border-amber-100 bg-amber-50/50 p-3 dark:border-amber-900/50 dark:bg-amber-950/20">
              <%= link_to(
                    entity.name,
                    admin_ecosystems_load_sources_entity_path(entity),
                    class: "text-xs font-bold text-gray-800 hover:text-amber-600 dark:text-gray-100"
                  ) %>

              <div class="mt-1 text-[10px] text-gray-500 dark:text-gray-400">
                Health score: <%= entity.health_score %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="rounded-xl border border-dashed border-gray-200 p-5 text-center text-xs text-gray-500 dark:border-gray-700">
          No review opportunities identified.
        </div>
      <% end %>
    </div>
  </div>

  <% isolated = dashboard[:isolated] || [] %>

  <% if isolated.any? %>
    <div class="border-t border-gray-100 p-5 dark:border-gray-800">
      <h3 class="mb-3 text-xs font-black uppercase tracking-widest text-gray-500 dark:text-gray-400">
        Isolated Entities
      </h3>

      <div class="flex flex-wrap gap-2">
        <% isolated.first(25).each do |entity| %>
          <%= link_to(
                entity.name,
                admin_ecosystems_load_sources_entity_path(entity),
                class: "rounded-lg border border-gray-200 bg-gray-50 px-3 py-2 text-[10px] font-bold text-gray-600 hover:border-violet-300 hover:text-violet-600 dark:border-gray-700 dark:bg-gray-950 dark:text-gray-300"
              ) %>
        <% end %>
      </div>
    </div>
  <% end %>
</section>
