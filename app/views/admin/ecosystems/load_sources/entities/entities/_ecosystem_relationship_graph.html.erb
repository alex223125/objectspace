
<%
  Rails.logger.info(
    "[EcosystemRelationshipGraph] Rendering graph partial"
  )

  graph_entities =
    if local_assigns[:graph_entities].present?
      local_assigns[:graph_entities]
    elsif defined?(@ecosystem_relationship_graph_entities) &&
      @ecosystem_relationship_graph_entities.present?
      @ecosystem_relationship_graph_entities
    elsif defined?(@entities) && @entities.present?
      @entities
    elsif defined?(@entity) && @entity.present?
      [@entity]
    else
      []
    end

  graph_entity =
    if defined?(@entity) && @entity.present?
      @entity
    else
      nil
    end

  Rails.logger.info(
    "[EcosystemRelationshipGraph] Focus entity ID: #{graph_entity&.id.inspect}"
  )

  Rails.logger.info(
    "[EcosystemRelationshipGraph] Input entities count: #{graph_entities.size}"
  )

  relationship_graph =
    Ecosystems::LoadSources::Entity::RelationshipGraph.call(
      entity: graph_entity,
      entities: graph_entity.present? ? nil : graph_entities,
      limit: 60
    )

  relationship_graph =
    relationship_graph.to_h if relationship_graph.respond_to?(:to_h)

  relationship_graph =
    {} unless relationship_graph.is_a?(Hash)

  Rails.logger.info(
    "[EcosystemRelationshipGraph] Service result keys: #{relationship_graph.keys.inspect}"
  )

  Rails.logger.info(
    "[EcosystemRelationshipGraph] Service result: #{relationship_graph.to_json.truncate(2000)}"
  )

  graph_payload = relationship_graph.to_json
%>

<div
  data-controller="entity-ecosystem-relationship-graph"
  data-entity-ecosystem-relationship-graph-payload-value="<%= ERB::Util.html_escape(graph_payload) %>"
  class="overflow-hidden rounded-[28px] border border-violet-200/70 bg-white shadow-sm dark:border-violet-900/50 dark:bg-gray-950">

  <div class="border-b border-violet-100 px-5 py-4 dark:border-violet-900/50">
    <div class="text-[9px] font-black uppercase tracking-[0.22em] text-violet-500">
      Ecosystem intelligence
    </div>

    <h2 class="mt-1 text-lg font-black text-gray-900 dark:text-white">
      Relationship graph
    </h2>

    <p class="mt-1 text-xs leading-5 text-gray-500 dark:text-gray-400">
      Each circle represents an entity. Lines represent relationships
      explicitly supplied by your application.
      Select a circle to inspect its connections.
    </p>
  </div>

  <div class="flex flex-wrap items-center gap-3 border-b border-gray-100 p-4 dark:border-gray-800">
    <span class="rounded-full bg-violet-50 px-3 py-1.5 text-xs font-bold text-violet-700 dark:bg-violet-950/40 dark:text-violet-300">
      <span data-entity-ecosystem-relationship-graph-target="nodeCount">0</span>
      entities
    </span>

    <span class="rounded-full bg-sky-50 px-3 py-1.5 text-xs font-bold text-sky-700 dark:bg-sky-950/40 dark:text-sky-300">
      <span data-entity-ecosystem-relationship-graph-target="relationshipCount">0</span>
      relationships
    </span>

    <span class="rounded-full bg-emerald-50 px-3 py-1.5 text-xs font-bold text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-300">
      <span data-entity-ecosystem-relationship-graph-target="connectedCount">0</span>
      connections to selection
    </span>

    <div class="ml-auto flex items-center gap-2">
      <button
        type="button"
        data-action="click->entity-ecosystem-relationship-graph#zoomOut"
        title="Zoom out to see more of the graph"
        class="rounded-xl border border-gray-200 px-3 py-2 text-sm font-bold text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:text-gray-200">
        −
      </button>

      <button
        type="button"
        data-action="click->entity-ecosystem-relationship-graph#zoomIn"
        title="Zoom in to inspect the graph"
        class="rounded-xl border border-gray-200 px-3 py-2 text-sm font-bold text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:text-gray-200">
        +
      </button>

      <button
        type="button"
        data-action="click->entity-ecosystem-relationship-graph#resetView"
        title="Reset zoom, pan, and selected entity"
        class="rounded-xl border border-gray-200 px-3 py-2 text-xs font-bold text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:text-gray-200">
        Reset view
      </button>
    </div>
  </div>

  <div class="grid gap-4 p-4 lg:grid-cols-[minmax(0,1fr)_280px]">
    <div class="min-w-0">
      <div class="mb-3 flex flex-col gap-3 sm:flex-row">
        <input
          type="search"
          placeholder="Search by entity name or type…"
          aria-label="Search graph entities"
          data-entity-ecosystem-relationship-graph-target="search"
          data-action="input->entity-ecosystem-relationship-graph#search"
          class="min-w-0 flex-1 rounded-xl border border-gray-200 px-3 py-2 text-sm outline-none focus:border-violet-400 focus:ring-2 focus:ring-violet-100 dark:border-gray-700 dark:bg-gray-900 dark:text-white">

        <select
          aria-label="Filter entities by type"
          data-entity-ecosystem-relationship-graph-target="filter"
          data-action="change->entity-ecosystem-relationship-graph#filter"
          class="rounded-xl border border-gray-200 px-3 py-2 text-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white">
          <option value="all">All entity types</option>
        </select>
      </div>

      <div
        data-entity-ecosystem-relationship-graph-target="canvas"
        class="relative overflow-auto rounded-2xl border border-gray-200 bg-slate-50 dark:border-gray-800 dark:bg-gray-900"
        style="min-height: 380px; touch-action: pan-y;">

        <svg
          data-entity-ecosystem-relationship-graph-target="svg"
          viewBox="0 0 900 500"
          role="img"
          aria-label="Interactive graph showing entities and their relationships"
          preserveAspectRatio="xMidYMid meet"
          class="block min-h-[380px] w-full">
        </svg>

        <div
          data-entity-ecosystem-relationship-graph-target="empty"
          class="pointer-events-none absolute inset-x-4 top-1/2 -translate-y-1/2 rounded-xl border border-dashed border-gray-300 bg-white/95 p-5 text-center text-sm leading-6 text-gray-500 dark:border-gray-700 dark:bg-gray-950/95 dark:text-gray-400">
          Loading graph data…
        </div>
      </div>

      <div class="mt-3 rounded-xl bg-violet-50/70 p-3 text-xs leading-5 text-violet-900 dark:bg-violet-950/30 dark:text-violet-200">
        <strong>How to explore:</strong>
        Select a circle to inspect it. Hover over a circle or line for a hint.
        Use the search box to find an entity, the filter to narrow the view,
        and the zoom buttons to change scale.
      </div>
    </div>

    <aside class="min-w-0 rounded-2xl border border-gray-200 bg-white p-4 dark:border-gray-800 dark:bg-gray-950">
      <div class="text-[10px] font-black uppercase tracking-widest text-violet-500">
        Entity guide
      </div>

      <h3 class="mt-2 text-sm font-black text-gray-900 dark:text-white">
        Understanding the graph
      </h3>

      <div class="mt-4 space-y-4 text-xs leading-5 text-gray-600 dark:text-gray-300">
        <div>
          <div class="font-bold text-gray-800 dark:text-gray-100">
            <span class="mr-2 inline-block h-3 w-3 rounded-full bg-violet-500"></span>
            Entity (circle)
          </div>
          <p class="mt-1">
            One record in your ecosystem, such as a concept, method,
            technology, problem, or version. The color represents its type
            when the type matches a configured color rule.
          </p>
        </div>

        <div>
          <div class="font-bold text-gray-800 dark:text-gray-100">
            <span class="mr-2 inline-block w-5 border-t-2 border-slate-400"></span>
            Relationship (line)
          </div>
          <p class="mt-1">
            A connection recorded between two entities. Its label should
            explain the relationship type. No line means no recognized
            connection is being displayed, not necessarily that the entities
            are unrelated in real life.
          </p>
        </div>

        <div>
          <div class="font-bold text-gray-800 dark:text-gray-100">
            Connected entities
          </div>
          <p class="mt-1">
            The number of distinct entities linked directly to the selected
            entity. It is not the total number of entities in the ecosystem.
          </p>
        </div>

        <div>
          <div class="font-bold text-gray-800 dark:text-gray-100">
            Relationship strength
          </div>
          <p class="mt-1">
            The line thickness uses the supplied strength or weight.
            If the data has no strength, the controller uses 1 as a
            display fallback. This is not automatically a probability
            or a confidence score.
          </p>
        </div>
      </div>

      <div class="mt-5 border-t border-gray-100 pt-4 dark:border-gray-800">
        <div class="text-[10px] font-black uppercase tracking-widest text-gray-400">
          Selected entity
        </div>

        <div
          data-entity-ecosystem-relationship-graph-target="details"
          class="mt-3 hidden">

          <h4
            data-entity-ecosystem-relationship-graph-target="detailsTitle"
            class="break-words text-sm font-black text-gray-900 dark:text-white">
          </h4>

          <div
            data-entity-ecosystem-relationship-graph-target="detailsType"
            class="mt-1 text-xs text-violet-600 dark:text-violet-400">
          </div>

          <div class="mt-3 rounded-xl bg-gray-50 p-3 dark:bg-gray-900">
            <div class="text-[10px] font-bold uppercase tracking-wider text-gray-400">
              Direct connections
            </div>
            <div
              data-entity-ecosystem-relationship-graph-target="detailsConnections"
              class="mt-1 text-xl font-black text-gray-900 dark:text-white">
              0
            </div>
          </div>

          <p
            data-entity-ecosystem-relationship-graph-target="detailsDescription"
            class="mt-3 break-words text-xs leading-5 text-gray-600 dark:text-gray-300">
          </p>
        </div>

        <p class="mt-3 text-xs leading-5 text-gray-500 dark:text-gray-400">
          Select a circle to see its name, type, description, and direct
          connections here.
        </p>
      </div>

      <div class="mt-5 border-t border-gray-100 pt-4 dark:border-gray-800">
        <div class="text-[10px] font-black uppercase tracking-widest text-gray-400">
          Exploration progress
        </div>

        <div class="mt-2 flex items-center justify-between gap-2 text-xs">
          <span data-entity-ecosystem-relationship-graph-target="status">
            🧭 Begin exploring
          </span>
          <span>
            <span data-entity-ecosystem-relationship-graph-target="xp">0</span> XP
          </span>
        </div>

        <div
          class="mt-3 h-2 overflow-hidden rounded-full bg-gray-100 dark:bg-gray-800"
          role="progressbar"
          aria-label="Entity exploration progress">
          <div
            data-entity-ecosystem-relationship-graph-target="progress"
            class="h-full rounded-full bg-gradient-to-r from-violet-500 to-indigo-500 transition-all duration-300"
            style="width: 0%">
          </div>
        </div>

        <p class="mt-2 text-[10px] leading-4 text-gray-400">
          XP and progress track which distinct entities you have opened
          during this page visit. They are exploration indicators, not
          measures of data quality.
        </p>
      </div>
    </aside>
  </div>
</div>