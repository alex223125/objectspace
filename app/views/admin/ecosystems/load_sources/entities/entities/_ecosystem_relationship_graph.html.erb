<%
  graph_entities =
    if defined?(local_assigns) &&
      local_assigns[:graph_entities].present?

      local_assigns[:graph_entities]

    elsif defined?(@ecosystem_relationship_graph_entities) &&
      @ecosystem_relationship_graph_entities.present?

      @ecosystem_relationship_graph_entities

    elsif defined?(@entities) &&
      @entities.present?

      @entities

    elsif defined?(@entity) &&
      @entity.present?

      [@entity]

    else
      []
    end

  graph_entity =
    if defined?(@entity) && @entity.present?
      @entity
    else
      nil
    end

  relationship_graph =
    Ecosystems::LoadSources::Entity::RelationshipGraph.call(
      entity: graph_entity,
      entities:
        graph_entity.present? ?
          nil :
          graph_entities,
      limit: 60
    )
%>

<div
  data-controller="ecosystem-relationship-graph"
  data-ecosystem-relationship-graph-payload-value="<%= ERB::Util.html_escape(relationship_graph.to_json) %>"
  class="overflow-hidden rounded-[28px] border border-violet-200/70 bg-gradient-to-br from-violet-50 via-white to-indigo-50 shadow-sm dark:border-violet-900/50 dark:from-violet-950/30 dark:via-gray-950 dark:to-indigo-950/30">

  <div class="border-b border-violet-100 px-5 py-4 dark:border-violet-900/50">

    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">

      <div>

        <div class="text-[9px] font-black uppercase tracking-[0.22em] text-violet-500">
          Ecosystem Intelligence
        </div>

        <h2 class="mt-1 text-lg font-black tracking-tight text-gray-900 dark:text-white">
          Relationship Graph
        </h2>

        <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">
          Structural relationships discovered across the entity ecosystem.
        </p>

      </div>

      <div class="flex items-center gap-2">

        <span class="rounded-full border border-violet-200 bg-white px-3 py-1.5 text-[9px] font-black uppercase tracking-wider text-violet-600 dark:border-violet-800 dark:bg-gray-900 dark:text-violet-400">
          <%= relationship_graph[:relationship_count] %>
          relationships
        </span>

        <span class="rounded-full border border-indigo-200 bg-white px-3 py-1.5 text-[9px] font-black uppercase tracking-wider text-indigo-600 dark:border-indigo-800 dark:bg-gray-900 dark:text-indigo-400">
          <%= relationship_graph[:node_count] %>
          nodes
        </span>

      </div>

    </div>

  </div>

  <div class="p-5">

    <% if relationship_graph[:nodes].empty? %>

      <div class="rounded-2xl border border-dashed border-violet-200 bg-white/70 px-5 py-10 text-center dark:border-violet-900 dark:bg-gray-950/50">

        <div class="text-3xl">
          ◎
        </div>

        <div class="mt-3 text-sm font-black text-gray-800 dark:text-white">
          No ecosystem relationships yet
        </div>

        <p class="mx-auto mt-1 max-w-md text-xs leading-relaxed text-gray-500 dark:text-gray-400">
          Relationship discovery will populate this graph as entities become connected.
        </p>

      </div>

    <% else %>

      <div
        data-ecosystem-relationship-graph-target="canvas"
        class="relative min-h-[260px] overflow-hidden rounded-2xl border border-violet-100 bg-gray-950 p-4 dark:border-violet-900/50">

        <svg
          data-ecosystem-relationship-graph-target="svg"
          viewBox="0 0 900 320"
          preserveAspectRatio="xMidYMid meet"
          class="h-full min-h-[260px] w-full">
        </svg>

      </div>

      <div class="mt-4 grid gap-2 sm:grid-cols-2 lg:grid-cols-3">

        <% relationship_graph[:nodes].first(9).each do |node| %>

          <div
            class="rounded-2xl border border-gray-200 bg-white p-3 dark:border-gray-800 dark:bg-gray-900">

            <div class="flex items-center gap-3">

              <div
                class="flex h-8 w-8 shrink-0 items-center justify-center rounded-xl bg-violet-100 text-sm dark:bg-violet-950/50">
                🧬
              </div>

              <div class="min-w-0">

                <div class="truncate text-xs font-black text-gray-800 dark:text-gray-100">
                  <%= node[:name] %>
                </div>

                <div class="truncate font-mono text-[8px] text-gray-400">
                  <%= node[:slug] %>
                </div>

              </div>

              <% if node[:focus] %>
                <span class="ml-auto rounded-full bg-indigo-100 px-2 py-1 text-[8px] font-black uppercase text-indigo-600 dark:bg-indigo-950 dark:text-indigo-400">
                  FOCUS
                </span>
              <% end %>

            </div>

          </div>

        <% end %>

      </div>

    <% end %>

  </div>

</div>