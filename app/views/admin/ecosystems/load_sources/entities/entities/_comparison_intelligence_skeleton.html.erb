<div class="mt-8 rounded-[32px] border-2 border-violet-100 bg-white p-6 shadow-sm md:p-8">

  <div class="animate-pulse">

    <div class="flex items-center gap-4">

      <div class="h-12 w-12 rounded-2xl bg-violet-100"></div>

      <div class="space-y-2">

        <div class="h-3 w-48 rounded-full bg-slate-200"></div>

        <div class="h-2 w-72 rounded-full bg-slate-100"></div>

      </div>

    </div>


    <div class="mt-7 grid grid-cols-1 gap-4 md:grid-cols-3">

      <% 3.times do %>

        <div class="rounded-[26px] border border-slate-100 p-5">

          <div class="h-2 w-24 rounded-full bg-slate-100"></div>

          <div class="mt-4 h-8 w-20 rounded-xl bg-slate-200"></div>

          <div class="mt-4 h-2 w-full rounded-full bg-slate-100"></div>

        </div>

      <% end %>

    </div>


    <div class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-2">

      <% 2.times do %>

        <div class="rounded-[26px] border border-slate-100 p-5">

          <div class="h-3 w-32 rounded-full bg-slate-200"></div>

          <div class="mt-5 space-y-3">

            <% 3.times do %>

              <div class="h-16 rounded-2xl bg-slate-50"></div>

            <% end %>

          </div>

        </div>

      <% end %>

    </div>

  </div>

</div>