<%
  type =
    fact[:type] ||
      fact["type"] ||
      "content_change"

  path =
    fact[:path] ||
      fact["path"] ||
      []

  identity =
    fact[:identity] ||
      fact["identity"]

  old_value =
    fact[:old_value] ||
      fact["old_value"]

  new_value =
    fact[:new_value] ||
      fact["new_value"]

  old_index =
    fact[:old_index] ||
      fact["old_index"]

  new_index =
    fact[:new_index] ||
      fact["new_index"]

  metadata =
    fact[:metadata] ||
      fact["metadata"] ||
      {}

  path_label =
    if path.respond_to?(:join)
      path.join(" › ")
    else
      path.to_s
    end

  type_label =
    case type.to_s
    when "content_change"
      "Changed"
    when "semantic_movement"
      "Moved"
    when "added_entity"
      "Added"
    when "removed_entity"
      "Removed"
    when "identity_warning"
      "Identity warning"
    else
      type.to_s.humanize
    end

  badge_classes =
    case type.to_s
    when "content_change"
      "bg-sky-50 text-sky-700 border-sky-200"
    when "semantic_movement"
      "bg-violet-50 text-violet-700 border-violet-200"
    when "added_entity"
      "bg-emerald-50 text-emerald-700 border-emerald-200"
    when "removed_entity"
      "bg-rose-50 text-rose-700 border-rose-200"
    when "identity_warning"
      "bg-amber-50 text-amber-700 border-amber-200"
    else
      "bg-slate-50 text-slate-700 border-slate-200"
    end
%>

<article
  class="
    group relative
    overflow-hidden
    rounded-[28px]
    border border-slate-200/80
    bg-white
    p-5
    shadow-sm
    transition-all duration-300
    hover:-translate-y-0.5
    hover:border-orange-200
    hover:shadow-lg hover:shadow-orange-100/40
  "
  data-comparison-row
  data-change-type="<%= type %>"
  data-comparison-path="<%= path_label %>"
  data-comparison-identity="<%= identity %>"
  data-old-value="<%= old_value.is_a?(Hash) || old_value.is_a?(Array) ? old_value.to_json : old_value %>"
  data-new-value="<%= new_value.is_a?(Hash) || new_value.is_a?(Array) ? new_value.to_json : new_value %>"
>

  <div class="flex flex-col gap-4">

    <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">

      <div class="min-w-0">

        <div class="flex flex-wrap items-center gap-2">

          <span
            class="
              inline-flex items-center
              rounded-full border
              px-2.5 py-1
              text-[10px] font-black uppercase
              tracking-wider
              <%= badge_classes %>
            "
          >
            <%= type_label %>
          </span>

          <% if identity.present? %>
            <span
              class="
                inline-flex items-center
                rounded-full
                bg-slate-50
                px-2.5 py-1
                text-[10px] font-bold
                text-slate-500
              "
            >
              ID: <%= identity %>
            </span>
          <% end %>

        </div>

        <div
          class="
            mt-3
            break-words
            text-sm font-black
            text-slate-800
          "
        >
          <%= path_label.presence || "Root" %>
        </div>

      </div>

      <button
        type="button"
        data-comparison-review-button
        data-action="click->entity-version-comparison#review"
        aria-pressed="false"
        class="
          shrink-0
          rounded-xl
          border border-slate-200
          bg-white
          px-3 py-2
          text-[10px] font-black
          text-slate-500
          shadow-sm
          transition
          hover:border-emerald-200
          hover:bg-emerald-50
          hover:text-emerald-700
        "
      >
        Mark reviewed
      </button>

    </div>

    <% if type.to_s == "semantic_movement" %>

      <div
        class="
          flex items-center gap-4
          rounded-2xl
          border border-violet-100
          bg-violet-50/60
          px-4 py-4
        "
      >
        <div
          class="
            flex h-10 w-10 shrink-0
            items-center justify-center
            rounded-xl
            bg-white
            text-violet-600
            shadow-sm
          "
        >
          ↔
        </div>

        <div>
          <div class="text-[10px] font-black uppercase tracking-widest text-violet-400">
            Position movement
          </div>

          <div class="mt-1 text-sm font-black text-violet-800">
            <%= old_index.nil? ? "—" : old_index %>
            <span class="mx-2 text-violet-300">→</span>
            <%= new_index.nil? ? "—" : new_index %>
          </div>
        </div>
      </div>

    <% elsif type.to_s == "identity_warning" %>

      <% if metadata.present? %>

        <dl class="grid gap-3 sm:grid-cols-2">

          <% metadata.each do |key, value| %>

            <div
              class="
                rounded-2xl
                border border-amber-100
                bg-amber-50/50
                p-4
              "
            >
              <dt
                class="
                  text-[9px]
                  font-black
                  uppercase
                  tracking-widest
                  text-amber-500
                "
              >
                <%= key.to_s.humanize %>
              </dt>

              <dd
                class="
                  mt-1
                  text-xs
                  font-semibold
                  leading-5
                  text-slate-700
                "
              >
                <%= value.is_a?(Hash) || value.is_a?(Array) ? value.to_json : value %>
              </dd>
            </div>

          <% end %>

        </dl>

      <% end %>

    <% else %>

      <div class="grid gap-4 lg:grid-cols-2">

        <div
          class="
            overflow-hidden
            rounded-2xl
            border border-rose-100
            bg-rose-50/40
          "
        >
          <div
            class="
              flex items-center justify-between
              border-b border-rose-100
              px-4 py-2.5
            "
          >
            <span
              class="
                text-[9px]
                font-black
                uppercase
                tracking-widest
                text-rose-500
              "
            >
              Previous
            </span>

            <span class="text-[10px] font-bold text-rose-300">
              OLD
            </span>
          </div>

          <pre
            class="
              max-h-72
              overflow-auto
              whitespace-pre-wrap
              break-words
              p-4
              font-mono
              text-[11px]
              leading-5
              text-slate-600
            "
          ><%= old_value.nil? ? "—" : old_value.is_a?(Hash) || old_value.is_a?(Array) ? JSON.pretty_generate(old_value) : old_value %></pre>
        </div>

        <div
          class="
            overflow-hidden
            rounded-2xl
            border border-emerald-100
            bg-emerald-50/40
          "
        >
          <div
            class="
              flex items-center justify-between
              border-b border-emerald-100
              px-4 py-2.5
            "
          >
            <span
              class="
                text-[9px]
                font-black
                uppercase
                tracking-widest
                text-emerald-600
              "
            >
              Current
            </span>

            <span class="text-[10px] font-bold text-emerald-300">
              NEW
            </span>
          </div>

          <pre
            class="
              max-h-72
              overflow-auto
              whitespace-pre-wrap
              break-words
              p-4
              font-mono
              text-[11px]
              leading-5
              text-slate-600
            "
          ><%= new_value.nil? ? "—" : new_value.is_a?(Hash) || new_value.is_a?(Array) ? JSON.pretty_generate(new_value) : new_value %></pre>
        </div>

      </div>

    <% end %>

  </div>

</article>