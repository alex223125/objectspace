<div class="mx-auto max-w-5xl px-6 py-10">

  <div class="mb-8">

    <%= link_to "← Back to investigation",
                admin_research_workspace_path(@workspace),
                class: "text-xs font-bold text-slate-500 hover:text-white" %>

    <div class="mt-5 text-xs font-bold uppercase tracking-[0.2em] text-orange-400">
      Research history
    </div>

    <h1 class="mt-2 text-3xl font-black text-white">
      <%= @workspace.title %>
    </h1>

    <p class="mt-2 text-sm leading-6 text-slate-500">
      Every saved state of this investigation is preserved here.
      Restoring a snapshot rebuilds the research layer from that historical state.
    </p>

  </div>

  <div class="mb-6 flex flex-wrap gap-3">

    <%= button_to(
          "Save current snapshot",
          snapshot_admin_research_workspace_path(@workspace),
          method: :post,
          class: "rounded-2xl bg-orange-500 px-5 py-3 text-sm font-bold text-white hover:bg-orange-400"
        ) %>

    <%= link_to(
          "Return to workspace",
          admin_research_workspace_path(@workspace),
          class: "rounded-2xl bg-white/5 px-5 py-3 text-sm font-bold text-slate-400 hover:bg-white/10 hover:text-white"
        ) %>

  </div>

  <div class="space-y-4">

    <% @snapshots.each do |snapshot| %>

      <div class="rounded-3xl border border-white/10 bg-white/[0.03] p-6">

        <div class="flex flex-col gap-5 lg:flex-row lg:items-center lg:justify-between">

          <div>

            <div class="flex flex-wrap items-center gap-2">

              <span class="rounded-full bg-orange-500/10 px-3 py-1 text-[10px] font-black uppercase tracking-wider text-orange-300">
                <%= snapshot.kind_label %>
              </span>

              <span class="text-xs text-slate-600">
                <%= snapshot.created_at_label %>
              </span>

            </div>

            <h2 class="mt-3 text-lg font-black text-white">
              <%= snapshot.label %>
            </h2>

            <div class="mt-3 grid grid-cols-3 gap-3 sm:max-w-md">

              <div class="rounded-2xl bg-black/20 p-3 text-center">
                <div class="text-lg font-black text-white">
                  <%= snapshot.item_count %>
                </div>
                <div class="text-[9px] font-bold uppercase tracking-wider text-slate-600">
                  Items
                </div>
              </div>

              <div class="rounded-2xl bg-black/20 p-3 text-center">
                <div class="text-lg font-black text-white">
                  <%= snapshot.annotation_count %>
                </div>
                <div class="text-[9px] font-bold uppercase tracking-wider text-slate-600">
                  Notes
                </div>
              </div>

              <div class="rounded-2xl bg-black/20 p-3 text-center">
                <div class="text-lg font-black text-white">
                  <%= snapshot.evidence_count %>
                </div>
                <div class="text-[9px] font-bold uppercase tracking-wider text-slate-600">
                  Evidence
                </div>
              </div>

            </div>

            <div class="mt-4 text-[10px] font-mono text-slate-700">
              <%= snapshot.checksum %>
            </div>

          </div>

          <div class="flex flex-wrap gap-2">

            <%= button_to(
                  "Restore this state",
                  restore_admin_research_workspace_snapshot_path(
                    @workspace,
                    snapshot
                  ),
                  method: :post,
                  data: {
                    turbo_confirm:
                      "Restore this historical state? Current research data will be replaced."
                  },
                  class: "rounded-xl bg-orange-500 px-4 py-2 text-xs font-bold text-white hover:bg-orange-400"
                ) %>

          </div>

        </div>

      </div>

    <% end %>

  </div>

  <% if @snapshots.empty? %>

    <div class="rounded-3xl border border-dashed border-white/10 bg-white/[0.02] p-12 text-center">

      <div class="text-4xl">
        🕰️
      </div>

      <h2 class="mt-4 text-xl font-black text-white">
        No research history yet
      </h2>

      <p class="mt-2 text-sm text-slate-500">
        Save a snapshot when you reach an important research milestone.
      </p>

    </div>

  <% end %>

</div>