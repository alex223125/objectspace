<div class="mx-auto max-w-6xl px-6 py-10">
  <div class="flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <div class="text-xs font-bold uppercase tracking-[0.2em] <%= snapshot_event_color(@snapshot.event_type) %>">
        Research history
      </div>

      <h1 class="mt-2 text-3xl font-black text-white">
        <%= @snapshot.title %>
      </h1>

      <p class="mt-2 text-sm text-slate-600">
        <%= @workspace.title %>
        · Snapshot #<%= @snapshot.sequence %>
      </p>
    </div>

    <div class="flex flex-wrap gap-2">
      <%= link_to "Back to investigation",
                  admin_saved_investigation_path(@workspace),
                  class: "rounded-2xl bg-white/5 px-5 py-3 text-sm font-bold text-slate-400 hover:bg-white/10 hover:text-white" %>

      <%= button_to "Restore snapshot",
                    restore_admin_research_workspace_snapshot_path(
                      @workspace,
                      @snapshot
                    ),
                    method: :post,
                    data: {
                      turbo_confirm: "Restore this snapshot? Current research records will be replaced."
                    },
                    class: "rounded-2xl bg-purple-500/10 px-5 py-3 text-sm font-bold text-purple-300 hover:bg-purple-500/20" %>
    </div>
  </div>

  <div class="mt-8 grid gap-3 sm:grid-cols-4">
    <%= render "admin/saved_investigations/metric",
               value: @snapshot.item_count,
               label: "Items" %>

    <%= render "admin/saved_investigations/metric",
               value: @snapshot.annotation_count,
               label: "Annotations" %>

    <%= render "admin/saved_investigations/metric",
               value: @snapshot.evidence_count,
               label: "Evidence" %>

    <%= render "admin/saved_investigations/metric",
               value: @snapshot.summary["research_strength"].to_i,
               label: "Strength" %>
  </div>

  <div class="mt-8 rounded-3xl border border-white/10 bg-white/[0.03] p-6">
    <div class="text-xs font-bold uppercase tracking-[0.2em] text-slate-600">
      Snapshot metadata
    </div>

    <pre class="mt-5 overflow-x-auto rounded-2xl bg-black/30 p-5 text-xs leading-6 text-slate-400"><%= JSON.pretty_generate(@snapshot.metadata) %></pre>
  </div>

  <div class="mt-8 rounded-3xl border border-white/10 bg-white/[0.03] p-6">
    <div class="text-xs font-bold uppercase tracking-[0.2em] text-slate-600">
      Snapshot payload
    </div>

    <pre class="mt-5 max-h-[700px] overflow-auto rounded-2xl bg-black/30 p-5 text-xs leading-6 text-slate-400"><%= JSON.pretty_generate(@snapshot.payload) %></pre>
  </div>
</div>