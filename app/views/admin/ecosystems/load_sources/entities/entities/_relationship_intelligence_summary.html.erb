<%
  intelligence =
    Ecosystems::LoadSources::Entity::CrossEntityIntelligence.new(
      entities: [entity]
    ).call

  relationships =
    intelligence[:relationships]
      .select do |relationship|
      relationship[:source_id] == entity.id ||
        relationship[:target_id] == entity.id
    end
      .first(5)
%>

<div class="rounded-[24px] border border-violet-200 bg-white p-5 shadow-sm dark:border-violet-900/50 dark:bg-gray-900">

  <div class="flex items-start justify-between gap-4">

    <div>

      <div class="text-[9px] font-black uppercase tracking-[0.2em] text-violet-500">
        Ecosystem Intelligence
      </div>

      <h3 class="mt-1 text-sm font-black text-gray-900 dark:text-white">
        Related entities
      </h3>

    </div>

    <div class="rounded-full border border-violet-200 bg-violet-50 px-2.5 py-1 text-[8px] font-black uppercase tracking-widest text-violet-600 dark:border-violet-900 dark:bg-violet-950/30 dark:text-violet-400">
      <%= relationships.length %>
    </div>

  </div>

  <% if relationships.any? %>

    <div class="mt-4 space-y-2">

      <% relationships.each do |relationship| %>

        <%
          other_id =
            relationship[:source_id] == entity.id ?
              relationship[:target_id] :
              relationship[:source_id]

          other_name =
            relationship[:source_id] == entity.id ?
              relationship[:target_name] :
              relationship[:source_name]
        %>

        <%= link_to(
              admin_ecosystems_load_sources_entity_path(other_id),
              class: "block rounded-xl border border-gray-100 bg-gray-50 p-3 transition hover:border-violet-200 hover:bg-violet-50 dark:border-gray-800 dark:bg-gray-950 dark:hover:border-violet-900"
            ) do %>

          <div class="flex items-center justify-between gap-3">

            <span class="truncate text-[10px] font-black text-gray-700 dark:text-gray-200">
              <%= other_name %>
            </span>

            <span class="<%= cross_entity_intelligence_strength_class(relationship[:strength]) %> shrink-0 rounded-full border px-2 py-1 text-[8px] font-black uppercase">
              <%= relationship[:score] %>
            </span>

          </div>

          <div class="mt-1 text-[8px] text-gray-400">
            <%= relationship[:reasons].first(3).join(" · ") %>
          </div>

        <% end %>

      <% end %>

    </div>

  <% else %>

    <div class="mt-4 rounded-xl border border-dashed border-gray-200 p-4 text-center text-[9px] text-gray-400 dark:border-gray-700">
      No related entities detected yet.
    </div>

  <% end %>

</div>