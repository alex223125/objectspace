<% entity = local_assigns.fetch(:entity) %>

<%
  relationships =
    entity.outgoing_relationships
          .active
          .includes(:source_entity, :target_entity)
          .confirmed_or_strong
          .limit(8)
%>

<div
  class="rounded-[28px] border border-violet-100 bg-white p-5 shadow-sm dark:border-violet-900/50 dark:bg-gray-900">

  <div class="flex items-center justify-between gap-3">

    <div>

      <div class="text-[9px] font-black uppercase tracking-[0.2em] text-violet-500">
        Structural Intelligence
      </div>

      <h3 class="mt-1 text-base font-black text-gray-900 dark:text-white">
        Related Entities
      </h3>

    </div>

    <div
      class="rounded-full border border-violet-200 bg-violet-50 px-3 py-1 text-[9px] font-black uppercase tracking-widest text-violet-600 dark:border-violet-900 dark:bg-violet-950/30 dark:text-violet-400">
      <%= relationships.length %>
    </div>

  </div>

  <% if relationships.any? %>

    <div class="mt-4 space-y-2">

      <% relationships.each do |relationship| %>

        <% other =
             relationship.other_entity(entity.id)
        %>

        <%= link_to(
              admin_ecosystems_load_sources_entity_path(other),
              class: "group flex items-center justify-between rounded-2xl border border-gray-100 bg-gray-50 px-3 py-3 transition hover:border-indigo-200 hover:bg-indigo-50 dark:border-gray-800 dark:bg-gray-950 dark:hover:border-indigo-900 dark:hover:bg-indigo-950/20"
            ) do %>

          <div class="min-w-0">

            <div class="truncate text-xs font-black text-gray-800 group-hover:text-indigo-600 dark:text-gray-100 dark:group-hover:text-indigo-400">
              <%= other.name %>
            </div>

            <div class="mt-0.5 text-[9px] text-gray-400">
              <%= relationship.relationship_kind.to_s.humanize %>
            </div>

          </div>

          <div class="ml-3 shrink-0 text-right">

            <div class="text-[10px] font-black text-indigo-600 dark:text-indigo-400">
              <%= (relationship.confidence.to_f * 100).round %>%
            </div>

            <div class="text-[8px] uppercase tracking-wider text-gray-400">
              confidence
            </div>

          </div>

        <% end %>

      <% end %>

    </div>

  <% else %>

    <div class="mt-4 rounded-2xl border border-dashed border-gray-200 px-4 py-8 text-center dark:border-gray-800">

      <div class="text-2xl">
        ◎
      </div>

      <div class="mt-2 text-xs font-black text-gray-600 dark:text-gray-300">
        No relationships discovered
      </div>

      <div class="mt-1 text-[10px] text-gray-400">
        Run relationship discovery to populate this intelligence layer.
      </div>

    </div>

  <% end %>

</div>