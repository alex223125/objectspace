<% if @entity.present? %>
  <div class="mt-6 rounded-[28px] border border-orange-200 bg-gradient-to-br from-orange-50 via-white to-violet-50 p-5 shadow-sm">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <div class="text-xs font-black uppercase tracking-[0.18em] text-orange-600">
          Discovery Workspace
        </div>

        <h3 class="mt-1 text-lg font-black text-slate-900">
          Continue this ecosystem investigation
        </h3>

        <p class="mt-1 max-w-2xl text-sm leading-6 text-slate-600">
          Create a research workspace from the current ecosystem exploration.
        </p>
      </div>

      <%= form_with(
            url: start_from_entity_admin_ecosystems_load_sources_entity_research_workspaces_path(
              entity_id: @entity.id
            ),
            method: :post,
            local: true
          ) do %>

        <%= hidden_field_tag(
              "research_workspace[title]",
              "New ecosystem investigation"
            ) %>

        <%= submit_tag(
              "🧭 Start investigation",
              class: "inline-flex items-center justify-center rounded-2xl bg-orange-500 px-5 py-3 text-sm font-black text-white shadow-sm transition hover:bg-orange-600 focus:outline-none focus:ring-2 focus:ring-orange-400 focus:ring-offset-2"
            ) %>

      <% end %>
    </div>
  </div>
<% end %>
