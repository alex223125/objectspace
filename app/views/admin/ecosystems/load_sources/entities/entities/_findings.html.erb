
<%
  categories = [
    {
      key: "signals",
      title: "Intelligence signals",
      description: "Observations returned by the intelligence service.",
      records: signals,
      accent: "border-sky-200",
      badge: "bg-sky-50 text-sky-800"
    },
    {
      key: "hotspots",
      title: "Structural hotspots",
      description: "Entities or regions identified as structurally important.",
      records: hotspots,
      accent: "border-orange-200",
      badge: "bg-orange-50 text-orange-800"
    },
    {
      key: "review",
      title: "Review opportunities",
      description: "Items the service identified for further investigation.",
      records: review_opportunities,
      accent: "border-amber-200",
      badge: "bg-amber-50 text-amber-800"
    },
    {
      key: "emerging",
      title: "Emerging entities",
      description: "Entities identified as newly emerging or activated.",
      records: emerging,
      accent: "border-emerald-200",
      badge: "bg-emerald-50 text-emerald-800"
    },
    {
      key: "declining",
      title: "Declining entities",
      description: "Entities identified as potentially declining.",
      records: declining,
      accent: "border-rose-200",
      badge: "bg-rose-50 text-rose-800"
    }
  ]
%>

<section aria-labelledby="intelligence-findings-heading">
  <div class="mb-4">
    <h2
      id="intelligence-findings-heading"
      class="text-lg font-bold text-slate-950"
    >
      Intelligence findings
    </h2>

    <p class="mt-1 text-sm leading-6 text-slate-600">
      Findings returned by the service. An empty collection does not establish
      that the analysis ran successfully or that no underlying issues exist.
    </p>
  </div>

  <div class="grid gap-4 lg:grid-cols-2">
    <% categories.each do |category| %>
      <section
        aria-labelledby="findings-<%= category[:key] %>"
        class="overflow-hidden rounded-xl border bg-white shadow-sm <%= category[:accent] %>"
      >
        <div class="flex items-start justify-between gap-3 border-b border-slate-100 px-4 py-4">
          <div class="min-w-0">
            <h3
              id="findings-<%= category[:key] %>"
              class="font-bold text-slate-900"
            >
              <%= category[:title] %>
            </h3>

            <p class="mt-1 text-xs leading-5 text-slate-600">
              <%= category[:description] %>
            </p>
          </div>

          <span class="shrink-0 rounded-lg px-2.5 py-1 text-xs font-bold <%= category[:badge] %>">
            <%= category[:records].size %>
          </span>
        </div>

        <% if category[:records].any? %>
          <div class="divide-y divide-slate-100">
            <% category[:records].each_with_index do |raw_record, index| %>
              <%
                record =
                  raw_record.is_a?(Hash) ?
                    raw_record.with_indifferent_access :
                    { value: raw_record.to_s }.with_indifferent_access

                title =
                  record[:label].presence ||
                    record[:name].presence ||
                    record[:title].presence ||
                    record[:entity_name].presence ||
                    record[:value].presence ||
                    "#{category[:title].singularize} #{index + 1}"

                description =
                  record[:description].presence ||
                    record[:reason].presence ||
                    record[:message].presence ||
                    record[:summary].presence ||
                    record[:details].presence

                severity =
                  record[:severity].presence ||
                    record[:priority].presence

                entity_id = record[:entity_id] || record[:id]
              %>

              <article class="px-4 py-4">
                <div class="flex items-start gap-3">
                  <div class="min-w-0 flex-1">
                    <h4 class="break-words text-sm font-semibold text-slate-900">
                      <%= title %>
                    </h4>

                    <% if description.present? %>
                      <p class="mt-1 text-sm leading-6 text-slate-600">
                        <%= description %>
                      </p>
                    <% end %>

                    <div class="mt-2 flex flex-wrap gap-2">
                      <% if entity_id.present? %>
                        <span class="rounded-md bg-slate-100 px-2 py-1 text-xs text-slate-600">
                          Entity ID: <%= entity_id %>
                        </span>
                      <% end %>

                      <% if severity.present? %>
                        <span class="rounded-md bg-amber-50 px-2 py-1 text-xs font-semibold text-amber-800">
                          <%= severity.to_s.humanize %>
                        </span>
                      <% end %>
                    </div>
                  </div>
                </div>

                <details class="mt-3">
                  <summary class="cursor-pointer text-xs font-semibold text-slate-600 hover:text-slate-900">
                    Inspect record data
                  </summary>

                  <pre class="mt-2 overflow-auto rounded-lg bg-slate-950 p-3 text-xs leading-5 text-slate-100"><%= JSON.pretty_generate(raw_record.respond_to?(:as_json) ? raw_record.as_json : raw_record) %></pre>
                </details>
              </article>
            <% end %>
          </div>
        <% else %>
          <div class="px-4 py-6">
            <p class="text-sm font-semibold text-slate-800">
              No records returned
            </p>

            <p class="mt-1 text-sm leading-6 text-slate-600">
              This collection is empty in the current payload. Check the
              analysis execution status before treating this as a confirmed
              no-findings result.
            </p>
          </div>
        <% end %>
      </section>
    <% end %>
  </div>
</section>