<%= form_with model: [:admin, collection],
              class: "space-y-6" do |form| %>

  <% if collection.errors.any? %>
    <div class="rounded-2xl border border-rose-500/20 bg-rose-500/10 p-4">
      <div class="text-sm font-black text-rose-300">
        Please fix the following:
      </div>

      <ul class="mt-2 list-disc pl-5 text-xs text-rose-200">
        <% collection.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name,
                   "Collection name",
                   class: "text-xs font-black uppercase tracking-[0.16em] text-slate-400" %>

    <%= form.text_field :name,
                        class: "mt-2 w-full rounded-2xl border border-white/10 bg-white/[0.04] px-4 py-3 text-sm text-white outline-none focus:border-orange-500",
                        placeholder: "e.g. AI Market Landscape" %>
  </div>

  <div>
    <%= form.label :description,
                   "Description",
                   class: "text-xs font-black uppercase tracking-[0.16em] text-slate-400" %>

    <%= form.text_area :description,
                       rows: 6,
                       class: "mt-2 w-full rounded-2xl border border-white/10 bg-white/[0.04] px-4 py-3 text-sm text-white outline-none focus:border-orange-500",
                       placeholder: "What is this research program trying to understand?" %>
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <%= form.label :status,
                     "Status",
                     class: "text-xs font-black uppercase tracking-[0.16em] text-slate-400" %>

      <%= form.select :status,
                      ResearchCollection::STATUSES.map { |status| [status.humanize, status] },
                      {},
                      class: "mt-2 w-full rounded-2xl border border-white/10 bg-slate-950 px-4 py-3 text-sm text-white outline-none focus:border-orange-500" %>
    </div>

    <div>
      <%= form.label :position,
                     "Position",
                     class: "text-xs font-black uppercase tracking-[0.16em] text-slate-400" %>

      <%= form.number_field :position,
                            min: 0,
                            class: "mt-2 w-full rounded-2xl border border-white/10 bg-white/[0.04] px-4 py-3 text-sm text-white outline-none focus:border-orange-500" %>
    </div>
  </div>

  <div class="flex items-center justify-end gap-3">
    <%= link_to "Cancel",
                collection.persisted? ? admin_research_collection_path(collection) : admin_research_collections_path,
                class: "rounded-xl px-4 py-2.5 text-xs font-bold text-slate-500 hover:text-white" %>

    <%= form.submit collection.persisted? ? "Save changes" : "Create collection",
                    class: "rounded-xl bg-orange-500 px-5 py-2.5 text-xs font-black text-white hover:bg-orange-400" %>
  </div>
<% end %>