<% if @entity.present? %>
  <%
    discovery = Ecosystem::DiscoveryEngine
      .new(@entity)
      .call

    profile =
      @entity.ecosystem_explorer_profile ||
        @entity.create_ecosystem_explorer_profile!

    missions =
      @entity.ecosystem_discovery_missions
             .available
             .order(created_at: :desc)
             .limit(3)
  %>

  <section class="mt-8 rounded-[36px] border border-orange-200/70 bg-gradient-to-br from-orange-50 via-white to-violet-50 p-6 shadow-sm">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <div class="flex items-center gap-2">
          <span class="rounded-full bg-orange-100 px-3 py-1 text-xs font-black uppercase tracking-wider text-orange-700">
            Discovery Engine
          </span>

          <span class="rounded-full bg-violet-100 px-3 py-1 text-xs font-bold text-violet-700">
            +<%= profile.xp %> XP
          </span>
        </div>

        <h2 class="mt-3 text-2xl font-black text-slate-950">
          What should you explore next?
        </h2>

        <p class="mt-1 text-sm text-slate-600">
          Discover research paths from ecosystem relationship signals.
        </p>
      </div>

      <%= link_to "Open Discovery →",
                  admin_ecosystem_discovery_path(@entity),
                  class: "rounded-2xl bg-slate-950 px-5 py-3 text-sm font-black text-white hover:bg-slate-800" %>
    </div>

    <div class="mt-6 grid gap-4 md:grid-cols-3">
      <% discovery[:recommendations].first(3).each do |recommendation| %>
        <div class="rounded-3xl bg-white p-5 ring-1 ring-slate-200">
          <div class="flex items-center justify-between">
            <span class="rounded-xl bg-violet-100 px-2.5 py-1 text-[10px] font-black uppercase text-violet-700">
              <%= recommendation[:type] %>
            </span>

            <span class="text-sm font-black text-orange-600">
              <%= recommendation[:score] %>%
            </span>
          </div>

          <h3 class="mt-4 font-black text-slate-900">
            <%= recommendation[:title] %>
          </h3>

          <p class="mt-2 text-xs leading-5 text-slate-500">
            <%= recommendation[:reasons].first %>
          </p>

          <div class="mt-4 h-2 overflow-hidden rounded-full bg-slate-100">
            <div
              class="h-full rounded-full bg-gradient-to-r from-orange-400 to-violet-500"
              style="width: <%= recommendation[:score] %>%"
            ></div>
          </div>
        </div>
      <% end %>

      <% if discovery[:recommendations].empty? %>
        <div class="md:col-span-3 rounded-3xl border border-dashed border-slate-300 p-8 text-center">
          <div class="text-3xl">🧭</div>

          <p class="mt-2 font-bold text-slate-700">
            No recommendations yet.
          </p>

          <p class="mt-1 text-sm text-slate-500">
            Create or confirm entity relationships to discover new paths.
          </p>
        </div>
      <% end %>
    </div>
  </section>
<% end %>
