<%
  tones = {
    "orange" => {
      wrapper: "border-orange-100 bg-orange-50/40",
      icon: "bg-orange-100 text-orange-600",
      bar: "from-orange-400 to-amber-400"
    },
    "violet" => {
      wrapper: "border-violet-100 bg-violet-50/40",
      icon: "bg-violet-100 text-violet-600",
      bar: "from-violet-400 to-indigo-500"
    },
    "rose" => {
      wrapper: "border-rose-100 bg-rose-50/40",
      icon: "bg-rose-100 text-rose-600",
      bar: "from-rose-400 to-red-500"
    },
    "emerald" => {
      wrapper: "border-emerald-100 bg-emerald-50/40",
      icon: "bg-emerald-100 text-emerald-600",
      bar: "from-emerald-400 to-teal-500"
    },
    "sky" => {
      wrapper: "border-sky-100 bg-sky-50/40",
      icon: "bg-sky-100 text-sky-600",
      bar: "from-sky-400 to-cyan-500"
    }
  }

  tone = tones[tone.to_s] || tones["violet"]
%>

<div
  class="
    rounded-2xl
    border
    p-4
    <%= tone[:wrapper] %>
  "
>

  <div class="flex items-center justify-between">

    <div
      class="
        flex h-8 w-8
        items-center justify-center
        rounded-xl
        text-sm
        <%= tone[:icon] %>
      "
    >
      <%= icon %>
    </div>

    <span
      class="
        text-xs
        font-black
        text-slate-600
      "
      data-entity-comparison-intelligence-target="<%= value_target %>"
    >
      0%
    </span>

  </div>

  <div
    class="
      mt-3
      text-[10px]
      font-black
      uppercase
      tracking-wider
      text-slate-400
    "
  >
    <%= label %>
  </div>

  <div
    class="
      mt-2 h-1.5
      overflow-hidden
      rounded-full
      bg-white
    "
  >

    <div
      class="
        h-full w-0
        rounded-full
        bg-gradient-to-r
        <%= tone[:bar] %>
        transition-all
        duration-700
      "
      data-entity-comparison-intelligence-target="<%= value_target %>"
    ></div>

  </div>

</div>