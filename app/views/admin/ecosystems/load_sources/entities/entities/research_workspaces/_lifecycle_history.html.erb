<% events = workspace.lifecycle_events %>

<div class="rounded-3xl border border-white/10 bg-white/[0.03] p-6">
  <div>
    <div class="text-xs font-bold uppercase tracking-[0.2em] text-slate-600">
      Research history
    </div>

    <h2 class="mt-2 text-lg font-black text-white">
      Investigation activity
    </h2>
  </div>

  <% if events.empty? %>
    <div class="mt-6 rounded-2xl bg-black/20 p-5 text-sm text-slate-600">
      No lifecycle events have been recorded yet.
    </div>
  <% else %>
    <div class="mt-6 space-y-4">
      <% events.first(20).each do |event| %>
        <div class="flex gap-4">
          <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-white/5 text-xs font-bold text-slate-400">
            <%= lifecycle_event_icon(event["event"]) %>
          </div>

          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center gap-2">
              <div class="font-bold text-white">
                <%= event["message"] %>
              </div>

              <% if event["created_at"].present? %>
                <div class="text-[10px] text-slate-700">
                  <%= time_ago_in_words(Time.iso8601(event["created_at"])) %> ago
                </div>
              <% end %>
            </div>

            <% if event.dig("data", "label").present? %>
              <div class="mt-1 text-xs text-slate-600">
                <%= event.dig("data", "label") %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>