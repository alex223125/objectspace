<div class="flex flex-wrap gap-2">

  <% if workspace.active? %>

    <div class="basis-full rounded-2xl border border-purple-500/10 bg-purple-500/[0.03] p-3">
      <%= render "checkpoint_form",
                 workspace: workspace %>
    </div>

    <%= button_to "Complete",
                  complete_admin_research_workspace_path(workspace),
                  method: :post,
                  class: "rounded-xl bg-sky-500/10 px-4 py-2.5 text-xs font-bold text-sky-300 hover:bg-sky-500/20" %>

    <%= button_to "Save checkpoint",
                  save_checkpoint_admin_research_workspace_path(workspace),
                  method: :post,
                  class: "rounded-xl bg-purple-500/10 px-4 py-2.5 text-xs font-bold text-purple-300 hover:bg-purple-500/20" %>

    <%= button_to "Archive",
                  archive_admin_research_workspace_path(workspace),
                  method: :post,
                  data: {
                    turbo_confirm: "Archive this investigation?"
                  },
                  class: "rounded-xl bg-white/5 px-4 py-2.5 text-xs font-bold text-slate-500 hover:bg-white/10 hover:text-white" %>

  <% elsif workspace.completed? %>

    <%= button_to "Resume investigation",
                  resume_admin_research_workspace_path(workspace),
                  method: :post,
                  class: "rounded-xl bg-emerald-500/10 px-4 py-2.5 text-xs font-bold text-emerald-300 hover:bg-emerald-500/20" %>

    <%= button_to "Archive",
                  archive_admin_research_workspace_path(workspace),
                  method: :post,
                  data: {
                    turbo_confirm: "Archive this completed investigation?"
                  },
                  class: "rounded-xl bg-white/5 px-4 py-2.5 text-xs font-bold text-slate-500 hover:bg-white/10 hover:text-white" %>

  <% elsif workspace.archived? %>

    <%= button_to "Reopen",
                  reopen_admin_research_workspace_path(workspace),
                  method: :post,
                  class: "rounded-xl bg-emerald-500/10 px-4 py-2.5 text-xs font-bold text-emerald-300 hover:bg-emerald-500/20" %>

  <% end %>

  <%= link_to "History",
              history_admin_research_workspace_path(workspace),
              class: "rounded-xl bg-white/5 px-4 py-2.5 text-xs font-bold text-slate-400 hover:bg-white/10 hover:text-white" %>

  <%= link_to "Checkpoints",
              snapshots_admin_research_workspace_path(workspace),
              class: "rounded-xl bg-white/5 px-4 py-2.5 text-xs font-bold text-slate-400 hover:bg-white/10 hover:text-white" %>

</div>