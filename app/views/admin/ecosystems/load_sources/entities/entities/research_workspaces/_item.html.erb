<div
  class="group flex gap-4 p-6 transition hover:bg-white/[0.02]"
  data-controller="research-provenance">

  <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-white/5 text-lg">
    <%= recommendation_icon(item.kind) %>
  </div>

  <div class="min-w-0 flex-1">

    <div class="flex flex-wrap items-center gap-2">

      <h3 class="font-bold <%= "text-slate-500 line-through" if item.completed? %>">
        <%= item.title %>
      </h3>

      <span class="rounded-full bg-white/5 px-2 py-1 text-[10px] font-bold uppercase tracking-wider text-slate-500">
        <%= item.kind %>
      </span>

      <% if item.completed? %>

        <span class="rounded-full bg-emerald-400/10 px-2 py-1 text-[10px] font-bold text-emerald-300">
          Completed
        </span>

      <% end %>

    </div>

    <% if item.body.present? %>

      <p class="mt-2 text-sm leading-6 text-slate-500">
        <%= item.body %>
      </p>

    <% end %>

    <% if item.target.present? %>

      <div class="mt-3 text-xs text-slate-600">

        Connected to

        <span class="font-semibold text-slate-400">
          <%= item.target_label %>
        </span>

      </div>

    <% end %>

    <div class="mt-4 flex flex-wrap gap-2">

      <span class="rounded-full bg-orange-500/10 px-2 py-1 text-[10px] font-bold text-orange-300">
        <%= item.research_workspace_annotations.count %>
        annotations
      </span>

      <span class="rounded-full bg-emerald-500/10 px-2 py-1 text-[10px] font-bold text-emerald-300">
        <%= item.research_workspace_evidences.count %>
        evidence
      </span>

    </div>

    <%= render "admin/research_workspaces/provenance",
               workspace: workspace,
               item: item %>

  </div>


  <div class="shrink-0 flex flex-col gap-2">

    <% if item.completed? %>

      <%= button_to "Reopen",
                    reopen_item_admin_research_workspace_path(
                      workspace,
                      item_id: item.id
                    ),
                    method: :patch,
                    class: "rounded-xl bg-white/5 px-3 py-2 text-xs font-bold text-slate-400 transition hover:bg-white/10 hover:text-white" %>

    <% else %>

      <%= button_to "Complete",
                    complete_item_admin_research_workspace_path(
                      workspace,
                      item_id: item.id
                    ),
                    method: :patch,
                    class: "rounded-xl bg-emerald-500/10 px-3 py-2 text-xs font-bold text-emerald-300 transition hover:bg-emerald-500/20" %>

    <% end %>

    <%= link_to "🧠 Annotate",
                new_admin_research_workspace_annotation_path(
                  workspace,
                  research_workspace_item_id: item.id
                ),
                class: "rounded-xl bg-orange-500/10 px-3 py-2 text-center text-xs font-bold text-orange-300 hover:bg-orange-500/20" %>

    <%= link_to "🔎 Evidence",
                new_admin_research_workspace_evidence_path(
                  workspace,
                  research_workspace_item_id: item.id
                ),
                class: "rounded-xl bg-blue-500/10 px-3 py-2 text-center text-xs font-bold text-blue-300 hover:bg-blue-500/20" %>

  </div>

  <%= render "admin/research_workspaces/research_panel",
             workspace: workspace,
             item: item %>

</div>


</div>

<div class="mt-4 flex flex-wrap gap-2">

  <% if item.annotation_count.positive? %>

    <span class="rounded-full bg-orange-500/10 px-2 py-1 text-[10px] font-bold text-orange-300">
      🧠 <%= item.annotation_count %> annotations
    </span>

  <% end %>

  <% if item.evidence_count.positive? %>

    <span class="rounded-full bg-blue-500/10 px-2 py-1 text-[10px] font-bold text-blue-300">
      🔎 <%= item.evidence_count %> evidence
    </span>

  <% end %>

  <% if item.verified_evidence_count.positive? %>

    <span class="rounded-full bg-emerald-500/10 px-2 py-1 text-[10px] font-bold text-emerald-300">
      ✓ <%= item.verified_evidence_count %> verified
    </span>

  <% end %>

</div>


