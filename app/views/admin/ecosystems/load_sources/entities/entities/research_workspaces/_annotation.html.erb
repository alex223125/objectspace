<div class="rounded-3xl border border-white/10 bg-black/10 p-5">
  <div class="flex items-start gap-4">
    <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-orange-500/10 text-lg">
      <%= annotation_icon(annotation.kind) %>
    </div>

    <div class="min-w-0 flex-1">
      <div class="flex flex-wrap items-center gap-2">
        <h4 class="font-bold text-white">
          <%= annotation.title %>
        </h4>

        <span class="rounded-full bg-white/5 px-2 py-1 text-[10px] font-bold uppercase tracking-wider text-slate-500">
          <%= annotation.kind_label %>
        </span>

        <span class="rounded-full bg-white/5 px-2 py-1 text-[10px] font-bold text-slate-400">
          <%= annotation.status_label %>
        </span>

        <% if annotation.approved? %>
          <span class="rounded-full bg-emerald-500/10 px-2 py-1 text-[10px] font-bold uppercase tracking-wider text-emerald-300">
            Approved
          </span>
        <% end %>
      </div>

      <p class="mt-3 whitespace-pre-line text-sm leading-6 text-slate-400">
        <%= annotation.body %>
      </p>

      <div class="mt-4 flex flex-wrap items-center gap-4 text-xs">
        <span class="<%= confidence_color(annotation.confidence) %>">
          Confidence
          <strong><%= annotation.confidence %>%</strong>
        </span>

        <span class="text-slate-600">
          <%= annotation.research_evidences.size %> supporting source<%= annotation.research_evidences.size == 1 ? "" : "s" %>
        </span>

        <% if annotation.author_name.present? %>
          <span class="text-slate-600">
            by <%= annotation.author_name %>
          </span>
        <% end %>

        <% if annotation.reviewer_name.present? %>
          <span class="text-slate-600">
            reviewed by <%= annotation.reviewer_name %>
          </span>
        <% end %>
      </div>

      <div class="mt-4 flex flex-wrap gap-2">
        <%= link_to "Edit",
                    edit_admin_research_workspace_item_annotation_path(
                      workspace,
                      annotation.research_workspace_item,
                      annotation
                    ),
                    class: "rounded-xl bg-white/5 px-3 py-2 text-xs font-bold text-slate-400 hover:bg-white/10 hover:text-white" %>

        <% unless annotation.reviewed? %>
          <%= button_to "Review",
                        review_admin_research_workspace_item_annotation_path(
                          workspace,
                          annotation.research_workspace_item,
                          annotation
                        ),
                        method: :patch,
                        class: "rounded-xl bg-sky-500/10 px-3 py-2 text-xs font-bold text-sky-300 hover:bg-sky-500/20" %>
        <% end %>

        <% unless annotation.approved? %>
          <%= button_to "Approve",
                        approve_admin_research_workspace_item_annotation_path(
                          workspace,
                          annotation.research_workspace_item,
                          annotation
                        ),
                        method: :patch,
                        class: "rounded-xl bg-emerald-500/10 px-3 py-2 text-xs font-bold text-emerald-300 hover:bg-emerald-500/20" %>
        <% end %>

        <% unless annotation.rejected? %>
          <%= button_to "Reject",
                        reject_admin_research_workspace_item_annotation_path(
                          workspace,
                          annotation.research_workspace_item,
                          annotation
                        ),
                        method: :patch,
                        class: "rounded-xl bg-rose-500/10 px-3 py-2 text-xs font-bold text-rose-300 hover:bg-rose-500/20" %>
        <% end %>

        <%= button_to "Delete",
                      admin_research_workspace_item_annotation_path(
                        workspace,
                        annotation.research_workspace_item,
                        annotation
                      ),
                      method: :delete,
                      data: {
                        turbo_confirm: "Delete this annotation?"
                      },
                      class: "rounded-xl bg-rose-500/10 px-3 py-2 text-xs font-bold text-rose-300 hover:bg-rose-500/20" %>
      </div>
    </div>
  </div>

  <% if annotation.research_evidences.any? %>
    <div class="mt-5 border-t border-white/5 pt-5">
      <div class="mb-3 text-xs font-bold uppercase tracking-wider text-slate-600">
        Supporting evidence
      </div>

      <div class="space-y-2">
        <% annotation.research_evidences.each do |evidence| %>
          <%= render "evidence",
                     evidence: evidence,
                     workspace: workspace %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>