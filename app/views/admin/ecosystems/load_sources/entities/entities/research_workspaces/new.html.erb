<div class="min-h-screen bg-[#070707] text-white">

  <div class="mx-auto max-w-3xl px-6 py-12">

    <%= link_to "← Saved investigations",
                admin_research_workspaces_path,
                class: "text-xs font-bold text-slate-600 hover:text-white" %>

    <div class="mt-8">

      <div class="text-xs font-black uppercase tracking-[0.3em] text-orange-400">
        New investigation
      </div>

      <h1 class="mt-3 text-4xl font-black">
        Start a research workspace
      </h1>

      <p class="mt-3 text-sm leading-6 text-slate-500">
        Create a persistent place for entities, questions, annotations,
        relationships, and evidence.
      </p>

    </div>

    <div class="mt-10 rounded-3xl border border-white/10 bg-white/[0.025] p-6">

      <%= form_with model: [:admin, @workspace],
                    local: true,
                    class: "space-y-6" do |form| %>

        <% if @workspace.errors.any? %>

          <div class="rounded-2xl border border-red-400/20 bg-red-400/5 p-4">

            <div class="text-sm font-bold text-red-300">
              Please fix the following:
            </div>

            <ul class="mt-2 space-y-1 text-xs text-red-300">
              <% @workspace.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>

          </div>

        <% end %>

        <div>

          <%= form.label :title,
                         class: "text-xs font-bold uppercase tracking-widest text-slate-500" %>

          <%= form.text_field :title,
                              autofocus: true,
                              placeholder: "Example: European AI ecosystem investigation",
                              class: "mt-3 w-full rounded-2xl border border-white/10 bg-black/20 px-4 py-4 text-sm text-white outline-none transition placeholder:text-slate-700 focus:border-orange-500/50" %>

        </div>

        <div>

          <%= form.label :status,
                         class: "text-xs font-bold uppercase tracking-widest text-slate-500" %>

          <%= form.select :status,
                          [["Active", "active"], ["Completed", "completed"], ["Archived", "archived"]],
                          {},
                          class: "mt-3 w-full rounded-2xl border border-white/10 bg-black/20 px-4 py-4 text-sm text-white outline-none" %>

        </div>

        <div class="flex justify-end">

          <%= form.submit "Create investigation",
                          class: "rounded-2xl bg-orange-500 px-6 py-3 text-sm font-bold text-white transition hover:bg-orange-400" %>

        </div>

      <% end %>

    </div>

  </div>

</div>