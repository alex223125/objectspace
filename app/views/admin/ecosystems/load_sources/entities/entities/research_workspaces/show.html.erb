<div class="mb-8">
  <%= render "research_strength",
             workspace: @workspace %>
</div>

<%= render "lifecycle_header",
           workspace: @workspace %>

<%= render "research_overview",
           workspace: @workspace %>

<%= render "lifecycle", workspace: @workspace %>

<%= render "research_panel", workspace: @workspace %>

<div class="mt-5 flex flex-wrap items-center gap-3">

  <span class="rounded-full px-3 py-2 text-xs font-bold <%= workspace_status_class(@workspace.status) %>">
    <%= @workspace.status.humanize %>
  </span>

  <span class="rounded-full bg-white/5 px-3 py-2 text-xs font-bold text-slate-500">
    <%= @workspace.items.count %> items
  </span>

  <%= render "admin/research_workspaces/lifecycle_controls",
             workspace: @workspace %>

</div>

<% summary = Admin::ResearchWorkspaces::InvestigationSummary.new(@workspace).call %>

<div class="mt-8">
  <%= render "admin/research_workspaces/summary",
             summary: summary %>
</div>

<%= render "admin/research_workspaces/research_panel",
           workspace: @workspace %>

<div class="mt-8 grid gap-6 xl:grid-cols-2">
  <%= render "snapshots",
             workspace: @workspace %>

  <%= render "lifecycle_history",
             workspace: @workspace %>
</div>


<div
  class="min-h-screen bg-slate-950 text-white"
  data-controller="research-workspace"
  data-research-workspace-recommendations-url-value="<%= recommendations_admin_research_workspace_path(@workspace) %>"
>

  <div class="mx-auto max-w-7xl px-6 py-8">

    <!-- HEADER -->

    <div class="mb-8">
      <%= link_to "← Research workspaces",
                  admin_research_workspaces_path,
                  class: "text-sm font-semibold text-slate-500 transition hover:text-white" %>

      <div class="mt-5 flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">

        <div>
          <div class="text-xs font-bold uppercase tracking-[0.3em] text-orange-400">
            Research Workspace
          </div>

          <h1 class="mt-2 text-4xl font-black tracking-tight">
            <%= @workspace.title %>
          </h1>

          <% if @workspace.summary.present? %>
            <p class="mt-3 max-w-3xl text-slate-400">
              <%= @workspace.summary %>
            </p>
          <% end %>
        </div>

        <div class="flex gap-2">
          <button
            type="button"
            data-action="research-workspace#refreshRecommendations"
            class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-sm font-bold transition hover:border-violet-400/30 hover:bg-white/10">
            ✦ Refresh intelligence
          </button>

          <%= button_to "Archive",
                        admin_research_workspace_path(@workspace),
                        method: :patch,
                        params: {
                          research_workspace: {
                            status: "archived"
                          }
                        },
                        class: "rounded-2xl bg-white/5 px-4 py-3 text-sm font-bold text-slate-300 transition hover:bg-white/10" %>
        </div>
      </div>
    </div>


    <%= render "research_summary",
               workspace: @workspace %>
    

    <!-- METRICS -->

    <div class="grid gap-4 md:grid-cols-4">

      <div class="rounded-[28px] border border-white/10 bg-orange-500/10 p-5">
        <div class="text-xs font-bold uppercase tracking-widest text-orange-300">
          Progress
        </div>
        <div class="mt-2 text-3xl font-black">
          <%= @metrics[:progress] %>%
        </div>
      </div>

      <div class="rounded-[28px] border border-white/10 bg-sky-500/10 p-5">
        <div class="text-xs font-bold uppercase tracking-widest text-sky-300">
          Entities
        </div>
        <div class="mt-2 text-3xl font-black">
          <%= @metrics[:entities] %>
        </div>
      </div>

      <div class="rounded-[28px] border border-white/10 bg-violet-500/10 p-5">
        <div class="text-xs font-bold uppercase tracking-widest text-violet-300">
          Questions
        </div>
        <div class="mt-2 text-3xl font-black">
          <%= @metrics[:questions] %>
        </div>
      </div>

      <div class="rounded-[28px] border border-white/10 bg-emerald-500/10 p-5">
        <div class="text-xs font-bold uppercase tracking-widest text-emerald-300">
          Notes
        </div>
        <div class="mt-2 text-3xl font-black">
          <%= @metrics[:notes] %>
        </div>
      </div>

    </div>

    <!-- PROGRESS -->

    <div class="mt-6 rounded-[30px] border border-white/10 bg-white/[0.03] p-6">
      <div class="mb-3 flex justify-between">
        <div>
          <div class="font-bold">Investigation progression</div>
          <div class="mt-1 text-sm text-slate-500">
            Turn discoveries into a structured research trail.
          </div>
        </div>

        <div class="font-black text-orange-300">
          <%= @metrics[:completed] %> / <%= @metrics[:items] %>
        </div>
      </div>

      <div class="h-3 overflow-hidden rounded-full bg-white/5">
        <div
          class="h-full rounded-full bg-gradient-to-r from-orange-500 via-violet-500 to-emerald-400 transition-all"
          style="width: <%= @metrics[:progress] %>%">
        </div>
      </div>
    </div>

    <!-- MAIN -->

    <div class="mt-6 grid gap-6 lg:grid-cols-[1fr_360px]">

      <!-- INVESTIGATION -->

      <section class="rounded-[32px] border border-white/10 bg-white/[0.03]">

        <div class="border-b border-white/10 p-6">
          <div class="flex items-center justify-between">
            <div>
              <div class="text-xs font-bold uppercase tracking-[0.25em] text-slate-500">
                Investigation trail
              </div>

              <h2 class="mt-2 text-xl font-black">
                Workspace evidence
              </h2>
            </div>

            <span class="rounded-full bg-orange-400/10 px-3 py-1 text-xs font-bold text-orange-300">
              <%= @workspace.items.count %> items
            </span>
          </div>
        </div>

        <div class="divide-y divide-white/5">
          <% @workspace.items.ordered.each do |item| %>

            <div class="space-y-4">
              <% @workspace.items.order(position: :asc).each do |item| %>
                <%= render "admin/research_workspaces/item",
                           workspace: @workspace,
                           item: item %>
              <% end %>
            </div>

            <%= render "admin/research_workspaces/research_integrity",
                       workspace: @workspace %>

          <% end %>

          <% if @workspace.items.empty? %>

            <div class="p-12 text-center">
              <div class="text-3xl">🧭</div>

              <h3 class="mt-4 font-bold">
                Your investigation starts here
              </h3>

              <p class="mx-auto mt-2 max-w-md text-sm text-slate-500">
                Add an entity, question, note, relationship,
                or research milestone.
              </p>
            </div>

          <% end %>
        </div>

      </section>

      <!-- INTELLIGENCE -->

      <aside class="space-y-6">

        <section
          class="rounded-[30px] border border-violet-400/20 bg-gradient-to-br from-violet-500/10 to-transparent p-6"
          data-research-workspace-target="recommendations"
        >

          <div class="text-xs font-bold uppercase tracking-[0.25em] text-violet-300">
            Discovery intelligence
          </div>

          <h2 class="mt-2 text-xl font-black">
            What should you explore next?
          </h2>

          <div class="mt-5 space-y-3">

            <% @recommendations.each do |recommendation| %>

              <div class="rounded-2xl border border-white/10 bg-black/10 p-4">

                <div class="flex items-start gap-3">
                  <div class="text-lg">
                    <%= recommendation_icon(recommendation[:kind]) %>
                  </div>

                  <div class="min-w-0 flex-1">
                    <div class="font-bold">
                      <%= recommendation[:title] %>
                    </div>

                    <div class="mt-1 text-xs leading-5 text-slate-500">
                      <%= recommendation[:description] %>
                    </div>
                  </div>
                </div>

              </div>

            <% end %>

            <% if @recommendations.empty? %>
              <div class="rounded-2xl bg-white/5 p-4 text-sm text-slate-500">
                No recommendations yet. Add an entity or research question
                to activate discovery intelligence.
              </div>
            <% end %>

          </div>
        </section>

        <!-- ADD ITEM -->

        <section class="rounded-[30px] border border-white/10 bg-white/[0.03] p-6">

          <div class="text-xs font-bold uppercase tracking-[0.25em] text-slate-500">
            Research action
          </div>

          <h2 class="mt-2 text-xl font-black">
            Add to investigation
          </h2>

          <div class="mt-5 grid gap-2">

            <%= form_with url: add_item_admin_research_workspace_path(@workspace),
                          method: :post,
                          local: true do |form| %>

              <%= hidden_field_tag "item[kind]", "question" %>

              <%= text_field_tag "item[title]",
                                 "",
                                 placeholder: "Research question...",
                                 class: "w-full rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-sm text-white placeholder:text-slate-600 outline-none focus:border-violet-400" %>

              <%= submit_tag "＋ Add question",
                             class: "mt-2 w-full cursor-pointer rounded-2xl bg-violet-500/15 px-4 py-3 text-sm font-bold text-violet-300 transition hover:bg-violet-500/25" %>
            <% end %>

            <%= form_with url: add_item_admin_research_workspace_path(@workspace),
                          method: :post,
                          local: true do |form| %>

              <%= hidden_field_tag "item[kind]", "note" %>

              <%= text_field_tag "item[title]",
                                 "",
                                 placeholder: "Research note...",
                                 class: "w-full rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-sm text-white placeholder:text-slate-600 outline-none focus:border-sky-400" %>

              <%= submit_tag "＋ Add note",
                             class: "mt-2 w-full cursor-pointer rounded-2xl bg-sky-500/15 px-4 py-3 text-sm font-bold text-sky-300 transition hover:bg-sky-500/25" %>
            <% end %>

          </div>
        </section>

      </aside>
    </div>

  </div>
</div>



<div class="mb-6">
  <%= link_to "Research collections",
              admin_research_collections_path,
              class: "inline-flex rounded-xl bg-white/5 px-4 py-2.5 text-xs font-bold text-slate-400 hover:bg-white/10 hover:text-white" %>
</div>





<div class="space-y-8">

  <!-- Workspace header -->

  <!-- Research dashboard -->

  <%= render "research_dashboard",
             workspace: @workspace %>

  <!-- Research strength -->

  <%= render "research_strength",
             workspace: @workspace %>

  <!-- Workspace items -->

  <div class="overflow-hidden rounded-3xl border border-white/10 bg-white/[0.02]">

    <% @items.each do |item| %>
      <%= render "item",
                 workspace: @workspace,
                 item: item %>
    <% end %>

  </div>

</div>
