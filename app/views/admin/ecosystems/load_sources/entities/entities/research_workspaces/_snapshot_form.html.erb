<div class="rounded-2xl border border-white/10 bg-black/20 p-4">
  <%= form_with url: snapshot_admin_research_workspace_path(workspace),
                method: :post,
                class: "flex flex-col gap-3 sm:flex-row sm:items-end" do |form| %>

    <div class="flex-1">
      <%= form.label :label,
                     "Snapshot label",
                     class: "text-xs font-bold uppercase tracking-wider text-slate-600" %>

      <%= form.text_field :label,
                          class: "mt-2 w-full rounded-xl border border-white/10 bg-white/[0.03] px-3 py-2.5 text-sm text-white placeholder:text-slate-700",
                          placeholder: "Before expert review" %>
    </div>

    <%= form.submit "Save snapshot",
                    class: "rounded-xl bg-sky-500 px-4 py-2.5 text-xs font-bold text-white hover:bg-sky-400" %>
  <% end %>
</div>