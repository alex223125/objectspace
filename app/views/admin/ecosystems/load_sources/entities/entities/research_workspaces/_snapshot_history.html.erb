<div class="rounded-3xl border border-white/10 bg-white/[0.03] p-6">

  <div class="flex items-start justify-between gap-4">

    <div>
      <div class="text-xs font-bold uppercase tracking-[0.2em] text-orange-400">
        Research history
      </div>

      <h2 class="mt-2 text-xl font-black text-white">
        Saved research states
      </h2>

      <p class="mt-1 text-sm text-slate-500">
        Immutable snapshots let you return to an earlier research state.
      </p>
    </div>

    <%= link_to "View all",
                admin_research_workspace_snapshots_path(workspace),
                class: "rounded-xl bg-white/5 px-3 py-2 text-xs font-bold text-slate-400 hover:bg-white/10 hover:text-white" %>

  </div>

  <div class="mt-6 space-y-3">

    <% snapshots.each do |snapshot| %>

      <div class="rounded-2xl border border-white/5 bg-black/10 p-4">

        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">

          <div>

            <div class="flex flex-wrap items-center gap-2">

              <span class="rounded-full bg-orange-500/10 px-2 py-1 text-[10px] font-bold uppercase tracking-wider text-orange-300">
                <%= snapshot.kind_label %>
              </span>

              <span class="text-xs text-slate-600">
                <%= snapshot.created_at_label %>
              </span>

            </div>

            <h3 class="mt-2 font-bold text-white">
              <%= snapshot.label %>
            </h3>

            <div class="mt-2 flex flex-wrap gap-4 text-xs text-slate-600">

              <span>
                <%= snapshot.item_count %> items
              </span>

              <span>
                <%= snapshot.annotation_count %> annotations
              </span>

              <span>
                <%= snapshot.evidence_count %> evidence
              </span>

            </div>

          </div>

          <%= button_to(
                "Restore",
                restore_admin_research_workspace_snapshot_path(
                  workspace,
                  snapshot
                ),
                method: :post,
                data: {
                  turbo_confirm:
                    "Restore this snapshot? Current research state will be replaced."
                },
                class: "rounded-xl bg-white/5 px-4 py-2 text-xs font-bold text-slate-400 hover:bg-orange-500/10 hover:text-orange-300"
              ) %>

        </div>

      </div>

    <% end %>

  </div>

</div>