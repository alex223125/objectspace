<div class="rounded-3xl border border-white/10 bg-white/[0.03] p-6 transition hover:border-white/20">

  <div class="flex items-start justify-between gap-4">

    <div class="min-w-0">

      <div class="flex flex-wrap items-center gap-2">

        <span class="rounded-full px-3 py-1 text-[10px] font-black uppercase tracking-wider <%= workspace_status_color(workspace.status) %>">
          <%= workspace_status_icon(workspace.status) %>
          <%= workspace.lifecycle_label %>
        </span>

        <% if workspace.last_opened_at.present? %>
          <span class="text-[10px] text-slate-600">
            Last opened
            <%= workspace.last_opened_at.strftime("%Y-%m-%d %H:%M") %>
          </span>
        <% end %>

      </div>

      <h2 class="mt-3 truncate text-xl font-black text-white">
        <%= workspace.title %>
      </h2>

      <p class="mt-1 text-xs text-slate-600">
        /<%= workspace.slug %>
      </p>

    </div>

    <div class="shrink-0 text-right">

      <div class="text-2xl font-black text-orange-300">
        <%= workspace.progress %>%
      </div>

      <div class="text-[10px] font-bold uppercase tracking-wider text-slate-600">
        Progress
      </div>

    </div>

  </div>

  <div class="mt-5 h-2 overflow-hidden rounded-full bg-white/5">
    <div
      class="h-full rounded-full bg-orange-500"
      style="width: <%= workspace.progress %>%">
    </div>
  </div>

  <div class="mt-5 grid grid-cols-2 gap-2 sm:grid-cols-4">

    <div class="rounded-2xl bg-black/20 p-3 text-center">
      <div class="text-lg font-black text-white">
        <%= workspace.items.count %>
      </div>
      <div class="text-[9px] font-bold uppercase tracking-wider text-slate-600">
        Items
      </div>
    </div>

    <div class="rounded-2xl bg-black/20 p-3 text-center">
      <div class="text-lg font-black text-white">
        <%= workspace.annotation_count %>
      </div>
      <div class="text-[9px] font-bold uppercase tracking-wider text-slate-600">
        Notes
      </div>
    </div>

    <div class="rounded-2xl bg-black/20 p-3 text-center">
      <div class="text-lg font-black text-white">
        <%= workspace.evidence_count %>
      </div>
      <div class="text-[9px] font-bold uppercase tracking-wider text-slate-600">
        Evidence
      </div>
    </div>

    <div class="rounded-2xl bg-black/20 p-3 text-center">
      <div class="text-lg font-black text-orange-300">
        <%= workspace.snapshot_count %>
      </div>
      <div class="text-[9px] font-bold uppercase tracking-wider text-slate-600">
        Snapshots
      </div>
    </div>

  </div>

  <div class="mt-6 flex flex-wrap gap-2">

    <%= link_to(
          workspace.open? ? "Resume investigation" : "Open investigation",
          admin_research_workspace_path(workspace),
          class: "rounded-xl bg-orange-500 px-4 py-2 text-xs font-bold text-white hover:bg-orange-400"
        ) %>

    <%= link_to(
          "History",
          admin_research_workspace_snapshots_path(workspace),
          class: "rounded-xl bg-white/5 px-4 py-2 text-xs font-bold text-slate-400 hover:bg-white/10 hover:text-white"
        ) %>

    <% if workspace.paused? %>

      <%= button_to(
            "Resume",
            resume_admin_research_workspace_path(workspace),
            method: :patch,
            class: "rounded-xl bg-emerald-500/10 px-4 py-2 text-xs font-bold text-emerald-300 hover:bg-emerald-500/20"
          ) %>

    <% elsif workspace.active? %>

      <%= button_to(
            "Pause",
            pause_admin_research_workspace_path(workspace),
            method: :patch,
            class: "rounded-xl bg-amber-500/10 px-4 py-2 text-xs font-bold text-amber-300 hover:bg-amber-500/20"
          ) %>

    <% end %>

  </div>

</div>