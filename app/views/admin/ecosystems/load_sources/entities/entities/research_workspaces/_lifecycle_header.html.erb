<div class="rounded-3xl border border-white/10 bg-white/[0.03] p-6">

  <div class="flex flex-col gap-5 lg:flex-row lg:items-start lg:justify-between">

    <div>

      <div class="flex flex-wrap items-center gap-2">

        <span class="inline-flex items-center gap-2 rounded-full border px-3 py-1 text-[10px] font-bold uppercase tracking-wider <%= investigation_status_badge(workspace.status) %>">

          <%= investigation_status_icon(workspace.status) %>

          <%= workspace.lifecycle_label %>

        </span>

        <span class="rounded-full bg-white/5 px-3 py-1 text-[10px] font-bold uppercase tracking-wider text-slate-500">
          Saved investigation
        </span>

      </div>

      <h1 class="mt-3 text-3xl font-black text-white">
        <%= workspace.title %>
      </h1>

      <div class="mt-2 text-xs text-slate-600">
        <%= workspace.slug %>
      </div>

    </div>

    <div>
      <%= render "lifecycle_controls",
                 workspace: workspace %>
    </div>

  </div>

  <div class="mt-7 grid gap-3 sm:grid-cols-2 lg:grid-cols-5">

    <div class="rounded-2xl bg-black/20 p-4">
      <div class="text-xl font-black text-white">
        <%= workspace.progress %>%
      </div>

      <div class="text-[10px] font-bold uppercase tracking-wider text-slate-600">
        Progress
      </div>
    </div>

    <div class="rounded-2xl bg-black/20 p-4">
      <div class="text-xl font-black text-orange-300">
        <%= workspace.annotation_count %>
      </div>

      <div class="text-[10px] font-bold uppercase tracking-wider text-slate-600">
        Annotations
      </div>
    </div>

    <div class="rounded-2xl bg-black/20 p-4">
      <div class="text-xl font-black text-emerald-300">
        <%= workspace.evidence_count %>
      </div>

      <div class="text-[10px] font-bold uppercase tracking-wider text-slate-600">
        Evidence
      </div>
    </div>

    <div class="rounded-2xl bg-black/20 p-4">
      <div class="text-xl font-black text-sky-300">
        <%= workspace.research_strength %>%
      </div>

      <div class="text-[10px] font-bold uppercase tracking-wider text-slate-600">
        Strength
      </div>
    </div>

    <div class="rounded-2xl bg-black/20 p-4">
      <div class="text-xl font-black text-purple-300">
        <%= workspace.snapshot_count %>
      </div>

      <div class="text-[10px] font-bold uppercase tracking-wider text-slate-600">
        Checkpoints
      </div>
    </div>

  </div>

</div>