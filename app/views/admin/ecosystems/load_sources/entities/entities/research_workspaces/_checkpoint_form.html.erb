<%= form_with url: save_checkpoint_admin_research_workspace_path(workspace),
              method: :post,
              class: "flex flex-col gap-3 sm:flex-row" do |form| %>

  <%= form.text_field :label,
                      name: "label",
                      value: "",
                      placeholder: "Checkpoint name, e.g. Evidence review complete",
                      class: "min-w-0 flex-1 rounded-xl border border-white/10 bg-black/20 px-4 py-2.5 text-sm text-white placeholder:text-slate-600" %>

  <%= form.submit "Save checkpoint",
                  class: "rounded-xl bg-purple-500 px-4 py-2.5 text-xs font-black text-white hover:bg-purple-400" %>

<% end %>