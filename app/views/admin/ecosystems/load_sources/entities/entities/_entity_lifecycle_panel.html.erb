<%# Entity lifecycle panel — intentionally independent of ResearchWorkspace %>

<% entity_status = entity.status.to_s.presence || "draft" %>
<% workflow_state = entity.workflow_state.to_s.presence || "draft" %>

<% status_classes =
     case entity_status
     when "published"
       "bg-emerald-50 text-emerald-700 border-emerald-200"
     when "archived"
       "bg-slate-100 text-slate-700 border-slate-300"
     when "deprecated"
       "bg-amber-50 text-amber-700 border-amber-200"
     when "draft"
       "bg-blue-50 text-blue-700 border-blue-200"
     else
       "bg-gray-50 text-gray-700 border-gray-200"
     end
%>

<section class="mb-6 rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <p class="text-xs font-semibold uppercase tracking-wider text-gray-500">
        Entity lifecycle
      </p>

      <h2 class="mt-1 text-lg font-bold text-gray-900">
        <%= entity.name %>
      </h2>

      <p class="mt-1 text-sm text-gray-500">
        Entity ID: <%= entity.id %>
      </p>
    </div>

    <span class="inline-flex items-center rounded-full border px-3 py-1.5 text-xs font-bold <%= status_classes %>">
      <%= entity_status.humanize %>
    </span>
  </div>

  <div class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <div class="rounded-lg border border-gray-100 bg-gray-50 p-4">
      <p class="text-xs font-medium text-gray-500">Status</p>
      <p class="mt-1 text-sm font-semibold text-gray-900">
        <%= entity_status.humanize %>
      </p>
    </div>

    <div class="rounded-lg border border-gray-100 bg-gray-50 p-4">
      <p class="text-xs font-medium text-gray-500">Workflow state</p>
      <p class="mt-1 text-sm font-semibold text-gray-900">
        <%= workflow_state.humanize %>
      </p>
    </div>

    <div class="rounded-lg border border-gray-100 bg-gray-50 p-4">
      <p class="text-xs font-medium text-gray-500">Created</p>
      <p class="mt-1 text-sm font-semibold text-gray-900">
        <%= entity.created_at&.strftime("%d %b %Y %H:%M") || "—" %>
      </p>
    </div>

    <div class="rounded-lg border border-gray-100 bg-gray-50 p-4">
      <p class="text-xs font-medium text-gray-500">Last updated</p>
      <p class="mt-1 text-sm font-semibold text-gray-900">
        <%= entity.updated_at&.strftime("%d %b %Y %H:%M") || "—" %>
      </p>
    </div>
  </div>
</section>

