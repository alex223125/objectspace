<%
  tone = local_assigns.fetch(:tone, :orange)

  tones = {
    orange: {
      shell: "border-orange-100 bg-orange-50/50",
      icon: "bg-orange-100 text-orange-700",
      accent: "text-orange-600"
    },
    violet: {
      shell: "border-violet-100 bg-violet-50/50",
      icon: "bg-violet-100 text-violet-700",
      accent: "text-violet-600"
    },
    emerald: {
      shell: "border-emerald-100 bg-emerald-50/50",
      icon: "bg-emerald-100 text-emerald-700",
      accent: "text-emerald-600"
    },
    amber: {
      shell: "border-amber-100 bg-amber-50/50",
      icon: "bg-amber-100 text-amber-700",
      accent: "text-amber-600"
    },
    rose: {
      shell: "border-rose-100 bg-rose-50/50",
      icon: "bg-rose-100 text-rose-700",
      accent: "text-rose-600"
    }
  }

  colors = tones.fetch(tone)
%>

<article
  class="
    group
    relative
    overflow-hidden
    rounded-[28px]
    border
    <%= colors[:shell] %>
    p-5
    shadow-sm
    transition-all
    duration-300
    hover:-translate-y-1
    hover:shadow-lg
  "
>

  <div
    class="
      absolute
      -right-10
      -top-10
      h-28
      w-28
      rounded-full
      bg-white/50
      blur-2xl
    "
  ></div>

  <div class="relative">

    <div class="flex items-start justify-between gap-4">

      <div
        class="
          flex
          h-11
          w-11
          items-center
          justify-center
          rounded-2xl
          <%= colors[:icon] %>
          text-lg
        "
      >
        <%= local_assigns.fetch(:icon, "✨") %>
      </div>

      <span
        class="
          rounded-full
          bg-white/70
          px-2.5
          py-1
          text-[9px]
          font-black
          uppercase
          tracking-widest
          <%= colors[:accent] %>
        "
      >
        <%= local_assigns.fetch(:label, "Insight") %>
      </span>

    </div>

    <h4
      class="
        mt-5
        text-sm
        font-black
        tracking-tight
        text-slate-800
      "
    >
      <%= local_assigns.fetch(:title, "Evolution detected") %>
    </h4>

    <p
      class="
        mt-2
        text-[11px]
        leading-5
        text-slate-500
      "
    >
      <%= local_assigns.fetch(
            :description,
            "Meaningful change has been detected in this comparison."
          ) %>
    </p>

    <% if local_assigns[:metric] %>

      <div
        class="
          mt-5
          flex
          items-end
          justify-between
        "
      >

        <span
          class="
            text-[9px]
            font-black
            uppercase
            tracking-widest
            text-slate-400
          "
        >
          Signal strength
        </span>

        <span
          class="
            text-lg
            font-black
            <%= colors[:accent] %>
          "
        >
          <%= metric %>
        </span>

      </div>

    <% end %>

  </div>

</article>