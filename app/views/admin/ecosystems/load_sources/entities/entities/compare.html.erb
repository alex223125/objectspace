<div
  data-controller="
    entity-diff
    entity-comparison-engagement
    entity-comparison-intelligence
    comparison-intelligence-bridge
  "
  data-entity-comparison-engagement-storage-key-value="entity-comparison-<%= @entity.id %>-<%= @old_version.id %>-<%= @new_version.id %>">

  <!-- EXISTING ENTITY DIFF PAYLOAD -->

  <script type="application/json" data-entity-diff-payload>
    ...
  </script>


  <!-- PREMIUM REVIEW -->

  <%= render "comparison_progress" %>

  <%= render "comparison_toolbar" %>




  <!-- NEW: COMPARISON INTELLIGENCE -->

  <%= render "comparison_progress" %>

  <%= render "comparison_toolbar" %>

  <%= render "comparison_intelligence" %>

  <%= render "ecosystem_relationship_graph" %>

  <%= render "evolution_timeline" %>

  <%= render "relationship_intelligence" %>

  <!-- COMPARISON INTELLIGENCE -->

  <%= render "relationship_intelligence", entity: @entity %>

  <%= render "ecosystem_relationship_graph", entity: @entity %>

  <!-- EXISTING SUMMARY -->

  <div data-entity-diff-target="summary"></div>


  <!-- EXISTING COMPARISON CONTENT -->

  <div data-entity-diff-target="content"></div>

  <div data-entity-diff-target="movements"></div>

  <div data-entity-diff-target="additions"></div>

  <div data-entity-diff-target="removals"></div>

  <div data-entity-diff-target="warnings"></div>


  <!-- PREMIUM EMPTY STATE -->

  <%= render "comparison_empty" %>


  <%= render "comparison_intelligence_section" %>

  <%= render "comparison_evolution_timeline" %>

  <%= render "comparison_intelligence" %>


</div>

<%= render(
      "comparisons/evolution_intelligence_panel",
      comparison: @comparison
    ) %>

<%= render "comparisons/evolution_timeline",
           versions: @versions,
           current_version: @current_version %>


<div
  data-controller="entity-diff entity-comparison-engagement entity-comparison-intelligence"
  data-entity-comparison-engagement-storage-key-value="entity-comparison-<%= @entity.id %>-<%= @old_version.id %>-<%= @new_version.id %>">

  <!-- Existing entity diff payload -->

  <script
    type="application/json"
    data-entity-diff-payload>
    <%= raw @comparison_payload.to_json %>
  </script>


  <!-- Existing premium review UI -->

  <%= render "comparison_progress" %>

  <%= render "comparison_toolbar" %>

  <%= render "comparison_intelligence" %>

  <!-- NEW: Comparison Intelligence -->

  <%= render "comparison_intelligence" %>


  <!-- Existing comparison summary -->

  <div data-entity-diff-target="summary"></div>


  <!-- Existing comparison content -->

  <div data-entity-diff-target="content"></div>

  <div data-entity-diff-target="movements"></div>

  <div data-entity-diff-target="additions"></div>

  <div data-entity-diff-target="removals"></div>

  <div data-entity-diff-target="warnings"></div>


  <!-- Existing empty state -->

  <%= render "comparison_empty" %>

  <%= render "comparison_intelligence_demo_payload" %>

</div>




