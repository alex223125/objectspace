<div
  class="mb-7 overflow-hidden rounded-[28px]
         border-2 border-orange-100
         bg-gradient-to-r
         from-orange-50/80
         via-white
         to-violet-50/70
         shadow-sm">

  <div class="p-5 md:p-6">

    <div class="flex flex-col gap-5 lg:flex-row lg:items-center lg:justify-between">

      <div class="flex items-start gap-4">

        <div
          class="flex h-12 w-12 shrink-0 items-center justify-center
                 rounded-2xl
                 border border-orange-200
                 bg-orange-100
                 text-xl
                 shadow-sm">

          🧭

        </div>

        <div>

          <div class="flex flex-wrap items-center gap-2">

            <span
              class="text-sm font-black tracking-tight text-slate-800">

              Comparison Mission

            </span>

            <span
              class="rounded-full
                     border border-violet-200
                     bg-violet-50
                     px-2.5 py-1
                     text-[9px]
                     font-black
                     uppercase
                     tracking-widest
                     text-violet-600">

              Interactive Review

            </span>

          </div>

          <p class="mt-1 text-xs leading-5 text-slate-400">

            Review the differences and build your comparison progress.

          </p>

        </div>

      </div>


      <div class="grid grid-cols-3 gap-2 sm:flex sm:items-center">

        <div
          class="rounded-2xl border border-white
                 bg-white/80 px-4 py-3 text-center shadow-sm">

          <div
            data-entity-comparison-engagement-target="xp"
            class="text-sm font-black text-orange-600">

            0

          </div>

          <div
            class="mt-0.5 text-[9px]
                   font-black uppercase
                   tracking-widest text-slate-400">

            XP

          </div>

        </div>


        <div
          class="rounded-2xl border border-white
                 bg-white/80 px-4 py-3 text-center shadow-sm">

          <div
            data-entity-comparison-engagement-target="level"
            class="text-sm font-black text-violet-600">

            1

          </div>

          <div
            class="mt-0.5 text-[9px]
                   font-black uppercase
                   tracking-widest text-slate-400">

            Level

          </div>

        </div>


        <div
          class="rounded-2xl border border-white
                 bg-white/80 px-4 py-3 text-center shadow-sm">

          <div
            data-entity-comparison-engagement-target="streak"
            class="text-sm font-black text-emerald-600">

            0

          </div>

          <div
            class="mt-0.5 text-[9px]
                   font-black uppercase
                   tracking-widest text-slate-400">

            Streak

          </div>

        </div>

      </div>

    </div>


    <div class="mt-6">

      <div class="mb-2 flex items-center justify-between gap-4">

        <div class="flex items-center gap-2">

          <span
            class="text-[10px]
                   font-black
                   uppercase
                   tracking-widest
                   text-slate-400">

            Review progress

          </span>

          <span
            data-entity-comparison-engagement-target="reviewedRows"
            class="text-[10px] font-black text-slate-500">

            0 reviewed

          </span>

        </div>

        <span
          data-entity-comparison-engagement-target="progress"
          class="text-xs font-black text-orange-600">

          0%

        </span>

      </div>


      <div
        class="h-3 overflow-hidden rounded-full
               border border-orange-100
               bg-white">

        <div
          data-entity-comparison-engagement-target="progressBar"
          role="progressbar"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow="0"
          class="h-full w-0 rounded-full
                 bg-gradient-to-r
                 from-orange-400
                 via-amber-400
                 via-violet-400
                 to-emerald-400
                 shadow-sm
                 transition-all duration-700">
        </div>

      </div>


      <div class="mt-3 flex flex-wrap items-center justify-between gap-2">

        <div class="text-[10px] font-bold text-slate-400">

          <span
            data-entity-comparison-engagement-target="reviewedCount">
            0
          </span>

          reviewed ·

          <span
            data-entity-comparison-engagement-target="remainingCount">
            0
          </span>

          remaining ·

          <span
            data-entity-comparison-engagement-target="totalCount">
            0
          </span>

          total

        </div>


        <button
          type="button"
          data-action="click->entity-comparison-engagement#resetProgress"
          class="rounded-xl border border-slate-200
                 bg-white px-3 py-1.5
                 text-[10px]
                 font-black
                 text-slate-400
                 transition
                 hover:border-rose-200
                 hover:bg-rose-50
                 hover:text-rose-600">

          Reset review progress

        </button>

      </div>

    </div>

  </div>


  <div
    class="border-t border-orange-100
           bg-white/60
           px-5 py-3 md:px-6">

    <div class="flex flex-wrap items-center gap-x-5 gap-y-2">

      <span class="text-[9px] font-black uppercase tracking-widest text-slate-400">
        Keyboard
      </span>

      <span class="text-[10px] font-bold text-slate-500">
        <kbd class="rounded-md border border-slate-200 bg-white px-1.5 py-0.5 shadow-sm">J</kbd>
        next
      </span>

      <span class="text-[10px] font-bold text-slate-500">
        <kbd class="rounded-md border border-slate-200 bg-white px-1.5 py-0.5 shadow-sm">K</kbd>
        previous
      </span>

      <span class="text-[10px] font-bold text-slate-500">
        <kbd class="rounded-md border border-slate-200 bg-white px-1.5 py-0.5 shadow-sm">R</kbd>
        review
      </span>

      <span class="text-[10px] font-bold text-slate-500">
        <kbd class="rounded-md border border-slate-200 bg-white px-1.5 py-0.5 shadow-sm">/</kbd>
        search
      </span>

    </div>

  </div>

</div>