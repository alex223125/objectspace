<%
  discovery_entity =
    if defined?(@entity) && @entity.present?
      @entity
    elsif defined?(entity) && entity.present?
      entity
    else
      nil
    end

  discovery_result =
    if discovery_entity.present?
      Ecosystems::LoadSources::Entity::RelationshipDiscoveryPreview.call(
        entity: discovery_entity,
        limit: 50,
        candidate_limit: 20
      )
    end
%>

<% if discovery_result.present? %>

  <div class="rounded-[28px] border border-amber-200/70 bg-gradient-to-br from-amber-50 via-white to-orange-50 p-5 shadow-sm dark:border-amber-900/50 dark:from-amber-950/30 dark:via-gray-950 dark:to-orange-950/20">

    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">

      <div>

        <div class="text-[9px] font-black uppercase tracking-[0.22em] text-amber-500">
          Relationship Discovery
        </div>

        <h2 class="mt-1 text-lg font-black tracking-tight text-gray-900 dark:text-white">
          Candidate Relationships
        </h2>

        <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">
          Deterministic candidates discovered from existing entity information.
        </p>

      </div>

      <div class="rounded-2xl border border-amber-200 bg-white px-4 py-3 text-center dark:border-amber-800 dark:bg-gray-900">

        <div class="text-[8px] font-black uppercase tracking-widest text-gray-400">
          Candidates
        </div>

        <div class="mt-1 text-2xl font-black text-amber-600 dark:text-amber-400">
          <%= discovery_result[:candidate_count] %>
        </div>

      </div>

    </div>

    <% if discovery_result[:candidates].any? %>

      <div class="mt-5 space-y-2">

        <% discovery_result[:candidates].first(8).each do |candidate| %>

          <div class="rounded-2xl border border-gray-200 bg-white p-3 dark:border-gray-800 dark:bg-gray-900">

            <div class="flex items-center gap-3">

              <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-amber-100 text-sm dark:bg-amber-950/50">
                🔎
              </div>

              <div class="min-w-0 flex-1">

                <div class="truncate text-xs font-black text-gray-800 dark:text-gray-100">
                  <%= candidate[:source_name] %>
                  →
                  <%= candidate[:target_name] %>
                </div>

                <div class="mt-1 flex flex-wrap gap-2 text-[8px] font-black uppercase tracking-wider text-gray-400">

                  <span>
                    <%= candidate[:relationship_kind] %>
                  </span>

                  <span>
                    <%= candidate[:confidence_percent] %>% confidence
                  </span>

                </div>

              </div>

            </div>

          </div>

        <% end %>

      </div>

    <% else %>

      <div class="mt-5 rounded-2xl border border-dashed border-amber-200 bg-white/70 px-5 py-8 text-center dark:border-amber-900 dark:bg-gray-950/50">

        <div class="text-2xl">
          ◎
        </div>

        <div class="mt-2 text-sm font-black text-gray-800 dark:text-white">
          No candidates discovered
        </div>

        <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">
          The current deterministic discovery rules did not find a strong enough connection.
        </p>

      </div>

    <% end %>

  </div>

<% end %>