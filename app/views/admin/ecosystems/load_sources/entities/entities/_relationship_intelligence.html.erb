<%
  intelligence_entity =
    if defined?(@entity) && @entity.present?
      @entity
    elsif defined?(entity) && entity.present?
      entity
    else
      nil
    end

  intelligence =
    if intelligence_entity.present?
      Ecosystems::LoadSources::Entity::EcosystemIntelligence.call(
        entity: intelligence_entity,
        limit: 20
      )
    end
%>

<% if intelligence.present? %>

  <div class="rounded-[28px] border border-sky-200/70 bg-gradient-to-br from-sky-50 via-white to-cyan-50 p-5 shadow-sm dark:border-sky-900/50 dark:from-sky-950/30 dark:via-gray-950 dark:to-cyan-950/20">

    <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">

      <div>

        <div class="text-[9px] font-black uppercase tracking-[0.22em] text-sky-500">
          Relationship Intelligence
        </div>

        <h2 class="mt-1 text-lg font-black tracking-tight text-gray-900 dark:text-white">
          Ecosystem Signals
        </h2>

        <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">
          Structural signals derived from this entity's relationship network.
        </p>

      </div>

      <div class="rounded-2xl border border-sky-200 bg-white px-4 py-3 text-center dark:border-sky-800 dark:bg-gray-900">

        <div class="text-[8px] font-black uppercase tracking-widest text-gray-400">
          Ecosystem Score
        </div>

        <div class="mt-1 text-2xl font-black text-sky-600 dark:text-sky-400">
          <%= intelligence[:ecosystem_score] %>
        </div>

      </div>

    </div>

    <div class="mt-5 grid grid-cols-2 gap-3 lg:grid-cols-4">

      <div class="rounded-2xl border border-gray-200 bg-white p-4 dark:border-gray-800 dark:bg-gray-900">
        <div class="text-[8px] font-black uppercase tracking-widest text-gray-400">
          Relationships
        </div>
        <div class="mt-1 text-xl font-black text-gray-900 dark:text-white">
          <%= intelligence[:relationship_count] %>
        </div>
      </div>

      <div class="rounded-2xl border border-gray-200 bg-white p-4 dark:border-gray-800 dark:bg-gray-900">
        <div class="text-[8px] font-black uppercase tracking-widest text-gray-400">
          Neighbors
        </div>
        <div class="mt-1 text-xl font-black text-gray-900 dark:text-white">
          <%= intelligence[:neighbor_count] %>
        </div>
      </div>

      <div class="rounded-2xl border border-gray-200 bg-white p-4 dark:border-gray-800 dark:bg-gray-900">
        <div class="text-[8px] font-black uppercase tracking-widest text-gray-400">
          Confirmed
        </div>
        <div class="mt-1 text-xl font-black text-emerald-600 dark:text-emerald-400">
          <%= intelligence[:confirmed_count] %>
        </div>
      </div>

      <div class="rounded-2xl border border-gray-200 bg-white p-4 dark:border-gray-800 dark:bg-gray-900">
        <div class="text-[8px] font-black uppercase tracking-widest text-gray-400">
          Confidence
        </div>
        <div class="mt-1 text-xl font-black text-violet-600 dark:text-violet-400">
          <%= (intelligence[:average_confidence].to_f * 100).round %>%
        </div>
      </div>

    </div>

    <% if intelligence[:attention_signals].any? %>

      <div class="mt-5 space-y-2">

        <% intelligence[:attention_signals].each do |signal| %>

          <% signal_classes =
               case signal[:severity].to_sym
               when :high
                 "border-red-200 bg-red-50 text-red-700 dark:border-red-900 dark:bg-red-950/30 dark:text-red-400"
               when :medium
                 "border-amber-200 bg-amber-50 text-amber-700 dark:border-amber-900 dark:bg-amber-950/30 dark:text-amber-400"
               else
                 "border-sky-200 bg-sky-50 text-sky-700 dark:border-sky-900 dark:bg-sky-950/30 dark:text-sky-400"
               end
          %>

          <div class="rounded-2xl border px-4 py-3 <%= signal_classes %>">

            <div class="text-[10px] font-black uppercase tracking-wider">
              <%= signal[:label] %>
            </div>

            <div class="mt-1 text-xs opacity-80">
              <%= signal[:message] %>
            </div>

          </div>

        <% end %>

      </div>

    <% end %>

    <% if intelligence[:neighbors].any? %>

      <div class="mt-5">

        <div class="mb-3 text-[9px] font-black uppercase tracking-[0.18em] text-gray-400">
          Connected Entities
        </div>

        <div class="space-y-2">

          <% intelligence[:neighbors].first(8).each do |neighbor| %>

            <% other = neighbor[:entity] %>
            <% relationship = neighbor[:relationship] %>

            <div class="flex items-center gap-3 rounded-2xl border border-gray-200 bg-white p-3 dark:border-gray-800 dark:bg-gray-900">

              <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-violet-100 text-sm dark:bg-violet-950/50">
                🧬
              </div>

              <div class="min-w-0 flex-1">

                <div class="truncate text-xs font-black text-gray-800 dark:text-gray-100">
                  <%= other.name %>
                </div>

                <div class="mt-0.5 flex flex-wrap gap-2 text-[8px] font-black uppercase tracking-wider text-gray-400">

                  <span>
                    <%= relationship.relationship_kind.to_s.humanize %>
                  </span>

                  <span>
                    <%= relationship.confidence_percent %>% confidence
                  </span>

                  <span>
                    <%= neighbor[:direction].to_s %>
                  </span>

                </div>

              </div>

              <div
                class="h-2 w-2 rounded-full <%= relationship.strong? ? 'bg-emerald-400' : relationship.moderate? ? 'bg-amber-400' : 'bg-slate-400' %>">
              </div>

            </div>

          <% end %>

        </div>

      </div>

    <% end %>

  </div>

<% end %>