                      Inspect →
                    </div>

                  <% end %>

                <% else %>

                  <div class="rounded-2xl border-2 border-red-100 bg-red-50 p-3 text-xs text-red-700 sm:p-4">
                    Source entity unavailable
                  </div>

                <% end %>

                <div class="flex min-w-0 flex-col items-center justify-center">

                  <div class="flex h-9 w-9 items-center justify-center rounded-full border border-orange-200 bg-orange-50 text-xl font-black text-orange-600 shadow-sm">
                    →
                  </div>

                  <div class="mt-2 max-w-20 break-words text-center text-[10px] font-black leading-4 text-slate-500">
                    <%= relationship.relationship_kind.to_s.humanize %>
                  </div>

                </div>

                <% if target_entity %>

                  <%= link_to entity_path.call(target_entity),
                              class: "group/target block min-w-0 rounded-2xl border-2 border-emerald-100 bg-gradient-to-br from-emerald-50/80 to-white p-3 shadow-sm transition duration-200 hover:border-emerald-300 hover:shadow-md hover:shadow-emerald-100/60 sm:p-4" do %>

                    <div class="text-[10px] font-black uppercase tracking-wider text-emerald-600">
                      Target
                    </div>

                    <div class="mt-3 break-words text-sm font-extrabold text-slate-700 transition group-hover/target:text-emerald-700 sm:text-base">
                      <%= target_entity.respond_to?(:name) && target_entity.name.present? ? target_entity.name : "Entity ##{target_entity.id}" %>
                    </div>

                    <div class="mt-2 text-[10px] text-slate-400">
                      Entity ID: <%= target_entity.id %>
                    </div>

                    <div class="mt-3 text-xs font-black text-emerald-600">
                      Inspect →
                    </div>

                  <% end %>

                <% else %>

                  <div class="rounded-2xl border-2 border-red-100 bg-red-50 p-3 text-xs text-red-700 sm:p-4">
                    Target entity unavailable
                  </div>

                <% end %>

              </div>

              <%# CONFIDENCE PROGRESS %>

              <div class="mt-5 border-t border-orange-100 pt-4">

                <div class="flex items-center justify-between gap-3 text-xs font-bold text-slate-500">
                  <span>Relationship strength</span>
                  <span class="<%= relationship.confidence.to_f >= 0.80 ? 'text-emerald-600' : 'text-violet-600' %>">
                    <%= relationship.confidence_percent %>%
                  </span>
                </div>

                <div class="mt-3 h-2.5 overflow-hidden rounded-full border border-slate-100 bg-slate-100">

                  <div
                    class="h-full rounded-full transition-all duration-700 <%= relationship.confidence.to_f >= 0.80 ? 'bg-gradient-to-r from-emerald-400 to-teal-400' : 'bg-gradient-to-r from-violet-400 to-sky-400' %>"
                    style="width: <%= [[relationship.confidence.to_f * 100, 100].min, 0].max %>%">
                  </div>

                </div>

                <div class="mt-3 text-[10px] font-bold text-slate-400">
                  Relationship ID: <%= relationship.id %>
                </div>

              </div>

            </article>

          <% end %>

        </div>

      <% else %>

        <%# LIGHT QUEST EMPTY STATE %>

        <div class="relative overflow-hidden rounded-[30px] border-2 border-dashed border-orange-200 bg-gradient-to-br from-orange-50/60 via-white to-amber-50/50 p-6 sm:p-10">

          <div class="pointer-events-none absolute -right-12 -top-12 h-48 w-48 rounded-full bg-orange-200/40 blur-3xl"></div>
          <div class="pointer-events-none absolute -bottom-12 -left-12 h-40 w-40 rounded-full bg-sky-200/30 blur-3xl"></div>

          <div class="relative flex flex-col items-center text-center">

            <div class="flex h-20 w-20 items-center justify-center rounded-[26px] border-2 border-orange-200 bg-gradient-to-br from-orange-100 to-amber-50 text-4xl text-orange-600 shadow-lg shadow-orange-100/60">
              ◈
            </div>

            <span class="mt-5 rounded-full border border-orange-200 bg-orange-100 px-4 py-2 text-[10px] font-black uppercase tracking-[0.16em] text-orange-700">
              ✨ Quest available
            </span>

            <h4 class="mt-5 text-xl font-black text-slate-800 sm:text-2xl">
              Your next mission: discover connections
            </h4>

            <p class="mt-3 max-w-2xl text-sm leading-7 text-slate-500 sm:text-base">
              You have
              <strong class="text-sky-700"><%= entity_count %> entities</strong>
              in your ecosystem, but no suggested or confirmed relationships
              are currently available for this preview.
              Rejected and archived relationships are excluded.
            </p>

            <div class="mt-7 grid w-full max-w-2xl gap-4 text-left sm:grid-cols-2">

              <div class="rounded-2xl border-2 border-sky-100 bg-white p-4 shadow-sm shadow-sky-100/40">

                <div class="flex items-center gap-3">

                  <span class="flex h-11 w-11 items-center justify-center rounded-xl border border-sky-200 bg-sky-100 text-lg text-sky-700">
                    ◈
                  </span>

                  <div>
                    <div class="text-[10px] font-black uppercase tracking-wider text-sky-500">
                      Mission 01
                    </div>

                    <div class="mt-1 text-sm font-extrabold text-slate-700">
                      Explore entities
                    </div>
                  </div>

                </div>

                <p class="mt-3 text-xs leading-6 text-slate-500">
                  Open an entity below to inspect its details.
                </p>

              </div>

              <div class="rounded-2xl border-2 border-emerald-100 bg-white p-4 shadow-sm shadow-emerald-100/40">

                <div class="flex items-center gap-3">

                  <span class="flex h-11 w-11 items-center justify-center rounded-xl border border-emerald-200 bg-emerald-100 text-lg text-emerald-700">
                    ⛓
                  </span>

                  <div>
                    <div class="text-[10px] font-black uppercase tracking-wider text-emerald-600">
                      Mission 02
                    </div>

                    <div class="mt-1 text-sm font-extrabold text-slate-700">
                      Establish a connection
                    </div>
                  </div>

                </div>

                <p class="mt-3 text-xs leading-6 text-slate-500">
                  Store a suggested or confirmed relationship between entities.
                </p>

              </div>

            </div>

            <%# NETWORK RULES %>

            <div class="mt-6 w-full max-w-2xl rounded-2xl border-2 border-orange-100 bg-white/90 p-5 text-left shadow-sm">

              <div class="flex items-center gap-3">

                <div class="flex h-10 w-10 items-center justify-center rounded-xl border border-orange-200 bg-orange-100 text-orange-700">
                  ℹ
                </div>

                <div class="text-sm font-black text-slate-700">
                  Network rules
                </div>

              </div>

              <ul class="mt-4 space-y-3 text-xs leading-6 text-slate-500">

                <li class="flex items-start gap-2">
                  <span class="font-black text-orange-500">•</span>
                  Entity records exist independently of relationship records.
                </li>

                <li class="flex items-start gap-2">
                  <span class="font-black text-sky-500">•</span>
                  Connections are read from stored source and target entity IDs.
                </li>

                <li class="flex items-start gap-2">
                  <span class="font-black text-violet-500">•</span>
                  The dashboard never invents relationships between entities.
                </li>

                <li class="flex items-start gap-2">
                  <span class="font-black text-emerald-500">•</span>
                  Only suggested and confirmed relationships appear in this preview.
                </li>

              </ul>

            </div>

          </div>

        </div>

      <% end %>

    </section>

    <%# ========================================================= %>
    <%# ENTITY DIRECTORY / COLLECTION %>
    <%# ========================================================= %>

    <section aria-labelledby="entity-directory-heading">

      <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">

        <div>

          <div class="text-[10px] font-black uppercase tracking-[0.18em] text-sky-600">
            📚 Collection log
          </div>

          <h3 id="entity-directory-heading" class="mt-2 text-2xl font-black text-slate-800 sm:text-3xl">
            Ecosystem entity directory
          </h3>

          <p class="mt-2 text-sm leading-6 text-slate-500 sm:text-base">
            Browse discovered entities and open their records to inspect the details.
          </p>

        </div>

        <span class="w-fit rounded-full border border-sky-200 bg-sky-50 px-4 py-2 text-xs font-black text-sky-700 shadow-sm">
          <%= directory_entities.size %> / <%= entity_count %> displayed
        </span>

      </div>

      <% if directory_entities.any? %>

        <div class="grid gap-5 sm:grid-cols-2 xl:grid-cols-3">

          <% directory_entities.each do |entity| %>

            <% entity_name =
                 entity.respond_to?(:name) && entity.name.present? ?
                   entity.name : "Entity ##{entity.id}" %>

            <% description =
                 if entity.respond_to?(:description)
                   entity.description
                 elsif entity.respond_to?(:summary)
                   entity.summary
                 end %>

            <%= link_to entity_path.call(entity),
                        class: "group relative block min-w-0 overflow-hidden rounded-[26px] border-2 border-orange-100 bg-gradient-to-br from-white via-white to-orange-50/40 p-5 shadow-md shadow-orange-100/30 transition duration-300 hover:-translate-y-1 hover:border-orange-200 hover:shadow-lg hover:shadow-orange-100/70" do %>

              <div class="pointer-events-none absolute -right-4 -top-4 h-24 w-24 rounded-full bg-orange-100/70 blur-2xl transition group-hover:bg-orange-200/60"></div>

              <div class="relative flex items-start gap-4">

                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl border-2 border-orange-200 bg-gradient-to-br from-orange-100 to-amber-50 text-sm font-black text-orange-700 shadow-sm transition group-hover:border-orange-300 group-hover:shadow-md">
                  <%= entity.id %>
                </div>

                <div class="min-w-0 flex-1">

                  <div class="flex flex-wrap items-center gap-2">

                    <h4 class="break-words text-base font-extrabold text-slate-700 transition group-hover:text-orange-700">
                      <%= entity_name %>
                    </h4>

                  </div>

                  <p class="mt-3 break-words text-xs leading-6 text-slate-500">
                    <%= description.present? ? truncate(description.to_s, length: 140) : "No description available." %>
                  </p>

                  <div class="mt-5 flex items-center justify-between gap-3 border-t border-orange-100 pt-4">

                    <span class="text-[10px] font-black uppercase tracking-wider text-slate-400">
                      Entity #<%= entity.id %>
                    </span>

                    <span class="text-xs font-black text-orange-600 transition group-hover:translate-x-1 group-hover:text-orange-700">
                      Inspect →
                    </span>

                  </div>

                </div>

              </div>

            <% end %>

          <% end %>

        </div>

        <% if entity_count > directory_entities.size %>

          <div class="mt-5 rounded-2xl border-2 border-sky-100 bg-gradient-to-r from-sky-50/70 via-white to-white p-4">

            <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">

              <p class="text-xs leading-6 text-slate-500">
                Showing
                <strong class="text-slate-700"><%= directory_entities.size %></strong>
                of
                <strong class="text-slate-700"><%= entity_count %></strong>
                entities.
              </p>

              <span class="text-[10px] font-black uppercase tracking-wider text-sky-600">
                ✦ More entities available
              </span>

            </div>

          </div>

        <% end %>

      <% else %>

        <div class="rounded-[28px] border-2 border-dashed border-orange-200 bg-gradient-to-br from-orange-50/50 via-white to-sky-50/30 p-8 text-center sm:p-10">

          <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl border-2 border-orange-200 bg-orange-100 text-3xl text-orange-600 shadow-sm">
            ◈
          </div>

          <h4 class="mt-5 text-lg font-black text-slate-800">
            Your collection is empty
          </h4>

          <p class="mx-auto mt-2 max-w-lg text-sm leading-7 text-slate-500">
            No entity records were supplied to this dashboard.
          </p>

        </div>

      <% end %>

    </section>

    <%# ========================================================= %>
    <%# DASHBOARD FOOTNOTE %>
    <%# ========================================================= %>

    <footer class="border-t-2 border-orange-100 pt-6">

      <div class="flex items-start gap-4 rounded-2xl border border-slate-100 bg-white/80 p-4 shadow-sm">

        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-slate-200 bg-slate-50 text-sm font-black text-slate-500">
          i
        </div>

        <p class="text-xs leading-6 text-slate-500">
          All statistics are calculated from stored entity and relationship records.
          Confidence represents the stored relationship score and does not independently
          verify the relationship. Network ranks, progress bars, and quest labels are
          presentation elements derived from the current dataset; they are not persisted
          player levels, XP, or achievements.
        </p>

      </div>

    </footer>

  </div>

</section>
