<%
  entity_model = ::Ecosystems::LoadSources::Entity::Entity

  entities =
    local_assigns[:entities] ||
      @entities ||
      entity_model.all

  entities =
    if entities.respond_to?(:to_a) && !entities.is_a?(ActiveRecord::Relation)
      entities.to_a
    else
      entities
    end

  entity_list = entities.to_a
  entity_count = entity_list.size
  entity_ids = entity_list.map(&:id)

  relationship_model =
    ::Ecosystems::LoadSources::Entity::EntityRelationship

  relationships =
    if entity_ids.empty?
      relationship_model.none
    else
      relationship_model
        .where(
          "(source_entity_id IN (:ids) OR target_entity_id IN (:ids))",
          ids: entity_ids
        )
        .where(state: %w[suggested confirmed])
        .includes(:source_entity, :target_entity)
        .order(confidence: :desc, updated_at: :desc)
    end

  relationship_list = relationships.to_a

  confirmed_count = relationship_list.count(&:state_confirmed?)
  suggested_count = relationship_list.count(&:state_suggested?)

  strong_count = relationship_list.count do |relationship|
    relationship.confidence.to_f >= 0.80
  end

  preview_relationships = relationship_list.first(12)
  relationship_count = relationship_list.size
  active_relationships = relationship_count.positive?

  directory_entities =
    entity_list.sort_by do |entity|
      -(entity.respond_to?(:updated_at) && entity.updated_at ?
          entity.updated_at.to_i : entity.id.to_i)
    end.first(12)

  entity_path = lambda do |entity|
    admin_ecosystems_load_sources_entity_path(entity)
  end

  # Gamification presentation values.
  # These are visual indicators, not persisted game progress.
  network_level = case entity_count
                  when 0..4 then 1
                  when 5..9 then 2
                  when 10..19 then 3
                  when 20..49 then 4
                  else 5
                  end

  network_rank = case network_level
                 when 1 then "ROOKIE EXPLORER"
                 when 2 then "FIELD SCOUT"
                 when 3 then "NETWORK BUILDER"
                 when 4 then "ECOSYSTEM MASTER"
                 else "LEGENDARY ARCHITECT"
                 end

  connection_rate =
    if entity_count > 1
      ((relationship_count.to_f / (entity_count * (entity_count - 1))) * 100).round
    else
      0
    end

  connection_rate = [[connection_rate, 100].min, 0].max

  confirmed_rate =
    if relationship_count.positive?
      ((confirmed_count.to_f / relationship_count) * 100).round
    else
      0
    end

  confirmed_rate = [[confirmed_rate, 100].min, 0].max

  entity_progress = [[entity_count, 100].min, 0].max
%>

