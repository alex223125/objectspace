                    <div class="text-[10px] font-black uppercase tracking-wider text-sky-600">
                      Source
                    </div>

                    <div class="mt-3 break-words text-sm font-extrabold text-slate-700 transition group-hover/source:text-sky-700 sm:text-base">
                      <%= source_entity.respond_to?(:name) && source_entity.name.present? ? source_entity.name : "Entity ##{source_entity.id}" %>
