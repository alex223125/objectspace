<div
  data-controller="entity-intelligence"
  class="space-y-5">

  <% metrics = @intelligence[:metrics] %>

  <!-- ============================================================
       HEADER
  ============================================================= -->

  <div
    class="relative overflow-hidden rounded-[28px] border border-slate-800 bg-slate-950 shadow-xl">

    <div
      class="pointer-events-none absolute inset-0 opacity-20"
      style="
      background-image:
        linear-gradient(rgba(99,102,241,.18) 1px, transparent 1px),
          linear-gradient(90deg, rgba(99,102,241,.18) 1px, transparent 1px);
        background-size: 24px 24px;
      ">
    </div>

    <div class="relative p-6">

      <div
        class="flex flex-col gap-5 lg:flex-row lg:items-center lg:justify-between">

        <div class="flex items-start gap-4">

          <div
            class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-violet-400/30 bg-violet-500/10 text-2xl">
            🧠
          </div>

          <div>

            <div
              class="text-[10px] font-black uppercase tracking-[0.25em] text-violet-400">
              Ecosystem Intelligence // Step 09
            </div>

            <h1
              class="mt-1 text-2xl font-black tracking-tight text-white">
              Cross-Entity Intelligence
            </h1>

            <p
              class="mt-2 max-w-3xl text-xs leading-relaxed text-slate-400">
              Discover structural relationships, ecosystem hubs,
              isolated entities, review opportunities, and emerging
              intelligence signals across the entity registry.
            </p>

          </div>

        </div>

        <div>

          <%= button_to(
                "RUN DISCOVERY",
                discover_admin_ecosystems_load_sources_entities_intelligence_path,
                method: :post,
                data: {
                  action: "click->entity-intelligence#prepareDiscovery"
                },
                class: "rounded-xl bg-violet-500 px-5 py-3 text-[10px] font-black uppercase tracking-widest text-white shadow-lg shadow-violet-500/20 transition hover:bg-violet-400"
              ) %>

          <div
            data-entity-intelligence-target="discoveryStatus"
            class="mt-2 hidden text-center text-[9px] font-bold text-violet-300">
            Relationship engine running…
          </div>

        </div>

      </div>

    </div>

  </div>


  <!-- ============================================================
       METRICS
  ============================================================= -->

  <div class="grid grid-cols-2 gap-3 lg:grid-cols-6">

    <% [
         ["ENTITIES", metrics[:entities], "indigo"],
         ["RELATIONSHIPS", metrics[:relationships], "violet"],
         ["HIGH CONFIDENCE", metrics[:high_confidence_relationships], "emerald"],
         ["SUGGESTED", metrics[:suggested_relationships], "sky"],
         ["ISOLATED", metrics[:isolated_entities], "amber"],
         ["REVIEW QUEUE", metrics[:review_queue], "orange"]
       ].each do |label, value, color| %>

      <div
        class="rounded-2xl border border-gray-200 bg-white p-4 shadow-sm dark:border-gray-800 dark:bg-gray-900">

        <div
          class="text-[9px] font-black uppercase tracking-[0.18em] text-gray-400">
          <%= label %>
        </div>

        <div
          class="mt-2 text-2xl font-black text-<%= color %>-500">
          <%= number_with_delimiter(value) %>
        </div>

      </div>

    <% end %>

  </div>


  <!-- ============================================================
       RELATIONSHIP EXPLORER
  ============================================================= -->

  <div
    class="overflow-hidden rounded-[28px] border border-gray-200 bg-white shadow-sm dark:border-gray-800 dark:bg-gray-900">

    <div
      class="flex flex-col gap-3 border-b border-gray-200 bg-gray-50 p-4 sm:flex-row sm:items-center sm:justify-between dark:border-gray-800 dark:bg-gray-950">

      <div>

        <div
          class="text-[10px] font-black uppercase tracking-[0.18em] text-gray-500">
          Relationship Explorer
        </div>

        <div
          class="mt-1 text-xs text-gray-400">
          Highest-confidence ecosystem connections.
        </div>

      </div>

      <input
        type="search"
        data-entity-intelligence-target="filter"
        data-action="input->entity-intelligence#filter"
        placeholder="Filter relationships…"
        class="w-full rounded-xl border border-gray-200 bg-white px-3 py-2 text-xs outline-none focus:border-violet-400 sm:w-64 dark:border-gray-700 dark:bg-gray-900 dark:text-white">

    </div>


    <div class="divide-y divide-gray-100 dark:divide-gray-800">

      <% @relationships.each do |relationship| %>

        <% source = relationship.source_entity %>
        <% target = relationship.target_entity %>

        <div
          data-entity-intelligence-target="relationshipRow"
          data-search="<%= [
                             source.name,
                             source.slug,
                             target.name,
                             target.slug,
                             relationship.relationship_kind
                           ].compact.join(" ") %>"
          class="p-4 transition hover:bg-violet-50/40 dark:hover:bg-violet-950/10">

          <div
            class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">

            <div class="min-w-0 flex-1">

              <div class="flex flex-wrap items-center gap-2">

                <%= link_to(
                      source.name,
                      admin_ecosystems_load_sources_entity_path(source),
                      class: "font-black text-gray-800 hover:text-violet-600 dark:text-white dark:hover:text-violet-400"
                    ) %>

                <span class="text-gray-300">→</span>

                <%= link_to(
                      target.name,
                      admin_ecosystems_load_sources_entity_path(target),
                      class: "font-black text-gray-800 hover:text-violet-600 dark:text-white dark:hover:text-violet-400"
                    ) %>

              </div>

              <div
                class="mt-1 text-[9px] font-black uppercase tracking-wider text-gray-400">
                <%= relationship.label %>
              </div>

            </div>


            <div class="flex items-center gap-3">

              <div class="w-28">

                <div
                  class="mb-1 flex justify-between text-[8px] font-black uppercase text-gray-400">

                  <span>Confidence</span>

                  <span>
                    <%= relationship.confidence_percent %>%
                  </span>

                </div>

                <div
                  class="h-1.5 overflow-hidden rounded-full bg-gray-100 dark:bg-gray-800">

                  <div
                    class="h-full rounded-full bg-violet-500"
                    style="width: <%= relationship.confidence_percent %>%">
                  </div>

                </div>

              </div>

              <button
                type="button"
                data-action="click->entity-intelligence#toggleEvidence"
                data-target="<%= relationship.id %>"
                aria-expanded="false"
                class="rounded-lg border border-gray-200 px-2 py-1 text-[9px] font-black uppercase text-gray-500 hover:bg-gray-100 dark:border-gray-700 dark:hover:bg-gray-800">
                EVIDENCE
              </button>

            </div>

          </div>


          <div
            data-evidence="<%= relationship.id %>"
            class="mt-3 hidden rounded-xl border border-violet-100 bg-violet-50/60 p-3 dark:border-violet-900/50 dark:bg-violet-950/20">

            <% relationship.evidence_items.each do |item| %>

              <div class="flex items-center justify-between gap-3 py-1">

                <span
                  class="text-[10px] font-bold text-violet-700 dark:text-violet-300">
                  <%= item["label"] || item[:label] %>
                </span>

                <span
                  class="font-mono text-[9px] text-violet-500">
                  <%= item["weight"] || item[:weight] %>
                </span>

              </div>

            <% end %>

          </div>

        </div>

      <% end %>


      <div
        data-entity-intelligence-target="emptyState"
        class="hidden p-10 text-center text-xs text-gray-400">
        No relationships match this filter.
      </div>

    </div>

  </div>


  <!-- ============================================================
       TWO COLUMN INTELLIGENCE
  ============================================================= -->

  <div class="grid gap-5 xl:grid-cols-2">


    <!-- HOTSPOTS -->

    <section
      class="rounded-[28px] border border-gray-200 bg-white p-5 shadow-sm dark:border-gray-800 dark:bg-gray-900">

      <div
        class="text-[10px] font-black uppercase tracking-[0.18em] text-orange-500">
        Ecosystem Hotspots
      </div>

      <p class="mt-1 text-xs text-gray-400">
        Entities with the highest relationship density.
      </p>

      <div class="mt-4 space-y-2">

        <% @intelligence[:hotspots].each do |item| %>

          <% entity = item[:entity] %>

          <% next unless entity %>

          <%= link_to(
                admin_ecosystems_load_sources_entity_intelligence_path(entity),
                class: "flex items-center justify-between rounded-xl border border-gray-100 p-3 transition hover:border-orange-200 hover:bg-orange-50 dark:border-gray-800 dark:hover:bg-orange-950/20"
              ) do %>

            <div class="min-w-0">

              <div
                class="truncate text-xs font-black text-gray-800 dark:text-white">
                <%= entity.name %>
              </div>

              <div
                class="mt-0.5 text-[9px] text-gray-400">
                <%= entity.entity_type&.name || "Unassigned" %>
              </div>

            </div>

            <span
              class="rounded-full bg-orange-100 px-2 py-1 text-[9px] font-black text-orange-600 dark:bg-orange-950/40 dark:text-orange-400">
              <%= item[:relationship_count] %>
            </span>

          <% end %>

        <% end %>

      </div>

    </section>


    <!-- REVIEW OPPORTUNITIES -->

    <section
      class="rounded-[28px] border border-gray-200 bg-white p-5 shadow-sm dark:border-gray-800 dark:bg-gray-900">

      <div
        class="text-[10px] font-black uppercase tracking-[0.18em] text-amber-500">
        Review Opportunities
      </div>

      <p class="mt-1 text-xs text-gray-400">
        Entities whose editorial or quality state deserves attention.
      </p>

      <div class="mt-4 space-y-2">

        <% @intelligence[:review_opportunities].each do |entity| %>

          <%= link_to(
                admin_ecosystems_load_sources_entity_intelligence_path(entity),
                class: "flex items-center justify-between rounded-xl border border-gray-100 p-3 transition hover:border-amber-200 hover:bg-amber-50 dark:border-gray-800 dark:hover:bg-amber-950/20"
              ) do %>

            <div class="min-w-0">

              <div
                class="truncate text-xs font-black text-gray-800 dark:text-white">
                <%= entity.name %>
              </div>

              <div
                class="mt-0.5 text-[9px] text-gray-400">
                <%= entity.workflow_state.to_s.titleize %>
              </div>

            </div>

            <span
              class="rounded-full bg-amber-100 px-2 py-1 text-[9px] font-black text-amber-700 dark:bg-amber-950/40 dark:text-amber-400">
              <%= entity.health_score %>%
            </span>

          <% end %>

        <% end %>

      </div>

    </section>


    <!-- ISOLATED -->

    <section
      class="rounded-[28px] border border-gray-200 bg-white p-5 shadow-sm dark:border-gray-800 dark:bg-gray-900">

      <div
        class="text-[10px] font-black uppercase tracking-[0.18em] text-sky-500">
        Isolated Entities
      </div>

      <p class="mt-1 text-xs text-gray-400">
        Entities for which the discovery engine has not found an ecosystem connection.
      </p>

      <div class="mt-4 space-y-2">

        <% @intelligence[:isolated].first(12).each do |entity| %>

          <%= link_to(
                entity.name,
                admin_ecosystems_load_sources_entity_intelligence_path(entity),
                class: "block rounded-xl border border-gray-100 p-3 text-xs font-black text-gray-700 hover:border-sky-200 hover:bg-sky-50 dark:border-gray-800 dark:text-gray-300 dark:hover:bg-sky-950/20"
              ) %>

          <%= link_to(
                "INTEL",
                admin_ecosystems_load_sources_entity_intelligence_path(entity),
                class: "rounded-lg px-2 py-1 text-[9px] font-black text-violet-600 hover:bg-violet-50 dark:text-violet-400 dark:hover:bg-violet-950"
              ) %>

          <%= link_to(
                "VIEW",
                admin_ecosystems_load_sources_entity_path(entity),
                class: "rounded-lg px-2 py-1 text-[9px] font-black text-indigo-600 hover:bg-indigo-50 dark:text-indigo-400 dark:hover:bg-indigo-950"
              ) %>

        <% end %>

      </div>

    </section>


    <!-- STALE -->

    <section
      class="rounded-[28px] border border-gray-200 bg-white p-5 shadow-sm dark:border-gray-800 dark:bg-gray-900">

      <div
        class="text-[10px] font-black uppercase tracking-[0.18em] text-red-500">
        Stale Entities
      </div>

      <p class="mt-1 text-xs text-gray-400">
        Entities that have not been updated within the intelligence freshness window.
      </p>

      <div class="mt-4 space-y-2">

        <% @intelligence[:stale_entities].first(12).each do |entity| %>

          <div
            class="rounded-xl border border-gray-100 p-3 dark:border-gray-800">

            <div
              class="text-xs font-black text-gray-700 dark:text-gray-300">
              <%= entity.name %>
            </div>

            <div
              class="mt-1 text-[9px] text-gray-400">
              Updated
              <%= time_ago_in_words(entity.updated_at) %>
              ago
            </div>

          </div>

        <% end %>

      </div>

    </section>

  </div>

</div>


