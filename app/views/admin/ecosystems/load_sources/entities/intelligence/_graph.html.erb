<div
  data-entity-intelligence-target="graphPanel"
  class="rounded-[24px] border border-gray-200 bg-white p-5 shadow-sm dark:border-gray-800 dark:bg-gray-900">

  <div class="flex items-center justify-between">

    <div>

      <div class="text-[10px] font-black uppercase tracking-[.2em] text-gray-400">
        Relationship Graph
      </div>

      <div class="mt-1 text-xs text-gray-500">
        Structural relationships inferred from shared entity characteristics.
      </div>

    </div>

    <span class="rounded-full bg-indigo-50 px-3 py-1 text-[9px] font-black uppercase text-indigo-600 dark:bg-indigo-950/40 dark:text-indigo-400">
      <%= graph[:nodes].length %> nodes
    </span>

  </div>

  <div
    data-entity-intelligence-target="graph"
    class="mt-5 min-h-[420px] overflow-hidden rounded-2xl border border-gray-100 bg-slate-950 dark:border-gray-800">

    <svg
      data-entity-intelligence-target="svg"
      class="h-[420px] w-full"
      viewBox="0 0 900 420"
      preserveAspectRatio="xMidYMid meet">
    </svg>

  </div>

  <div class="mt-3 flex flex-wrap gap-4 text-[9px] font-bold text-gray-400">

    <span class="flex items-center gap-2">
      <span class="h-2.5 w-2.5 rounded-full bg-indigo-500"></span>
      Focus entity
    </span>

    <span class="flex items-center gap-2">
      <span class="h-2.5 w-2.5 rounded-full bg-sky-500"></span>
      Related entity
    </span>

    <span>
      Connection strength is calculated from shared structural attributes.
    </span>

  </div>

</div>