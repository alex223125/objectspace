<div class="rounded-[24px] border border-gray-200 bg-white p-5 shadow-sm dark:border-gray-800 dark:bg-gray-900">

  <div class="flex items-center justify-between">

    <div>

      <div class="text-[10px] font-black uppercase tracking-[.2em] text-gray-400">
        Ecosystem Overview
      </div>

      <div class="mt-1 text-xs text-gray-500">
        Structural characteristics of the current entity registry.
      </div>

    </div>

    <div class="rounded-xl bg-indigo-50 px-3 py-2 text-[9px] font-black uppercase text-indigo-600 dark:bg-indigo-950/40 dark:text-indigo-400">
      Intelligence
    </div>

  </div>

  <div class="mt-5 grid grid-cols-2 gap-3 lg:grid-cols-5">

    <div class="rounded-2xl bg-gray-50 p-4 dark:bg-gray-950">
      <div class="text-[9px] font-black uppercase text-gray-400">
        Entities
      </div>

      <div class="mt-1 text-xl font-black text-gray-900 dark:text-white">
        <%= number_with_delimiter(ecosystem[:entity_count]) %>
      </div>
    </div>

    <div class="rounded-2xl bg-gray-50 p-4 dark:bg-gray-950">
      <div class="text-[9px] font-black uppercase text-gray-400">
        Types
      </div>

      <div class="mt-1 text-xl font-black text-gray-900 dark:text-white">
        <%= ecosystem[:type_count] %>
      </div>
    </div>

    <div class="rounded-2xl bg-gray-50 p-4 dark:bg-gray-950">
      <div class="text-[9px] font-black uppercase text-gray-400">
        Templates
      </div>

      <div class="mt-1 text-xl font-black text-gray-900 dark:text-white">
        <%= ecosystem[:template_count] %>
      </div>
    </div>

    <div class="rounded-2xl bg-gray-50 p-4 dark:bg-gray-950">
      <div class="text-[9px] font-black uppercase text-gray-400">
        Avg Health
      </div>

      <div class="mt-1 text-xl font-black text-gray-900 dark:text-white">
        <%= ecosystem[:health][:average] %>%
      </div>
    </div>

    <div class="rounded-2xl bg-gray-50 p-4 dark:bg-gray-950">
      <div class="text-[9px] font-black uppercase text-gray-400">
        Attention
      </div>

      <div class="mt-1 text-xl font-black text-amber-500">
        <%= ecosystem[:health][:critical] + ecosystem[:health][:needs_attention] %>
      </div>
    </div>

  </div>

</div>