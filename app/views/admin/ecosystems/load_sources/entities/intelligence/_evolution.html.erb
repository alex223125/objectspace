<div class="rounded-[24px] border border-gray-200 bg-white p-5 shadow-sm dark:border-gray-800 dark:bg-gray-900">

  <div class="flex items-center justify-between">

    <div>

      <div class="text-[10px] font-black uppercase tracking-[.2em] text-gray-400">
        Entity Evolution
      </div>

      <div class="mt-1 text-xs text-gray-500">
        Version progression detected for this entity.
      </div>

    </div>

    <div class="rounded-xl bg-violet-50 px-3 py-2 text-[9px] font-black uppercase text-violet-600 dark:bg-violet-950/30 dark:text-violet-400">
      <%= evolution[:version_count] %> versions
    </div>

  </div>

  <% if evolution[:versions].any? %>

    <div class="mt-6 overflow-x-auto">

      <div class="flex min-w-max items-center gap-2">

        <% evolution[:versions].each_with_index do |version, index| %>

          <% unless index.zero? %>
            <div class="h-px w-8 bg-violet-200 dark:bg-violet-900"></div>
          <% end %>

          <div class="relative rounded-2xl border border-violet-100 bg-violet-50 px-4 py-3 dark:border-violet-900/50 dark:bg-violet-950/20">

            <div class="text-[9px] font-black uppercase tracking-wider text-violet-500">
              Version
            </div>

            <div class="mt-1 text-lg font-black text-violet-700 dark:text-violet-300">
              <%= version[:version_number] || "—" %>
            </div>

            <% if version[:created_at].present? %>
              <div class="mt-1 text-[9px] text-gray-400">
                <%= version[:created_at] %>
              </div>
            <% end %>

          </div>

        <% end %>

      </div>

    </div>

  <% else %>

    <div class="mt-5 rounded-2xl border border-dashed border-gray-200 p-6 text-center dark:border-gray-800">

      <div class="text-xs font-black text-gray-600 dark:text-gray-300">
        No version history detected
      </div>

      <div class="mt-1 text-[10px] text-gray-400">
        Evolution data will become more useful as version history accumulates.
      </div>

    </div>

  <% end %>

</div>