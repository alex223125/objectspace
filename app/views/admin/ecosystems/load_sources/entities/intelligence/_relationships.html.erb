<div class="rounded-[24px] border border-gray-200 bg-white p-5 shadow-sm dark:border-gray-800 dark:bg-gray-900">

  <div class="text-[10px] font-black uppercase tracking-[.2em] text-gray-400">
    Related Entities
  </div>

  <div class="mt-1 text-xs text-gray-500">
    Strongest structural connections.
  </div>

  <div class="mt-5 space-y-3">

    <% if relationships[:all].any? %>

      <% relationships[:all].each do |relationship| %>

        <%= link_to(
              admin_ecosystems_load_sources_entity_path(relationship[:id]),
              class: "block rounded-2xl border border-gray-100 bg-gray-50 p-3 transition hover:border-indigo-200 hover:bg-indigo-50/50 dark:border-gray-800 dark:bg-gray-950 dark:hover:border-indigo-900 dark:hover:bg-indigo-950/20"
            ) do %>

          <div class="flex items-start justify-between gap-3">

            <div class="min-w-0">

              <div class="truncate text-xs font-black text-gray-800 dark:text-gray-100">
                <%= relationship[:name] %>
              </div>

              <div class="mt-1 truncate font-mono text-[9px] text-gray-400">
                <%= relationship[:slug] %>
              </div>

            </div>

            <div class="shrink-0 rounded-lg bg-indigo-100 px-2 py-1 text-[9px] font-black text-indigo-600 dark:bg-indigo-950 dark:text-indigo-400">
              <%= relationship[:score] %>
            </div>

          </div>

          <div class="mt-2 flex flex-wrap gap-1">

            <% relationship[:reasons].each do |reason| %>

              <span class="rounded-full border border-gray-200 bg-white px-2 py-1 text-[8px] font-bold text-gray-500 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-400">
                <%= reason[:label] %>
              </span>

            <% end %>

          </div>

        <% end %>

      <% end %>

    <% else %>

      <div class="rounded-2xl border border-dashed border-gray-200 p-6 text-center dark:border-gray-800">

        <div class="text-xl">
          ◌
        </div>

        <div class="mt-2 text-xs font-black text-gray-700 dark:text-gray-300">
          No structural relationships found
        </div>

        <p class="mt-1 text-[10px] text-gray-400">
          More relationships will appear as the ecosystem grows.
        </p>

      </div>

    <% end %>

  </div>

</div>