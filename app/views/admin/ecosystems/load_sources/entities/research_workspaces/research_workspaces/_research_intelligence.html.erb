<div class="rounded-3xl border border-white/10 bg-gradient-to-br from-white/[0.04] to-transparent p-5">

  <div class="flex items-center justify-between gap-4">

    <div>

      <div class="text-[10px] font-bold uppercase tracking-widest text-slate-600">
        Research strength
      </div>

      <div class="mt-1 text-lg font-black text-white">
        <%= item.research_strength %>%
      </div>

    </div>

    <div class="text-right">

      <div class="text-xs text-slate-600">
        <%= item.annotation_count %> annotations
      </div>

      <div class="mt-1 text-xs text-slate-600">
        <%= item.evidence_count %> evidence
      </div>

      <div class="mt-1 text-xs text-emerald-400/70">
        <%= item.verified_evidence_count %> verified
      </div>

    </div>

  </div>

  <div class="mt-4 h-2 overflow-hidden rounded-full bg-white/5">

    <div
      class="h-full rounded-full bg-gradient-to-r from-orange-400 via-blue-400 to-emerald-400 transition-all"
      style="width: <%= item.research_strength %>%">
    </div>

  </div>

</div>