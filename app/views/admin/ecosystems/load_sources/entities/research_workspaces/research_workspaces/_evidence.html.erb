<div class="rounded-2xl border border-white/5 bg-white/[0.02] p-4">
  <div class="flex items-start gap-3">
    <div class="text-lg">
      <%= evidence_icon(evidence.source_type) %>
    </div>

    <div class="min-w-0 flex-1">
      <div class="flex flex-wrap items-center gap-2">
        <h4 class="font-bold text-white">
          <%= evidence.title %>
        </h4>

        <% if evidence.verified? %>
          <span class="rounded-full bg-emerald-500/10 px-2 py-1 text-[10px] font-bold uppercase tracking-wider text-emerald-300">
            Verified
          </span>
        <% else %>
          <span class="rounded-full bg-amber-500/10 px-2 py-1 text-[10px] font-bold uppercase tracking-wider text-amber-300">
            Unverified
          </span>
        <% end %>
      </div>

      <div class="mt-1 text-xs text-slate-600">
        <%= evidence.source_type_label %>

        <% if evidence.publisher.present? %>
          · <%= evidence.publisher %>
        <% end %>

        <% if evidence.author.present? %>
          · <%= evidence.author %>
        <% end %>
      </div>

      <% if evidence.excerpt.present? %>
        <blockquote class="mt-3 border-l-2 border-orange-500/30 pl-3 text-sm italic leading-6 text-slate-500">
          <%= evidence.excerpt %>
        </blockquote>
      <% end %>

      <% if evidence.notes.present? %>
        <p class="mt-3 text-xs leading-5 text-slate-600">
          <%= evidence.notes %>
        </p>
      <% end %>

      <div class="mt-3 flex flex-wrap items-center gap-4 text-xs">
        <span class="<%= confidence_color(evidence.confidence) %>">
          Confidence
          <strong><%= evidence.confidence %>%</strong>
        </span>

        <% if evidence.research_annotation.present? %>
          <span class="text-slate-600">
            Supports:
            <%= evidence.research_annotation.title %>
          </span>
        <% end %>

        <% if evidence.source_url.present? %>
          <%= link_to "Open source",
                      evidence.source_url,
                      target: "_blank",
                      rel: "noopener noreferrer",
                      class: "font-bold text-orange-400 hover:text-orange-300" %>
        <% end %>
      </div>

      <div class="mt-4 flex flex-wrap gap-2">
        <%= link_to "Edit",
                    edit_admin_research_workspace_item_evidence_path(
                      workspace,
                      evidence.research_workspace_item,
                      evidence
                    ),
                    class: "rounded-xl bg-white/5 px-3 py-2 text-xs font-bold text-slate-400 hover:bg-white/10 hover:text-white" %>

        <% if evidence.verified? %>
          <%= button_to "Unverify",
                        unverify_admin_research_workspace_item_evidence_path(
                          workspace,
                          evidence.research_workspace_item,
                          evidence
                        ),
                        method: :patch,
                        class: "rounded-xl bg-amber-500/10 px-3 py-2 text-xs font-bold text-amber-300 hover:bg-amber-500/20" %>
        <% else %>
          <%= button_to "Verify",
                        verify_admin_research_workspace_item_evidence_path(
                          workspace,
                          evidence.research_workspace_item,
                          evidence
                        ),
                        method: :patch,
                        class: "rounded-xl bg-emerald-500/10 px-3 py-2 text-xs font-bold text-emerald-300 hover:bg-emerald-500/20" %>
        <% end %>

        <%= button_to "Delete",
                      admin_research_workspace_item_evidence_path(
                        workspace,
                        evidence.research_workspace_item,
                        evidence
                      ),
                      method: :delete,
                      data: {
                        turbo_confirm: "Delete this evidence?"
                      },
                      class: "rounded-xl bg-rose-500/10 px-3 py-2 text-xs font-bold text-rose-300 hover:bg-rose-500/20" %>
      </div>
    </div>
  </div>
</div>