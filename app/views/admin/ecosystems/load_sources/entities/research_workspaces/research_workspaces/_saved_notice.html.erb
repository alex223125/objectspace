
<% if @total_count.positive? %>
  <div class="flex flex-col gap-1 rounded-xl border border-emerald-500/20 bg-emerald-500/5 px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
    <p class="text-sm font-bold text-slate-800 dark:text-slate-200">
      <%= number_with_delimiter(@total_count) %> matching investigations
    </p>

    <p class="text-xs text-slate-500">
      Filter: <%= @filter.humanize %>
      <% if @search_query.present? %>
        · Search: <%= @search_query %>
      <% end %>
    </p>
  </div>
<% end %>