<div class="rounded-3xl border border-white/10 bg-white/[0.03] p-6">
  <div class="flex items-start justify-between gap-4">
    <div>
      <div class="text-xs font-bold uppercase tracking-[0.2em] text-orange-400">
        Research history
      </div>

      <h2 class="mt-2 text-xl font-black text-white">
        Saved research states
      </h2>

      <p class="mt-1 text-sm text-slate-500">
        Immutable snapshots let you return to an earlier research state.
      </p>
    </div>
  </div>

  <div class="mt-6 space-y-3">
    <% if snapshots.present? %>
      <% snapshots.each do |snapshot| %>
        <div class="rounded-2xl border border-white/5 bg-black/10 p-4">
          <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <div class="flex flex-wrap items-center gap-2">
                <span class="rounded-full bg-orange-500/10 px-2 py-1 text-[10px] font-bold uppercase tracking-wider text-orange-300">
                  <%= snapshot.kind_label %>
                </span>

                <span class="text-xs text-slate-600">
                  <%= snapshot.created_at_label %>
                </span>
              </div>

              <h3 class="mt-2 font-bold text-white">
                <%= snapshot.label %>
              </h3>

              <div class="mt-2 flex flex-wrap gap-4 text-xs text-slate-600">
                <span><%= snapshot.item_count %> items</span>
                <span><%= snapshot.annotation_count %> annotations</span>
                <span><%= snapshot.evidence_count %> evidence</span>
              </div>
            </div>

            <%= link_to(
                  "View snapshot",
                  admin_ecosystems_load_sources_entity_research_workspace_snapshot_path(snapshot),
                  class: "rounded-xl bg-white/5 px-4 py-2 text-xs font-bold text-slate-400 hover:bg-white/10 hover:text-white"
                ) %>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="rounded-2xl border border-white/5 bg-black/10 p-6 text-center">
        <p class="text-sm font-semibold text-slate-400">
          No saved research snapshots yet.
        </p>
        <p class="mt-1 text-xs text-slate-600">
          Save a research state to see it listed here.
        </p>
      </div>
    <% end %>
  </div>
</div>
