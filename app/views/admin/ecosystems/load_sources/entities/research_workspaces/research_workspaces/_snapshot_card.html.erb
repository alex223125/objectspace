<div class="rounded-3xl border border-white/10 bg-white/[0.03] p-6">

  <div class="flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between">

    <div>

      <div class="flex flex-wrap items-center gap-2">

        <% if index.zero? %>
          <span class="rounded-full bg-purple-500/10 px-3 py-1 text-[10px] font-black uppercase tracking-wider text-purple-300">
            Latest
          </span>
        <% end %>

        <span class="rounded-full bg-white/5 px-3 py-1 text-[10px] font-bold uppercase tracking-wider text-slate-500">
          v<%= snapshot["version"] %>
        </span>

      </div>

      <h2 class="mt-3 text-lg font-black text-white">
        <%= snapshot["label"] %>
      </h2>

      <div class="mt-2 text-xs text-slate-600">
        Created <%= investigation_time(snapshot["created_at"]) %>
      </div>

    </div>

    <div class="grid grid-cols-3 gap-2 sm:min-w-[280px]">

      <div class="rounded-2xl bg-black/20 p-3 text-center">
        <div class="font-black text-white">
          <%= snapshot.dig("workspace", "progress") || 0 %>%
        </div>

        <div class="text-[9px] font-bold uppercase tracking-wider text-slate-600">
          Progress
        </div>
      </div>

      <div class="rounded-2xl bg-black/20 p-3 text-center">
        <div class="font-black text-orange-300">
          <%= snapshot.dig("workspace", "annotation_count") || 0 %>
        </div>

        <div class="text-[9px] font-bold uppercase tracking-wider text-slate-600">
          Notes
        </div>
      </div>

      <div class="rounded-2xl bg-black/20 p-3 text-center">
        <div class="font-black text-emerald-300">
          <%= snapshot.dig("workspace", "evidence_count") || 0 %>
        </div>

        <div class="text-[9px] font-bold uppercase tracking-wider text-slate-600">
          Evidence
        </div>
      </div>

    </div>

  </div>

  <div class="mt-6 grid gap-3 sm:grid-cols-4">

    <div class="rounded-2xl bg-black/20 p-4">
      <div class="text-lg font-black text-white">
        <%= Array(snapshot["items"]).length %>
      </div>

      <div class="text-[10px] font-bold uppercase tracking-wider text-slate-600">
        Items
      </div>
    </div>

    <div class="rounded-2xl bg-black/20 p-4">
      <div class="text-lg font-black text-orange-300">
        <%= snapshot.dig("workspace", "annotation_count") || 0 %>
      </div>

      <div class="text-[10px] font-bold uppercase tracking-wider text-slate-600">
        Annotations
      </div>
    </div>

    <div class="rounded-2xl bg-black/20 p-4">
      <div class="text-lg font-black text-emerald-300">
        <%= snapshot.dig("workspace", "verified_evidence_count") || 0 %>
      </div>

      <div class="text-[10px] font-bold uppercase tracking-wider text-slate-600">
        Verified
      </div>
    </div>

    <div class="rounded-2xl bg-black/20 p-4">
      <div class="text-lg font-black text-sky-300">
        <%= snapshot.dig("workspace", "research_strength") || 0 %>%
      </div>

      <div class="text-[10px] font-bold uppercase tracking-wider text-slate-600">
        Strength
      </div>
    </div>

  </div>

  <details class="mt-6">

    <summary class="cursor-pointer text-xs font-bold uppercase tracking-wider text-slate-500 hover:text-white">
      Inspect checkpoint contents
    </summary>

    <div class="mt-4 space-y-3">

      <% Array(snapshot["items"]).each do |item| %>

        <div class="rounded-2xl border border-white/5 bg-black/10 p-4">

          <div class="flex flex-wrap items-center justify-between gap-3">

            <div>
              <div class="text-[10px] font-bold uppercase tracking-wider text-slate-600">
                <%= item["kind"] %>
              </div>

              <div class="mt-1 font-bold text-white">
                <%= item["title"] %>
              </div>
            </div>

            <div class="text-xs text-slate-600">
              <%= Array(item["annotations"]).length %> annotations ·
              <%= Array(item["evidences"]).length %> evidence
            </div>

          </div>

        </div>

      <% end %>

    </div>

  </details>

</div>