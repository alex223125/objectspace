<div class="space-y-3">

  <% evidences = item.evidences.ordered %>

  <% if evidences.empty? %>

    <div class="rounded-2xl border border-dashed border-white/10 bg-white/[0.02] p-5 text-sm text-slate-600">
      No evidence attached yet.
    </div>

  <% else %>

    <% evidences.each do |evidence| %>

      <div class="rounded-3xl border border-white/10 bg-white/[0.02] p-5">

        <div class="flex items-start gap-4">

          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-blue-400/10 text-lg">
            <%= evidence_icon(evidence.evidence_type) %>
          </div>

          <div class="min-w-0 flex-1">

            <div class="flex flex-wrap items-center gap-2">

              <h4 class="font-bold text-white">
                <%= evidence.title %>
              </h4>

              <span class="rounded-full bg-white/5 px-2 py-1 text-[10px] font-bold uppercase tracking-wider text-slate-500">
                <%= evidence.evidence_type_label %>
              </span>

              <% if evidence.verified? %>

                <span class="rounded-full bg-emerald-400/10 px-2 py-1 text-[10px] font-bold text-emerald-300">
                  ✓ Verified
                </span>

              <% else %>

                <span class="rounded-full bg-amber-400/10 px-2 py-1 text-[10px] font-bold text-amber-300">
                  Unverified
                </span>

              <% end %>

            </div>

            <% if evidence.source_name.present? %>

              <div class="mt-2 text-xs font-semibold text-slate-500">
                <%= evidence.source_name %>
              </div>

            <% end %>

            <% if evidence.source_url.present? %>

              <%= link_to evidence.source_url,
                          evidence.source_url,
                          target: "_blank",
                          rel: "noopener noreferrer",
                          class: "mt-2 block truncate text-xs text-blue-400 hover:text-blue-300" %>

            <% end %>

            <% if evidence.excerpt.present? %>

              <blockquote class="mt-4 rounded-2xl border-l-2 border-blue-400/50 bg-black/20 px-4 py-3 text-sm leading-6 text-slate-400">
                <%= evidence.excerpt %>
              </blockquote>

            <% end %>

            <% if evidence.notes.present? %>

              <div class="mt-3 text-xs leading-5 text-slate-600">
                <span class="font-bold text-slate-500">Research note:</span>
                <%= evidence.notes %>
              </div>

            <% end %>

            <div class="mt-4 flex flex-wrap items-center gap-4 text-xs">

              <span class="<%= confidence_color(evidence.confidence) %> font-semibold">
                <%= evidence.confidence %>% confidence
              </span>

              <% if evidence.published_at.present? %>
                <span class="text-slate-600">
                  Published <%= evidence.published_at.strftime("%Y-%m-%d") %>
                </span>
              <% end %>

              <% if evidence.accessed_at.present? %>
                <span class="text-slate-600">
                  Accessed <%= evidence.accessed_at.strftime("%Y-%m-%d") %>
                </span>
              <% end %>

            </div>

          </div>

          <div class="shrink-0 space-y-2">

            <% unless evidence.verified? %>

              <%= form_with url: verify_evidence_admin_research_workspace_path(
                workspace,
                item_id: item.id,
                evidence_id: evidence.id
              ),
                            method: :patch,
                            local: true do %>

                <%= text_field_tag :verification_note,
                                   nil,
                                   placeholder: "Verification note",
                                   class: "mb-2 w-40 rounded-xl border border-white/10 bg-black/20 px-3 py-2 text-xs text-white placeholder:text-slate-700 focus:border-emerald-400 focus:outline-none" %>

                <%= submit_tag "Verify",
                               class: "w-full rounded-xl bg-emerald-500/10 px-3 py-2 text-xs font-bold text-emerald-300 transition hover:bg-emerald-500/20" %>

              <% end %>

            <% end %>

            <%= button_to "Delete",
                          delete_evidence_admin_research_workspace_path(
                            workspace,
                            item_id: item.id,
                            evidence_id: evidence.id
                          ),
                          method: :delete,
                          class: "w-full rounded-xl bg-white/5 px-3 py-2 text-xs font-bold text-slate-600 transition hover:bg-red-500/10 hover:text-red-300" %>

          </div>

        </div>

      </div>

    <% end %>

  <% end %>

</div>