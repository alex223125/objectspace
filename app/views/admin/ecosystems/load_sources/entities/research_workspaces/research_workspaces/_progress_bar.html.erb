
<div class="mt-4">
  <div class="mb-2 flex items-center justify-between">
    <span class="text-xs font-medium text-slate-500">Item completion</span>
    <span class="text-xs font-bold text-slate-700 dark:text-slate-300"><%= progress %>%</span>
  </div>

  <div class="h-2 overflow-hidden rounded-full bg-slate-200 dark:bg-white/10"
       role="progressbar"
       aria-label="Research item completion"
       aria-valuemin="0"
       aria-valuemax="100"
       aria-valuenow="<%= progress %>">
    <div class="h-full rounded-full bg-orange-500 transition-all"
         style="width: <%= progress %>%"></div>
  </div>
</div>