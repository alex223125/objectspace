
<div class="max-w-6xl mx-auto my-8 p-6 md:p-8
            bg-gradient-to-b from-white via-orange-50/20 to-slate-50/50
            border-2 border-orange-100 rounded-[32px]
            shadow-md shadow-orange-100/40">

  <header class="mb-8 pb-5 border-b-2 border-orange-100">
    <div class="flex items-center gap-4">
      <div class="w-12 h-12 rounded-2xl bg-orange-100
                  border border-orange-200 flex items-center
                  justify-center text-xl">
        🕸️
      </div>

      <div>
        <h1 class="text-lg font-black tracking-wide text-slate-700">
          Research Provenance
        </h1>
        <p class="mt-1 text-xs text-slate-400">
          Trace connections between investigation items, annotations, and evidence
        </p>
      </div>
    </div>
  </header>

  <% graph = @provenance_graph %>

  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
    <% [
         ["Graph nodes", graph.dig(:summary, :nodes)],
         ["Relationships", graph.dig(:summary, :edges)],
         ["Investigation items", graph.dig(:summary, :items)]
       ].each do |label, value| %>
      <section class="rounded-[24px] border border-orange-100
                      bg-white p-5">
        <p class="text-[10px] uppercase tracking-widest
                  font-black text-slate-400"><%= label %></p>
        <p class="mt-3 text-2xl font-black text-orange-600">
          <%= value %>
        </p>
      </section>
    <% end %>
  </div>

  <section class="mt-8">
    <h2 class="mb-4 text-sm font-black text-slate-700">Graph nodes</h2>

    <% if graph[:nodes].empty? %>
      <div class="rounded-[24px] border-2 border-dashed
                  border-orange-200 bg-white/80 p-8 text-center">
        <p class="text-sm font-bold text-slate-600">
          No provenance records yet
        </p>
        <p class="mt-2 text-xs text-slate-400">
          Add investigation items, annotations, and evidence to build a traceable research graph.
        </p>
      </div>
    <% else %>
      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
        <% graph[:nodes].each do |node| %>
          <article class="rounded-[24px] border border-orange-100
                          bg-white p-5 shadow-sm">
            <div class="flex items-center justify-between gap-3">
              <span class="rounded-full bg-orange-50 px-3 py-1
                           text-[10px] font-black uppercase
                           tracking-wider text-orange-700">
                <%= node[:type] %>
              </span>
              <span class="text-[10px] font-bold text-slate-400">
                <%= node[:id] %>
              </span>
            </div>

            <h3 class="mt-4 break-words text-sm font-black text-slate-700">
              <%= node[:title].presence || "Untitled #{node[:type]}" %>
            </h3>

            <% if node[:source_name].present? %>
              <p class="mt-2 text-xs text-slate-500">
                Source: <%= node[:source_name] %>
              </p>
            <% end %>

            <% if node[:source_url].present? %>
              <p class="mt-2 break-all text-xs">
                <%= link_to node[:source_url], node[:source_url],
                            target: "_blank",
                            rel: "noopener noreferrer",
                            class: "font-bold text-orange-600 underline" %>
              </p>
            <% end %>

            <% if node[:status].present? %>
              <p class="mt-3 text-[10px] font-bold uppercase
                        tracking-wider text-slate-400">
                Status: <%= node[:status] %>
              </p>
            <% end %>
          </article>
        <% end %>
      </div>
    <% end %>
  </section>

  <section class="mt-8">
    <h2 class="mb-4 text-sm font-black text-slate-700">
      Relationships
    </h2>

    <% if graph[:edges].empty? %>
      <p class="rounded-2xl border border-orange-100 bg-white
                p-5 text-xs text-slate-400">
        No relationships have been recorded.
      </p>
    <% else %>
      <div class="space-y-3">
        <% graph[:edges].each do |edge| %>
          <article class="grid grid-cols-1 sm:grid-cols-[1fr_auto_1fr]
                          items-center gap-3 rounded-2xl
                          border border-orange-100 bg-white p-4">
            <code class="break-all text-xs font-bold text-slate-600">
              <%= edge[:source] %>
            </code>

            <span class="rounded-full bg-orange-50 px-3 py-2
                         text-center text-[10px] font-black
                         uppercase tracking-wider text-orange-700">
              <%= edge[:type].humanize %>
            </span>

            <code class="break-all text-xs font-bold text-slate-600">
              <%= edge[:target] %>
            </code>
          </article>
        <% end %>
      </div>
    <% end %>
  </section>
</div>