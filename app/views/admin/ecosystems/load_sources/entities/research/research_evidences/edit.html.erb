<div class="mx-auto max-w-3xl px-6 py-10">

  <%= link_to "← Evidence",
              admin_research_workspace_evidence_path(
                @workspace,
                @evidence
              ),
              class: "text-sm font-bold text-slate-500 hover:text-white" %>

  <h1 class="mt-6 text-3xl font-black text-white">
    Edit evidence
  </h1>

  <div class="mt-8 rounded-3xl border border-white/10 bg-white/[0.03] p-6">

    <%= render "form",
               workspace: @workspace,
               evidence: @evidence %>

  </div>

</div>