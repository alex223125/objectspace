<div class="mx-auto max-w-7xl px-6 py-10">

  <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">

    <div>

      <div class="text-xs font-bold uppercase tracking-[0.2em] text-orange-400">
        Research Workspace
      </div>

      <h1 class="mt-2 text-3xl font-black text-white">
        Evidence & provenance
      </h1>

      <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-500">
        Keep the sources, documents, datasets, interviews, and observations
        supporting your investigation.
      </p>

    </div>

    <%= link_to "← Workspace",
                admin_research_workspace_path(@workspace),
                class: "rounded-2xl bg-white/5 px-4 py-3 text-sm font-bold text-slate-300 hover:bg-white/10 hover:text-white" %>

  </div>

  <div class="mt-8 grid gap-8 lg:grid-cols-[1fr_420px]">

    <section class="space-y-4">

      <% if @evidences.any? %>

        <% @evidences.each do |evidence| %>

          <article class="rounded-3xl border border-white/10 bg-white/[0.03] p-6">

            <div class="flex items-start gap-4">

              <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-blue-500/10 text-xl">
                <%= evidence.source_icon %>
              </div>

              <div class="min-w-0 flex-1">

                <div class="flex flex-wrap items-center gap-2">

                  <h2 class="font-bold text-white">
                    <%= evidence.title %>
                  </h2>

                  <span class="rounded-full bg-white/5 px-2 py-1 text-[10px] font-bold uppercase tracking-wider text-slate-500">
                    <%= evidence.source_type_label %>
                  </span>

                  <% if evidence.verified? %>

                    <span class="rounded-full bg-emerald-500/10 px-2 py-1 text-[10px] font-bold text-emerald-300">
                      Verified
                    </span>

                  <% else %>

                    <span class="rounded-full bg-amber-500/10 px-2 py-1 text-[10px] font-bold text-amber-300">
                      Unverified
                    </span>

                  <% end %>

                </div>

                <% if evidence.source_url.present? %>

                  <div class="mt-2 truncate text-xs text-slate-600">
                    <%= evidence.source_url %>
                  </div>

                <% end %>

                <% if evidence.excerpt.present? %>

                  <div class="mt-4 border-l-2 border-white/10 pl-4 text-sm italic leading-6 text-slate-500">
                    <%= evidence.excerpt %>
                  </div>

                <% end %>

                <div class="mt-4 flex flex-wrap gap-3 text-xs text-slate-600">

                  <span>
                    Confidence:
                    <span class="text-slate-400">
                      <%= evidence.confidence %>%
                    </span>
                  </span>

                  <span>
                    Item:
                    <span class="text-slate-400">
                      <%= evidence.research_workspace_item.title %>
                    </span>
                  </span>

                </div>

              </div>

            </div>

            <div class="mt-5 flex flex-wrap gap-2">

              <%= link_to "Open",
                          admin_research_workspace_evidence_path(
                            @workspace,
                            evidence
                          ),
                          class: "rounded-xl bg-white/5 px-3 py-2 text-xs font-bold text-slate-300 hover:bg-white/10 hover:text-white" %>

              <%= link_to "Edit",
                          edit_admin_research_workspace_evidence_path(
                            @workspace,
                            evidence
                          ),
                          class: "rounded-xl bg-white/5 px-3 py-2 text-xs font-bold text-slate-300 hover:bg-white/10 hover:text-white" %>

              <% unless evidence.verified? %>

                <%= button_to "Verify",
                              verify_admin_research_workspace_evidence_path(
                                @workspace,
                                evidence
                              ),
                              method: :patch,
                              class: "rounded-xl bg-emerald-500/10 px-3 py-2 text-xs font-bold text-emerald-300" %>

              <% end %>

            </div>

          </article>

        <% end %>

      <% else %>

        <div class="rounded-3xl border border-dashed border-white/10 p-10 text-center">

          <div class="text-3xl">
            🔎
          </div>

          <h2 class="mt-3 font-bold text-white">
            No evidence yet
          </h2>

          <p class="mt-2 text-sm text-slate-500">
            Add the first source supporting this investigation.
          </p>

        </div>

      <% end %>

    </section>

    <aside class="rounded-3xl border border-white/10 bg-white/[0.03] p-6">

      <h2 class="text-lg font-black text-white">
        Add evidence
      </h2>

      <p class="mt-2 text-sm leading-6 text-slate-500">
        Evidence should support a workspace item or annotation.
      </p>

      <div class="mt-6">

        <%= render "form",
                   workspace: @workspace,
                   evidence: @evidence %>

      </div>

    </aside>

  </div>

</div>