<div class="row g-3">

  <% totals = @portfolio[:totals] %>

  <div class="col-md-3">
    <div class="card h-100">
      <div class="card-body">
        <div class="text-muted small">Collections</div>
        <div class="fs-2 fw-bold">
          <%= totals[:collections] %>
        </div>
      </div>
    </div>
  </div>

  <div class="col-md-3">
    <div class="card h-100">
      <div class="card-body">
        <div class="text-muted small">Open questions</div>
        <div class="fs-2 fw-bold">
          <%= totals[:open_questions] %>
        </div>
      </div>
    </div>
  </div>

  <div class="col-md-3">
    <div class="card h-100">
      <div class="card-body">
        <div class="text-muted small">Findings</div>
        <div class="fs-2 fw-bold">
          <%= totals[:findings] %>
        </div>
      </div>
    </div>
  </div>

  <div class="col-md-3">
    <div class="card h-100">
      <div class="card-body">
        <div class="text-muted small">Relationships</div>
        <div class="fs-2 fw-bold">
          <%= totals[:relationships] %>
        </div>
      </div>
    </div>
  </div>

</div>