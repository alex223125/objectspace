
<section class="rounded-[26px] border border-slate-200 bg-white p-5 shadow-sm sm:p-7"
         data-controller="graph-presentation"
         aria-labelledby="graph-presentation-heading">

  <p class="text-[10px] font-black uppercase tracking-[0.18em] text-indigo-700">Display preferences</p>
  <h2 id="graph-presentation-heading" class="mt-1 text-lg font-black text-slate-900">Presentation mode</h2>
  <p class="mt-2 text-sm leading-6 text-slate-500">
    Choose a presentation preference. This control changes the display only and does not change relationship data.
  </p>

  <fieldset class="mt-5 grid gap-3 sm:grid-cols-3">
    <legend class="mb-3 text-xs font-bold text-slate-600">Display layout</legend>

    <% [
         ["standard", "Standard", "Balanced spacing for normal administration."],
         ["compact", "Compact", "A denser layout for smaller screens."],
         ["presentation", "Presentation", "A simplified layout for demonstrations."]
       ].each do |value, label, description| %>

      <label class="cursor-pointer rounded-2xl border border-slate-200 p-4 transition hover:border-indigo-200 hover:bg-indigo-50/40">
        <div class="flex items-center gap-3">
          <input type="radio"
                 name="graph_presentation_mode"
                 value="<%= value %>"
                 <%= "checked" if value == "standard" %>
                 data-action="change->graph-presentation#changeMode">
          <span class="text-sm font-black text-slate-800"><%= label %></span>
        </div>
        <p class="mt-3 text-xs leading-5 text-slate-500"><%= description %></p>
      </label>
    <% end %>
  </fieldset>

  <p class="mt-4 text-xs text-slate-400">
    Your presentation controller must implement the selected layout for this control to change the page.
  </p>
</section>