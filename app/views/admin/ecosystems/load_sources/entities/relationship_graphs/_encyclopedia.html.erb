
<section class="rounded-[26px] border border-slate-200 bg-white p-5 shadow-sm sm:p-7"
         aria-labelledby="graph-encyclopedia-heading">

  <p class="text-[10px] font-black uppercase tracking-[0.18em] text-cyan-700">Knowledge base</p>
  <h2 id="graph-encyclopedia-heading" class="mt-1 text-xl font-black text-slate-900">Graph encyclopedia</h2>
  <p class="mt-2 text-sm leading-6 text-slate-500">
    Quick definitions for the terminology used throughout this workspace.
  </p>

  <div class="mt-5 grid gap-3 lg:grid-cols-2">
    <% [
         ["Entity", "A domain record representing something your application knows about."],
         ["Node", "The graph representation of an entity within a particular graph response."],
         ["Edge", "A connection represented by a source identifier and a target identifier."],
         ["Relationship kind", "The domain-specific classification of a connection."],
         ["Relationship state", "The persisted lifecycle state of a relationship, such as suggested or confirmed."],
         ["Confidence", "An assessment supplied by your domain logic. Its meaning depends on the scoring contract."],
         ["Evidence", "Information supporting or explaining why a relationship was proposed or accepted."],
         ["Candidate", "A possible connection that may require validation and review before persistence."],
         ["Isolated entity", "An entity with no eligible connection in the analyzed graph scope."],
         ["Provenance", "Information describing where a record came from and how it was produced."],
         ["Coverage", "The represented portion of a defined population, as calculated by the reporting service."],
         ["Traversal depth", "The number of relationship hops explored from a starting entity, when supported by the graph service."]
       ].each do |term, definition| %>
      <details class="group rounded-xl border border-slate-200 p-4">
        <summary class="cursor-pointer list-none text-sm font-black text-slate-800">
          <%= term %>
          <span class="float-right text-cyan-600 group-open:rotate-45">＋</span>
        </summary>
        <p class="mt-3 text-xs leading-6 text-slate-500"><%= definition %></p>
      </details>
    <% end %>
  </div>
</section>