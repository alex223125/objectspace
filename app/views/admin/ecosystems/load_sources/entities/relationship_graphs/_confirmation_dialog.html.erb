<dialog
  id="relationship-graph-confirmation"
  data-controller="graph-drawer"
  data-graph-drawer-target="dialog"
  aria-labelledby="graph-confirmation-title"
  aria-describedby="graph-confirmation-description"
  class="w-[calc(100%-2rem)] max-w-xl rounded-[28px] border-2 border-orange-200 bg-white p-0 text-slate-900 shadow-2xl backdrop:bg-slate-950/50 backdrop:backdrop-blur-sm"
>
  <div class="border-b-2 border-orange-100 bg-gradient-to-r from-orange-50 to-white p-6 sm:p-7">
    <div class="flex items-start gap-4">
      <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border-2 border-orange-200 bg-orange-100 text-2xl" aria-hidden="true">
        !
      </span>

      <div>
        <h2 id="graph-confirmation-title" class="text-xl font-black sm:text-2xl">
          Confirm this action
        </h2>

        <p id="graph-confirmation-description" class="mt-2 text-base leading-7 text-slate-600">
          Review the action before continuing. Any change to stored relationships
          should be explicitly authorized and audited.
        </p>
      </div>
    </div>
  </div>

  <div class="space-y-5 p-6 sm:p-7">
    <div
      data-graph-drawer-target="message"
      class="rounded-2xl border-2 border-slate-100 bg-slate-50 p-4 text-base leading-7 text-slate-700"
      aria-live="polite"
    >
      No action has been selected.
    </div>

    <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
      <button
        type="button"
        data-action="click->graph-drawer#close"
        class="inline-flex min-h-12 items-center justify-center rounded-xl border-2 border-slate-200 bg-white px-5 py-3 text-base font-bold text-slate-700 transition hover:bg-slate-50 focus:outline-none focus:ring-4 focus:ring-slate-100"
      >
        Cancel
      </button>

      <button
        type="button"
        data-graph-drawer-target="confirmButton"
        data-action="click->graph-drawer#confirm"
        class="inline-flex min-h-12 items-center justify-center rounded-xl border-2 border-red-200 bg-red-600 px-5 py-3 text-base font-black text-white transition hover:bg-red-700 focus:outline-none focus:ring-4 focus:ring-red-100"
      >
        Confirm action
      </button>
    </div>

    <p class="text-sm leading-6 text-slate-500">
      This dialog does not perform a server-side change by itself. Your
      controller must implement the confirmation behavior and invoke the
      appropriate authorized action.
    </p>
  </div>
</dialog>
