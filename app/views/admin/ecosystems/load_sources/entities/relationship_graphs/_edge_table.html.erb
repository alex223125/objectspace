
<%
  edges = local_assigns[:edges] || []
  nodes = local_assigns[:nodes] || []
  edges = [] unless edges.is_a?(Array)
  nodes = [] unless nodes.is_a?(Array)

  node_names = nodes.each_with_object({}) do |node, result|
    next unless node.respond_to?(:to_h)
    node = node.to_h
    id = node[:id] || node["id"]
    name = node[:name] || node["name"] || node[:label] || node["label"]
    result[id.to_s] = name if id.present?
  end

  edge_value = lambda do |edge, *keys|
    keys.each do |key|
      value = edge[key]
      value = edge[key.to_s] if value.nil?
      return value unless value.nil?
    end
    nil
  end
%>

<section class="rounded-[26px] border border-slate-200 bg-white p-5 shadow-sm sm:p-7"
         aria-labelledby="relationship-register-heading">

  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <p class="text-[10px] font-black uppercase tracking-[0.18em] text-orange-600">Audit register</p>
      <h2 id="relationship-register-heading" class="mt-1 text-xl font-black text-slate-900">Relationship register</h2>
      <p class="mt-2 text-sm leading-6 text-slate-500">
        Inspect the source, target, state, confidence, and available evidence for each returned relationship.
      </p>
    </div>

    <span class="rounded-full border border-slate-200 bg-slate-50 px-3 py-1.5 text-xs font-black text-slate-600">
      <%= number_with_delimiter(edges.size) %> records
    </span>
  </div>

  <div class="mt-5 overflow-x-auto rounded-2xl border border-slate-200">
    <table class="w-full min-w-[850px] text-left text-sm">
      <thead class="bg-slate-50 text-[10px] uppercase tracking-wider text-slate-500">
      <tr>
        <th scope="col" class="px-4 py-3">Source</th>
        <th scope="col" class="px-4 py-3">Relationship</th>
        <th scope="col" class="px-4 py-3">Target</th>
        <th scope="col" class="px-4 py-3">State</th>
        <th scope="col" class="px-4 py-3">Confidence</th>
        <th scope="col" class="px-4 py-3">Evidence</th>
      </tr>
      </thead>

      <tbody class="divide-y divide-slate-100">
      <% edges.each do |raw_edge| %>
        <%
          edge = raw_edge.respond_to?(:to_h) ? raw_edge.to_h : {}

          source_id = edge_value.call(edge, :source, :source_id)
          target_id = edge_value.call(edge, :target, :target_id)
          source_name = edge_value.call(edge, :source_name) || node_names[source_id.to_s]
          target_name = edge_value.call(edge, :target_name) || node_names[target_id.to_s]
          kind = edge_value.call(edge, :relationship_kind, :kind) || "Not provided"
          state = edge_value.call(edge, :state) || "Not provided"
          confidence = edge_value.call(edge, :confidence_percent)
          confidence = edge_value.call(edge, :confidence).to_f * 100 if confidence.nil? && !edge_value.call(edge, :confidence).nil?
          evidence = edge_value.call(edge, :evidence, :evidence_items)
        %>

        <tr class="align-top transition hover:bg-orange-50/30">
          <td class="px-4 py-4">
            <p class="font-bold text-slate-800"><%= source_name.presence || "Unknown source" %></p>
            <p class="mt-1 break-all font-mono text-[10px] text-slate-400"><%= source_id.presence || "No ID" %></p>
          </td>

          <td class="px-4 py-4">
              <span class="inline-flex rounded-lg border border-orange-100 bg-orange-50 px-2.5 py-1 text-xs font-bold text-orange-700">
                <%= kind.to_s.humanize %>
              </span>
          </td>

          <td class="px-4 py-4">
            <p class="font-bold text-slate-800"><%= target_name.presence || "Unknown target" %></p>
            <p class="mt-1 break-all font-mono text-[10px] text-slate-400"><%= target_id.presence || "No ID" %></p>
          </td>

          <td class="px-4 py-4">
              <span class="inline-flex rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-bold text-slate-600">
                <%= state.to_s.humanize %>
              </span>
          </td>

          <td class="px-4 py-4">
            <% if confidence.nil? %>
              <span class="text-xs text-slate-400">Not provided</span>
            <% else %>
              <span class="font-bold tabular-nums text-slate-700"><%= number_with_precision(confidence, precision: 1) %>%</span>
            <% end %>
          </td>

          <td class="px-4 py-4">
            <% if evidence.blank? %>
              <span class="text-xs text-slate-400">No evidence supplied</span>
            <% else %>
              <details>
                <summary class="cursor-pointer text-xs font-bold text-orange-700">Inspect evidence</summary>
                <pre class="mt-2 max-w-xs overflow-auto whitespace-pre-wrap break-words rounded-lg bg-slate-50 p-3 text-[10px] leading-5 text-slate-600"><%= evidence.is_a?(String) ? evidence : JSON.pretty_generate(evidence) %></pre>
              </details>
            <% end %>
          </td>
        </tr>
      <% end %>
      </tbody>
    </table>
  </div>

  <% if edges.empty? %>
    <p class="mt-4 rounded-xl border border-dashed border-slate-200 p-5 text-sm leading-6 text-slate-500">
      No relationships were returned for this request. Review the graph filters and diagnostics before concluding that no relationships exist in the database.
    </p>
  <% end %>
</section>