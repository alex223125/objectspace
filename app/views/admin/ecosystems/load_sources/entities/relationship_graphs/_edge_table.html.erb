
<%
  edges = local_assigns[:edges] || []
  nodes = local_assigns[:nodes] || []

  read_value = lambda do |object, *keys|
    keys.each do |key|
      value =
        if object.respond_to?(:key?) && object.key?(key.to_s)
          object[key.to_s]
        elsif object.respond_to?(:key?) && object.key?(key.to_sym)
          object[key.to_sym]
        elsif object.respond_to?(key)
          object.public_send(key)
        end
      return value unless value.nil?
    end
    nil
  end

  node_names = {}
  nodes.each do |node|
    id = read_value.call(node, :id, :uuid, :key)
    name = read_value.call(node, :name, :label, :title, :display_name)
    node_names[id.to_s] = name if id.present? && name.present?
  end
%>

<section class="overflow-hidden rounded-[28px] border-2 border-slate-200 bg-white shadow-md"
         aria-labelledby="edge-table-title">
  <header class="border-b-2 border-slate-100 p-5 sm:p-6">
    <p class="text-sm font-black uppercase tracking-[0.16em] text-slate-500">Reference view</p>
    <div class="mt-2 flex flex-wrap items-center justify-between gap-3">
      <h2 id="edge-table-title" class="text-2xl font-black text-slate-900">Relationship table</h2>
      <span class="rounded-full border border-slate-200 bg-slate-50 px-4 py-2 text-sm font-bold text-slate-700">
        <%= number_with_delimiter(edges.size) %> rows
      </span>
    </div>
    <p class="mt-2 text-base leading-7 text-slate-600">
      Use this tabular view when you need to compare source entities, relationship types, and target entities side by side.
    </p>
  </header>

  <% if edges.any? %>
    <div class="overflow-x-auto">
      <table class="w-full min-w-[760px] border-collapse text-left">
        <thead class="bg-slate-50">
        <tr>
          <th scope="col" class="border-b border-slate-200 px-5 py-4 text-sm font-black uppercase tracking-wide text-slate-600">Source</th>
          <th scope="col" class="border-b border-slate-200 px-5 py-4 text-sm font-black uppercase tracking-wide text-slate-600">Relationship</th>
          <th scope="col" class="border-b border-slate-200 px-5 py-4 text-sm font-black uppercase tracking-wide text-slate-600">Target</th>
          <th scope="col" class="border-b border-slate-200 px-5 py-4 text-sm font-black uppercase tracking-wide text-slate-600">Identifier</th>
        </tr>
        </thead>

        <tbody class="divide-y divide-slate-100">
        <% edges.each do |edge| %>
          <%
            source = read_value.call(edge, :source, :source_id, :from, :from_id, :subject_id)
            target = read_value.call(edge, :target, :target_id, :to, :to_id, :object_id)

            source = read_value.call(source, :id, :uuid) if source.is_a?(Hash)
            target = read_value.call(target, :id, :uuid) if target.is_a?(Hash)

            source_name = node_names[source.to_s] || read_value.call(edge, :source_name, :from_name, :subject)
            target_name = node_names[target.to_s] || read_value.call(edge, :target_name, :to_name, :object)
            relation = read_value.call(edge, :type, :relationship_type, :predicate, :label)
            identifier = read_value.call(edge, :id, :uuid)
          %>

          <tr class="transition hover:bg-orange-50/40">
            <td class="max-w-[260px] break-words px-5 py-4 text-base font-semibold text-slate-800">
              <%= source_name.presence || source.presence || "Not supplied" %>
            </td>
            <td class="px-5 py-4">
                <span class="inline-flex rounded-full border border-sky-200 bg-sky-50 px-3 py-1.5 text-sm font-bold text-sky-800">
                  <%= relation.presence || "Unspecified" %>
                </span>
            </td>
            <td class="max-w-[260px] break-words px-5 py-4 text-base font-semibold text-slate-800">
              <%= target_name.presence || target.presence || "Not supplied" %>
            </td>
            <td class="max-w-[220px] break-all px-5 py-4 text-sm text-slate-500">
              <%= identifier.presence || "—" %>
            </td>
          </tr>
        <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="p-6">
      <p class="rounded-2xl border-2 border-dashed border-slate-200 bg-slate-50 p-6 text-base leading-7 text-slate-600">
        There are no relationship rows to display. The table will populate when the graph payload contains edges.
      </p>
    </div>
  <% end %>
</section>