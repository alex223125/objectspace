
<%
  nodes = local_assigns[:nodes] || []
  edges = local_assigns[:edges] || []

  read_value = lambda do |object, *keys|
    keys.each do |key|
      value =
        if object.respond_to?(:key?) && object.key?(key.to_s)
          object[key.to_s]
        elsif object.respond_to?(:key?) && object.key?(key.to_sym)
          object[key.to_sym]
        elsif object.respond_to?(key)
          object.public_send(key)
        end
      return value unless value.nil?
    end
    nil
  end

  entity_types = nodes.map { |node| read_value.call(node, :type, :entity_type, :category, :kind) }
                      .compact.map(&:to_s).reject(&:blank?).uniq.sort
  relationship_types = edges.map { |edge| read_value.call(edge, :type, :relationship_type, :predicate, :label) }
                            .compact.map(&:to_s).reject(&:blank?).uniq.sort
%>


<section
  class="overflow-hidden rounded-[28px] border-2 border-orange-100 bg-white shadow-md shadow-orange-100/20"
  data-controller="graph-drawer graph-filters"
  data-graph-drawer-open-value="true"
  aria-labelledby="graph-filters-title"
>
  <button
    type="button"
    data-action="click->graph-drawer#toggle"
    data-graph-drawer-target="toggle"
    aria-expanded="true"
    aria-controls="graph-filters-panel"
    class="flex min-h-16 w-full items-center justify-between gap-4 bg-gradient-to-r from-orange-50 to-white px-5 py-4 text-left transition hover:bg-orange-50 focus:outline-none focus-visible:ring-4 focus-visible:ring-orange-100 sm:px-6"
  >
    <span class="min-w-0">
      <span class="block text-sm font-black uppercase tracking-[0.16em] text-orange-700">
        Refine results
      </span>

      <span
        id="graph-filters-title"
        class="mt-1 block text-xl font-black text-slate-900"
      >
        Graph filters
      </span>

      <span class="mt-1 block text-sm leading-6 text-slate-600">
        Narrow your investigation without changing stored data.
      </span>
    </span>

    <span
      data-graph-drawer-target="icon"
      class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border-2 border-orange-200 bg-white text-xl font-bold text-orange-800 transition-transform"
      aria-hidden="true"
    >
      −
    </span>
  </button>

  <div
    id="graph-filters-panel"
    data-graph-drawer-target="panel"
    data-graph-filters-target="panel"
    class="border-t-2 border-orange-100 p-5 sm:p-6"
  >
    <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
      <div>
        <h3 class="text-sm font-bold text-slate-900">
          Filter criteria
        </h3>

        <p class="mt-1 text-sm text-slate-500">
          Combine entity and relationship types to narrow your results.
        </p>
      </div>

      <span
        data-graph-filters-target="activeBadge"
        class="inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-3 py-1.5 text-xs font-bold text-slate-700"
        aria-live="polite"
      >
        No active filters
      </span>
    </div>

    <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
      <div>
        <label
          for="graph-filter-entity-type"
          class="block text-sm font-semibold text-slate-800"
        >
          Entity type
        </label>

        <select
          id="graph-filter-entity-type"
          name="entity_type"
          data-graph-filters-target="entityType"
          data-action="change->graph-filters#preview"
          class="mt-2 min-h-12 w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 focus:border-orange-500 focus:outline-none focus:ring-4 focus:ring-orange-100"
        >
          <option value="">All entity types</option>
        </select>
      </div>

      <div>
        <label
          for="graph-filter-relationship-type"
          class="block text-sm font-semibold text-slate-800"
        >
          Relationship type
        </label>

        <select
          id="graph-filter-relationship-type"
          name="relationship_type"
          data-graph-filters-target="relationshipType"
          data-action="change->graph-filters#preview"
          class="mt-2 min-h-12 w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 focus:border-orange-500 focus:outline-none focus:ring-4 focus:ring-orange-100"
        >
          <option value="">All relationship types</option>
        </select>
      </div>
    </div>

    <div class="mt-5 flex flex-wrap items-center gap-3 border-t border-slate-100 pt-5">
      <button
        type="button"
        data-action="click->graph-filters#apply"
        class="inline-flex min-h-11 items-center justify-center gap-2 rounded-xl bg-orange-600 px-5 py-3 text-sm font-bold text-white transition hover:bg-orange-700 focus:outline-none focus-visible:ring-4 focus-visible:ring-orange-200"
      >
        <span aria-hidden="true">⌕</span>
        Apply filters
      </button>

      <button
        type="button"
        data-action="click->graph-filters#reset"
        class="inline-flex min-h-11 items-center justify-center rounded-xl border border-slate-300 bg-white px-5 py-3 text-sm font-bold text-slate-700 transition hover:bg-slate-50 focus:outline-none focus-visible:ring-4 focus-visible:ring-slate-200"
      >
        Clear filters
      </button>

      <span
        class="text-sm text-slate-500 md:ml-auto"
        data-graph-filters-target="resultCount"
        aria-live="polite"
        role="status"
      >
        Preparing filters…
      </span>
    </div>

    <p
      class="mt-4 text-sm leading-6 text-slate-500"
      data-graph-filters-target="message"
      aria-live="polite"
    >
      Filters only affect the current view. Stored entities and relationships remain unchanged.
    </p>
  </div>
</section>