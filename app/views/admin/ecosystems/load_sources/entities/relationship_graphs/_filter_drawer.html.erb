
<details class="mb-4 overflow-hidden rounded-2xl border border-slate-200 bg-white"
         data-controller="graph-filters">
  <summary class="cursor-pointer list-none bg-slate-50/70 px-5 py-4 transition hover:bg-orange-50/50">
    <span class="flex flex-wrap items-center justify-between gap-3">
      <span>
        <span class="block text-sm font-black text-slate-800">Graph filters</span>
        <span class="mt-1 block text-xs text-slate-500">Adjust the request scope and reload the graph.</span>
      </span>
      <span class="rounded-full border border-orange-100 bg-orange-50 px-3 py-1.5 text-xs font-bold text-orange-700">Configure →</span>
    </span>
  </summary>

  <form action="<%= request.path %>"
        method="get"
        class="grid gap-4 border-t border-slate-100 p-5 sm:grid-cols-2 xl:grid-cols-4">

    <label class="flex flex-col gap-2 text-xs font-bold text-slate-700">
      Entity search
      <input type="search"
             name="query"
             value="<%= params[:query] %>"
             placeholder="Optional keyword"
             class="rounded-xl border border-slate-200 px-3 py-3 text-sm font-normal"
             data-tooltip="A search term passed to your graph service. Its exact matching behavior depends on that service.">
    </label>

    <label class="flex flex-col gap-2 text-xs font-bold text-slate-700">
      Relationship state
      <select name="state" class="rounded-xl border border-slate-200 bg-white px-3 py-3 text-sm font-normal">
        <option value="">All states</option>
        <% %w[confirmed suggested rejected archived active].each do |state| %>
          <option value="<%= state %>" <%= "selected" if params[:state] == state %>><%= state.humanize %></option>
        <% end %>
      </select>
    </label>

    <label class="flex flex-col gap-2 text-xs font-bold text-slate-700">
      Relationship type
      <input type="text"
             name="relationship_type"
             value="<%= params[:relationship_type] %>"
             placeholder="Optional type"
             class="rounded-xl border border-slate-200 px-3 py-3 text-sm font-normal">
    </label>

    <label class="flex flex-col gap-2 text-xs font-bold text-slate-700">
      Maximum nodes
      <select name="limit" class="rounded-xl border border-slate-200 bg-white px-3 py-3 text-sm font-normal">
        <% [50, 100, 250, 500, 1000, 2000].each do |limit| %>
          <option value="<%= limit %>" <%= "selected" if (params[:limit].presence || "100").to_i == limit %>><%= limit %></option>
        <% end %>
      </select>
    </label>

    <div class="flex flex-wrap items-center gap-3 sm:col-span-2 xl:col-span-4">
      <button type="submit"
              class="rounded-xl bg-gradient-to-r from-orange-500 to-amber-500 px-5 py-3 text-sm font-black text-white shadow-sm transition hover:from-orange-600 hover:to-amber-600">
        Apply filters →
      </button>

      <a href="<%= request.path %>"
         class="rounded-xl border border-slate-200 bg-white px-5 py-3 text-sm font-bold text-slate-600 hover:bg-slate-50">
        Reset
      </a>

      <p class="text-xs leading-5 text-slate-400">
        Applying filters reloads this page. The server determines which records qualify.
      </p>
    </div>
  </form>
</details>