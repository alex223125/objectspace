
<section class="rounded-[28px] border-2 border-orange-100 bg-gradient-to-r from-orange-50/70 via-white to-emerald-50/40 p-5 sm:p-7"
         aria-labelledby="graph-legend-title">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <p class="text-sm font-black uppercase tracking-[0.16em] text-orange-700">Field guide</p>
      <h2 id="graph-legend-title" class="mt-1 text-2xl font-black text-slate-900">How to read the network</h2>
      <p class="mt-2 max-w-3xl text-base leading-7 text-slate-600">
        A graph is a map of recorded connections. The visual treatment helps you navigate it;
        it does not, by itself, establish that a relationship is verified or approved.
      </p>
    </div>
    <span class="w-fit rounded-full border border-orange-200 bg-white px-4 py-2 text-sm font-bold text-orange-800">Visual guide</span>
  </div>

  <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
    <% [
         ["🟠", "Entity node", "A record in your ecosystem. Select it to inspect the information available for that entity.", "border-orange-200 bg-orange-50"],
         ["🔗", "Relationship", "A recorded connection between two entities. Inspect its type and evidence when provided.", "border-sky-200 bg-sky-50"],
         ["🎯", "Current selection", "The entity you are investigating. Selection is a navigation aid, not a data change.", "border-violet-200 bg-violet-50"],
         ["🕸️", "Connected group", "A set of entities linked by one or more relationships in the displayed graph.", "border-emerald-200 bg-emerald-50"]
       ].each do |icon, title, description, classes| %>
      <article class="rounded-2xl border-2 p-4 sm:p-5 <%= classes %>">
        <div class="flex items-start gap-3">
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-white bg-white text-2xl shadow-sm" aria-hidden="true"><%= icon %></span>
          <div>
            <h3 class="text-lg font-black text-slate-900"><%= title %></h3>
            <p class="mt-2 text-base leading-7 text-slate-700"><%= description %></p>
          </div>
        </div>
      </article>
    <% end %>
  </div>
</section>