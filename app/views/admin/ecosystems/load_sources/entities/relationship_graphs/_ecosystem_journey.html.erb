
<%
  nodes = local_assigns[:nodes] || []
  edges = local_assigns[:edges] || []

  journey_steps = [
    {
      number: "01",
      title: "Find a starting entity",
      description: "Search for a familiar name, identifier, or category. Start with a record whose identity you can recognize.",
      color: "border-orange-200 bg-orange-50 text-orange-800"
    },
    {
      number: "02",
      title: "Inspect its connections",
      description: "Look at the relationship list and graph edges. Identify which entities are directly connected to your starting point.",
      color: "border-sky-200 bg-sky-50 text-sky-800"
    },
    {
      number: "03",
      title: "Examine the evidence",
      description: "Review available descriptions, source references, and provenance. Distinguish recorded facts from assumptions.",
      color: "border-violet-200 bg-violet-50 text-violet-800"
    },
    {
      number: "04",
      title: "Build a defensible interpretation",
      description: "Compare multiple connections, note missing information, and record conclusions only when the evidence supports them.",
      color: "border-emerald-200 bg-emerald-50 text-emerald-800"
    }
  ]
%>

<section class="overflow-hidden rounded-[28px] border-2 border-orange-100 bg-white shadow-lg shadow-orange-100/20"
         aria-labelledby="ecosystem-journey-title"
         data-controller="guided-tour">
  <header class="border-b-2 border-orange-100 bg-gradient-to-r from-orange-50/70 via-white to-amber-50/40 p-5 sm:p-7">
    <p class="text-sm font-black uppercase tracking-[0.16em] text-orange-700">Guided investigation</p>
    <h2 id="ecosystem-journey-title" class="mt-2 text-2xl font-black text-slate-900 sm:text-3xl">
      Your journey through the ecosystem
    </h2>
    <p class="mt-3 max-w-3xl text-base leading-7 text-slate-600">
      A reliable investigation moves from discovery to evidence. Follow these steps to explore the network
      without confusing a recorded connection with a proven conclusion.
    </p>
  </header>

  <div class="grid grid-cols-1 gap-4 p-5 sm:p-6 lg:grid-cols-2">
    <% journey_steps.each do |step| %>
      <article class="rounded-2xl border-2 border-slate-100 bg-white p-5 transition hover:border-orange-200 hover:shadow-md">
        <div class="flex items-start gap-4">
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl border text-base font-black <%= step[:color] %>">
            <%= step[:number] %>
          </span>
          <div>
            <h3 class="text-lg font-black text-slate-900"><%= step[:title] %></h3>
            <p class="mt-2 text-base leading-7 text-slate-600"><%= step[:description] %></p>
          </div>
        </div>
      </article>
    <% end %>
  </div>

  <div class="mx-5 mb-5 rounded-2xl border-2 border-emerald-100 bg-emerald-50/60 p-5 sm:mx-6 sm:mb-6">
    <h3 class="text-lg font-black text-emerald-950">Current snapshot</h3>
    <p class="mt-2 text-base leading-7 text-emerald-900">
      This view contains <strong><%= number_with_delimiter(nodes.size) %></strong> entities and
      <strong><%= number_with_delimiter(edges.size) %></strong> relationships.
      <% if nodes.empty? %>
        No entities are available yet, so begin by checking whether the graph service is returning data.
      <% elsif edges.empty? %>
        Entities are present, but no relationship edges were supplied in this snapshot.
      <% else %>
        You can begin with a known entity and trace the relationships represented in the current snapshot.
      <% end %>
    </p>
  </div>
</section>