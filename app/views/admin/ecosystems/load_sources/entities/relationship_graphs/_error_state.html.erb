<% error_message = local_assigns.fetch(:message, nil) %>
<% error_code = local_assigns.fetch(:error_code, nil) %>
<% retry_url = local_assigns.fetch(:retry_url, nil) %>

<section
  class="overflow-hidden rounded-[30px] border-2 border-red-200 bg-white shadow-lg shadow-red-100/30"
  aria-labelledby="graph-error-title"
  role="alert"
>
  <header class="border-b-2 border-red-100 bg-gradient-to-r from-red-50 via-white to-orange-50/50 p-5 sm:p-7">
    <div class="flex items-start gap-4">
      <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border-2 border-red-200 bg-red-100 text-2xl font-black text-red-700" aria-hidden="true">
        !
      </span>

      <div>
        <p class="text-sm font-black uppercase tracking-[0.16em] text-red-700">
          Graph unavailable
        </p>

        <h2 id="graph-error-title" class="mt-2 text-2xl font-black text-slate-900">
          We could not load this relationship graph
        </h2>

        <p class="mt-2 max-w-3xl text-base leading-7 text-slate-600">
          <%= error_message.presence || "The graph could not be prepared. Your existing records have not been changed by this display error." %>
        </p>
      </div>
    </div>
  </header>

  <div class="space-y-5 p-5 sm:p-7">
    <% if error_code.present? %>
      <div class="rounded-2xl border-2 border-slate-200 bg-slate-50 p-4">
        <p class="text-sm font-bold text-slate-600">Reference code</p>
        <p class="mt-1 break-all font-mono text-base font-bold text-slate-900">
          <%= error_code %>
        </p>
      </div>
    <% end %>

    <div class="rounded-2xl border-2 border-amber-100 bg-amber-50 p-5">
      <h3 class="text-lg font-black text-amber-900">
        Suggested troubleshooting
      </h3>

      <ul class="mt-3 space-y-2 text-base leading-7 text-amber-900">
        <li>• Check whether the graph endpoint responds successfully.</li>
        <li>• Inspect the server log for the underlying exception.</li>
        <li>• Verify that the payload contains valid node and edge arrays.</li>
        <li>• Check authorization and required database records.</li>
      </ul>
    </div>

    <div class="flex flex-col gap-3 sm:flex-row">
      <% if retry_url.present? %>
        <a
          href="<%= retry_url %>"
          class="inline-flex min-h-12 items-center justify-center rounded-xl border-2 border-orange-300 bg-orange-500 px-5 py-3 text-base font-black text-white transition hover:bg-orange-600 focus:outline-none focus:ring-4 focus:ring-orange-100"
        >
          Reload graph
        </a>
      <% end %>

      <button
        type="button"
        onclick="window.location.reload()"
        class="inline-flex min-h-12 items-center justify-center rounded-xl border-2 border-slate-200 bg-white px-5 py-3 text-base font-bold text-slate-700 transition hover:bg-slate-50 focus:outline-none focus:ring-4 focus:ring-slate-100"
      >
        Reload this page
      </button>
    </div>

    <p class="text-sm leading-6 text-slate-500">
      For security, do not render raw exception messages or stack traces in
      this template. Log technical details on the server and display a
      safe reference code when available.
    </p>
  </div>
</section>
