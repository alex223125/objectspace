
<section class="rounded-[26px] border border-slate-200 bg-white p-5 shadow-sm sm:p-7"
         aria-labelledby="graph-shortcuts-heading">

  <p class="text-[10px] font-black uppercase tracking-[0.18em] text-slate-500">Navigation reference</p>
  <h2 id="graph-shortcuts-heading" class="mt-1 text-lg font-black text-slate-900">Keyboard shortcuts</h2>
  <p class="mt-2 text-sm leading-6 text-slate-500">
    These are recommended keyboard conventions. A shortcut works only if the registered controller implements it.
  </p>

  <div class="mt-5 overflow-x-auto rounded-xl border border-slate-200">
    <table class="w-full text-left text-sm">
      <thead class="bg-slate-50 text-xs font-bold text-slate-500">
      <tr>
        <th scope="col" class="px-4 py-3">Key</th>
        <th scope="col" class="px-4 py-3">Action</th>
      </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
      <% [
           ["Tab", "Move focus between interactive controls."],
           ["Enter / Space", "Activate the focused button or control."],
           ["Escape", "Close a dismissible dialog when supported."],
           ["/", "Focus graph search when the keyboard controller enables it."],
           ["?", "Open keyboard help when the application implements it."]
         ].each do |key, action| %>
        <tr>
          <td class="px-4 py-3"><kbd class="rounded-lg border border-slate-200 bg-slate-50 px-2 py-1 text-xs font-black text-slate-700"><%= key %></kbd></td>
          <td class="px-4 py-3 text-xs leading-5 text-slate-600"><%= action %></td>
        </tr>
      <% end %>
      </tbody>
    </table>
  </div>
</section>