<section
  class="rounded-[28px] border-2 border-slate-200 bg-white p-5 shadow-lg shadow-slate-100/60 sm:p-7"
  aria-labelledby="keyboard-shortcuts-title"
  data-controller="graph-keyboard"
>
  <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <p class="text-sm font-black uppercase tracking-[0.16em] text-orange-700">
        Navigation guide
      </p>

      <h2 id="keyboard-shortcuts-title" class="mt-2 text-2xl font-black text-slate-900">
        Keyboard shortcuts
      </h2>

      <p class="mt-2 max-w-2xl text-base leading-7 text-slate-600">
        Navigate the relationship explorer with your keyboard. Shortcuts should
        remain inactive while you are typing in a form field.
      </p>
    </div>

    <span class="w-fit rounded-full border border-orange-200 bg-orange-50 px-4 py-2 text-sm font-bold text-orange-800">
      Accessibility
    </span>
  </div>

  <div class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-3">
    <% shortcuts = [
      ["?", "Show keyboard help", "Open the shortcut guide."],
      ["Esc", "Close a panel", "Dismiss an open drawer or dialog when supported."],
      ["↑ / ↓", "Move through results", "Navigate a focused list when supported."],
      ["Enter", "Activate selection", "Open the focused entity or action."],
      ["/", "Focus search", "Move focus to entity search when supported."],
      ["Tab", "Move focus", "Follow the accessible focus order."]
    ] %>

    <% shortcuts.each do |key, label, description| %>
      <article class="flex items-start gap-4 rounded-2xl border-2 border-slate-100 bg-gradient-to-br from-white to-slate-50 p-4 transition hover:border-orange-200 hover:shadow-md">
        <kbd class="inline-flex min-h-12 min-w-12 shrink-0 items-center justify-center rounded-xl border-2 border-slate-200 bg-white px-3 text-base font-black text-slate-800 shadow-sm">
          <%= key %>
        </kbd>

        <div>
          <h3 class="text-base font-black text-slate-900">
            <%= label %>
          </h3>

          <p class="mt-1 text-sm leading-6 text-slate-600">
            <%= description %>
          </p>
        </div>
      </article>
    <% end %>
  </div>

  <div class="mt-5 rounded-2xl border-2 border-sky-100 bg-sky-50 p-4">
    <p class="text-base font-bold text-sky-900">
      Helpful tip
    </p>

    <p class="mt-1 text-sm leading-6 text-sky-800">
      Keyboard commands depend on the actions implemented by your Stimulus
      controllers. The key descriptions above are guidance, not a guarantee
      that every shortcut is currently implemented.
    </p>
  </div>
</section>
