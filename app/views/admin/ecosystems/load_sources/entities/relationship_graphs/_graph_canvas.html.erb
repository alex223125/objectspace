
<%
  payload = local_assigns[:graph_payload] || {}
  nodes = payload[:nodes] || payload["nodes"] || []
  edges = payload[:edges] || payload["edges"] || []
%>

<section class="overflow-hidden rounded-[30px] border-2 border-orange-100 bg-white shadow-lg shadow-orange-100/30" aria-labelledby="graph-workspace-title">
  <%= render "graph_toolbar", graph_payload: payload %>

  <div class="relative overflow-hidden bg-gradient-to-b from-white via-orange-50/20 to-slate-50/60">
    <div class="pointer-events-none absolute inset-0 opacity-60" aria-hidden="true"
         style="background-image:radial-gradient(#fed7aa 1px,transparent 1px);background-size:24px 24px;"></div>

    <div class="relative flex flex-col gap-3 border-b border-orange-100 p-5 sm:flex-row sm:items-center sm:justify-between sm:p-6">
      <div>
        <h3 id="graph-workspace-title" class="text-xl font-black text-slate-900">Relationship network</h3>
        <p class="mt-2 max-w-2xl text-base leading-7 text-slate-600">
          Each node represents an entity. Lines represent relationships included in the current snapshot.
          Select a node to begin an investigation.
        </p>
      </div>

      <div class="flex flex-wrap gap-2">
        <span class="rounded-full border border-orange-200 bg-orange-50 px-3 py-2 text-sm font-bold text-orange-800">
          <%= nodes.size %> nodes
        </span>
        <span class="rounded-full border border-sky-200 bg-sky-50 px-3 py-2 text-sm font-bold text-sky-800">
          <%= edges.size %> edges
        </span>
      </div>
    </div>

    <div class="relative">
      <div class="overflow-x-auto">
        <svg data-graph-canvas-target="svg"
             viewBox="0 0 1000 650"
             role="group"
             aria-label="Interactive network of entities and relationships"
             class="block h-auto min-h-[420px] w-full"
             style="min-width:600px;max-height:850px;"
             preserveAspectRatio="xMidYMid meet">
          <rect x="0" y="0" width="1000" height="650" rx="24" fill="#fffdf9" aria-hidden="true"></rect>
          <g data-layer="relationships" aria-label="Relationships"></g>
          <g data-layer="entities" aria-label="Entities"></g>
        </svg>
      </div>

      <div data-graph-canvas-target="hint"
           aria-live="polite"
           aria-atomic="true"
           class="absolute bottom-4 left-4 right-4 rounded-2xl border-2 border-orange-200 bg-white/95 p-4 text-base font-semibold leading-7 text-slate-700 shadow-lg backdrop-blur sm:bottom-5 sm:left-5 sm:right-auto sm:max-w-lg">
        Choose an entity to explore its available details and connections.
      </div>
    </div>

    <div class="border-t-2 border-orange-100 bg-white p-5 sm:p-6">
      <label for="graph-entity-search" class="mb-2 block text-base font-bold text-slate-800">
        Find an entity
      </label>

      <div class="relative">
        <span class="pointer-events-none absolute inset-y-0 left-4 flex items-center text-xl text-slate-400" aria-hidden="true">⌕</span>
        <input id="graph-entity-search"
               type="search"
               autocomplete="off"
               placeholder="Search by name, identifier, type, or summary…"
               data-graph-canvas-target="search"
               data-action="input->graph-canvas#search"
               class="min-h-14 w-full rounded-2xl border-2 border-slate-200 bg-slate-50 py-3 pl-12 pr-4 text-base text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-orange-400 focus:bg-white focus:ring-4 focus:ring-orange-100">
      </div>

      <p class="mt-3 text-base leading-7 text-slate-600">
        Tip: Try a distinctive entity name or identifier first. Narrow the results before inspecting individual connections.
      </p>
    </div>
  </div>
</section>