
<%
  graph = local_assigns[:graph] || {}
  nodes = graph[:nodes] || graph["nodes"] || []
  edges = graph[:edges] || graph["edges"] || []
  nodes = [] unless nodes.is_a?(Array)
  edges = [] unless edges.is_a?(Array)
%>

<section class="overflow-hidden rounded-2xl border border-slate-200 bg-slate-50/70"
         aria-labelledby="graph-canvas-heading"
         data-relationship-graph-target="canvas"
         data-graph-export-data-value="<%= json_escape(graph.to_json) %>">

  <div class="flex flex-wrap items-start justify-between gap-3 border-b border-slate-200 bg-white p-4 sm:p-5">
    <div>
      <h3 id="graph-canvas-heading" class="text-sm font-black text-slate-900">Relationship canvas</h3>
      <p class="mt-1 text-xs leading-5 text-slate-500">
        Inspect the entities and relationship endpoints returned by the graph service.
      </p>
    </div>

    <div class="flex gap-2 text-xs font-bold">
      <span class="rounded-full border border-indigo-100 bg-indigo-50 px-3 py-1.5 text-indigo-700"><%= nodes.size %> nodes</span>
      <span class="rounded-full border border-emerald-100 bg-emerald-50 px-3 py-1.5 text-emerald-700"><%= edges.size %> edges</span>
    </div>
  </div>

  <div class="grid gap-4 p-4 sm:p-5 xl:grid-cols-2">
    <section class="min-w-0 rounded-xl border border-slate-200 bg-white p-4">
      <h4 class="text-xs font-black uppercase tracking-wider text-slate-500">Entities</h4>

      <% if nodes.any? %>
        <ul class="mt-3 max-h-[420px] space-y-2 overflow-y-auto">
          <% nodes.each do |node| %>
            <%
              node = node.respond_to?(:to_h) ? node.to_h : {}
              id = node[:id] || node["id"]
              name = node[:name] || node["name"] ||
                node[:label] || node["label"] || "Unnamed entity"
              description = node[:description] || node["description"] ||
                node[:summary] || node["summary"]
            %>
            <li class="rounded-xl border border-slate-100 p-3 transition hover:border-orange-200 hover:bg-orange-50/30"
                data-graph-node-id="<%= id %>"
                data-tooltip="Entity ID: <%= id.presence || 'not provided' %>">
              <p class="break-words text-sm font-bold text-slate-800"><%= name %></p>
              <% if id.present? %>
                <p class="mt-1 break-all font-mono text-[10px] text-slate-400">ID: <%= id %></p>
              <% end %>
              <% if description.present? %>
                <p class="mt-2 text-xs leading-5 text-slate-500"><%= description %></p>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="mt-3 text-sm text-slate-500">No entities were returned.</p>
      <% end %>
    </section>

    <section class="min-w-0 rounded-xl border border-slate-200 bg-white p-4">
      <h4 class="text-xs font-black uppercase tracking-wider text-slate-500">Relationship connections</h4>

      <% if edges.any? %>
        <ul class="mt-3 max-h-[420px] space-y-2 overflow-y-auto">
          <% edges.each do |edge| %>
            <%
              edge = edge.respond_to?(:to_h) ? edge.to_h : {}
              source_id = edge[:source] || edge["source"] || edge[:source_id] || edge["source_id"]
              target_id = edge[:target] || edge["target"] || edge[:target_id] || edge["target_id"]
              kind = edge[:relationship_kind] || edge["relationship_kind"] ||
                edge[:kind] || edge["kind"] || "Relationship"
              state = edge[:state] || edge["state"] || "Not provided"
            %>
            <li class="rounded-xl border border-slate-100 p-3"
                data-tooltip="Source: <%= source_id %>. Target: <%= target_id %>.">
              <p class="text-sm font-bold text-slate-800"><%= kind.to_s.humanize %></p>
              <p class="mt-2 break-all font-mono text-[10px] leading-5 text-slate-500">
                <%= source_id.presence || "Missing source" %>
                <span class="px-1 text-orange-500">→</span>
                <%= target_id.presence || "Missing target" %>
              </p>
              <span class="mt-2 inline-flex rounded-full border border-slate-200 bg-slate-50 px-2 py-1 text-[10px] font-bold text-slate-600">
                <%= state.to_s.humanize %>
              </span>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="mt-3 text-sm text-slate-500">No relationship edges were returned.</p>
      <% end %>
    </section>
  </div>

  <div class="border-t border-slate-200 bg-white px-4 py-3 text-[11px] leading-5 text-slate-400">
    This data inspector displays service output. It does not itself create, modify, or approve relationships.
  </div>
</section>