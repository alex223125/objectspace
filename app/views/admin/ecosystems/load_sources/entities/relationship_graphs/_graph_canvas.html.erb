
<%
  raw_payload = graph_payload || {}
  payload = raw_payload.respond_to?(:as_json) ? raw_payload.as_json : {}
  payload = payload.deep_stringify_keys if payload.respond_to?(:deep_stringify_keys)
  payload = {} unless payload.is_a?(Hash)

  nodes = payload["nodes"] || payload["entities"] || []
  edges = payload["edges"] || payload["relationships"] || []
  meta = payload["meta"].is_a?(Hash) ? payload["meta"] : {}

  nodes = nodes.select { |item| item.is_a?(Hash) }
  edges = edges.select { |item| item.is_a?(Hash) }

  graph_json = {
    nodes: nodes,
    edges: edges,
    meta: meta
  }.to_json

  node_count = meta["node_count"] || nodes.size
  edge_count = meta["edge_count"] || edges.size
%>

<section
  id="graph-fullscreen-workspace"
  class="graph-workspace"
  data-controller="graph-workspace"
  data-graph-workspace-graph-value="<%= graph_json %>"
  aria-labelledby="network-section-title"
>
  <%= render "admin/ecosystems/load_sources/entities/relationship_graphs/graph_toolbar", node_count: node_count, relationship_count: edge_count %>

  <div class="graph-workspace-body">
    <aside class="graph-sidebar" aria-label="Graph navigation and controls">
      <div class="graph-sidebar-section">
        <p class="graph-sidebar-heading">Explore your ecosystem</p>

        <label class="graph-search-label" for="graph-node-search">
          Search entities
        </label>

        <input
          id="graph-node-search"
          type="search"
          placeholder="Search names, IDs, types..."
          autocomplete="off"
          class="graph-search"
          data-graph-workspace-target="search"
          data-action="input->graph-workspace#search"
        >

        <p class="graph-sidebar-help">
          Search highlights matching entities and dims unrelated nodes.
        </p>
      </div>

      <div class="graph-sidebar-section">
        <p class="graph-sidebar-heading">Graph layout</p>

        <button type="button" class="graph-tool-button"
                data-action="click->graph-workspace#layoutForce">
          <span aria-hidden="true">✳</span>
          Force-directed
        </button>

        <button type="button" class="graph-tool-button"
                data-action="click->graph-workspace#layoutCircle">
          <span aria-hidden="true">◉</span>
          Circular layout
        </button>

        <button type="button" class="graph-tool-button"
                data-action="click->graph-workspace#layoutGrid">
          <span aria-hidden="true">▦</span>
          Grid layout
        </button>
      </div>

      <div class="graph-sidebar-section">
        <p class="graph-sidebar-heading">Display options</p>

        <label class="graph-check">
          <input
            type="checkbox"
            checked
            data-graph-workspace-target="labels"
            data-action="change->graph-workspace#toggleLabels"
          >
          Show node labels
        </label>

        <label class="graph-check">
          <input
            type="checkbox"
            checked
            data-graph-workspace-target="edgesToggle"
            data-action="change->graph-workspace#toggleEdges"
          >
          Show relationships
        </label>

        <label class="graph-check">
          <input
            type="checkbox"
            data-graph-workspace-target="isolateToggle"
            data-action="change->graph-workspace#toggleIsolate"
          >
          Focus selected entity
        </label>
      </div>

      <div class="graph-sidebar-section">
        <p class="graph-sidebar-heading">Navigation</p>

        <div class="graph-zoom-row">
          <button type="button" class="graph-tool-button graph-zoom-button"
                  aria-label="Zoom out"
                  data-action="click->graph-workspace#zoomOut">−</button>

          <button type="button" class="graph-tool-button graph-zoom-button"
                  aria-label="Zoom in"
                  data-action="click->graph-workspace#zoomIn">+</button>

          <button type="button" class="graph-tool-button graph-fit-button"
                  data-action="click->graph-workspace#fit">
            Fit graph
          </button>
        </div>

        <button type="button" class="graph-tool-button"
                data-action="click->graph-workspace#clearSelection">
          Clear selection
        </button>
      </div>

      <div class="graph-sidebar-footer">
        <span class="graph-status-dot" aria-hidden="true"></span>
        <span data-graph-workspace-target="status">
          Initializing graph…
        </span>
      </div>
    </aside>

    <main class="graph-stage" aria-label="Interactive relationship graph">
      <div class="graph-stage-topline">
        <div>
          <span class="graph-stage-label">NETWORK CANVAS</span>
          <span class="graph-stage-subtitle"
                data-graph-workspace-target="layoutStatus">
            Force-directed layout
          </span>
        </div>

        <span class="graph-stage-count"
              data-graph-workspace-target="visibleCount">
          <%= nodes.size %> nodes
        </span>
      </div>

      <div
        class="graph-canvas"
        data-graph-workspace-target="canvas"
        role="group"
        aria-label="Interactive network. Select a node to inspect its properties. Use the mouse wheel to zoom and drag the background to pan."
      ></div>

      <div class="graph-stage-controls" aria-label="Graph navigation">
        <button type="button" title="Zoom out" aria-label="Zoom out"
                data-action="click->graph-workspace#zoomOut">−</button>
        <button type="button" title="Zoom in" aria-label="Zoom in"
                data-action="click->graph-workspace#zoomIn">+</button>
        <button type="button" title="Fit graph to view"
                data-action="click->graph-workspace#fit">Fit</button>
      </div>

      <div class="graph-minimap-note">
        <span aria-hidden="true">⌖</span>
        Scroll to zoom · Drag background to pan · Select a node to inspect
      </div>

      <div class="graph-empty-state hidden"
           data-graph-workspace-target="emptyState"
           role="status">
        <span class="graph-empty-icon" aria-hidden="true">◎</span>
        <strong data-graph-workspace-target="emptyTitle">
          No graph elements found
        </strong>
        <p data-graph-workspace-target="emptyMessage">
          Check the graph payload and relationship filters.
        </p>
      </div>
    </main>

    <aside class="graph-inspector" aria-label="Entity and relationship inspector">
      <div class="graph-inspector-header">
        <div>
          <p class="graph-sidebar-heading">Details panel</p>
          <h3 class="graph-inspector-title">Entity inspector</h3>
        </div>

        <span class="graph-selection-badge"
              data-graph-workspace-target="selectionStatus">
          Nothing selected
        </span>
      </div>

      <div class="graph-inspector-content"
           data-graph-workspace-target="inspector"
           aria-live="polite">
        <div class="graph-inspector-placeholder">
          <span class="graph-inspector-symbol" aria-hidden="true">◎</span>
          <strong>Select an entity</strong>
          <p>
            Select any node in the graph to inspect its attributes,
            relationships, status, and available evidence.
          </p>
        </div>
      </div>
    </aside>
  </div>
</section>