
<%
  metrics = local_assigns[:metrics] || {}

  read_metric = lambda do |*keys|
    keys.each do |key|
      value = metrics[key]
      value = metrics[key.to_s] if value.nil?
      return value unless value.nil?
    end
    nil
  end

  cards = [
    ["Registered entities", [:entity_count, :total_entities], "Entity records reported by the metrics service.", "🌐", "orange"],
    ["Persisted relationships", [:relationship_count, :total_relationships], "Relationship records reported by the metrics service.", "🔗", "sky"],
    ["Connected entities", [:connected_entities, :connected_entity_count], "Entities reported as connected.", "🕸️", "violet"],
    ["Isolated entities", [:isolated_entities, :isolated_entity_count], "Entities reported without eligible connections.", "◉", "emerald"]
  ]
%>

<section aria-label="Ecosystem overview">
  <div class="mb-4">
    <p class="text-[10px] font-black uppercase tracking-[0.18em] text-orange-600">Ecosystem at a glance</p>
    <h2 class="mt-1 text-lg font-black text-slate-900">Overview metrics</h2>
  </div>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
    <% cards.each do |label, keys, description, icon, color| %>
      <% value = read_metric.call(*keys) %>
      <article class="rounded-[24px] border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
               data-tooltip="<%= description %>">
        <div class="flex items-start justify-between gap-3">
          <p class="text-xs font-bold text-slate-500"><%= label %></p>
          <span class="flex h-10 w-10 items-center justify-center rounded-2xl bg-<%= color %>-50 text-lg">
            <%= icon %>
          </span>
        </div>

        <p class="mt-4 text-3xl font-black tracking-tight text-slate-900">
          <%= value.nil? ? "—" : number_with_delimiter(value) %>
        </p>

        <p class="mt-2 text-xs leading-5 text-slate-500">
          <%= value.nil? ? "Not provided by the metrics service." : description %>
        </p>
      </article>
    <% end %>
  </div>
</section>