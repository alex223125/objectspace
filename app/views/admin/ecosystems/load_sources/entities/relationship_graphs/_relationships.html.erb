
<% graph_payload = local_assigns[:graph_payload] || @graph_payload || @graph_data || {} %>
<% graph_payload = graph_payload.as_json if graph_payload.respond_to?(:as_json) %>
<% graph_payload = graph_payload.stringify_keys if graph_payload.respond_to?(:stringify_keys) %>

<% supplied_relationships = local_assigns[:relationships] || local_assigns[:edges] %>

<% if supplied_relationships.nil? %>
  <% supplied_relationships = graph_payload["edges"] || graph_payload[:edges] %>
<% end %>

<% supplied_relationships ||= @relationships || @edges || [] %>
<% supplied_relationships = supplied_relationships.to_a if supplied_relationships.respond_to?(:to_a) && !supplied_relationships.is_a?(Array) %>
<% supplied_relationships = [] unless supplied_relationships.is_a?(Array) %>

<section class="space-y-5"
         aria-label="Relationship analysis">

  <div class="rounded-[28px] border-2 border-orange-100 bg-gradient-to-r from-white via-orange-50/40 to-emerald-50/30 p-5 shadow-md shadow-orange-100/30 sm:p-6">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex items-start gap-4">
        <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl border border-orange-200 bg-orange-100 text-xl">
          🔗
        </div>

        <div>
          <p class="text-xs font-black uppercase tracking-[0.18em] text-orange-600">
            Relationship intelligence
          </p>

          <h2 class="mt-1 text-xl font-black text-slate-900 sm:text-2xl">
            Connections and relationships
          </h2>

          <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600">
            Inspect relationship records, their direction, their status, and any supplied descriptions.
          </p>
        </div>
      </div>

      <div class="flex flex-wrap gap-2">
        <span class="rounded-xl border border-sky-200 bg-white px-4 py-2 text-sm font-black text-sky-800">
          <%= supplied_relationships.size %> records
        </span>
      </div>
    </div>
  </div>

  <%= render "relationship_list", relationships: supplied_relationships %>

</section>