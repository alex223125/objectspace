
<%
  entity = local_assigns[:entity]

  read_value = lambda do |object, *keys|
    next nil if object.nil?

    keys.each do |key|
      value =
        if object.respond_to?(:key?) && object.key?(key.to_s)
          object[key.to_s]
        elsif object.respond_to?(:key?) && object.key?(key.to_sym)
          object[key.to_sym]
        elsif object.respond_to?(key)
          object.public_send(key)
        end

      return value unless value.nil?
    end

    nil
  end

  entity_name = read_value.call(entity, :name, :label, :title, :display_name)
  entity_id = read_value.call(entity, :id, :uuid, :key)
  entity_type = read_value.call(entity, :type, :entity_type, :category, :kind)
  entity_description = read_value.call(entity, :description, :summary, :notes)
%>

<aside
  class="overflow-hidden rounded-[28px] border-2 border-violet-100 bg-gradient-to-b from-white via-violet-50/20 to-white shadow-lg shadow-violet-100/30"
  aria-labelledby="entity-dossier-title"
  aria-live="polite"
>
  <header class="border-b-2 border-violet-100 bg-gradient-to-r from-violet-50 to-white p-5 sm:p-6">
    <p class="text-sm font-black uppercase tracking-[0.16em] text-violet-700">
      Entity profile
    </p>

    <h2 id="entity-dossier-title" class="mt-2 text-2xl font-black text-slate-900">
      Entity dossier
    </h2>

    <p class="mt-2 text-base leading-7 text-slate-600">
      Inspect the selected record, its classification, and available metadata.
    </p>
  </header>

  <div class="p-5 sm:p-6">
    <div data-graph-selection-target="dossier">
      <% if entity.present? %>
        <div class="rounded-2xl border-2 border-violet-100 bg-white p-5">
          <h3 class="break-words text-xl font-black text-slate-900">
            <%= entity_name.presence || "Unnamed entity" %>
          </h3>

          <% if entity_type.present? %>
            <span class="mt-3 inline-flex rounded-full border border-violet-200 bg-violet-50 px-3 py-1.5 text-sm font-bold text-violet-800">
              <%= entity_type %>
            </span>
          <% end %>

          <p class="mt-4 whitespace-pre-wrap break-words text-base leading-7 text-slate-700">
            <%= entity_description.presence || "No description is available for this entity." %>
          </p>

          <% if entity_id.present? %>
            <dl class="mt-5 border-t border-slate-100 pt-4">
              <dt class="text-sm font-bold uppercase tracking-wide text-slate-500">
                Identifier
              </dt>
              <dd class="mt-1 break-all text-base text-slate-800">
                <%= entity_id %>
              </dd>
            </dl>
          <% end %>
        </div>
      <% else %>
        <div class="rounded-2xl border-2 border-dashed border-violet-200 bg-white p-6 text-center">
          <span class="text-4xl" aria-hidden="true">🔎</span>
          <h3 class="mt-3 text-xl font-black text-slate-900">
            Select an entity to investigate
          </h3>
          <p class="mt-2 text-base leading-7 text-slate-600">
            Choose a record from the directory to display its details here.
          </p>
        </div>
      <% end %>
    </div>

    <div class="mt-5 rounded-2xl border border-slate-200 bg-slate-50 p-4">
      <h3 class="text-base font-bold text-slate-900">
        Investigation checklist
      </h3>

      <ul class="mt-3 space-y-2 text-base leading-7 text-slate-600">
        <li>• Confirm the entity's identity and classification.</li>
        <li>• Review its recorded relationships.</li>
        <li>• Check available evidence and provenance before drawing conclusions.</li>
      </ul>
    </div>
  </div>
</aside>