
<%
  entity = local_assigns[:entity]
  entity = entity.to_h if entity.respond_to?(:to_h)
  entity = {} unless entity.is_a?(Hash)

  read = lambda do |*keys|
    keys.each do |key|
      value = entity[key]
      value = entity[key.to_s] if value.nil?
      return value unless value.nil?
    end
    nil
  end

  entity_id = read.call(:id)
  entity_name = read.call(:name, :label) || "Unnamed entity"
  entity_description = read.call(:description, :summary)
%>

<section class="rounded-[26px] border border-orange-100 bg-white p-5 shadow-sm"
         aria-labelledby="entity-dossier-heading">

  <p class="text-[10px] font-black uppercase tracking-[0.18em] text-orange-600">Entity profile</p>
  <h2 id="entity-dossier-heading" class="mt-1 text-lg font-black text-slate-900"><%= entity_name %></h2>

  <% if entity_id.present? %>
    <p class="mt-2 break-all font-mono text-xs text-slate-400">ID: <%= entity_id %></p>
  <% end %>

  <% if entity_description.present? %>
    <p class="mt-4 text-sm leading-7 text-slate-600"><%= entity_description %></p>
  <% else %>
    <p class="mt-4 text-sm leading-7 text-slate-500">No description was provided for this entity.</p>
  <% end %>
</section>