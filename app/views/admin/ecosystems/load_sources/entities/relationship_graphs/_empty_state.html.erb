<% nodes = local_assigns.fetch(:nodes, []) || [] %>
<% edges = local_assigns.fetch(:edges, []) || [] %>
<% message = local_assigns.fetch(:message, nil) %>

<section
  class="overflow-hidden rounded-[30px] border-2 border-orange-100 bg-gradient-to-b from-white via-orange-50/40 to-slate-50/70 p-6 shadow-lg shadow-orange-100/30 sm:p-10"
  aria-labelledby="graph-empty-title"
  role="status"
>
  <div class="mx-auto max-w-3xl text-center">
    <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-[28px] border-2 border-orange-200 bg-gradient-to-br from-orange-100 to-amber-50 text-4xl shadow-md shadow-orange-100/60" aria-hidden="true">
      🌐
    </div>

    <p class="mt-6 text-sm font-black uppercase tracking-[0.18em] text-orange-700">
      Knowledge graph workspace
    </p>

    <h2 id="graph-empty-title" class="mt-3 text-2xl font-black tracking-tight text-slate-900 sm:text-3xl">
      Your graph is ready to explore
    </h2>

    <p class="mx-auto mt-4 max-w-2xl text-base leading-7 text-slate-600">
      <% if message.present? %>
        <%= message %>
      <% elsif nodes.empty? && edges.empty? %>
        There are no entities or relationships in the current graph snapshot.
        Once your graph data is available, this workspace can help you explore
        records, inspect connections, and understand the structure of your ecosystem.
      <% else %>
        The current graph has no entities to display. Review the available
        filters and graph data before continuing.
      <% end %>
    </p>

    <div class="mt-7 grid grid-cols-1 gap-3 text-left sm:grid-cols-3">
      <article class="rounded-2xl border-2 border-orange-100 bg-white p-4">
        <p class="text-sm font-bold text-slate-600">Entities</p>
        <p class="mt-2 text-3xl font-black text-orange-700"><%= nodes.size %></p>
        <p class="mt-2 text-sm leading-6 text-slate-500">
          Records available in this view.
        </p>
      </article>

      <article class="rounded-2xl border-2 border-sky-100 bg-white p-4">
        <p class="text-sm font-bold text-slate-600">Relationships</p>
        <p class="mt-2 text-3xl font-black text-sky-700"><%= edges.size %></p>
        <p class="mt-2 text-sm leading-6 text-slate-500">
          Connections available in this view.
        </p>
      </article>

      <article class="rounded-2xl border-2 border-emerald-100 bg-white p-4">
        <p class="text-sm font-bold text-slate-600">Next step</p>
        <p class="mt-2 text-lg font-black text-emerald-700">Inspect data</p>
        <p class="mt-2 text-sm leading-6 text-slate-500">
          Check source records, filters, and graph generation.
        </p>
      </article>
    </div>

    <div class="mt-7 rounded-2xl border-2 border-slate-200 bg-white p-5 text-left">
      <h3 class="text-lg font-black text-slate-900">
        What to check
      </h3>

      <ul class="mt-3 space-y-2 text-base leading-7 text-slate-600">
        <li>• Confirm that the graph service returns a <code>nodes</code> array.</li>
        <li>• Check whether active filters are excluding all records.</li>
        <li>• Verify that entity IDs and relationship endpoints match.</li>
        <li>• Review application logs if graph generation failed.</li>
      </ul>
    </div>
  </div>
</section>
