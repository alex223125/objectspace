
<section class="rounded-[26px] border-2 border-dashed border-orange-200 bg-gradient-to-b from-orange-50/50 to-white p-8 text-center sm:p-12"
         role="status"
         aria-labelledby="graph-empty-title">

  <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-[24px] border border-orange-200 bg-white text-3xl shadow-sm">🧭</div>

  <p class="mt-5 text-[10px] font-black uppercase tracking-[0.2em] text-orange-600">Exploration workspace</p>
  <h3 id="graph-empty-title" class="mt-2 text-xl font-black text-slate-900">Your knowledge graph starts here</h3>

  <p class="mx-auto mt-3 max-w-xl text-sm leading-7 text-slate-500">
    The request completed, but no nodes were returned. Check the active filters, graph scope, and service output before concluding that the database has no entities.
  </p>

  <div class="mx-auto mt-6 grid max-w-2xl gap-3 text-left sm:grid-cols-3">
    <% [
         ["01 · Filters", "Clear search and broaden the requested scope."],
         ["02 · Records", "Verify that eligible entity records exist."],
         ["03 · Services", "Inspect the graph response and Rails logs."]
       ].each do |title, description| %>
      <article class="rounded-xl border border-slate-200 bg-white p-4">
        <p class="text-xs font-black text-slate-800"><%= title %></p>
        <p class="mt-2 text-xs leading-5 text-slate-500"><%= description %></p>
      </article>
    <% end %>
  </div>

  <button type="button"
          class="mt-6 rounded-xl border border-orange-200 bg-white px-5 py-3 text-sm font-black text-orange-700 hover:bg-orange-50"
          data-action="click->relationship-graph#reload">
    Reload graph →
  </button>
</section>