
<%
  diagnostics = local_assigns[:diagnostics] || []
  diagnostics = [diagnostics] if diagnostics.is_a?(Hash) || diagnostics.is_a?(String)

  read_value = lambda do |object, *keys|
    next nil if object.nil?

    keys.each do |key|
      value =
        if object.respond_to?(:key?) && object.key?(key.to_s)
          object[key.to_s]
        elsif object.respond_to?(:key?) && object.key?(key.to_sym)
          object[key.to_sym]
        elsif object.respond_to?(key)
          object.public_send(key)
        end

      return value unless value.nil?
    end

    nil
  end
%>

<section class="overflow-hidden rounded-[28px] border-2 border-violet-100 bg-white shadow-lg shadow-violet-100/20"
         aria-labelledby="graph-diagnostics-title">
  <header class="border-b-2 border-violet-100 bg-gradient-to-r from-violet-50/80 via-white to-amber-50/40 p-5 sm:p-7">
    <p class="text-sm font-black uppercase tracking-[0.16em] text-violet-800">Investigation tools</p>
    <h2 id="graph-diagnostics-title" class="mt-2 text-2xl font-black text-slate-900 sm:text-3xl">
      Graph diagnostics
    </h2>
    <p class="mt-3 max-w-3xl text-base leading-7 text-slate-600">
      Inspect diagnostic findings returned by the graph service. Findings may help identify missing data,
      unexpected graph structure, or incomplete metadata, depending on which checks your application implements.
    </p>
  </header>

  <% if diagnostics.any? %>
    <div class="space-y-4 p-5 sm:p-6">
      <% diagnostics.each_with_index do |diagnostic, index| %>
        <%
          title = read_value.call(diagnostic, :title, :name, :code, :type)
          message = read_value.call(diagnostic, :message, :description, :details, :summary)
          severity = read_value.call(diagnostic, :severity, :level, :status)
          recommendation = read_value.call(diagnostic, :recommendation, :suggestion, :remediation)
          record_id = read_value.call(diagnostic, :record_id, :entity_id, :relationship_id)

          severity_classes =
            case severity.to_s.downcase
            when "critical", "error", "high"
              "border-rose-200 bg-rose-50 text-rose-800"
            when "warning", "medium"
              "border-amber-200 bg-amber-50 text-amber-900"
            when "info", "low"
              "border-sky-200 bg-sky-50 text-sky-800"
            else
              "border-slate-200 bg-slate-50 text-slate-700"
            end
        %>

        <article class="rounded-2xl border-2 border-slate-100 bg-white p-5">
          <div class="flex items-start gap-4">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-violet-200 bg-violet-50 text-base font-black text-violet-800">
              <%= index + 1 %>
            </span>

            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-center gap-3">
                <h3 class="text-lg font-black text-slate-900">
                  <%= title.presence || "Diagnostic finding" %>
                </h3>

                <% if severity.present? %>
                  <span class="rounded-full border px-3 py-1.5 text-sm font-bold <%= severity_classes %>">
                    <%= severity.to_s.humanize %>
                  </span>
                <% end %>
              </div>

              <p class="mt-3 text-base leading-7 text-slate-600">
                <%= message.presence || (diagnostic.is_a?(String) ? diagnostic : "No diagnostic message was supplied.") %>
              </p>

              <% if recommendation.present? %>
                <div class="mt-4 rounded-xl border border-emerald-100 bg-emerald-50/50 p-4">
                  <h4 class="text-sm font-black uppercase tracking-wide text-emerald-900">Suggested investigation</h4>
                  <p class="mt-2 text-base leading-7 text-slate-700"><%= recommendation %></p>
                </div>
              <% end %>

              <% if record_id.present? %>
                <p class="mt-3 break-all text-sm text-slate-500">Related record: <%= record_id %></p>
              <% end %>
            </div>
          </div>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="p-5 sm:p-7">
      <div class="rounded-2xl border-2 border-dashed border-violet-200 bg-violet-50/40 p-6">
        <h3 class="text-xl font-black text-slate-900">No diagnostic findings supplied</h3>
        <p class="mt-2 text-base leading-7 text-slate-600">
          The graph service has not supplied any diagnostic records for this view.
          This is not proof that the graph has passed every integrity, completeness, or consistency check.
        </p>
      </div>
    </div>
  <% end %>
</section>