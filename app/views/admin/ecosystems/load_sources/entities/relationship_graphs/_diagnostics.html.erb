
<%
  diagnostics = local_assigns[:diagnostics] || {}
  metrics = local_assigns[:metrics] || {}
  graph_loaded = local_assigns.fetch(:graph_loaded, true)

  read_value = lambda do |hash, *keys|
    keys.each do |key|
      value = hash[key]
      value = hash[key.to_s] if value.nil?
      return value unless value.nil?
    end
    nil
  end

  checks = [
    ["Entities", [:entity_count, :total_entities]],
    ["Relationships", [:relationship_count, :total_relationships]],
    ["Confirmed", [:confirmed_count, :confirmed_relationships]],
    ["Suggested", [:suggested_count, :suggested_relationships]],
    ["Rejected", [:rejected_count, :rejected_relationships]],
    ["Archived", [:archived_count, :archived_relationships]],
    ["Isolated entities", [:isolated_entity_count, :isolated_entities]],
    ["Self-links", [:self_link_count, :self_links]],
    ["Missing endpoint IDs", [:missing_endpoint_count, :missing_endpoint_ids]],
    ["Endpoints not found", [:orphan_endpoint_count, :endpoints_not_found]],
    ["Missing confidence", [:missing_confidence_count, :missing_confidence]],
    ["Low confidence", [:low_confidence_count]]
  ]
%>

<section class="rounded-[26px] border border-slate-200 bg-white p-5 shadow-sm sm:p-7"
         aria-labelledby="graph-diagnostics-heading">

  <p class="text-[10px] font-black uppercase tracking-[0.18em] text-violet-700">Data quality</p>
  <h2 id="graph-diagnostics-heading" class="mt-1 text-xl font-black text-slate-900">Graph diagnostics</h2>
  <p class="mt-2 text-sm leading-6 text-slate-500">
    Review available counts and consistency indicators. These values are supplied by your services, not inferred by the view.
  </p>

  <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3 xl:grid-cols-4">
    <% checks.each do |label, keys| %>
      <% value = read_value.call(diagnostics, *keys) %>
      <% value = read_value.call(metrics, *keys) if value.nil? %>

      <article class="rounded-2xl border border-slate-200 bg-slate-50/70 p-4"
               data-tooltip="<%= label %>: a service-reported diagnostic, not an independent database audit.">
        <p class="text-xs font-bold text-slate-500"><%= label %></p>
        <p class="mt-2 text-2xl font-black text-slate-900">
          <%= value.nil? ? "—" : number_with_delimiter(value) %>
        </p>
        <% if value.nil? %>
          <p class="mt-1 text-[10px] text-slate-400">Not reported</p>
        <% end %>
      </article>
    <% end %>
  </div>

  <div class="mt-5 rounded-2xl bg-slate-900 p-5 text-white">
    <h3 class="text-sm font-black">Administrator interpretation guide</h3>
    <ul class="mt-3 list-disc space-y-2 pl-5 text-xs leading-6 text-slate-300">
      <li>Isolated entities may be legitimate records without eligible connections.</li>
      <li>Missing endpoints can indicate inconsistent relationship data or endpoints excluded by graph scope.</li>
      <li>Missing confidence is only a defect if your domain requires that value.</li>
      <li>Compare counts only when their relationship states and scopes match.</li>
      <li>A dash means the service did not supply a value; it does not mean zero.</li>
    </ul>
  </div>

  <p class="mt-4 text-xs leading-5 text-slate-400">
    Graph request: <%= graph_loaded ? "rendered" : "failed" %>.
    Diagnostic counts may still be available even when the graph service fails.
  </p>
</section>