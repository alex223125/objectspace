
<%
  candidates = local_assigns[:candidates] || []
  candidates = [] unless candidates.is_a?(Array)
%>

<section class="rounded-[26px] border border-amber-200 bg-gradient-to-br from-white via-amber-50/30 to-white p-5 shadow-sm sm:p-7"
         aria-labelledby="candidate-connections-heading">

  <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <p class="text-[10px] font-black uppercase tracking-[0.18em] text-amber-700">Discovery workspace</p>
      <h2 id="candidate-connections-heading" class="mt-1 text-xl font-black text-slate-900">Potential connections</h2>
      <p class="mt-2 max-w-3xl text-sm leading-6 text-slate-500">
        Candidate connections are exploratory suggestions. They should be reviewed against evidence and domain knowledge before being saved as trusted relationships.
      </p>
    </div>

    <span class="w-fit rounded-full border border-amber-200 bg-amber-50 px-3 py-1.5 text-xs font-black text-amber-800">
      <%= candidates.size %> candidates
    </span>
  </div>

  <% if candidates.any? %>
    <div class="mt-5 grid gap-3 lg:grid-cols-2">
      <% candidates.each do |raw_candidate| %>
        <%
          candidate = raw_candidate.respond_to?(:to_h) ? raw_candidate.to_h : {}
          source = candidate[:source_name] || candidate["source_name"] ||
            candidate[:source] || candidate["source"] || "Unknown source"
          target = candidate[:target_name] || candidate["target_name"] ||
            candidate[:target] || candidate["target"] || "Unknown target"
          reason = candidate[:reason] || candidate["reason"] ||
            candidate[:explanation] || candidate["explanation"]
          score = candidate[:confidence] || candidate["confidence"] ||
            candidate[:score] || candidate["score"]
        %>

        <article class="rounded-2xl border border-amber-100 bg-white p-4">
          <div class="flex items-start gap-3">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-amber-50 text-lg">✦</span>
            <div class="min-w-0 flex-1">
              <p class="break-words text-sm font-black text-slate-800"><%= source %></p>
              <p class="my-1 text-xs font-bold text-amber-600">may relate to ↓</p>
              <p class="break-words text-sm font-black text-slate-800"><%= target %></p>

              <% if reason.present? %>
                <p class="mt-3 text-xs leading-6 text-slate-500"><%= reason %></p>
              <% end %>

              <% if score.present? %>
                <p class="mt-3 text-xs font-bold text-slate-500">Reported score: <%= score %></p>
              <% end %>
            </div>
          </div>

          <p class="mt-4 border-t border-amber-100 pt-3 text-[10px] leading-5 text-amber-800">
            Suggested connection · Not automatically confirmed
          </p>
        </article>
      <% end %>
    </div>
  <% else %>
    <p class="mt-5 rounded-2xl border border-dashed border-amber-200 bg-white/80 p-5 text-sm leading-6 text-slate-500">
      No candidates were returned by the discovery service. This does not establish that the remaining entities are unrelated.
    </p>
  <% end %>
</section>