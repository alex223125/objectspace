
<%
  candidates = local_assigns[:candidates] || []

  read_value = lambda do |object, *keys|
    next nil if object.nil?
    keys.each do |key|
      value =
        if object.respond_to?(:key?) && object.key?(key.to_s)
          object[key.to_s]
        elsif object.respond_to?(:key?) && object.key?(key.to_sym)
          object[key.to_sym]
        elsif object.respond_to?(key)
          object.public_send(key)
        end
      return value unless value.nil?
    end
    nil
  end
%>

<section class="overflow-hidden rounded-[28px] border-2 border-amber-100 bg-white shadow-lg shadow-amber-100/20"
         aria-labelledby="candidate-connections-title"
         data-controller="graph-evidence graph-review">
  <header class="border-b-2 border-amber-100 bg-gradient-to-r from-amber-50/80 via-white to-orange-50/40 p-5 sm:p-7">
    <p class="text-sm font-black uppercase tracking-[0.16em] text-amber-800">Discovery workspace</p>
    <div class="mt-2 flex flex-wrap items-center justify-between gap-3">
      <h2 id="candidate-connections-title" class="text-2xl font-black text-slate-900 sm:text-3xl">
        Candidate connections
      </h2>
      <span class="rounded-full border border-amber-200 bg-white px-4 py-2 text-sm font-bold text-amber-900">
        <%= number_with_delimiter(candidates.size) %> candidates
      </span>
    </div>
    <p class="mt-3 max-w-3xl text-base leading-7 text-slate-600">
      Candidate connections are possible associations that may deserve investigation.
      They are not established relationships merely because they appear in this section.
    </p>
  </header>

  <% if candidates.any? %>
    <div class="space-y-4 p-5 sm:p-6">
      <% candidates.each_with_index do |candidate, index| %>
        <%
          source_name = read_value.call(candidate, :source_name, :from_name, :source, :subject)
          target_name = read_value.call(candidate, :target_name, :to_name, :target, :object)
          relation = read_value.call(candidate, :type, :relationship_type, :predicate, :label)
          explanation = read_value.call(candidate, :reason, :explanation, :description, :summary)
          confidence = read_value.call(candidate, :confidence, :score)
          evidence = read_value.call(candidate, :evidence, :evidence_summary)
          candidate_id = read_value.call(candidate, :id, :uuid)
        %>

        <article class="rounded-2xl border-2 border-amber-100 bg-white p-5 transition hover:border-amber-300 hover:shadow-md">
          <div class="flex items-start gap-4">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-amber-200 bg-amber-50 text-lg font-black text-amber-900" aria-hidden="true">
              <%= index + 1 %>
            </span>

            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-center gap-2">
                <span class="break-words text-base font-bold text-slate-900"><%= source_name.presence || "Source not specified" %></span>
                <span class="text-amber-700" aria-hidden="true">→</span>
                <span class="break-words text-base font-bold text-slate-900"><%= target_name.presence || "Target not specified" %></span>
              </div>

              <% if relation.present? %>
                <span class="mt-3 inline-flex rounded-full border border-amber-200 bg-amber-50 px-3 py-1.5 text-sm font-bold text-amber-900">
                  <%= relation %>
                </span>
              <% end %>

              <p class="mt-3 text-base leading-7 text-slate-600">
                <%= explanation.presence || "No explanation was supplied. Inspect the underlying evidence before evaluating this candidate." %>
              </p>

              <% if confidence.present? %>
                <p class="mt-3 text-sm font-semibold text-slate-600">
                  Supplied confidence or score: <%= confidence %>
                </p>
              <% end %>

              <% if evidence.present? %>
                <div class="mt-4 rounded-xl border border-sky-100 bg-sky-50/60 p-4">
                  <h3 class="text-sm font-black uppercase tracking-wide text-sky-900">Available evidence</h3>
                  <p class="mt-2 text-base leading-7 text-slate-700"><%= evidence %></p>
                </div>
              <% end %>

              <% if candidate_id.present? %>
                <p class="mt-3 break-all text-sm text-slate-500">Candidate ID: <%= candidate_id %></p>
              <% end %>
            </div>
          </div>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="p-5 sm:p-6">
      <div class="rounded-2xl border-2 border-dashed border-amber-200 bg-amber-50/40 p-6 sm:p-8">
        <span class="text-4xl" aria-hidden="true">🧭</span>
        <h3 class="mt-3 text-xl font-black text-slate-900">No candidate connections supplied</h3>
        <p class="mt-2 max-w-2xl text-base leading-7 text-slate-600">
          The current page has no candidate records to review. To populate this section, have your graph service
          return a candidate collection and assign it to <code>@candidate_connections</code>.
          This template intentionally avoids inventing possible relationships.
        </p>
      </div>
    </div>
  <% end %>

  <footer class="border-t border-amber-100 bg-amber-50/40 p-5 sm:p-6">
    <p class="text-base leading-7 text-amber-950">
      <strong>Review principle:</strong> A candidate should be supported by inspectable evidence and an explicit
      review process before it becomes a stored relationship. This template does not create, approve, or persist candidates.
    </p>
  </footer>
</section>