
<%
  payload = local_assigns[:graph_payload] || {}
  nodes = payload[:nodes] || payload["nodes"] || []
  edges = payload[:edges] || payload["edges"] || []
%>

<header class="border-b-2 border-orange-100 bg-gradient-to-r from-orange-50/70 via-white to-amber-50/40 p-5 sm:p-7">
  <div class="flex flex-col gap-5 2xl:flex-row 2xl:items-center 2xl:justify-between">
    <div class="min-w-0">
      <div class="flex items-center gap-3">
        <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl border-2 border-orange-200 bg-orange-100 text-xl" aria-hidden="true">🕸️</span>
        <div>
          <p class="text-sm font-black uppercase tracking-[0.16em] text-orange-700">Interactive workspace</p>
          <h2 class="mt-1 text-2xl font-black text-slate-900">Knowledge explorer</h2>
        </div>
      </div>

      <p class="mt-3 max-w-3xl text-base leading-7 text-slate-600">
        Fit the network into view, clear your current selection, or download the snapshot for further analysis.
      </p>
    </div>

    <div class="flex flex-wrap gap-3">
      <button
        type="button"
        data-action="click->graph-canvas#fit"
        class="inline-flex min-h-12 items-center justify-center gap-2 rounded-xl border-2 border-orange-300 bg-gradient-to-r from-orange-500 to-amber-400 px-5 py-3 text-base font-bold text-white shadow-md transition hover:-translate-y-0.5 hover:shadow-lg focus:outline-none focus:ring-4 focus:ring-orange-200">
        <span aria-hidden="true">⤢</span> Fit graph
      </button>

      <button type="button"
              data-action="graph-canvas#reset"
              class="inline-flex min-h-12 items-center justify-center gap-2 rounded-xl border-2 border-slate-200 bg-white px-5 py-3 text-base font-bold text-slate-700 transition hover:border-violet-300 hover:bg-violet-50 focus:outline-none focus:ring-4 focus:ring-violet-100">
        <span aria-hidden="true">↺</span> Reset selection
      </button>

      <button type="button"
              data-action="click->graph-export#exportJSON"
              class="inline-flex min-h-12 items-center justify-center gap-2 rounded-xl border-2 border-sky-200 bg-sky-50 px-5 py-3 text-base font-bold text-sky-800 transition hover:bg-sky-100 focus:outline-none focus:ring-4 focus:ring-sky-100">
        <span aria-hidden="true">↓</span> Export JSON
      </button>
    </div>
  </div>

  <div class="mt-5 flex flex-wrap gap-3">
    <span class="rounded-full border border-orange-200 bg-white px-4 py-2 text-sm font-bold text-orange-800">
      <%= number_with_delimiter(nodes.size) %> entities
    </span>
    <span class="rounded-full border border-sky-200 bg-sky-50 px-4 py-2 text-sm font-bold text-sky-800">
      <%= number_with_delimiter(edges.size) %> relationships
    </span>
    <span class="rounded-full border border-emerald-200 bg-emerald-50 px-4 py-2 text-sm font-bold text-emerald-800">
      Read-only mode
    </span>
  </div>
</header>