
<header class="graph-workspace-toolbar">
  <div class="graph-workspace-brand">
    <span class="graph-brand-icon" aria-hidden="true">◈</span>

    <div>
      <p class="graph-eyebrow">OBJECTSPACE / KNOWLEDGE INTELLIGENCE</p>
      <h2 id="network-section-title">Relationship Explorer</h2>
      <p class="graph-toolbar-subtitle">
        Explore entities, connections, and ecosystem structure.
      </p>
    </div>
  </div>

  <div class="graph-toolbar-actions">
    <div class="graph-stat">
      <strong><%= number_with_delimiter(node_count) %></strong>
      <span>Entities</span>
    </div>

    <div class="graph-stat">
      <strong><%= number_with_delimiter(relationship_count) %></strong>
      <span>Relationships</span>
    </div>

    <span class="graph-toolbar-divider" aria-hidden="true"></span>

    <button type="button"
            class="graph-toolbar-button"
            data-action="click->graph-workspace#fit">
      <span aria-hidden="true">⛶</span>
      Fit view
    </button>

    <button
      type="button"
      class="graph-toolbar-button graph-primary-button"
      data-graph-workspace-target="fullscreenButton"
      data-action="click->graph-workspace#toggleFullscreen"
    >
      <span aria-hidden="true">⛶</span>
      Enter fullscreen
    </button>
  </div>
</header>