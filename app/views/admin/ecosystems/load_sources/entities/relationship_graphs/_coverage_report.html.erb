
<%
  coverage = local_assigns[:coverage] || local_assigns[:meta] || {}
  coverage = coverage.as_json if coverage.respond_to?(:as_json)
  coverage = coverage.stringify_keys if coverage.respond_to?(:stringify_keys)

  coverage = {} unless coverage.respond_to?(:[])

  nodes_count = coverage["node_count"] || coverage["nodes_count"]
  edges_count = coverage["edge_count"] || coverage["edges_count"]
  connected = coverage["connected_node_count"] || coverage["connected_entities"]
  isolated = coverage["isolated_node_count"] || coverage["isolated_entities"]
  total_sources = coverage["source_count"] || coverage["total_sources"]
  missing_sources = coverage["missing_source_count"] || coverage["entities_without_sources"]
  coverage_percent = coverage["coverage_percent"] || coverage["coverage_percentage"]
%>

<section class="overflow-hidden rounded-[28px] border-2 border-sky-100 bg-white shadow-lg shadow-sky-100/20"
         aria-labelledby="graph-coverage-title">
  <header class="border-b-2 border-sky-100 bg-gradient-to-r from-sky-50/80 via-white to-emerald-50/40 p-5 sm:p-7">
    <p class="text-sm font-black uppercase tracking-[0.16em] text-sky-800">Data completeness</p>
    <h2 id="graph-coverage-title" class="mt-2 text-2xl font-black text-slate-900 sm:text-3xl">
      Graph coverage report
    </h2>
    <p class="mt-3 max-w-3xl text-base leading-7 text-slate-600">
      Understand which parts of the supplied graph are represented and where information may be missing.
      Coverage figures are only shown when the backend supplies them; unknown values are not estimated.
    </p>
  </header>

  <div class="grid grid-cols-1 gap-4 p-5 sm:grid-cols-2 sm:p-6 xl:grid-cols-3">
    <% [
         ["Entities", nodes_count, "Records represented in the current graph", "border-orange-200 bg-orange-50/50 text-orange-800"],
         ["Relationships", edges_count, "Connections included in this snapshot", "border-sky-200 bg-sky-50/50 text-sky-800"],
         ["Connected entities", connected, "Entities reported as connected", "border-emerald-200 bg-emerald-50/50 text-emerald-800"],
         ["Isolated entities", isolated, "Entities reported without visible connections", "border-violet-200 bg-violet-50/50 text-violet-800"],
         ["Known sources", total_sources, "Source records reported by the backend", "border-amber-200 bg-amber-50/50 text-amber-900"],
         ["Missing source references", missing_sources, "Records reported without source references", "border-rose-200 bg-rose-50/50 text-rose-800"]
       ].each do |label, value, description, colors| %>
      <article class="rounded-2xl border-2 p-5 <%= colors %>">
        <h3 class="text-base font-bold"><%= label %></h3>
        <p class="mt-3 text-3xl font-black tabular-nums">
          <%= value.nil? ? "—" : number_with_delimiter(value) %>
        </p>
        <p class="mt-2 text-sm leading-6 opacity-90"><%= description %></p>
      </article>
    <% end %>
  </div>

  <% if coverage_percent.present? %>
    <div class="mx-5 mb-5 rounded-2xl border-2 border-sky-100 bg-sky-50/50 p-5 sm:mx-6 sm:mb-6">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h3 class="text-lg font-black text-slate-900">Reported coverage</h3>
        <span class="text-2xl font-black tabular-nums text-sky-800"><%= coverage_percent %>%</span>
      </div>
      <p class="mt-2 text-base leading-7 text-slate-600">
        This percentage is supplied by the backend. Its precise meaning depends on the coverage calculation
        implemented by your application.
      </p>
    </div>
  <% end %>

  <footer class="border-t border-sky-100 bg-sky-50/40 p-5 sm:p-6">
    <p class="text-base leading-7 text-slate-700">
      <strong>Interpretation:</strong> A missing value means the metric was not supplied.
      An isolated entity is not automatically an invalid record, and missing provenance does not prove that a source never existed.
    </p>
  </footer>
</section>