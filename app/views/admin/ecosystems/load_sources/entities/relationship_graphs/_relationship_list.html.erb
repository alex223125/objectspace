
<%
  relationships = local_assigns[:relationships] || []
  relationships = [] unless relationships.is_a?(Array)
%>

<div class="space-y-3" aria-label="Relationship list">
  <% relationships.each do |raw_relationship| %>
    <%
      relationship = raw_relationship.respond_to?(:to_h) ? raw_relationship.to_h : {}
      name = relationship[:entity_name] || relationship["entity_name"] ||
        relationship[:name] || relationship["name"] || "Unnamed entity"
      kind = relationship[:relationship_kind] || relationship["relationship_kind"] || "Relationship"
      direction = relationship[:direction] || relationship["direction"]
      confidence = relationship[:confidence_percent] || relationship["confidence_percent"]
    %>

    <article class="rounded-xl border border-slate-200 bg-white p-4">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <h3 class="text-sm font-bold text-slate-800"><%= name %></h3>
        <span class="rounded-full bg-orange-50 px-2.5 py-1 text-xs font-bold text-orange-700"><%= kind.to_s.humanize %></span>
      </div>

      <% if direction.present? %>
        <p class="mt-2 text-xs text-slate-500">Direction: <%= direction.to_s.humanize %></p>
      <% end %>

      <% unless confidence.nil? %>
        <p class="mt-2 text-xs text-slate-500">Reported confidence: <%= confidence %>%</p>
      <% end %>
    </article>
  <% end %>

  <% if relationships.empty? %>
    <p class="rounded-xl border border-dashed border-slate-200 p-4 text-sm text-slate-500">No relationships available.</p>
  <% end %>
</div>