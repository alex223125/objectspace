
<%
  relationships = local_assigns[:relationships] || []
  nodes = local_assigns[:nodes] || []

  read_value = lambda do |object, *keys|
    keys.each do |key|
      value =
        if object.respond_to?(:key?) && object.key?(key.to_s)
          object[key.to_s]
        elsif object.respond_to?(:key?) && object.key?(key.to_sym)
          object[key.to_sym]
        elsif object.respond_to?(key)
          object.public_send(key)
        end
      return value unless value.nil?
    end
    nil
  end

  node_names = {}
  nodes.each do |node|
    id = read_value.call(node, :id, :uuid, :key)
    name = read_value.call(node, :name, :label, :title, :display_name)
    node_names[id.to_s] = name if id.present? && name.present?
  end
%>

<section class="overflow-hidden rounded-[28px] border-2 border-sky-100 bg-white shadow-lg shadow-sky-100/20"
         aria-labelledby="relationship-list-title">
  <header class="border-b-2 border-sky-100 bg-gradient-to-r from-sky-50/80 to-white p-5 sm:p-6">
    <p class="text-sm font-black uppercase tracking-[0.16em] text-sky-800">Connections explorer</p>
    <div class="mt-2 flex flex-wrap items-center justify-between gap-3">
      <h2 id="relationship-list-title" class="text-2xl font-black text-slate-900">Recorded relationships</h2>
      <span class="rounded-full border border-sky-200 bg-white px-4 py-2 text-sm font-bold text-sky-800">
        <%= number_with_delimiter(relationships.size) %> connections
      </span>
    </div>
    <p class="mt-2 max-w-3xl text-base leading-7 text-slate-600">
      Each entry describes a connection represented in the supplied graph data. Review the source and evidence
      before treating a connection as authoritative.
    </p>
  </header>

  <% if relationships.any? %>
    <div class="divide-y divide-slate-100">
      <% relationships.each_with_index do |edge, index| %>
        <%
          source_id = read_value.call(edge, :source, :source_id, :from, :from_id, :subject_id)
          target_id = read_value.call(edge, :target, :target_id, :to, :to_id, :object_id)

          source_id = read_value.call(source_id, :id, :uuid) if source_id.is_a?(Hash)
          target_id = read_value.call(target_id, :id, :uuid) if target_id.is_a?(Hash)

          source_name = node_names[source_id.to_s] || read_value.call(edge, :source_name, :from_name, :subject)
          target_name = node_names[target_id.to_s] || read_value.call(edge, :target_name, :to_name, :object)

          relation_type = read_value.call(edge, :type, :relationship_type, :predicate, :label, :name)
          edge_description = read_value.call(edge, :description, :summary, :evidence_summary)
          edge_id = read_value.call(edge, :id, :uuid)
        %>

        <article class="p-5 transition hover:bg-sky-50/30 sm:p-6">
          <div class="flex items-start gap-4">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-sky-200 bg-sky-50 text-lg font-black text-sky-800" aria-hidden="true">
              <%= index + 1 %>
            </span>

            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-center gap-2">
                <span class="break-words text-base font-bold text-slate-900"><%= source_name.presence || source_id.presence || "Source not supplied" %></span>
                <span class="text-sky-700" aria-label="connects to">→</span>
                <span class="break-words text-base font-bold text-slate-900"><%= target_name.presence || target_id.presence || "Target not supplied" %></span>
              </div>

              <% if relation_type.present? %>
                <span class="mt-3 inline-flex rounded-full border border-sky-200 bg-sky-50 px-3 py-1.5 text-sm font-bold text-sky-800">
                  <%= relation_type %>
                </span>
              <% end %>

              <% if edge_description.present? %>
                <p class="mt-3 text-base leading-7 text-slate-600"><%= edge_description %></p>
              <% else %>
                <p class="mt-3 text-base leading-7 text-slate-500">
                  No relationship description was supplied for this entry.
                </p>
              <% end %>

              <% if edge_id.present? %>
                <p class="mt-3 break-all text-sm text-slate-500">Relationship ID: <%= edge_id %></p>
              <% end %>
            </div>
          </div>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="p-6 sm:p-8">
      <div class="rounded-2xl border-2 border-dashed border-sky-200 bg-sky-50/40 p-6 text-center">
        <span class="text-4xl" aria-hidden="true">🔗</span>
        <h3 class="mt-3 text-xl font-black text-slate-900">No relationships in this snapshot</h3>
        <p class="mx-auto mt-2 max-w-2xl text-base leading-7 text-slate-600">
          The current payload contains no relationship entries. This may mean the selected scope has no recorded
          connections or that the graph service returned an empty result.
        </p>
      </div>
    </div>
  <% end %>
</section>