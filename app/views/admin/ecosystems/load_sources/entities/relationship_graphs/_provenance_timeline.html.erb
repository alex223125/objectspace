
<%
  diagnostics = local_assigns[:diagnostics] || {}
  events = diagnostics[:provenance_events] || diagnostics["provenance_events"] || []
  events = [] unless events.is_a?(Array)
%>

<section class="rounded-[26px] border border-slate-200 bg-white p-5 shadow-sm sm:p-7"
         aria-labelledby="provenance-timeline-heading">

  <p class="text-[10px] font-black uppercase tracking-[0.18em] text-violet-700">Relationship history</p>
  <h2 id="provenance-timeline-heading" class="mt-1 text-lg font-black text-slate-900">Relationship provenance</h2>
  <p class="mt-2 text-sm leading-6 text-slate-500">
    Provenance records where a relationship came from, why it was proposed, and what evidence supports it.
  </p>

  <% if events.any? %>
    <ol class="mt-6 space-y-4">
      <% events.each do |raw_event| %>
        <%
          event = raw_event.respond_to?(:to_h) ? raw_event.to_h : {}
          title = event[:title] || event["title"] || event[:event_type] || event["event_type"] || "Provenance event"
          detail = event[:description] || event["description"] || event[:message] || event["message"]
          occurred_at = event[:occurred_at] || event["occurred_at"] || event[:created_at] || event["created_at"]
          actor = event[:actor] || event["actor"]
        %>
        <li class="relative border-l-2 border-violet-100 pl-5">
          <span class="absolute -left-[7px] top-1 h-3 w-3 rounded-full border-2 border-violet-400 bg-white"></span>
          <p class="text-sm font-black text-slate-800"><%= title.to_s.humanize %></p>
          <% if occurred_at.present? %>
            <p class="mt-1 text-[10px] text-slate-400"><%= occurred_at %></p>
          <% end %>
          <% if actor.present? %>
            <p class="mt-1 text-xs text-slate-500">Actor: <%= actor %></p>
          <% end %>
          <% if detail.present? %>
            <p class="mt-2 text-xs leading-6 text-slate-500"><%= detail %></p>
          <% end %>
        </li>
      <% end %>
    </ol>
  <% else %>
    <p class="mt-5 rounded-xl border border-dashed border-slate-200 p-5 text-sm leading-6 text-slate-500">
      No provenance events were provided. The history may be unavailable or not yet recorded by your application.
    </p>
  <% end %>
</section>