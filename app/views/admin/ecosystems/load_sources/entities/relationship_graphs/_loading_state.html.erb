<% loading_message = local_assigns.fetch(:message, "Preparing your relationship graph…") %>

<section
  class="overflow-hidden rounded-[30px] border-2 border-orange-100 bg-white p-5 shadow-lg shadow-orange-100/20 sm:p-8"
  aria-labelledby="graph-loading-title"
  aria-busy="true"
  role="status"
>
  <div class="flex items-start gap-4">
    <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border-2 border-orange-200 bg-orange-50 text-2xl" aria-hidden="true">
      <span class="inline-block animate-spin">⟳</span>
    </div>

    <div class="min-w-0">
      <p class="text-sm font-black uppercase tracking-[0.16em] text-orange-700">
        Please wait
      </p>

      <h2 id="graph-loading-title" class="mt-2 text-xl font-black text-slate-900 sm:text-2xl">
        Loading relationship explorer
      </h2>

      <p class="mt-2 text-base leading-7 text-slate-600">
        <%= loading_message %>
      </p>
    </div>
  </div>

  <div class="mt-7 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4" aria-hidden="true">
    <% 4.times do %>
      <div class="animate-pulse rounded-2xl border-2 border-slate-100 bg-slate-50 p-5">
        <div class="h-4 w-2/3 rounded-lg bg-slate-200"></div>
        <div class="mt-5 h-9 w-1/2 rounded-lg bg-slate-200"></div>
        <div class="mt-5 h-3 w-full rounded-lg bg-slate-100"></div>
      </div>
    <% end %>
  </div>

  <div class="mt-6 animate-pulse rounded-2xl border-2 border-orange-100 bg-orange-50/40 p-5" aria-hidden="true">
    <div class="h-5 w-1/3 rounded-lg bg-orange-100"></div>
    <div class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-3">
      <% 3.times do %>
        <div class="h-24 rounded-2xl border border-orange-100 bg-white"></div>
      <% end %>
    </div>
  </div>

  <p class="mt-5 text-sm leading-6 text-slate-500">
    If loading does not complete, check the graph request, server logs, and
    browser console. This visual state does not automatically retry failed requests.
  </p>
</section>
