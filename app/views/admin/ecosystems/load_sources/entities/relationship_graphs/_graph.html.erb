
<%
  graph = local_assigns[:graph] || {}
  graph = graph.to_h if graph.respond_to?(:to_h)
  graph = {} unless graph.is_a?(Hash)

  nodes = graph[:nodes] || graph["nodes"] || []
  edges = graph[:edges] || graph["edges"] || []
  nodes = [] unless nodes.is_a?(Array)
  edges = [] unless edges.is_a?(Array)

  if nodes.any?
    graph = graph.merge(
      nodes: nodes,
      edges: edges
    )
  end
%>

<% if local_assigns[:error].present? %>
  <%= render "error_state", error: local_assigns[:error] %>
<% elsif nodes.any? %>
  <%= render "graph_canvas", graph: graph %>
<% else %>
  <%= render "empty_state" %>
<% end %>