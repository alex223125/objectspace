
<%
  changes = local_assigns[:changes] || local_assigns[:change_feed] || []

  read_value = lambda do |object, *keys|
    next nil if object.nil?

    keys.each do |key|
      value =
        if object.respond_to?(:key?) && object.key?(key.to_s)
          object[key.to_s]
        elsif object.respond_to?(:key?) && object.key?(key.to_sym)
          object[key.to_sym]
        elsif object.respond_to?(key)
          object.public_send(key)
        end

      return value unless value.nil?
    end

    nil
  end

  ordered_changes = changes.to_a.sort_by do |change|
    read_value.call(change, :created_at, :occurred_at, :timestamp).to_s
  end.reverse
%>

<section class="overflow-hidden rounded-[28px] border-2 border-emerald-100 bg-white shadow-lg shadow-emerald-100/20"
         aria-labelledby="graph-change-feed-title"
         data-controller="graph-live-updates">
  <header class="border-b-2 border-emerald-100 bg-gradient-to-r from-emerald-50/80 via-white to-sky-50/40 p-5 sm:p-7">
    <p class="text-sm font-black uppercase tracking-[0.16em] text-emerald-800">Activity history</p>
    <h2 id="graph-change-feed-title" class="mt-2 text-2xl font-black text-slate-900 sm:text-3xl">
      Graph change feed
    </h2>
    <p class="mt-3 max-w-3xl text-base leading-7 text-slate-600">
      Review changes reported by your application. This feed is a presentation of supplied records;
      it does not subscribe to live events unless your Stimulus controller implements that connection.
    </p>
  </header>

  <% if ordered_changes.any? %>
    <div class="divide-y divide-emerald-100">
      <% ordered_changes.each do |change| %>
        <%
          action_name = read_value.call(change, :action, :event_type, :change_type, :kind)
          description = read_value.call(change, :description, :summary, :message, :details)
          timestamp = read_value.call(change, :created_at, :occurred_at, :timestamp)
          actor = read_value.call(change, :actor_name, :user_name, :actor)
          record_id = read_value.call(change, :entity_id, :relationship_id, :record_id)
        %>

        <article class="p-5 transition hover:bg-emerald-50/30 sm:p-6">
          <div class="flex items-start gap-4">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-emerald-200 bg-emerald-50 text-xl text-emerald-800" aria-hidden="true">
              ↻
            </span>

            <div class="min-w-0 flex-1">
              <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
                <h3 class="text-lg font-black text-slate-900">
                  <%= action_name.present? ? action_name.to_s.humanize : "Graph activity" %>
                </h3>

                <% if timestamp.present? %>
                  <time class="text-sm font-semibold text-slate-500">
                    <%= timestamp.respond_to?(:strftime) ? timestamp.strftime("%d %b %Y, %H:%M") : timestamp %>
                  </time>
                <% end %>
              </div>

              <p class="mt-2 text-base leading-7 text-slate-600">
                <%= description.presence || "No additional details were supplied for this change." %>
              </p>

              <div class="mt-3 flex flex-wrap gap-x-5 gap-y-2 text-sm text-slate-500">
                <% if actor.present? %>
                  <span>By: <strong class="text-slate-700"><%= actor %></strong></span>
                <% end %>

                <% if record_id.present? %>
                  <span class="break-all">Record ID: <%= record_id %></span>
                <% end %>
              </div>
            </div>
          </div>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="p-5 sm:p-7">
      <div class="rounded-2xl border-2 border-dashed border-emerald-200 bg-emerald-50/40 p-6">
        <h3 class="text-xl font-black text-slate-900">No changes supplied</h3>
        <p class="mt-2 text-base leading-7 text-slate-600">
          When your controller provides recorded graph changes, they will appear here.
          This empty state does not imply that no changes have ever occurred.
        </p>
      </div>
    </div>
  <% end %>
</section>