
<%
  manual_sections = [
    {
      title: "Finding an entity",
      icon: "🔎",
      description: "Use the entity directory and search controls to narrow the visible records.",
      instructions: [
        "Search by a known name, identifier, or type supported by your search controller.",
        "Check the result's displayed identity before selecting it.",
        "Clear filters if an expected record does not appear."
      ]
    },
    {
      title: "Reading the graph",
      icon: "🕸️",
      description: "Nodes represent entities and edges represent relationships included in the current snapshot.",
      instructions: [
        "Select a node to inspect the associated dossier when selection behavior is implemented.",
        "Use the graph fit control to bring the network into view.",
        "Remember that visual proximity is not a measure of trust or importance unless explicitly defined."
      ]
    },
    {
      title: "Evaluating evidence",
      icon: "📚",
      description: "Use source descriptions, provenance, and review status to understand what supports a connection.",
      instructions: [
        "Inspect the relationship type and both endpoints.",
        "Look for evidence and source references supplied by the application.",
        "Record missing evidence as uncertainty instead of assuming that the relationship is verified."
      ]
    },
    {
      title: "Filtering and exporting",
      icon: "⚙️",
      description: "Filters and exports should operate on the current permitted graph data.",
      instructions: [
        "Check the active filter settings before interpreting counts.",
        "Verify the exported file's contents and scope.",
        "Do not export confidential data unless your authorization and data-handling rules permit it."
      ]
    },
    {
      title: "Troubleshooting",
      icon: "🧭",
      description: "When the graph appears empty or incomplete, check the supplied payload and browser console.",
      instructions: [
        "Confirm that the Rails action supplies nodes and edges in the expected schema.",
        "Check that Stimulus identifiers, targets, and action method names match the registered controllers.",
        "Review response limits, graph depth, and filters before concluding that data is missing."
      ]
    }
  ]
%>

<section class="overflow-hidden rounded-[28px] border-2 border-slate-200 bg-white shadow-lg shadow-slate-100/40"
         aria-labelledby="field-manual-title"
         data-controller="graph-manual">
  <header class="border-b-2 border-slate-200 bg-gradient-to-r from-slate-50 via-white to-orange-50/40 p-5 sm:p-7">
    <p class="text-sm font-black uppercase tracking-[0.16em] text-slate-600">Documentation and help</p>
    <h2 id="field-manual-title" class="mt-2 text-2xl font-black text-slate-900 sm:text-3xl">
      Relationship graph field manual
    </h2>
    <p class="mt-3 max-w-3xl text-base leading-7 text-slate-600">
      A practical reference for exploring the graph, understanding its controls, reviewing evidence,
      and troubleshooting common display problems.
    </p>
  </header>

  <div class="space-y-4 p-5 sm:p-7">
    <% manual_sections.each_with_index do |section, index| %>
      <details class="group rounded-2xl border-2 border-slate-100 bg-white transition open:border-orange-200 open:bg-orange-50/20"
               <%= 'open' if index.zero? %>>
        <summary class="flex cursor-pointer list-none items-center gap-4 p-5">
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl border-2 border-orange-100 bg-orange-50 text-2xl" aria-hidden="true">
            <%= section[:icon] %>
          </span>

          <span class="min-w-0 flex-1">
            <span class="block text-lg font-black text-slate-900"><%= section[:title] %></span>
            <span class="mt-1 block text-base leading-6 text-slate-600"><%= section[:description] %></span>
          </span>

          <span class="text-xl font-black text-orange-700 transition group-open:rotate-45" aria-hidden="true">+</span>
        </summary>

        <div class="border-t border-slate-100 px-5 pb-5 pt-4">
          <ol class="space-y-3">
            <% section[:instructions].each_with_index do |instruction, instruction_index| %>
              <li class="flex items-start gap-3">
                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg border border-orange-200 bg-orange-50 text-sm font-black text-orange-800">
                  <%= instruction_index + 1 %>
                </span>
                <p class="text-base leading-7 text-slate-700"><%= instruction %></p>
              </li>
            <% end %>
          </ol>
        </div>
      </details>
    <% end %>
  </div>

  <footer class="border-t-2 border-slate-200 bg-slate-50/70 p-5 sm:p-6">
    <h3 class="text-lg font-black text-slate-900">Need to investigate a display issue?</h3>
    <p class="mt-2 text-base leading-7 text-slate-600">
      Start by comparing the Rails payload with the rendered page, then verify the registered Stimulus
      controller names and target declarations. This manual describes expected workflows; your existing
      controller code determines which interactions are currently implemented.
    </p>
  </footer>
</section>