<article
  class="group relative overflow-hidden rounded-[26px] border border-white/10 bg-white/[0.035] p-5 transition duration-300 hover:-translate-y-0.5 hover:border-orange-400/25 hover:bg-white/[0.055]"
>
  <div class="absolute right-0 top-0 h-28 w-28 rounded-full bg-orange-500/[0.05] blur-3xl"></div>

  <div class="relative">

    <div class="flex items-start justify-between gap-4">

      <div class="min-w-0">
        <div class="flex items-center gap-2">
          <span class="rounded-full border border-orange-400/15 bg-orange-400/10 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-orange-300">
            <%= discovery_relationship_label(recommendation[:relationship][:kind]) %>
          </span>

          <% if recommendation[:relationship][:reciprocal] %>
            <span class="rounded-full border border-sky-400/15 bg-sky-400/10 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-sky-300">
              Two-way
            </span>
          <% end %>
        </div>

        <h3 class="mt-3 truncate text-lg font-black text-white">
          <%= recommendation[:title] %>
        </h3>

        <p class="mt-1 text-xs font-medium uppercase tracking-wider text-white/35">
          <%= recommendation[:entity_type].to_s.humanize %>
        </p>
      </div>

      <div class="shrink-0 text-right">
        <div class="text-[10px] font-bold uppercase tracking-widest text-white/30">
          Value
        </div>

        <div class="mt-1 text-2xl font-black <%= discovery_score_classes(recommendation[:score]) %>">
          <%= recommendation[:score] %>
        </div>
      </div>

    </div>

    <div class="mt-5">
      <div class="h-1.5 overflow-hidden rounded-full bg-white/5">
        <div
          class="h-full rounded-full bg-gradient-to-r from-orange-500 via-amber-400 to-violet-400 transition-all duration-700"
          style="width: <%= recommendation[:score] %>%"
        ></div>
      </div>
    </div>

    <% if recommendation[:signals].present? %>
      <div class="mt-4 flex flex-wrap gap-2">
        <% recommendation[:signals].each do |signal| %>
          <span class="rounded-full border px-2.5 py-1 text-[10px] font-bold <%= discovery_signal_classes(signal[:tone]) %>">
            <%= signal[:label] %>
          </span>
        <% end %>
      </div>
    <% end %>

    <div class="mt-5 grid grid-cols-2 gap-2">
      <a
        href="<%= recommendation[:actions][:explore] %>"
        class="rounded-xl bg-orange-500 px-3 py-2.5 text-center text-xs font-black text-white transition hover:bg-orange-400"
      >
        Explore →
      </a>

      <a
        href="<%= recommendation[:actions][:compare] %>"
        class="rounded-xl border border-white/10 bg-white/[0.04] px-3 py-2.5 text-center text-xs font-bold text-white/70 transition hover:border-violet-400/30 hover:text-white"
      >
        Compare
      </a>
    </div>

  </div>
</article>