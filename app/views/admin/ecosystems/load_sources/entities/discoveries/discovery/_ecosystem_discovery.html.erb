<section
  class="relative overflow-hidden rounded-[36px] border border-violet-200/70 bg-white shadow-[0_25px_80px_rgba(76,29,149,0.10)] dark:border-violet-900/50 dark:bg-slate-950"
  data-controller="ecosystem-discovery"
  data-ecosystem-discovery-url-value="<%= admin_ecosystem_discovery_path %>"
  data-ecosystem-discovery-recommendations-url-value="<%= admin_ecosystem_discovery_recommendations_path %>"
  data-ecosystem-discovery-missions-url-value="<%= admin_ecosystem_discovery_missions_path %>"
>
  <div class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-orange-400 via-violet-500 to-emerald-400"></div>

  <div class="p-6 md:p-8">

    <!-- HEADER -->

    <div class="flex flex-col gap-5 lg:flex-row lg:items-center lg:justify-between">
      <div>
        <div class="mb-2 flex items-center gap-2 text-xs font-black uppercase tracking-[0.2em] text-violet-600 dark:text-violet-400">
          <span>🧭</span>
          Ecosystem Discovery
        </div>

        <h2 class="text-2xl font-black tracking-tight text-slate-900 dark:text-white md:text-3xl">
          Explore beyond the current entity
        </h2>

        <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-500 dark:text-slate-400">
          Discover connected entities, follow relationship signals,
          and turn the ecosystem graph into an investigation path.
        </p>
      </div>

      <div class="rounded-3xl border border-violet-200 bg-violet-50 px-5 py-4 dark:border-violet-900/50 dark:bg-violet-950/30">
        <div class="text-[10px] font-black uppercase tracking-[0.18em] text-violet-500">
          Discovery XP
        </div>

        <div
          class="mt-1 text-3xl font-black text-violet-700 dark:text-violet-300"
          data-ecosystem-discovery-target="xp"
        >
          0
        </div>

        <div class="text-xs text-violet-500">
          available from current exploration
        </div>
      </div>
    </div>

    <!-- METRICS -->

    <div class="mt-7 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      <div class="rounded-3xl border border-slate-200 bg-slate-50 p-5 dark:border-slate-800 dark:bg-slate-900">
        <div class="text-[10px] font-black uppercase tracking-widest text-slate-400">
          Discovery score
        </div>

        <div
          class="mt-2 text-3xl font-black text-slate-900 dark:text-white"
          data-ecosystem-discovery-target="score"
        >
          —
        </div>
      </div>

      <div class="rounded-3xl border border-sky-200 bg-sky-50 p-5 dark:border-sky-900/50 dark:bg-sky-950/20">
        <div class="text-[10px] font-black uppercase tracking-widest text-sky-500">
          Recommendations
        </div>

        <div
          class="mt-2 text-3xl font-black text-sky-700 dark:text-sky-300"
          data-ecosystem-discovery-target="recommendationCount"
        >
          0
        </div>
      </div>

      <div class="rounded-3xl border border-orange-200 bg-orange-50 p-5 dark:border-orange-900/50 dark:bg-orange-950/20">
        <div class="text-[10px] font-black uppercase tracking-widest text-orange-500">
          Signals
        </div>

        <div
          class="mt-2 text-3xl font-black text-orange-700 dark:text-orange-300"
          data-ecosystem-discovery-target="signalCount"
        >
          0
        </div>
      </div>

      <div class="rounded-3xl border border-emerald-200 bg-emerald-50 p-5 dark:border-emerald-900/50 dark:bg-emerald-950/20">
        <div class="text-[10px] font-black uppercase tracking-widest text-emerald-500">
          Missions
        </div>

        <div
          class="mt-2 text-3xl font-black text-emerald-700 dark:text-emerald-300"
          data-ecosystem-discovery-target="missionCount"
        >
          0
        </div>
      </div>
    </div>

    <!-- CURRENT ENTITY -->

    <div class="mt-7 rounded-[30px] border border-indigo-200 bg-gradient-to-br from-indigo-50 to-white p-6 dark:border-indigo-900/50 dark:from-indigo-950/30 dark:to-slate-950">
      <div class="text-[10px] font-black uppercase tracking-[0.18em] text-indigo-500">
        Current investigation
      </div>

      <div
        class="mt-2 text-xl font-black text-slate-900 dark:text-white"
        data-ecosystem-discovery-target="currentEntity"
      >
        Select an entity from the ecosystem graph
      </div>

      <div class="mt-2 text-sm text-slate-500 dark:text-slate-400">
        Recommendations will appear here once an entity is selected.
      </div>
    </div>

    <!-- SIGNALS -->

    <div class="mt-7">
      <div class="mb-3 flex items-center justify-between">
        <div>
          <h3 class="text-lg font-black text-slate-900 dark:text-white">
            Discovery signals
          </h3>

          <p class="text-xs text-slate-500">
            Why this entity is interesting.
          </p>
        </div>
      </div>

      <div
        class="grid gap-3 md:grid-cols-2 lg:grid-cols-3"
        data-ecosystem-discovery-target="signals"
      >
        <div class="rounded-3xl border border-dashed border-slate-300 p-5 text-sm text-slate-400 dark:border-slate-700">
          Select an entity to calculate discovery signals.
        </div>
      </div>
    </div>

    <!-- RECOMMENDATIONS -->

    <div class="mt-7">
      <div class="mb-3 flex items-center justify-between">
        <div>
          <h3 class="text-lg font-black text-slate-900 dark:text-white">
            Discover next
          </h3>

          <p class="text-xs text-slate-500">
            Recommended paths through the ecosystem.
          </p>
        </div>

        <button
          type="button"
          class="rounded-2xl border border-slate-200 bg-white px-4 py-2 text-xs font-black text-slate-700 transition hover:-translate-y-0.5 hover:border-violet-300 hover:text-violet-700 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300"
          data-action="ecosystem-discovery#refresh"
        >
          ↻ Refresh
        </button>
      </div>

      <div
        class="grid gap-4 md:grid-cols-2"
        data-ecosystem-discovery-target="recommendations"
      >
        <div class="rounded-3xl border border-dashed border-slate-300 p-6 text-sm text-slate-400 dark:border-slate-700">
          Select an entity from the graph to discover related entities.
        </div>
      </div>
    </div>

    <!-- MISSIONS -->

    <div class="mt-7 rounded-[30px] border border-orange-200 bg-gradient-to-br from-orange-50 via-white to-amber-50 p-6 dark:border-orange-900/40 dark:from-orange-950/20 dark:via-slate-950 dark:to-amber-950/20">
      <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
        <div>
          <div class="text-[10px] font-black uppercase tracking-[0.18em] text-orange-500">
            Explorer missions
          </div>

          <h3 class="mt-1 text-xl font-black text-slate-900 dark:text-white">
            Turn research into progression
          </h3>

          <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
            Complete exploration actions to build toward the future Research Quest system.
          </p>
        </div>

        <div class="rounded-2xl bg-white/80 px-4 py-3 shadow-sm dark:bg-slate-900/70">
          <div class="text-[10px] font-black uppercase tracking-widest text-slate-400">
            Mission XP
          </div>

          <div
            class="text-2xl font-black text-orange-600"
            data-ecosystem-discovery-target="missionXp"
          >
            0
          </div>
        </div>
      </div>

      <div
        class="mt-5 grid gap-3 md:grid-cols-2"
        data-ecosystem-discovery-target="missions"
      >
        <div class="rounded-3xl border border-dashed border-orange-200 p-5 text-sm text-orange-400">
          Select an entity to generate exploration missions.
        </div>
      </div>
    </div>

    <!-- STATUS -->

    <div
      class="mt-5 hidden rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-semibold text-red-700 dark:border-red-900/50 dark:bg-red-950/30 dark:text-red-300"
      data-ecosystem-discovery-target="error"
    ></div>

  </div>
</section>