<%# Ecosystem Discovery page.
    Uses the entity and discovery result supplied by the controller. %>

<main class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
  <header class="mb-8">
    <div class="text-xs font-bold uppercase tracking-widest text-violet-500">
      Ecosystem Intelligence
    </div>

    <h1 class="mt-2 text-3xl font-black text-slate-900 dark:text-white">
      Discovery Engine
    </h1>

    <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">
      Explore connections and discover related entities.
    </p>
  </header>

  <% if @entity.present? %>
    <section class="mb-8 rounded-3xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-950">
      <div class="text-xs font-bold uppercase tracking-widest text-slate-400">
        Current entity
      </div>

      <h2 class="mt-2 text-2xl font-bold text-slate-900 dark:text-white">
        <%= @entity.try(:name).presence ||
            @entity.try(:title).presence ||
            "Entity ##{@entity.id}" %>
      </h2>

      <p class="mt-2 text-sm text-slate-500">
        ID: <%= @entity.id %>
      </p>
    </section>
  <% end %>

  <% if @discovery.present? %>
    <% if @discovery.respond_to?(:recommendations) %>
      <% recommendations = @discovery.recommendations || [] %>
    <% elsif @discovery.is_a?(Hash) %>
      <% recommendations = @discovery[:recommendations] || [] %>
    <% else %>
      <% recommendations = [] %>
    <% end %>

    <% if @discovery.respond_to?(:metrics) %>
      <% metrics = @discovery.metrics || {} %>
    <% elsif @discovery.is_a?(Hash) %>
      <% metrics = @discovery[:stats] || @discovery[:metrics] || {} %>
    <% else %>
      <% metrics = {} %>
    <% end %>

    <section class="mb-8 grid grid-cols-2 gap-4 lg:grid-cols-4">
      <div class="rounded-2xl border border-slate-200 p-5 dark:border-slate-800">
        <div class="text-xs font-bold uppercase text-slate-400">
          Recommendations
        </div>
        <div class="mt-2 text-3xl font-black text-slate-900 dark:text-white">
          <%= recommendations.size %>
        </div>
      </div>

      <div class="rounded-2xl border border-slate-200 p-5 dark:border-slate-800">
        <div class="text-xs font-bold uppercase text-slate-400">
          Discovery score
        </div>
        <div class="mt-2 text-3xl font-black text-violet-600">
          <%= metrics[:discovery_score] || metrics[:score] || "—" %>
        </div>
      </div>

      <div class="rounded-2xl border border-slate-200 p-5 dark:border-slate-800">
        <div class="text-xs font-bold uppercase text-slate-400">
          Signals
        </div>
        <div class="mt-2 text-3xl font-black text-orange-500">
          <%= metrics[:signal_count] || 0 %>
        </div>
      </div>

      <div class="rounded-2xl border border-slate-200 p-5 dark:border-slate-800">
        <div class="text-xs font-bold uppercase text-slate-400">
          Missions
        </div>
        <div class="mt-2 text-3xl font-black text-emerald-600">
          <%= metrics[:mission_count] || 0 %>
        </div>
      </div>
    </section>

    <section>
      <h2 class="mb-4 text-xl font-black text-slate-900 dark:text-white">
        Recommended discoveries
      </h2>

      <% if recommendations.any? %>
        <div class="grid gap-4 md:grid-cols-2">
          <% recommendations.each do |recommendation| %>
            <% item = recommendation.respond_to?(:to_h) ? recommendation.to_h : {} %>
            <article class="rounded-3xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-950">
              <h3 class="text-lg font-bold text-slate-900 dark:text-white">
                <%= item[:title] || item[:name] || "Related entity ##{item[:id]}" %>
              </h3>

              <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">
                Type: <%= item[:entity_type] || item[:type] || "Entity" %>
              </p>

              <% if item[:score].present? %>
                <p class="mt-3 text-sm font-semibold text-violet-600">
                  Discovery score: <%= item[:score] %>
                </p>
              <% end %>

              <% if item[:reasons].present? %>
                <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-slate-500">
                  <% Array(item[:reasons]).each do |reason| %>
                    <li><%= reason %></li>
                  <% end %>
                </ul>
              <% end %>
            </article>
          <% end %>
        </div>
      <% else %>
        <div class="rounded-3xl border border-dashed border-slate-300 p-8 text-sm text-slate-500 dark:border-slate-700">
          <p class="font-semibold">No recommendations available yet.</p>
          <p class="mt-2">
            This entity currently has no discovered relationships.
            Create or discover relationships to populate recommendations.
          </p>
        </div>
      <% end %>
    </section>
  <% else %>
    <div class="rounded-3xl border border-amber-200 bg-amber-50 p-6 text-sm text-amber-900">
      Discovery data was not provided by the controller.
      Check the discovery service and controller result assignment.
    </div>
  <% end %>
</main>
