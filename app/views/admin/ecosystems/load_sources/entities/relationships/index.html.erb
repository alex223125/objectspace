<div class="space-y-5">

  <div
    class="relative overflow-hidden rounded-[28px] border border-violet-500/20 bg-slate-950 p-6 shadow-2xl">

    <div
      class="pointer-events-none absolute inset-0 opacity-20"
      style="
      background-image:
        radial-gradient(circle at 20% 20%, rgba(139,92,246,.35), transparent 30%),
          radial-gradient(circle at 80% 80%, rgba(14,165,233,.25), transparent 30%);
      ">
    </div>

    <div class="relative">

      <div class="flex flex-col gap-5 lg:flex-row lg:items-center lg:justify-between">

        <div>

          <div
            class="text-[10px] font-black uppercase tracking-[0.25em] text-violet-400">
            Ecosystem Intelligence
          </div>

          <h1 class="mt-2 text-2xl font-black tracking-tight text-white">
            <%= @entity.name %>
          </h1>

          <p class="mt-1 max-w-2xl text-xs leading-relaxed text-slate-400">
            Cross-entity relationship signals discovered from
            shared ontology, templates, scope and semantic vocabulary.
          </p>

        </div>

        <div>

          <%= button_to(
                "DISCOVER RELATIONSHIPS",
                discover_admin_ecosystems_load_sources_entity_relationships_path(@entity),
                method: :post,
                class: "rounded-xl bg-violet-500 px-4 py-2.5 text-[10px] font-black uppercase tracking-widest text-white shadow-lg shadow-violet-500/20 transition hover:bg-violet-400"
              ) %>

        </div>

      </div>

    </div>

  </div>


  <div
    data-controller="relationship-intelligence"
    data-relationship-intelligence-entity-id-value="<%= @entity.id %>"
    data-relationship-intelligence-url-value="<%= admin_ecosystems_load_sources_entity_relationships_path(@entity, format: :json) %>"
    class="space-y-5">

    <div
      data-relationship-intelligence-target="metrics"
      class="grid grid-cols-2 gap-3 lg:grid-cols-4">

      <%= render(
            "metrics",
            metrics: @intelligence[:metrics]
          ) %>

    </div>


    <div class="grid gap-5 xl:grid-cols-[1.5fr_1fr]">

      <div
        class="rounded-[28px] border border-gray-200 bg-white p-5 shadow-sm dark:border-gray-800 dark:bg-gray-900">

        <div class="flex items-center justify-between">

          <div>

            <div
              class="text-[10px] font-black uppercase tracking-[0.2em] text-gray-400">
              Relationship Network
            </div>

            <div class="mt-1 text-xs text-gray-400">
              Strongest known ecosystem connections
            </div>

          </div>

          <div
            data-relationship-intelligence-target="status"
            class="text-[9px] font-black uppercase tracking-widest text-emerald-500">
            LIVE
          </div>

        </div>

        <div
          data-relationship-intelligence-target="graph"
          class="mt-5 min-h-[380px]">
          <%= render(
                "graph",
                intelligence: @intelligence
              ) %>
        </div>

      </div>


      <div
        class="rounded-[28px] border border-gray-200 bg-white p-5 shadow-sm dark:border-gray-800 dark:bg-gray-900">

        <div
          class="text-[10px] font-black uppercase tracking-[0.2em] text-gray-400">
          Related Entities
        </div>

        <div
          data-relationship-intelligence-target="relationships"
          class="mt-4 space-y-2">

          <%= render(
                "relationships",
                relationships:
                  @intelligence[:relationships]
              ) %>

        </div>

      </div>

    </div>

  </div>

</div>