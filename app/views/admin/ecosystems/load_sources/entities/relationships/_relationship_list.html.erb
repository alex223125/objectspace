<div class="rounded-3xl border border-slate-800 bg-slate-900 shadow-xl">

  <div class="border-b border-slate-800 px-5 py-4">

    <div class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-500">
      Discovered Connections
    </div>

    <div class="mt-1 text-xs text-slate-400">
      Explainable relationships discovered from structural and semantic signals.
    </div>

  </div>


  <% if relationships.any? %>

    <div class="divide-y divide-slate-800">

      <% relationships.each do |relationship| %>

        <% other = relationship.other_entity(entity) %>

        <div class="p-5 transition hover:bg-slate-800/40">

          <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">

            <div class="min-w-0">

              <div class="flex items-center gap-3">

                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-indigo-500/20 bg-indigo-500/10">
                  🔗
                </div>

                <div class="min-w-0">

                  <div class="truncate text-sm font-black text-white">
                    <%= other.name %>
                  </div>

                  <div class="mt-0.5 font-mono text-[9px] text-slate-500">
                    <%= other.slug %>
                  </div>

                </div>

              </div>

            </div>


            <div class="flex items-center gap-3">

              <span
                class="rounded-full border border-indigo-500/20 bg-indigo-500/10 px-2.5 py-1 text-[9px] font-black uppercase tracking-wider text-indigo-300">
                <%= relationship.relationship_kind.to_s.humanize %>
              </span>

              <span
                class="rounded-full border border-slate-700 bg-slate-950 px-2.5 py-1 text-[9px] font-black uppercase tracking-wider text-slate-400">
                <%= relationship.state.to_s %>
              </span>

            </div>

          </div>


          <div class="mt-4">

            <div class="mb-1 flex items-center justify-between">

              <span class="text-[9px] font-black uppercase tracking-widest text-slate-500">
                Confidence
              </span>

              <span class="text-[10px] font-black text-indigo-300">
                <%= relationship.confidence_percentage %>%
              </span>

            </div>

            <div class="h-2 overflow-hidden rounded-full bg-slate-800">

              <div
                class="h-full rounded-full bg-gradient-to-r from-indigo-500 via-violet-500 to-emerald-400"
                style="width: <%= relationship.confidence_percentage %>%">
              </div>

            </div>

          </div>


          <% if relationship.evidence_items.any? %>

            <div class="mt-4 flex flex-wrap gap-2">

              <% relationship.evidence_items.each do |evidence| %>

                <span
                  class="rounded-lg border border-slate-700 bg-slate-950 px-2.5 py-1 text-[9px] font-bold text-slate-400">

                  <%= evidence["label"] || evidence[:label] || "Signal" %>

                </span>

              <% end %>

            </div>

          <% end %>

        </div>

      <% end %>

    </div>

  <% else %>

    <div class="px-6 py-14 text-center">

      <div class="text-3xl">
        ◌
      </div>

      <div class="mt-3 text-sm font-black text-white">
        No relationships discovered yet
      </div>

      <p class="mx-auto mt-2 max-w-md text-xs leading-relaxed text-slate-500">
        Run relationship discovery to analyze this entity against
        other active entities in the ecosystem.
      </p>

    </div>

  <% end %>

</div>