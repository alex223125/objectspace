<% if relationships.any? %>

  <% relationships.each do |relationship| %>

    <div
      class="group rounded-2xl border border-gray-100 bg-gray-50 p-3 transition hover:border-violet-200 hover:bg-violet-50/40 dark:border-gray-800 dark:bg-gray-950 dark:hover:border-violet-900">

      <div class="flex items-start justify-between gap-3">

        <div class="min-w-0">

          <div
            class="truncate text-xs font-black text-gray-800 dark:text-gray-100">
            <%= relationship[:entity_name] || "Unknown entity" %>
          </div>

          <div
            class="mt-1 truncate font-mono text-[9px] text-gray-400">
            <%= relationship[:entity_slug] %>
          </div>

        </div>

        <span
          class="shrink-0 rounded-full border border-violet-200 bg-violet-50 px-2 py-1 text-[8px] font-black uppercase tracking-wider text-violet-600 dark:border-violet-900 dark:bg-violet-950/30 dark:text-violet-400">
          <%= relationship[:relationship_label] %>
        </span>

      </div>


      <div class="mt-3">

        <div class="flex items-center justify-between text-[8px] font-black uppercase tracking-wider">

          <span class="text-gray-400">
            Confidence
          </span>

          <span class="text-gray-500 dark:text-gray-400">
            <%= relationship[:confidence_percent] %>%
          </span>

        </div>

        <div class="mt-1 h-1.5 overflow-hidden rounded-full bg-gray-200 dark:bg-gray-800">

          <div
            class="h-full rounded-full bg-gradient-to-r from-amber-400 via-sky-400 to-violet-500"
            style="width: <%= relationship[:confidence_percent] %>%">
          </div>

        </div>

      </div>


      <% if relationship[:evidence].present? %>

        <div class="mt-3 flex flex-wrap gap-1">

          <% relationship[:evidence].each do |evidence| %>

            <span
              class="rounded-md bg-white px-1.5 py-1 text-[8px] font-bold text-gray-500 dark:bg-gray-900 dark:text-gray-400">
              <%= evidence[:signal].to_s.humanize %>
            </span>

          <% end %>

        </div>

      <% end %>

    </div>

  <% end %>

<% else %>

  <div
    class="rounded-2xl border border-dashed border-gray-200 px-4 py-10 text-center dark:border-gray-800">

    <div class="text-2xl">
      ◌
    </div>

    <div class="mt-2 text-xs font-black text-gray-700 dark:text-gray-200">
      No relationship signals yet
    </div>

    <p class="mx-auto mt-1 max-w-xs text-[10px] leading-relaxed text-gray-400">
      Run relationship discovery to identify possible
      connections across the entity ecosystem.
    </p>

  </div>

<% end %>