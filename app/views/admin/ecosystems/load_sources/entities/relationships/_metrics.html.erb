<% [
     [
       "RELATIONSHIPS",
       metrics[:total_relationships],
       "◈",
       "violet"
     ],
     [
       "CONFIRMED",
       metrics[:confirmed_relationships],
       "✓",
       "emerald"
     ],
     [
       "SUGGESTED",
       metrics[:suggested_relationships],
       "✦",
       "amber"
     ],
     [
       "AVG CONFIDENCE",
       "#{metrics[:average_confidence_percent]}%",
       "◎",
       "sky"
     ]
   ].each do |label, value, icon, color| %>

  <div
    class="rounded-2xl border border-gray-200 bg-white p-4 shadow-sm dark:border-gray-800 dark:bg-gray-900">

    <div class="flex items-center justify-between">

      <span
        class="text-[9px] font-black uppercase tracking-[0.18em] text-gray-400">
        <%= label %>
      </span>

      <span class="text-sm text-<%= color %>-500">
        <%= icon %>
      </span>

    </div>

    <div class="mt-2 text-2xl font-black text-gray-800 dark:text-white">
      <%= value %>
    </div>

  </div>

<% end %>