<div
  class="max-w-6xl mx-auto my-10 p-8
         bg-gradient-to-b from-white via-orange-50/20 to-slate-50/50
         border-2 border-orange-100
         rounded-[38px]
         shadow-md shadow-orange-100/40">

  <div class="flex flex-col gap-5 md:flex-row md:items-center md:justify-between">

    <div class="flex items-center gap-4">

      <div
        class="w-12 h-12 rounded-2xl
               bg-violet-100
               border border-violet-200
               flex items-center justify-center
               text-xl">

        🧬

      </div>

      <div>

        <h1 class="text-xl font-black text-slate-800">
          Identity Intelligence
        </h1>

        <p class="mt-1 text-sm text-slate-400">
          Identity → matching → movement → semantic classification
        </p>

      </div>

    </div>

    <div
      class="rounded-full
             bg-emerald-50
             border border-emerald-200
             px-4 py-2
             text-[10px]
             font-black
             text-emerald-600">

      READ ONLY

    </div>

  </div>


  <!-- ========================================================= -->
  <!-- PIPELINE -->
  <!-- ========================================================= -->

  <div
    class="mt-8
           rounded-[28px]
           border border-orange-100
           bg-white
           p-5">

    <div
      class="flex flex-wrap
             items-center
             justify-center
             gap-3">

      <% [
           ["Configuration", "⚙️"],
           ["Identity", "🧬"],
           ["Validation", "🔎"],
           ["Matching", "🔗"],
           ["Movement", "↔️"],
           ["Classification", "🏷️"]
         ].each_with_index do |stage, index| %>

        <div
          class="flex items-center gap-2
                 rounded-2xl
                 bg-orange-50
                 border border-orange-100
                 px-4 py-3">

          <span>
            <%= stage[1] %>
          </span>

          <span class="text-[10px] font-black text-orange-700">
            <%= stage[0] %>
          </span>

        </div>

        <% unless index == 5 %>
          <span class="text-orange-300">
            →
          </span>
        <% end %>

      <% end %>

    </div>

  </div>


  <!-- ========================================================= -->
  <!-- SOURCES -->
  <!-- ========================================================= -->

  <%= render(
        partial: "identity_result",
        locals: {
          title: "metadata.sources",
          identity_key: "uuid",
          classification: @source_result
        }
      ) %>


  <!-- ========================================================= -->
  <!-- TAGS -->
  <!-- ========================================================= -->

  <%= render(
        partial: "identity_result",
        locals: {
          title: "metadata.tags",
          identity_key: "slug",
          classification: @tag_result
        }
      ) %>


  <!-- ========================================================= -->
  <!-- SAFETY -->
  <!-- ========================================================= -->

  <div
    class="mt-8
           rounded-[26px]
           bg-slate-50
           border border-slate-100
           p-5">

    <div class="text-xs font-black text-slate-600">
      Deliberately untouched
    </div>

    <div class="mt-3 flex flex-wrap gap-2">

      <% [
           "Restore",
           "Rollback",
           "Release management",
           "Comments",
           "Publishing mutation",
           "Editing",
           "New version model",
           "Database migration"
         ].each do |item| %>

        <span
          class="rounded-full
                 bg-white
                 border border-slate-200
                 px-3 py-1
                 text-[10px]
                 font-bold
                 text-slate-400">

          ❌ <%= item %>

        </span>

      <% end %>

    </div>

  </div>

</div>