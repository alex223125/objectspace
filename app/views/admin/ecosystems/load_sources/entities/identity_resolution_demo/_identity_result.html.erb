<div
  class="mt-8
         rounded-[30px]
         border-2 border-slate-100
         bg-white
         p-6
         shadow-sm">

  <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">

    <div>

      <div class="flex items-center gap-2">

        <span
          class="h-3 w-3
                 rounded-full
                 bg-violet-400
                 shadow-[0_0_8px_rgba(167,139,250,0.6)]">
        </span>

        <h2 class="text-sm font-black text-slate-700">
          <%= title %>
        </h2>

      </div>

      <p class="mt-1 text-xs text-slate-400">
        Identity field:
        <strong class="text-violet-500">
          <%= identity_key %>
        </strong>
      </p>

    </div>


    <% if classification.safe_to_compare? %>

      <span
        class="rounded-full
               bg-emerald-50
               border border-emerald-200
               px-3 py-1
               text-[10px]
               font-black
               text-emerald-600">

        ✓ SAFE MATCHING

      </span>

    <% else %>

      <span
        class="rounded-full
               bg-red-50
               border border-red-200
               px-3 py-1
               text-[10px]
               font-black
               text-red-600">

        ⚠ IDENTITY REVIEW

      </span>

    <% end %>

  </div>


  <!-- ========================================================= -->
  <!-- MOVED -->
  <!-- ========================================================= -->

  <div class="mt-6">

    <div class="text-[10px] uppercase tracking-widest font-black text-slate-400">
      Moved
    </div>

    <% if classification.moved.any? %>

      <div class="mt-3 grid gap-3">

        <% classification.moved.each do |match| %>

          <div
            class="rounded-2xl
                   bg-violet-50
                   border border-violet-100
                   p-4">

            <div class="flex items-center justify-between">

              <div>

                <div class="text-xs font-black text-violet-700">
                  Identity:
                  <%= match.identity %>
                </div>

                <div class="mt-1 text-[10px] text-violet-400">
                  Position
                  <%= match.old_index %>
                  →
                  <%= match.new_index %>
                </div>

              </div>

              <div class="text-xl">
                ↔️
              </div>

            </div>

          </div>

        <% end %>

      </div>

    <% else %>

      <div class="mt-2 text-xs text-slate-400">
        No moved items detected.
      </div>

    <% end %>

  </div>


  <!-- ========================================================= -->
  <!-- ADDED -->
  <!-- ========================================================= -->

  <div class="mt-6">

    <div class="text-[10px] uppercase tracking-widest font-black text-slate-400">
      Added
    </div>

    <div class="mt-2 flex flex-wrap gap-2">

      <% classification.added.each do |index| %>

        <span
          class="rounded-full
                 bg-emerald-50
                 border border-emerald-100
                 px-3 py-1
                 text-[10px]
                 font-black
                 text-emerald-600">

          + index <%= index %>

        </span>

      <% end %>

      <% if classification.added.empty? %>

        <span class="text-xs text-slate-400">
          None
        </span>

      <% end %>

    </div>

  </div>


  <!-- ========================================================= -->
  <!-- REMOVED -->
  <!-- ========================================================= -->

  <div class="mt-6">

    <div class="text-[10px] uppercase tracking-widest font-black text-slate-400">
      Removed
    </div>

    <div class="mt-2 flex flex-wrap gap-2">

      <% classification.removed.each do |index| %>

        <span
          class="rounded-full
                 bg-amber-50
                 border border-amber-100
                 px-3 py-1
                 text-[10px]
                 font-black
                 text-amber-600">

          − index <%= index %>

        </span>

      <% end %>

      <% if classification.removed.empty? %>

        <span class="text-xs text-slate-400">
          None
        </span>

      <% end %>

    </div>

  </div>


  <!-- ========================================================= -->
  <!-- IDENTITY ISSUES -->
  <!-- ========================================================= -->

  <% if classification.issues.any? %>

    <div
      class="mt-6
             rounded-2xl
             bg-red-50
             border border-red-100
             p-4">

      <div class="text-xs font-black text-red-700">
        Identity issues
      </div>

      <div class="mt-3 grid gap-2">

        <% classification.issues.each do |issue| %>

          <div
            class="rounded-xl
                   bg-white
                   border border-red-100
                   px-3 py-2">

            <div class="flex items-center justify-between gap-3">

              <span class="text-[10px] font-black text-red-600">
                <%= issue.type %>
              </span>

              <span class="text-[9px] text-slate-400">
                <%= issue.side %>
              </span>

            </div>

            <p class="mt-1 text-[10px] leading-4 text-slate-400">
              <%= issue.message %>
            </p>

          </div>

        <% end %>

      </div>

    </div>

  <% end %>

</div>