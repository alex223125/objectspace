<% configuration =
     @configuration ||
       ::Ecosystems::LoadSources::Entity::DiffIntelligence::Configuration.empty
%>

<% rules =
     configuration.rules
%>

<div
  class="
    max-w-6xl
    mx-auto
    my-8
    px-4
    sm:px-6
    lg:px-8
  "
  data-controller="diff-intelligence"
>

  <!-- ========================================================= -->
  <!-- HERO -->
  <!-- ========================================================= -->

  <div
    class="
      overflow-hidden
      rounded-[38px]
      border-2
      border-orange-100
      bg-gradient-to-b
      from-white
      via-orange-50/20
      to-slate-50/50
      shadow-md
      shadow-orange-100/40
    "
  >

    <div
      class="
        border-b-2
        border-orange-100
        p-6
        lg:p-8
      "
    >

      <div
        class="
          flex
          flex-col
          gap-5
          lg:flex-row
          lg:items-center
          lg:justify-between
        "
      >

        <div class="flex items-start gap-4">

          <div
            class="
              flex
              h-14
              w-14
              shrink-0
              items-center
              justify-center
              rounded-[22px]
              border-[3px]
              border-violet-300
              bg-violet-50
              text-2xl
              shadow-md
              shadow-violet-200/60
              ring-[5px]
              ring-violet-100/50
            "
          >
            🧠
          </div>

          <div>

            <div
              class="
                text-[10px]
                font-black
                uppercase
                tracking-[0.18em]
                text-violet-500
              "
            >
              Diff Intelligence
            </div>

            <h1
              class="
                mt-1
                text-2xl
                font-black
                tracking-tight
                text-slate-800
              "
            >
              Comparison intelligence
            </h1>

            <p
              class="
                mt-2
                max-w-3xl
                text-xs
                leading-6
                text-slate-400
              "
            >
              Configure how the semantic comparison engine identifies
              objects inside arrays.
            </p>

          </div>

        </div>

        <div
          class="
            flex
            w-fit
            items-center
            gap-2
            rounded-full
            border
            border-emerald-200
            bg-emerald-50
            px-4
            py-2
          "
        >

          <span
            class="
              h-2.5
              w-2.5
              rounded-full
              bg-emerald-400
              shadow-[0_0_10px_rgba(52,211,153,0.7)]
            "
          ></span>

          <span
            class="
              text-[9px]
              font-black
              uppercase
              tracking-widest
              text-emerald-700
            "
          >
            Read-only intelligence
          </span>

        </div>

      </div>

    </div>


    <!-- ======================================================= -->
    <!-- ECOSYSTEM PROGRESS -->
    <!-- ======================================================= -->

    <div class="p-6 lg:p-8">

      <div
        class="
          rounded-[30px]
          border-2
          border-orange-100
          bg-gradient-to-r
          from-orange-50/80
          via-white
          to-emerald-50/60
          p-6
          shadow-sm
        "
      >

        <div
          class="
            flex
            flex-col
            gap-5
            md:flex-row
            md:items-center
            md:justify-between
          "
        >

          <div class="flex items-start gap-4">

            <div
              class="
                flex
                h-11
                w-11
                shrink-0
                items-center
                justify-center
                rounded-2xl
                border
                border-orange-200
                bg-orange-100
                text-lg
              "
            >
              🌳
            </div>

            <div>

              <div
                class="
                  text-sm
                  font-black
                  text-slate-700
                "
              >
                Semantic evolution path
              </div>

              <p
                class="
                  mt-1
                  text-xs
                  leading-6
                  text-slate-400
                "
              >
                Teach the comparison engine how your data is structured.
              </p>

            </div>

          </div>

          <div
            class="
              rounded-full
              border
              border-violet-200
              bg-violet-50
              px-4
              py-2
              text-[9px]
              font-black
              uppercase
              tracking-widest
              text-violet-600
            "
          >
            Intelligence configuration
          </div>

        </div>


        <div class="mt-6">

          <div
            class="
              mb-2
              flex
              items-center
              justify-between
            "
          >

            <span
              class="
                text-[9px]
                font-black
                uppercase
                tracking-widest
                text-slate-400
              "
            >
              Configuration maturity
            </span>

            <span
              class="
                text-[10px]
                font-black
                text-violet-500
              "
              data-diff-intelligence-target="progressLabel"
            >
              0 rules configured
            </span>

          </div>

          <div
            class="
              h-2.5
              overflow-hidden
              rounded-full
              border
              border-orange-100
              bg-white
            "
          >

            <div
              class="
                h-full
                w-0
                rounded-full
                bg-gradient-to-r
                from-orange-400
                via-violet-400
                to-emerald-400
                shadow-sm
                transition-all
                duration-700
              "
              data-diff-intelligence-target="progress"
            ></div>

          </div>

        </div>

      </div>


      <!-- ===================================================== -->
      <!-- CONFIGURATION FORM -->
      <!-- ===================================================== -->

      <form
        method="post"
        action="<%= admin_ecosystems_load_sources_entity_diff_intelligence_path(@entity) %>"
        class="mt-6"
        data-diff-intelligence-target="form"
      >

        <%= hidden_field_tag :_method, :patch %>

        <%= hidden_field_tag(
              :authenticity_token,
              form_authenticity_token
            ) %>


        <!-- =================================================== -->
        <!-- INTRO -->
        <!-- =================================================== -->

        <div
          class="
            rounded-[30px]
            border-2
            border-slate-100
            bg-white
            p-6
            shadow-sm
          "
        >

          <div
            class="
              flex
              flex-col
              gap-4
              md:flex-row
              md:items-center
              md:justify-between
            "
          >

            <div>

              <div
                class="
                  text-[10px]
                  font-black
                  uppercase
                  tracking-widest
                  text-slate-400
                "
              >
                Identity rules
              </div>

              <h2
                class="
                  mt-1
                  text-lg
                  font-black
                  text-slate-700
                "
              >
                Configure array identities
              </h2>

              <p
                class="
                  mt-2
                  max-w-2xl
                  text-xs
                  leading-6
                  text-slate-400
                "
              >
                Tell the comparison engine which field uniquely identifies
                objects at a particular path.
              </p>

            </div>


            <button
              type="button"
              class="
                flex
                shrink-0
                items-center
                justify-center
                gap-2
                rounded-2xl
                border-2
                border-violet-300
                bg-gradient-to-r
                from-violet-400
                to-purple-400
                px-5
                py-3
                text-xs
                font-black
                text-white
                shadow-md
                shadow-violet-200/60
                transition-all
                duration-300
                hover:-translate-y-0.5
                hover:from-violet-500
                hover:to-purple-500
                hover:shadow-lg
              "
              data-action="click->diff-intelligence#addRule"
            >
              <span>＋</span>
              <span>Add identity rule</span>
            </button>

          </div>

        </div>


        <!-- =================================================== -->
        <!-- RULES -->
        <!-- =================================================== -->

        <div
          class="mt-5 space-y-4"
          data-diff-intelligence-target="rules"
        >

          <% rules.each do |path, rule| %>

            <div
              class="
                rounded-[28px]
                border-2
                border-violet-100
                bg-gradient-to-br
                from-violet-50/60
                via-white
                to-white
                p-5
                shadow-sm
                transition-all
                duration-300
                hover:-translate-y-0.5
                hover:shadow-md
              "
              data-diff-intelligence-rule
            >

              <div
                class="
                  flex
                  flex-col
                  gap-4
                  lg:flex-row
                  lg:items-end
                "
              >

                <div class="flex-1">

                  <label
                    class="
                      mb-2
                      block
                      text-[9px]
                      font-black
                      uppercase
                      tracking-widest
                      text-slate-400
                    "
                  >
                    Data path
                  </label>

                  <input
                    type="text"
                    name="diff_intelligence[rules][<%= path %>][path]"
                    value="<%= path %>"
                    placeholder="metadata.sources"
                    class="
                      w-full
                      rounded-2xl
                      border-2
                      border-slate-100
                      bg-white
                      px-4
                      py-3
                      text-sm
                      font-bold
                      text-slate-700
                      outline-none
                      transition
                      focus:border-violet-300
                      focus:ring-4
                      focus:ring-violet-50
                    "
                    data-rule-path
                  >

                </div>


                <div class="flex-1">

                  <label
                    class="
                      mb-2
                      block
                      text-[9px]
                      font-black
                      uppercase
                      tracking-widest
                      text-slate-400
                    "
                  >
                    Identity field
                  </label>

                  <select
                    name="diff_intelligence[rules][<%= path %>][identity]"
                    class="
                      w-full
                      rounded-2xl
                      border-2
                      border-slate-100
                      bg-white
                      px-4
                      py-3
                      text-sm
                      font-bold
                      text-slate-700
                      outline-none
                      transition
                      focus:border-violet-300
                      focus:ring-4
                      focus:ring-violet-50
                    "
                  >

                    <% ::Ecosystems::LoadSources::Entity::DiffIntelligence::Configuration::DEFAULT_IDENTITY_KEYS.each do |identity| %>

                      <option
                        value="<%= identity %>"
                        <%= "selected" if rule["identity"].to_s == identity %>
                      >
                        <%= identity %>
                      </option>

                    <% end %>

                  </select>

                </div>


                <button
                  type="button"
                  class="
                    flex
                    h-12
                    shrink-0
                    items-center
                    justify-center
                    rounded-2xl
                    border-2
                    border-rose-100
                    bg-rose-50
                    px-5
                    text-xs
                    font-black
                    text-rose-500
                    transition-all
                    hover:border-rose-200
                    hover:bg-rose-100
                  "
                  data-action="click->diff-intelligence#removeRule"
                >
                  Remove
                </button>

              </div>


              <div
                class="
                  mt-4
                  flex
                  items-center
                  gap-2
                  text-[10px]
                  font-bold
                  text-violet-500
                "
              >

                <span
                  class="
                    h-2
                    w-2
                    rounded-full
                    bg-violet-400
                    shadow-[0_0_8px_rgba(167,139,250,0.7)]
                  "
                ></span>

                This rule controls semantic identity matching.

              </div>

            </div>

          <% end %>

        </div>


        <!-- =================================================== -->
        <!-- EMPTY -->
        <!-- =================================================== -->

        <div
          class="
            mt-5
            <%= rules.any? ? "hidden" : "" %>
            rounded-[30px]
            border-2
            border-dashed
            border-slate-200
            bg-white
            px-6
            py-14
            text-center
          "
          data-diff-intelligence-target="empty"
        >

          <div
            class="
              mx-auto
              flex
              h-14
              w-14
              items-center
              justify-center
              rounded-2xl
              bg-violet-50
              text-2xl
            "
          >
            🧩
          </div>

          <div
            class="
              mt-4
              text-sm
              font-black
              text-slate-700
            "
          >
            No identity rules yet
          </div>

          <p
            class="
              mx-auto
              mt-2
              max-w-md
              text-xs
              leading-6
              text-slate-400
            "
          >
            Add an identity rule when an array contains objects
            that should be matched by a stable identifier.
          </p>

        </div>


        <!-- =================================================== -->
        <!-- EXAMPLE -->
        <!-- =================================================== -->

        <div
          class="
            mt-5
            rounded-[30px]
            border-2
            border-sky-100
            bg-gradient-to-r
            from-sky-50
            via-white
            to-white
            p-6
          "
        >

          <div class="flex items-start gap-4">

            <div
              class="
                flex
                h-11
                w-11
                shrink-0
                items-center
                justify-center
                rounded-2xl
                border
                border-sky-200
                bg-sky-100
                text-lg
              "
            >
              💡
            </div>

            <div>

              <div
                class="
                  text-sm
                  font-black
                  text-sky-700
                "
              >
                Example
              </div>

              <p
                class="
                  mt-2
                  text-xs
                  leading-6
                  text-slate-400
                "
              >
                If
                <code
                  class="
                    rounded
                    bg-sky-100
                    px-1.5
                    py-0.5
                    font-mono
                    text-sky-700
                  "
                >
                  metadata.sources
                </code>
                contains objects such as
                <code
                  class="
                    rounded
                    bg-sky-100
                    px-1.5
                    py-0.5
                    font-mono
                    text-sky-700
                  "
                >
                  { uuid: "abc" }
                </code>,
                configure the path with
                <strong>uuid</strong>.
              </p>

            </div>

          </div>

        </div>


        <!-- =================================================== -->
        <!-- ACTION BAR -->
        <!-- =================================================== -->

        <div
          class="
            sticky
            bottom-4
            z-20
            mt-6
            rounded-[28px]
            border-2
            border-orange-100
            bg-white/95
            p-4
            shadow-xl
            shadow-orange-100/40
            backdrop-blur
          "
        >

          <div
            class="
              flex
              flex-col
              gap-4
              md:flex-row
              md:items-center
              md:justify-between
            "
          >

            <div class="flex items-center gap-3">

              <div
                class="
                  flex
                  h-10
                  w-10
                  items-center
                  justify-center
                  rounded-xl
                  bg-orange-100
                  text-lg
                "
              >
                ⚡
              </div>

              <div>

                <div
                  class="
                    text-xs
                    font-black
                    text-slate-700
                  "
                >
                  Configuration ready
                </div>

                <div
                  class="
                    text-[10px]
                    text-slate-400
                  "
                  data-diff-intelligence-target="status"
                >
                  Changes have not been saved.
                </div>

              </div>

            </div>


            <div class="flex items-center gap-3">

              <a
                href="<%= compare_admin_ecosystems_load_sources_entity_path(@entity) %>"
                class="
                  rounded-2xl
                  border-2
                  border-slate-100
                  bg-white
                  px-5
                  py-3
                  text-xs
                  font-black
                  text-slate-500
                  transition
                  hover:border-slate-200
                  hover:bg-slate-50
                "
              >
                Back to comparison
              </a>

              <button
                type="submit"
                class="
                  rounded-2xl
                  border-2
                  border-orange-300
                  bg-gradient-to-r
                  from-orange-400
                  to-amber-400
                  px-6
                  py-3
                  text-xs
                  font-black
                  text-white
                  shadow-md
                  shadow-orange-200/60
                  transition-all
                  duration-300
                  hover:-translate-y-0.5
                  hover:from-orange-500
                  hover:to-amber-500
                  hover:shadow-lg
                "
                data-diff-intelligence-target="saveButton"
              >
                Save intelligence
              </button>

            </div>

          </div>

        </div>

      </form>

    </div>

  </div>

</div>