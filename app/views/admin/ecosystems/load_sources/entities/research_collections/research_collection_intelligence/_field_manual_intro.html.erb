
<%# ============================================================================
RESEARCH COLLECTION INTELLIGENCE — INTRODUCTION
Purpose:
Explain what the dashboard measures, how to interpret its metrics, and where
to begin. This partial is intentionally compact; the full field manual follows.
============================================================================ %>

<section
  aria-labelledby="research-intelligence-intro-title"
  class="relative mb-8 overflow-hidden rounded-[28px] border-2 border-indigo-100 bg-gradient-to-br from-white via-indigo-50/50 to-sky-50/40 p-5 shadow-sm shadow-indigo-100/40 md:p-7"
>
  <div class="pointer-events-none absolute -right-12 -top-12 h-40 w-40 rounded-full bg-indigo-200/20 blur-3xl"></div>

  <div class="relative">
    <div class="flex flex-wrap items-center gap-2">
      <span class="rounded-full border border-indigo-200 bg-indigo-50 px-3 py-1.5 text-[10px] font-black uppercase tracking-[0.16em] text-indigo-700">
        Research field guide
      </span>

      <span class="rounded-full border border-sky-200 bg-sky-50 px-3 py-1.5 text-[10px] font-bold text-sky-700">
        Start here
      </span>
    </div>

    <div class="mt-5 grid grid-cols-1 gap-6 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-8">
        <h2 id="research-intelligence-intro-title" class="text-2xl font-black tracking-tight text-slate-900 md:text-3xl">
          Understand the intelligence behind your research
        </h2>

        <p class="mt-3 max-w-3xl text-sm leading-7 text-slate-600 md:text-base">
          This dashboard brings together the questions your research asks,
          the objectives guiding the investigation, the findings it produces,
          and the evidence used to evaluate those findings. It also highlights
          contradictions, unfinished work, and connections between research
          elements.
        </p>

        <p class="mt-3 max-w-3xl text-sm leading-7 text-slate-500">
          Think of it as a research observatory rather than a simple report.
          The numbers describe the current recorded state of your collection;
          they do not automatically establish that a conclusion is correct,
          that evidence is reliable, or that the investigation is complete.
        </p>
      </div>

      <div class="lg:col-span-4">
        <div class="rounded-2xl border border-indigo-100 bg-white/90 p-5 shadow-sm">
          <div class="text-[10px] font-black uppercase tracking-[0.18em] text-indigo-500">
            Reading sequence
          </div>

          <ol class="mt-4 space-y-3">
            <% [
                 ["01", "Questions", "What remains unknown?"],
                 ["02", "Objectives", "What must be investigated?"],
                 ["03", "Findings", "What has been learned?"],
                 ["04", "Evidence", "What supports the claims?"]
               ].each do |number, title, description| %>
              <li class="flex items-start gap-3">
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-xl border border-indigo-100 bg-indigo-50 text-[10px] font-black text-indigo-700">
                  <%= number %>
                </span>

                <div>
                  <div class="text-xs font-black text-slate-800"><%= title %></div>
                  <p class="mt-1 text-xs leading-5 text-slate-500"><%= description %></p>
                </div>
              </li>
            <% end %>
          </ol>
        </div>
      </div>
    </div>

    <div class="mt-6 rounded-2xl border border-amber-200 bg-amber-50/80 p-4">
      <div class="flex items-start gap-3">
        <span class="text-xl" aria-hidden="true">💡</span>

        <div>
          <h3 class="text-xs font-black uppercase tracking-wider text-amber-800">
            An important distinction
          </h3>

          <p class="mt-2 text-sm leading-6 text-amber-900/80">
            <strong>Research activity is not the same as research quality.</strong>
            A high completion percentage tells you about recorded progress.
            Confidence depends on the quality, relevance, independence, and
            consistency of the underlying evidence.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>