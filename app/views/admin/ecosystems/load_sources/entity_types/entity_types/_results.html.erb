<%= turbo_frame_tag "entity_types_results" do %>

  <div
    data-admin_entity_types-target="results"
    class="grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-3"
  >

    <% if entity_types.present? %>

      <% entity_types.each do |entity_type| %>

        <div
          class="rounded-2xl border border-gray-200
                 bg-white p-6 shadow-sm
                 dark:border-gray-800 dark:bg-gray-900"
        >

          <div class="flex items-start justify-between gap-4">

            <div class="min-w-0">

              <h2
                class="truncate text-lg font-bold
                       text-gray-900 dark:text-white"
              >
                <%= entity_type.name %>
              </h2>

              <div class="mt-1 font-mono text-xs text-indigo-500">
                <%= entity_type.slug %>
              </div>

            </div>

            <% if entity_type.active? %>

              <span
                class="shrink-0 rounded-full bg-emerald-100
                       px-3 py-1 text-xs font-semibold
                       text-emerald-700"
              >
                Active
              </span>

            <% else %>

              <span
                class="shrink-0 rounded-full bg-gray-100
                       px-3 py-1 text-xs font-semibold
                       text-gray-500"
              >
                Inactive
              </span>

            <% end %>

          </div>

          <% if entity_type.description.present? %>

            <p class="mt-4 line-clamp-3 text-sm text-gray-500">
              <%= entity_type.description %>
            </p>

          <% else %>

            <p class="mt-4 text-sm italic text-gray-400">
              No description.
            </p>

          <% end %>

          <div
            class="mt-6 flex items-center justify-between
                   border-t border-gray-100 pt-4"
          >

            <%= link_to(
                  "View",
                  admin_ecosystems_load_sources_entity_types_entity_type_path(
                    entity_type
                  ),
                  data: { turbo_frame: "_top" },
                  class: "text-sm font-semibold text-indigo-600"
                ) %>

            <%= link_to(
                  "Edit",
                  edit_admin_ecosystems_load_sources_entity_types_entity_type_path(
                    entity_type
                  ),
                  data: { turbo_frame: "_top" },
                  class: "text-sm font-semibold text-gray-600"
                ) %>

          </div>

        </div>

      <% end %>

    <% else %>

      <div class="md:col-span-2 xl:col-span-3">

        <div
          class="rounded-2xl border border-dashed
                 border-gray-300 bg-white p-12 text-center"
        >

          <div class="text-3xl">
            🧩
          </div>

          <h3 class="mt-4 text-lg font-bold text-gray-900">
            No entity types found
          </h3>

          <p class="mt-2 text-sm text-gray-500">
            Try changing your search.
          </p>

        </div>

      </div>

    <% end %>

  </div>

<% end %>
