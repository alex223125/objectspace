<div class="min-h-screen bg-slate-50 dark:bg-gray-950">

  <div class="mx-auto max-w-4xl px-5 py-10">

    <div class="mb-8 flex items-center justify-between">

      <%= link_to(
            "← Entity Types",
            admin_ecosystems_load_sources_entity_types_entity_types_path,
            class: "text-sm font-medium text-gray-500 hover:text-indigo-600"
          ) %>


      <div class="flex items-center gap-3">

        <%= link_to(
              "Edit",
              edit_admin_ecosystems_load_sources_entity_types_entity_type_path(@entity_type),
              class: "rounded-xl border border-gray-300 px-4 py-2
                      text-sm font-semibold text-gray-700
                      hover:bg-gray-50
                      dark:border-gray-700 dark:text-gray-300"
            ) %>


        <%= button_to(
              "Delete",
              admin_ecosystems_load_sources_entity_types_entity_type_path(@entity_type),
              method: :delete,
              data: {
                turbo_confirm: "Delete #{@entity_type.name}?"
              },
              class: "rounded-xl bg-red-600 px-4 py-2 text-sm
                      font-semibold text-white hover:bg-red-700"
            ) %>

      </div>

    </div>


    <div class="rounded-3xl border border-gray-200 bg-white p-8 shadow-sm
                dark:border-gray-800 dark:bg-gray-900">

      <div class="flex items-start gap-5">

        <div
          class="flex h-16 w-16 shrink-0 items-center justify-center
                 rounded-2xl bg-indigo-100 text-3xl
                 dark:bg-indigo-900/40"
        >
          🧩
        </div>


        <div class="flex-1">

          <div class="flex items-center gap-3">

            <h1 class="text-3xl font-bold text-gray-900 dark:text-white">
              <%= @entity_type.name %>
            </h1>

            <% if @entity_type.active? %>

              <span class="rounded-full bg-emerald-100 px-3 py-1
                           text-xs font-semibold text-emerald-700">
                Active
              </span>

            <% else %>

              <span class="rounded-full bg-gray-100 px-3 py-1
                           text-xs font-semibold text-gray-500">
                Inactive
              </span>

            <% end %>

          </div>


          <div class="mt-2 font-mono text-sm text-indigo-500">
            <%= @entity_type.slug %>
          </div>

        </div>

      </div>


      <div class="mt-8 border-t border-gray-200 pt-8 dark:border-gray-800">

        <h2 class="text-sm font-semibold uppercase tracking-wider text-gray-400">
          Description
        </h2>

        <p class="mt-3 leading-7 text-gray-600 dark:text-gray-300">
          <%= @entity_type.description.presence || "No description provided." %>
        </p>

      </div>


      <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2">

        <div class="rounded-xl bg-gray-50 p-4 dark:bg-gray-950">

          <div class="text-xs uppercase tracking-wider text-gray-400">
            Created
          </div>

          <div class="mt-1 text-sm font-medium text-gray-900 dark:text-white">
            <%= @entity_type.created_at&.strftime("%Y-%m-%d %H:%M") %>
          </div>

        </div>


        <div class="rounded-xl bg-gray-50 p-4 dark:bg-gray-950">

          <div class="text-xs uppercase tracking-wider text-gray-400">
            Updated
          </div>

          <div class="mt-1 text-sm font-medium text-gray-900 dark:text-white">
            <%= @entity_type.updated_at&.strftime("%Y-%m-%d %H:%M") %>
          </div>

        </div>

      </div>

    </div>

  </div>

</div>
