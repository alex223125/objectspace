<aside
  class="group fixed left-0 top-0 z-40 flex h-screen w-72
         flex-col overflow-hidden
         border-r border-slate-200
         bg-white
         shadow-[4px_0_30px_rgba(15,23,42,0.04)]
         transition-all duration-300
         lg:translate-x-0">

  <!-- ========================================================= -->
  <!-- DECORATIVE BACKGROUND -->
  <!-- ========================================================= -->

  <div class="pointer-events-none absolute inset-0 overflow-hidden">

    <div
      class="absolute -left-24 -top-24 h-72 w-72
             rounded-full bg-amber-200/30 blur-[90px]">
    </div>

    <div
      class="absolute -right-24 top-[35%] h-72 w-72
             rounded-full bg-sky-200/25 blur-[90px]">
    </div>

    <div
      class="absolute -bottom-24 left-[25%] h-72 w-72
             rounded-full bg-violet-200/20 blur-[90px]">
    </div>

  </div>


  <!-- ========================================================= -->
  <!-- BRAND HEADER -->
  <!-- ========================================================= -->

  <div
    class="relative flex h-20 shrink-0 items-center
           justify-between
           border-b border-slate-100
           px-5">

    <%= link_to admin_root_path,
                class: "group/brand flex items-center gap-3" do %>

      <!-- Logo -->

      <div
        class="flex h-11 w-11 shrink-0 items-center
               justify-center rounded-2xl
               border-2 border-amber-200
               bg-gradient-to-br
               from-amber-50 to-orange-50
               shadow-sm shadow-amber-100
               transition-all duration-300
               group-hover/brand:-rotate-3
               group-hover/brand:scale-105">

        <svg
          class="h-6 w-6 text-amber-500"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor">

          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M14 10l-2 1m0 0l-2-1m2 1v2.5M20 7l-2 1m2-1l-2-1m2 1v2.5M14 4l-2-1-2 1M4 7l2-1M4 7l2 1M4 7v2.5M12 21l-2-1m2 1l2-1m-2 1v-2.5M6 18l-2-1v-2.5M18 18l2-1v-2.5"
            />

        </svg>

      </div>


      <!-- Brand -->

      <div>

        <div
          class="text-lg font-black tracking-tight
                 text-slate-800">

          Objectspace

        </div>

        <div
          class="text-[9px] font-black uppercase
                 tracking-[0.2em] text-amber-500">

          Admin Quest

        </div>

      </div>

    <% end %>

  </div>


  <!-- ========================================================= -->
  <!-- ADMIN PROFILE / LEVEL -->
  <!-- ========================================================= -->

  <div class="relative px-4 pt-5">

    <div
      class="rounded-[22px]
             border border-slate-200
             bg-gradient-to-br
             from-slate-50 via-white to-amber-50
             p-4
             shadow-sm">

      <div class="flex items-center gap-3">

        <!-- Avatar -->

        <div
          class="flex h-11 w-11 shrink-0
                 items-center justify-center
                 rounded-2xl
                 bg-gradient-to-br
                 from-violet-500 to-indigo-500
                 text-sm font-black text-white
                 shadow-md shadow-violet-200">

          A

        </div>


        <div class="min-w-0">

          <div
            class="truncate text-sm font-black
                   text-slate-700">

            Administrator

          </div>

          <div
            class="mt-0.5 text-[9px] font-black
                   uppercase tracking-wider
                   text-slate-400">

            System Guardian

          </div>

        </div>

      </div>


      <!-- XP Progress -->

      <div class="mt-4">

        <div class="mb-2 flex items-center justify-between">

          <span
            class="text-[9px] font-black uppercase
                   tracking-widest text-slate-400">

            Admin Level

          </span>

          <span
            class="rounded-full
                   bg-violet-50 px-2 py-0.5
                   text-[9px] font-black
                   text-violet-500">

            LVL 12

          </span>

        </div>


        <div
          class="h-2 overflow-hidden
                 rounded-full bg-slate-200">

          <div
            class="h-full w-[72%]
                   rounded-full
                   bg-gradient-to-r
                   from-violet-500
                   via-sky-400
                   to-emerald-400
                   shadow-sm">

          </div>

        </div>


        <div
          class="mt-2 flex items-center justify-between">

          <span
            class="text-[8px] font-bold
                   text-slate-400">

            7,240 XP

          </span>

          <span
            class="text-[8px] font-bold
                   text-slate-400">

            10,000 XP

          </span>

        </div>

      </div>

    </div>

  </div>


  <!-- ========================================================= -->
  <!-- NAVIGATION -->
  <!-- ========================================================= -->

  <div
    class="relative flex-1 overflow-y-auto
           px-4 py-6">

    <!-- ======================================================= -->
    <!-- MAIN QUEST -->
    <!-- ======================================================= -->

    <div class="mb-3 px-3">

      <div
        class="text-[9px] font-black uppercase
               tracking-[0.2em] text-slate-400">

        Main Quest

      </div>

    </div>


    <nav class="space-y-1">


      <!-- Dashboard -->

      <%= link_to admin_root_path,
                  class: "group flex items-center gap-3
                  rounded-2xl px-3 py-3
                  text-sm font-bold
                  transition-all duration-200
                  #{current_page?(admin_root_path) ?
                                                'bg-amber-50 text-amber-600 shadow-sm' :
                                                'text-slate-600 hover:bg-amber-50 hover:text-amber-600'}" do %>

        <span
          class="flex h-9 w-9 shrink-0
                 items-center justify-center
                 rounded-xl
                 bg-slate-100
                 text-base
                 transition
                 group-hover:scale-105
                 group-hover:bg-amber-100">

          🏠

        </span>

        <span class="flex-1">
          Dashboard
        </span>

      <% end %>


      <!-- Articles -->

      <%= link_to admin_article_versions_path,
                  class: "group flex items-center gap-3
                  rounded-2xl px-3 py-3
                  text-sm font-bold
                  transition-all duration-200
                  #{current_page?(admin_article_versions_path) ?
                                                'bg-rose-50 text-rose-600 shadow-sm' :
                                                'text-slate-600 hover:bg-rose-50 hover:text-rose-600'}" do %>

        <span
          class="flex h-9 w-9 shrink-0
                 items-center justify-center
                 rounded-xl
                 bg-rose-50
                 text-base
                 transition
                 group-hover:scale-105">

          📚

        </span>

        <span class="flex-1">
          Articles
        </span>

        <span
          class="rounded-full
                 bg-rose-100
                 px-2 py-0.5
                 text-[8px] font-black
                 text-rose-500">

          QUEST

        </span>

      <% end %>

    </nav>


    <!-- ======================================================= -->
    <!-- KNOWLEDGE -->
    <!-- ======================================================= -->

    <div class="mb-3 mt-8 px-3">

      <div
        class="text-[9px] font-black uppercase
               tracking-[0.2em] text-slate-400">

        Knowledge

      </div>

    </div>


    <nav class="space-y-1">


      <!-- Articles CMS -->

      <%= link_to admin_article_versions_path,
                  class: "group flex items-center gap-3
                  rounded-2xl px-3 py-3
                  text-sm font-bold
                  text-slate-600
                  transition-all duration-200
                  hover:bg-violet-50
                  hover:text-violet-600" do %>

        <span
          class="flex h-9 w-9 shrink-0
                 items-center justify-center
                 rounded-xl bg-violet-50
                 text-base
                 transition
                 group-hover:scale-105">

          🧠

        </span>

        <span class="flex-1">
          Knowledge Base
        </span>

      <% end %>


      <!-- Search -->

      <%= link_to admin_article_versions_path,
                  class: "group flex items-center gap-3
                  rounded-2xl px-3 py-3
                  text-sm font-bold
                  text-slate-600
                  transition-all duration-200
                  hover:bg-sky-50
                  hover:text-sky-600" do %>

        <span
          class="flex h-9 w-9 shrink-0
                 items-center justify-center
                 rounded-xl bg-sky-50
                 text-base
                 transition
                 group-hover:scale-105">

          🔎

        </span>

        <span class="flex-1">
          Explore Content
        </span>

      <% end %>

    </nav>


    <!-- ======================================================= -->
    <!-- SYSTEM -->
    <!-- ======================================================= -->

    <div class="mb-3 mt-8 px-3">

      <div
        class="text-[9px] font-black uppercase
               tracking-[0.2em] text-slate-400">

        System

      </div>

    </div>


    <nav class="space-y-1">


      <!-- Settings -->

      <%= link_to "#",
                  class: "group flex items-center gap-3
                  rounded-2xl px-3 py-3
                  text-sm font-bold
                  text-slate-600
                  transition-all duration-200
                  hover:bg-slate-50
                  hover:text-slate-800" do %>

        <span
          class="flex h-9 w-9 shrink-0
                 items-center justify-center
                 rounded-xl bg-slate-100
                 text-base">

          ⚙️

        </span>

        <span class="flex-1">
          Settings
        </span>

      <% end %>


      <!-- Permissions -->

      <%= link_to "#",
                  class: "group flex items-center gap-3
                  rounded-2xl px-3 py-3
                  text-sm font-bold
                  text-slate-600
                  transition-all duration-200
                  hover:bg-slate-50
                  hover:text-slate-800" do %>

        <span
          class="flex h-9 w-9 shrink-0
                 items-center justify-center
                 rounded-xl bg-slate-100
                 text-base">

          🛡️

        </span>

        <span class="flex-1">
          Permissions
        </span>

      <% end %>

    </nav>

  </div>


  <!-- ========================================================= -->
  <!-- DAILY QUEST -->
  <!-- ========================================================= -->

  <div
    class="relative shrink-0
           border-t border-slate-100
           p-4">

    <div
      class="relative overflow-hidden
             rounded-[22px]
             border-2 border-amber-100
             bg-gradient-to-br
             from-amber-50
             via-white
             to-orange-50
             p-4">

      <!-- Glow -->

      <div
        class="pointer-events-none absolute
               -right-8 -top-8
               h-24 w-24 rounded-full
               bg-amber-300/30
               blur-2xl">
      </div>


      <div class="relative">

        <div class="flex items-center gap-2">

          <span class="text-lg">
            🏆
          </span>

          <span
            class="text-[9px] font-black uppercase
                   tracking-widest
                   text-amber-600">

            Daily Quest

          </span>

        </div>


        <p
          class="mt-2 text-xs font-bold
                 leading-5 text-slate-600">

          Grow the knowledge ecosystem.

        </p>


        <div class="mt-3">

          <div
            class="mb-1 flex items-center
                   justify-between">

            <span
              class="text-[8px] font-black
                     uppercase tracking-wider
                     text-slate-400">

              Progress

            </span>

            <span
              class="text-[9px] font-black
                     text-emerald-500">

              68%

            </span>

          </div>


          <div
            class="h-1.5 overflow-hidden
                   rounded-full bg-white">

            <div
              class="h-full w-[68%]
                     rounded-full
                     bg-gradient-to-r
                     from-amber-400
                     to-orange-400">

            </div>

          </div>

        </div>

      </div>

    </div>


    <!-- ======================================================= -->
    <!-- SIGN OUT -->
    <!-- ======================================================= -->

    <%= button_to destroy_admin_user_session_path,
                  method: :delete,
                  class: "group mt-3 flex w-full
                items-center gap-3
                rounded-2xl px-3 py-2.5
                text-sm font-bold
                text-slate-500
                transition-all duration-200
                hover:bg-red-50
                hover:text-red-500" do %>

      <span
        class="flex h-8 w-8 shrink-0
               items-center justify-center
               rounded-xl bg-slate-100
               transition
               group-hover:bg-red-100">

        🚪

      </span>

      <span>
        Sign out
      </span>

    <% end %>

  </div>

</aside>