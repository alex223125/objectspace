<%# ============================================================ %>
<%# FILE: app/views/admin/support_messages/_message.html.erb    %>
<%# ============================================================ %>
<%# Single row rendered inside the support messages <tbody>      %>
<%# ============================================================ %>


<tr
  data-infinite-scroll-row
  class="group border-b border-slate-100
         transition-all duration-200
         hover:bg-sky-50/40
         dark:border-strokedark
         dark:hover:bg-sky-500/5"
>


  <%# ========================================================== %>
  <%# VISITOR                                                     %>
  <%# ========================================================== %>

  <td class="px-6 py-5">

    <div class="flex items-center gap-3">

      <div
        class="flex h-11 w-11 shrink-0 items-center
               justify-center rounded-xl
               border border-sky-100
               bg-gradient-to-br from-sky-50 to-violet-50
               text-lg
               dark:border-sky-500/20
               dark:from-sky-500/10
               dark:to-violet-500/10"
      >
        💬
      </div>


      <div class="min-w-0">

        <div
          class="truncate text-sm font-black
                 text-slate-700 dark:text-white"
        >
          <%= message.first_name %>
          <%= message.last_name %>
        </div>


        <div
          class="mt-1 truncate text-xs
                 text-slate-400"
        >
          <%= message.email %>
        </div>


        <% if message.organization_name.present? %>

          <div
            class="mt-1 truncate text-[10px]
                   font-semibold text-slate-400"
          >
            <%= message.organization_name %>
          </div>

        <% end %>

      </div>

    </div>

  </td>


  <%# ========================================================== %>
  <%# SUPPORT CATEGORY                                             %>
  <%# ========================================================== %>

  <td class="px-6 py-5">

    <div
      class="text-xs font-black
             text-slate-600 dark:text-gray-300"
    >
      <%= message.support_category_label %>
    </div>


    <% if message.respond_to?(:source) && message.source.present? %>

      <div
        class="mt-1 flex items-center gap-1.5
               text-[10px] text-slate-400"
      >

        <span>
          ↳
        </span>

        <span>
          <%= message.source_label %>
        </span>

      </div>

    <% end %>


    <% if message.attachments.attached? %>

      <div
        class="mt-2 inline-flex items-center gap-1.5
               rounded-full
               border border-violet-100
               bg-violet-50
               px-2.5 py-1
               text-[9px] font-black
               uppercase tracking-wider
               text-violet-600
               dark:border-violet-500/20
               dark:bg-violet-500/10
               dark:text-violet-400"
      >

        📎

        <%= message.attachments.count %>

        <%= message.attachments.count == 1 ? "attachment" : "attachments" %>

      </div>

    <% end %>

  </td>


  <%# ========================================================== %>
  <%# EMAIL VERIFICATION                                           %>
  <%# ========================================================== %>

  <td class="px-6 py-5">

    <% if message.email_confirmed? %>

      <span
        class="inline-flex items-center gap-1.5
               rounded-full
               border border-emerald-100
               bg-emerald-50
               px-3 py-1.5
               text-[9px] font-black
               uppercase tracking-wider
               text-emerald-600
               dark:border-emerald-500/20
               dark:bg-emerald-500/10
               dark:text-emerald-400"
      >

        <span
          class="h-1.5 w-1.5 rounded-full
                 bg-emerald-400"
        ></span>

        Confirmed

      </span>

    <% else %>

      <span
        class="inline-flex items-center gap-1.5
               rounded-full
               border border-amber-100
               bg-amber-50
               px-3 py-1.5
               text-[9px] font-black
               uppercase tracking-wider
               text-amber-600
               dark:border-amber-500/20
               dark:bg-amber-500/10
               dark:text-amber-400"
      >

        <span
          class="h-1.5 w-1.5 rounded-full
                 bg-amber-400"
        ></span>

        Awaiting Email

      </span>

    <% end %>

  </td>


  <%# ========================================================== %>
  <%# MESSAGE STATUS                                               %>
  <%# ========================================================== %>

  <td class="px-6 py-5">

    <%# -------------------------------------------------------- %>
    <%# Convert status key to human-readable label               %>
    <%# -------------------------------------------------------- %>

    <% status_label =
         SupportMessage::STATUSES.to_h[message.status] ||
           message.status.to_s.humanize
    %>


    <%# -------------------------------------------------------- %>
    <%# Status color                                               %>
    <%# -------------------------------------------------------- %>

    <% case message.status.to_s %>

    <% when "pending_confirmation" %>

      <% status_classes =
           "border-amber-100 bg-amber-50 text-amber-600 dark:border-amber-500/20 dark:bg-amber-500/10 dark:text-amber-400" %>

      <% status_icon = "⏳" %>


    <% when "confirmed" %>

      <% status_classes =
           "border-sky-100 bg-sky-50 text-sky-600 dark:border-sky-500/20 dark:bg-sky-500/10 dark:text-sky-400" %>

      <% status_icon = "✓" %>


    <% when "read" %>

      <% status_classes =
           "border-violet-100 bg-violet-50 text-violet-600 dark:border-violet-500/20 dark:bg-violet-500/10 dark:text-violet-400" %>

      <% status_icon = "◉" %>


    <% when "replied" %>

      <% status_classes =
           "border-emerald-100 bg-emerald-50 text-emerald-600 dark:border-emerald-500/20 dark:bg-emerald-500/10 dark:text-emerald-400" %>

      <% status_icon = "↗" %>


    <% when "archived" %>

      <% status_classes =
           "border-slate-200 bg-slate-100 text-slate-500 dark:border-strokedark dark:bg-form-input dark:text-gray-400" %>

      <% status_icon = "▣" %>


    <% else %>

      <% status_classes =
           "border-slate-200 bg-slate-50 text-slate-500 dark:border-strokedark dark:bg-form-input dark:text-gray-400" %>

      <% status_icon = "•" %>

    <% end %>


    <span
      class="inline-flex items-center gap-1.5
             rounded-full border
             px-3 py-1.5
             text-[9px] font-black
             uppercase tracking-wider
             <%= status_classes %>"
    >

      <span>
        <%= status_icon %>
      </span>

      <%= status_label %>

    </span>

  </td>


  <%# ========================================================== %>
  <%# RECEIVED                                                     %>
  <%# ========================================================== %>

  <td class="px-6 py-5">

    <div
      class="text-xs font-bold
             text-slate-500 dark:text-gray-300"
    >
      <%= message.created_at.strftime("%d %b %Y") %>
    </div>


    <div
      class="mt-1 text-[10px]
             text-slate-400"
    >
      <%= message.created_at.strftime("%H:%M") %>
    </div>


    <div
      class="mt-1 text-[9px]
             text-slate-300
             dark:text-gray-500"
    >
      Updated
      <%= message.updated_at.strftime("%d %b %Y %H:%M") %>
    </div>

  </td>


  <%# ========================================================== %>
  <%# ACTION                                                       %>
  <%# ========================================================== %>

  <td class="px-6 py-5 text-right">

    <%= link_to admin_support_message_path(message),
                class: "inline-flex items-center gap-2
                       rounded-xl
                       border border-sky-200
                       bg-sky-50
                       px-4 py-2
                       text-[10px] font-black
                       uppercase tracking-wider
                       text-sky-600
                       transition-all duration-200
                       hover:-translate-y-0.5
                       hover:border-sky-300
                       hover:bg-sky-100
                       hover:shadow-sm
                       dark:border-sky-500/20
                       dark:bg-sky-500/10
                       dark:text-sky-400" do %>

      Open

      <span
        class="transition-transform duration-200
               group-hover:translate-x-0.5"
      >
        →
      </span>

    <% end %>

  </td>

</tr>