<div
  class="relative min-h-screen overflow-hidden bg-white dark:bg-boxdark"
  data-controller="algorithm-versions-admin-dashboard-infinity-scroll"
  data-algorithm-versions-admin-dashboard-infinity-scroll-current-page-value="<%= @articles.current_page %>"
  data-algorithm-versions-admin-dashboard-infinity-scroll-total-pages-value="<%= @articles.total_pages %>"
  data-algorithm-versions-admin-dashboard-infinity-scroll-url-value="<%= admin_article_versions_path %>"
>

  <!-- ========================================================= -->
  <!-- BACKGROUND ATMOSPHERE -->
  <!-- ========================================================= -->

  <div class="pointer-events-none absolute inset-0 overflow-hidden">

    <div
      class="absolute -left-40 -top-40 h-[500px] w-[500px]
             rounded-full bg-amber-200/30 blur-[120px]
             dark:bg-amber-500/10">
    </div>

    <div
      class="absolute right-[-160px] top-[10%] h-[500px] w-[500px]
             rounded-full bg-sky-200/30 blur-[120px]
             dark:bg-sky-500/10">
    </div>

    <div
      class="absolute bottom-[-200px] left-[20%] h-[500px] w-[500px]
             rounded-full bg-emerald-200/25 blur-[120px]
             dark:bg-emerald-500/10">
    </div>

    <div
      class="absolute bottom-[10%] right-[15%] h-[400px] w-[400px]
             rounded-full bg-violet-200/25 blur-[120px]
             dark:bg-violet-500/10">
    </div>

    <div
      class="absolute left-[8%] top-[18%] h-2 w-2 rounded-full
             bg-amber-400
             shadow-[0_0_15px_rgba(251,191,36,0.6)]
             animate-bounce">
    </div>

    <div
      class="absolute left-[24%] top-[10%] h-1.5 w-1.5 rounded-full
             bg-sky-400
             shadow-[0_0_15px_rgba(56,189,248,0.6)]
             animate-pulse">
    </div>

    <div
      class="absolute right-[17%] top-[28%] h-2 w-2 rounded-full
             bg-violet-400
             shadow-[0_0_15px_rgba(139,92,246,0.6)]
             animate-bounce
             [animation-delay:700ms]">
    </div>

    <div
      class="absolute right-[7%] bottom-[20%] h-1.5 w-1.5 rounded-full
             bg-emerald-400
             shadow-[0_0_15px_rgba(52,211,153,0.6)]
             animate-pulse
             [animation-delay:1200ms]">
    </div>

  </div>


  <!-- ========================================================= -->
  <!-- TOAST -->
  <!-- ========================================================= -->

  <div
    data-algorithm-versions-admin-dashboard-infinity-scroll-target="toast"
    class="pointer-events-none fixed left-1/2 top-5 z-[9999]
           -translate-x-1/2 -translate-y-5
           opacity-0 transition-all duration-300"
    aria-live="polite"
    aria-atomic="true"
  >

    <div
      data-algorithm-versions-admin-dashboard-infinity-scroll-target="toastContent"
      class="flex items-center gap-3 rounded-2xl
             border-2 border-sky-200
             bg-white px-5 py-3
             text-sm font-black text-sky-600
             shadow-[0_15px_45px_rgba(14,165,233,0.18)]
             dark:border-sky-500/30
             dark:bg-boxdark
             dark:text-sky-400"
    >

      <span
        data-algorithm-versions-admin-dashboard-infinity-scroll-target="toastSpinner"
        class="hidden h-4 w-4 animate-spin rounded-full
               border-2 border-sky-200
               border-t-sky-500"
      ></span>

      <span
        data-algorithm-versions-admin-dashboard-infinity-scroll-target="toastIcon"
        class="text-base"
      >
        ⟳
      </span>

      <span
        data-algorithm-versions-admin-dashboard-infinity-scroll-target="toastMessage"
      >
        Loading more articles...
      </span>

    </div>

  </div>


  <!-- ========================================================= -->
  <!-- MAIN -->
  <!-- ========================================================= -->

  <div class="relative mx-auto max-w-7xl px-5 py-10 sm:px-7 lg:px-10">


    <!-- ======================================================= -->
    <!-- HERO -->
    <!-- ======================================================= -->

    <div
      class="mb-10 flex flex-col gap-6
             lg:flex-row lg:items-end lg:justify-between"
    >

      <div class="max-w-3xl">

        <div class="flex items-center gap-3">

          <div
            class="flex h-11 w-11 items-center justify-center
                   rounded-2xl border-2 border-amber-200
                   bg-amber-50 text-xl
                   shadow-sm shadow-amber-100
                   dark:border-amber-500/20
                   dark:bg-amber-500/10"
          >
            📚
          </div>

          <div>

            <div
              class="text-[10px] font-black uppercase
                     tracking-[0.22em] text-amber-600"
            >
              Knowledge Quest
            </div>

            <div
              class="mt-1 text-xs font-medium text-slate-400
                     dark:text-gray-500"
            >
              Manage your content ecosystem
            </div>

          </div>

        </div>

        <h1
          class="mt-6 text-4xl font-black tracking-tight
                 text-slate-800 dark:text-white
                 sm:text-5xl"
        >
          Article

          <span
            class="bg-gradient-to-r from-amber-500
                   via-sky-500 to-violet-500
                   bg-clip-text text-transparent"
          >
            Command Center
          </span>
        </h1>

        <p
          class="mt-4 max-w-2xl text-sm leading-6
                 text-slate-500 dark:text-gray-400"
        >
          Search, organize and evolve your knowledge base.
          Every article is another building block in your learning ecosystem.
        </p>

      </div>


      <div class="shrink-0">

        <%= link_to new_admin_article_version_path,
                    class: "group inline-flex items-center gap-3
                           rounded-2xl border-2 border-amber-200
                           bg-gradient-to-r from-amber-400 to-orange-400
                           px-6 py-3.5 text-sm font-black text-white
                           shadow-lg shadow-amber-200/40
                           transition-all duration-300
                           hover:-translate-y-1
                           hover:from-amber-500 hover:to-orange-500
                           hover:shadow-xl hover:shadow-amber-200/60
                           dark:border-amber-500/30" do %>

          <span
            class="text-lg transition-transform duration-300
                   group-hover:rotate-90"
          >
            +
          </span>

          <span>
            Create Article
          </span>

          <span
            class="text-white/70 transition-transform duration-300
                   group-hover:translate-x-1"
          >
            →
          </span>

        <% end %>

      </div>

    </div>


    <!-- ======================================================= -->
    <!-- STATS -->
    <!-- ======================================================= -->

    <div class="mb-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">


      <!-- Total Articles -->

      <div
        class="group rounded-[26px]
               border-2 border-rose-100
               bg-white p-5
               shadow-[0_12px_35px_rgba(244,63,94,0.07)]
               transition-all duration-300
               hover:-translate-y-1
               hover:border-rose-200
               dark:border-rose-500/20
               dark:bg-boxdark"
      >

        <div class="flex items-center justify-between">

          <div
            class="flex h-12 w-12 items-center justify-center
                   rounded-2xl border-2 border-rose-200
                   bg-rose-50 text-lg
                   shadow-sm shadow-rose-100
                   dark:border-rose-500/20
                   dark:bg-rose-500/10"
          >
            📖
          </div>

          <span
            class="rounded-full border border-rose-100
                   bg-rose-50 px-3 py-1
                   text-[9px] font-black uppercase
                   tracking-wider text-rose-500
                   dark:border-rose-500/20
                   dark:bg-rose-500/10"
          >
            Library
          </span>

        </div>

        <div class="mt-5">

          <p
            class="text-[10px] font-black uppercase
                   tracking-widest text-slate-400"
          >
            Total Articles
          </p>

          <p
            data-algorithm-versions-admin-dashboard-infinity-scroll-target="totalCount"
            class="mt-1 text-3xl font-black text-slate-800 dark:text-white"
          >
            <%= @articles.respond_to?(:total_count) ? @articles.total_count : @articles.count %>
          </p>

        </div>

      </div>


      <!-- Search -->

      <div
        class="group rounded-[26px]
               border-2 border-sky-100
               bg-white p-5
               shadow-[0_12px_35px_rgba(14,165,233,0.07)]
               transition-all duration-300
               hover:-translate-y-1
               hover:border-sky-200
               dark:border-sky-500/20
               dark:bg-boxdark"
      >

        <div class="flex items-center justify-between">

          <div
            class="flex h-12 w-12 items-center justify-center
                   rounded-2xl border-2 border-sky-200
                   bg-sky-50 text-lg
                   shadow-sm shadow-sky-100
                   dark:border-sky-500/20
                   dark:bg-sky-500/10"
          >
            🔎
          </div>

          <span
            class="rounded-full border border-sky-100
                   bg-sky-50 px-3 py-1
                   text-[9px] font-black uppercase
                   tracking-wider text-sky-500
                   dark:border-sky-500/20
                   dark:bg-sky-500/10"
          >
            Discovery
          </span>

        </div>

        <div class="mt-5">

          <p
            class="text-[10px] font-black uppercase
                   tracking-widest text-slate-400"
          >
            Current Quest
          </p>

          <p
            class="mt-1 truncate text-lg font-black
                   text-slate-800 dark:text-white"
          >
            <%= params[:q].presence || "Explore the library" %>
          </p>

        </div>

      </div>


      <!-- Visibility -->

      <div
        class="group rounded-[26px]
               border-2 border-emerald-100
               bg-white p-5
               shadow-[0_12px_35px_rgba(16,185,129,0.07)]
               transition-all duration-300
               hover:-translate-y-1
               hover:border-emerald-200
               dark:border-emerald-500/20
               dark:bg-boxdark"
      >

        <div class="flex items-center justify-between">

          <div
            class="flex h-12 w-12 items-center justify-center
                   rounded-2xl border-2 border-emerald-200
                   bg-emerald-50 text-lg
                   shadow-sm shadow-emerald-100
                   dark:border-emerald-500/20
                   dark:bg-emerald-500/10"
          >
            🚀
          </div>

          <span
            class="rounded-full border border-emerald-100
                   bg-emerald-50 px-3 py-1
                   text-[9px] font-black uppercase
                   tracking-wider text-emerald-500
                   dark:border-emerald-500/20
                   dark:bg-emerald-500/10"
          >
            Publishing
          </span>

        </div>

        <div class="mt-5">

          <p
            class="text-[10px] font-black uppercase
                   tracking-widest text-slate-400"
          >
            Visibility
          </p>

          <p class="mt-1 text-lg font-black text-slate-800 dark:text-white">

            <% if params[:visibility_status].present? %>
              <%= params[:visibility_status].to_i == 1 ? "Public Only" : "Draft Only" %>
            <% else %>
              All Articles
            <% end %>

          </p>

        </div>

      </div>


      <!-- Level -->

      <div
        class="group rounded-[26px]
               border-2 border-violet-100
               bg-white p-5
               shadow-[0_12px_35px_rgba(139,92,246,0.07)]
               transition-all duration-300
               hover:-translate-y-1
               hover:border-violet-200
               dark:border-violet-500/20
               dark:bg-boxdark"
      >

        <div class="flex items-center justify-between">

          <div
            class="flex h-12 w-12 items-center justify-center
                   rounded-2xl border-2 border-violet-200
                   bg-violet-50 text-lg
                   shadow-sm shadow-violet-100
                   dark:border-violet-500/20
                   dark:bg-violet-500/10"
          >
            🏆
          </div>

          <span
            class="rounded-full border border-violet-100
                   bg-violet-50 px-3 py-1
                   text-[9px] font-black uppercase
                   tracking-wider text-violet-500
                   dark:border-violet-500/20
                   dark:bg-violet-500/10"
          >
            Level Up
          </span>

        </div>

        <div class="mt-5">

          <div class="flex items-end justify-between">

            <div>

              <p
                class="text-[10px] font-black uppercase
                       tracking-widest text-slate-400"
              >
                Knowledge XP
              </p>

              <p
                class="mt-1 text-2xl font-black
                       text-slate-800 dark:text-white"
              >
                +1,850 XP
              </p>

            </div>

            <span class="text-xs font-black text-violet-500">
              68%
            </span>

          </div>

          <div
            class="mt-3 h-2 overflow-hidden rounded-full
                   bg-violet-50 dark:bg-violet-500/10"
          >

            <div
              class="h-full w-[68%] rounded-full
                     bg-gradient-to-r from-violet-400 to-fuchsia-400
                     transition-all duration-700
                     group-hover:w-[82%]"
            ></div>

          </div>

        </div>

      </div>

    </div>


    <!-- ======================================================= -->
    <!-- SEARCH -->
    <!-- ======================================================= -->

    <div
      class="mb-8 rounded-[28px]
             border-2 border-slate-100
             bg-white p-6
             shadow-[0_12px_35px_rgba(15,23,42,0.05)]
             dark:border-strokedark
             dark:bg-boxdark"
    >

      <div class="mb-6 flex items-center gap-4">

        <div
          class="flex h-11 w-11 items-center justify-center
                 rounded-2xl border-2 border-sky-200
                 bg-sky-50 text-lg
                 dark:border-sky-500/20
                 dark:bg-sky-500/10"
        >
          🧭
        </div>

        <div>

          <h2
            class="text-lg font-black text-slate-800 dark:text-white"
          >
            Article Discovery Quest
          </h2>

          <p class="mt-1 text-xs text-slate-400">
            Find the knowledge you are looking for.
          </p>

        </div>

      </div>


      <%= form_with url: admin_article_versions_path,
                    method: :get,
                    local: true do |f| %>

        <div
          class="grid grid-cols-1 gap-5
                 md:grid-cols-2 xl:grid-cols-5"
        >

          <div class="xl:col-span-2">

            <label
              class="mb-2 block text-[10px] font-black uppercase
                     tracking-widest text-slate-400"
            >
              Search Quest
            </label>

            <div class="relative">

              <span
                class="absolute left-4 top-1/2
                       -translate-y-1/2 text-sky-400"
              >
                🔎
              </span>

              <%= f.text_field :q,
                               value: params[:q],
                               placeholder: "Search article knowledge...",
                               class: "w-full rounded-2xl border-2 border-slate-100
                                       bg-slate-50 py-3.5 pl-11 pr-4
                                       text-sm text-slate-700 outline-none
                                       transition focus:border-sky-300
                                       focus:bg-white focus:ring-4
                                       focus:ring-sky-50
                                       dark:border-strokedark
                                       dark:bg-form-input
                                       dark:text-white
                                       dark:focus:border-sky-500" %>

            </div>

          </div>


          <div>

            <label
              class="mb-2 block text-[10px] font-black uppercase
                     tracking-widest text-slate-400"
            >
              Visibility
            </label>

            <%= f.select :visibility_status,
                         [
                           ["Public", 1],
                           ["Draft", 0]
                         ],
                         {
                           include_blank: "All Statuses",
                           selected: params[:visibility_status]
                         },
                         class: "w-full rounded-2xl border-2 border-slate-100
                                 bg-slate-50 px-4 py-3.5 text-sm
                                 text-slate-700 outline-none transition
                                 focus:border-emerald-300
                                 focus:bg-white focus:ring-4
                                 focus:ring-emerald-50
                                 dark:border-strokedark
                                 dark:bg-form-input
                                 dark:text-white" %>

          </div>


          <div>

            <label
              class="mb-2 block text-[10px] font-black uppercase
                     tracking-widest text-slate-400"
            >
              Sort
            </label>

            <%= f.select :sort,
                         [
                           ["Newest", "created_at"],
                           ["Recently Updated", "updated_at"],
                           ["Title", "title"]
                         ],
                         {
                           selected: params[:sort] || "created_at"
                         },
                         class: "w-full rounded-2xl border-2 border-slate-100
                                 bg-slate-50 px-4 py-3.5 text-sm
                                 text-slate-700 outline-none transition
                                 focus:border-violet-300
                                 focus:bg-white focus:ring-4
                                 focus:ring-violet-50
                                 dark:border-strokedark
                                 dark:bg-form-input
                                 dark:text-white" %>

          </div>


          <div>

            <label
              class="mb-2 block text-[10px] font-black uppercase
                     tracking-widest text-slate-400"
            >
              Start Date
            </label>

            <%= f.date_field :start_date,
                             value: params[:start_date],
                             class: "w-full rounded-2xl border-2 border-slate-100
                                     bg-slate-50 px-4 py-3.5 text-sm
                                     text-slate-700 outline-none transition
                                     focus:border-amber-300
                                     focus:bg-white focus:ring-4
                                     focus:ring-amber-50
                                     dark:border-strokedark
                                     dark:bg-form-input
                                     dark:text-white" %>

          </div>


          <div>

            <label
              class="mb-2 block text-[10px] font-black uppercase
                     tracking-widest text-slate-400"
            >
              End Date
            </label>

            <%= f.date_field :end_date,
                             value: params[:end_date],
                             class: "w-full rounded-2xl border-2 border-slate-100
                                     bg-slate-50 px-4 py-3.5 text-sm
                                     text-slate-700 outline-none transition
                                     focus:border-rose-300
                                     focus:bg-white focus:ring-4
                                     focus:ring-rose-50
                                     dark:border-strokedark
                                     dark:bg-form-input
                                     dark:text-white" %>

          </div>

        </div>


        <%= f.hidden_field :direction,
                           value: params[:direction].presence || "desc" %>


        <div
          class="mt-6 flex flex-col gap-3
                 border-t-2 border-slate-50 pt-5
                 sm:flex-row sm:justify-end
                 dark:border-strokedark"
        >

          <%= link_to admin_article_versions_path,
                      class: "inline-flex items-center justify-center gap-2
                             rounded-2xl border-2 border-slate-100
                             bg-white px-5 py-3 text-xs font-black
                             text-slate-500 transition hover:border-slate-200
                             hover:bg-slate-50
                             dark:border-strokedark
                             dark:bg-boxdark dark:text-gray-400" do %>
            ↺
            Reset Quest
          <% end %>

          <%= f.submit "🚀 Explore Articles",
                       class: "cursor-pointer rounded-2xl
                               border-2 border-sky-200
                               bg-gradient-to-r from-sky-400 to-cyan-400
                               px-6 py-3 text-xs font-black text-white
                               shadow-md shadow-sky-200/40
                               transition-all duration-300
                               hover:-translate-y-0.5
                               hover:from-sky-500 hover:to-cyan-500" %>

        </div>

      <% end %>

    </div>


    <!-- ======================================================= -->
    <!-- ARTICLE LIST -->
    <!-- ======================================================= -->

    <div
      class="relative rounded-[30px]
             border-2 border-slate-100
             bg-white
             shadow-[0_15px_45px_rgba(15,23,42,0.06)]
             dark:border-strokedark
             dark:bg-boxdark"
    >

      <!-- HEADER -->

      <div
        class="border-b-2 border-slate-50 px-6 py-6
               dark:border-strokedark sm:px-8"
      >

        <div
          class="flex flex-col gap-4
                 sm:flex-row sm:items-center sm:justify-between"
        >

          <div class="flex items-center gap-4">

            <div
              class="flex h-12 w-12 items-center justify-center
                     rounded-2xl border-2 border-violet-200
                     bg-violet-50 text-lg
                     dark:border-violet-500/20
                     dark:bg-violet-500/10"
            >
              🗺️
            </div>

            <div>

              <h2
                class="text-xl font-black text-slate-800 dark:text-white"
              >
                Knowledge Quest
              </h2>

              <p class="mt-1 text-xs text-slate-400">
                Your article progression map.
              </p>

            </div>

          </div>


          <div
            class="inline-flex w-fit items-center gap-2
                   rounded-full border border-emerald-100
                   bg-emerald-50 px-4 py-2
                   text-[10px] font-black uppercase
                   tracking-wider text-emerald-600
                   dark:border-emerald-500/20
                   dark:bg-emerald-500/10"
          >

            <span
              class="h-2 w-2 rounded-full
                     bg-emerald-400 animate-pulse"
            ></span>

            <span
              data-algorithm-versions-admin-dashboard-infinity-scroll-target="visibleCount"
            >
              <%= @articles.count %>
            </span>

            Articles Loaded

          </div>

        </div>


        <!-- Progress -->

        <div class="mt-6">

          <div class="mb-2 flex items-center justify-between">

            <span
              class="text-[9px] font-black uppercase
                     tracking-widest text-slate-400"
            >
              Knowledge Ecosystem
            </span>

            <span class="text-[10px] font-black text-violet-500">
              Level 04 · 68%
            </span>

          </div>

          <div
            class="h-2 overflow-hidden rounded-full
                   bg-slate-100 dark:bg-meta-4"
          >

            <div
              class="h-full w-[68%] rounded-full
                     bg-gradient-to-r from-emerald-400
                     via-sky-400 to-violet-400"
            ></div>

          </div>

        </div>

      </div>


      <!-- ===================================================== -->
      <!-- TABLE -->
      <!-- ===================================================== -->

      <div class="max-w-full overflow-x-auto">

        <table class="w-full min-w-[900px] table-auto">

          <thead>

          <tr class="bg-slate-50 dark:bg-meta-4">

            <th class="px-6 py-4 text-left">
                <span
                  class="text-[9px] font-black uppercase
                         tracking-widest text-slate-400"
                >
                  Quest
                </span>
            </th>

            <th class="px-6 py-4 text-left">
                <span
                  class="text-[9px] font-black uppercase
                         tracking-widest text-slate-400"
                >
                  Identity
                </span>
            </th>

            <th class="px-6 py-4 text-left">
                <span
                  class="text-[9px] font-black uppercase
                         tracking-widest text-slate-400"
                >
                  Status
                </span>
            </th>

            <th class="px-6 py-4 text-left">
                <span
                  class="text-[9px] font-black uppercase
                         tracking-widest text-slate-400"
                >
                  Created
                </span>
            </th>

            <th class="px-6 py-4 text-right">
                <span
                  class="text-[9px] font-black uppercase
                         tracking-widest text-slate-400"
                >
                  Quest Actions
                </span>
            </th>

          </tr>

          </thead>


          <!-- ================================================= -->
          <!-- IMPORTANT: ONLY <tr> ELEMENTS GO HERE -->
          <!-- ================================================= -->

          <tbody
            data-algorithm-versions-admin-dashboard-infinity-scroll-target="articles"
          >

          <%= render partial: "article",
                     collection: @articles,
                     as: :article,
                     locals: {
                       offset: (@articles.current_page - 1) *
                         @articles.limit_value
                     } %>

          </tbody>

        </table>

      </div>


      <!-- ===================================================== -->
      <!-- LOADING -->
      <!-- ===================================================== -->

      <div
        data-algorithm-versions-admin-dashboard-infinity-scroll-target="loading"
        class="hidden border-t-2 border-slate-50
               px-6 py-12 dark:border-strokedark"
        aria-live="polite"
      >

        <div class="flex flex-col items-center justify-center">

          <div class="relative h-12 w-12">

            <div
              class="absolute inset-0 rounded-full
                     border-4 border-sky-100
                     dark:border-sky-500/10"
