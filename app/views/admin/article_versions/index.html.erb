<div class="relative min-h-screen overflow-hidden bg-white dark:bg-boxdark">

  <!-- ========================================================= -->
  <!-- GAMIFICATION ATMOSPHERE -->
  <!-- ========================================================= -->

  <div class="pointer-events-none absolute inset-0 overflow-hidden">

    <!-- Large colorful background glows -->

    <div
      class="absolute -left-40 -top-40 h-[500px] w-[500px]
             rounded-full bg-amber-200/30 blur-[120px]
             dark:bg-amber-500/10">
    </div>

    <div
      class="absolute right-[-160px] top-[10%] h-[500px] w-[500px]
             rounded-full bg-sky-200/30 blur-[120px]
             dark:bg-sky-500/10">
    </div>

    <div
      class="absolute bottom-[-200px] left-[20%] h-[500px] w-[500px]
             rounded-full bg-emerald-200/25 blur-[120px]
             dark:bg-emerald-500/10">
    </div>

    <div
      class="absolute bottom-[10%] right-[15%] h-[400px] w-[400px]
             rounded-full bg-violet-200/25 blur-[120px]
             dark:bg-violet-500/10">
    </div>


    <!-- Floating particles -->

    <div
      class="absolute left-[8%] top-[18%] h-2 w-2 rounded-full
             bg-amber-400 shadow-[0_0_15px_rgba(251,191,36,0.6)]
             animate-bounce">
    </div>

    <div
      class="absolute left-[24%] top-[10%] h-1.5 w-1.5 rounded-full
             bg-sky-400 shadow-[0_0_15px_rgba(56,189,248,0.6)]
             animate-pulse">
    </div>

    <div
      class="absolute right-[17%] top-[28%] h-2 w-2 rounded-full
             bg-violet-400 shadow-[0_0_15px_rgba(139,92,246,0.6)]
             animate-bounce [animation-delay:700ms]">
    </div>

    <div
      class="absolute right-[7%] bottom-[20%] h-1.5 w-1.5 rounded-full
             bg-emerald-400 shadow-[0_0_15px_rgba(52,211,153,0.6)]
             animate-pulse [animation-delay:1200ms]">
    </div>

  </div>


  <!-- ========================================================= -->
  <!-- MAIN CONTAINER -->
  <!-- ========================================================= -->

  <div class="relative mx-auto max-w-7xl px-5 py-10 sm:px-7 lg:px-10">


    <!-- ======================================================= -->
    <!-- HERO HEADER -->
    <!-- ======================================================= -->

    <div class="mb-10 flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">

      <div class="max-w-3xl">

        <!-- Quest label -->

        <div class="flex items-center gap-3">

          <div
            class="flex h-11 w-11 items-center justify-center
                   rounded-2xl border-2 border-amber-200
                   bg-amber-50 text-xl
                   shadow-sm shadow-amber-100
                   dark:border-amber-500/20
                   dark:bg-amber-500/10">

            📚

          </div>

          <div>

            <div
              class="text-[10px] font-black uppercase
                     tracking-[0.22em] text-amber-600">

              Knowledge Quest

            </div>

            <div
              class="mt-1 text-xs font-medium text-slate-400
                     dark:text-gray-500">

              Manage your content ecosystem

            </div>

          </div>

        </div>


        <!-- Title -->

        <h1
          class="mt-6 text-4xl font-black tracking-tight
                 text-slate-800 dark:text-white
                 sm:text-5xl">

          Article

          <span
            class="bg-gradient-to-r from-amber-500
                   via-sky-500 to-violet-500
                   bg-clip-text text-transparent">

            Command Center

          </span>

        </h1>


        <p
          class="mt-4 max-w-2xl text-sm leading-6
                 text-slate-500 dark:text-gray-400">

          Search, organize and evolve your knowledge base.
          Every article is another building block in your learning ecosystem.

        </p>

      </div>


      <!-- New Article -->

      <div class="shrink-0">

        <%= link_to new_admin_article_version_path,
                    class: "group inline-flex items-center gap-3
                           rounded-2xl border-2 border-amber-200
                           bg-gradient-to-r from-amber-400 to-orange-400
                           px-6 py-3.5
                           text-sm font-black text-white
                           shadow-lg shadow-amber-200/40
                           transition-all duration-300
                           hover:-translate-y-1
                           hover:from-amber-500
                           hover:to-orange-500
                           hover:shadow-xl hover:shadow-amber-200/60
                           dark:border-amber-500/30" do %>

          <span class="text-lg transition-transform duration-300 group-hover:rotate-90">
            +
          </span>

          <span>
            Create Article
          </span>

          <span class="text-white/70 transition-transform duration-300 group-hover:translate-x-1">
            →
          </span>

        <% end %>

      </div>

    </div>


    <!-- ======================================================= -->
    <!-- QUEST STATS -->
    <!-- ======================================================= -->

    <div class="mb-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">


      <!-- Articles -->

      <div
        class="group rounded-[26px]
               border-2 border-rose-100
               bg-white p-5
               shadow-[0_12px_35px_rgba(244,63,94,0.07)]
               transition-all duration-300
               hover:-translate-y-1
               hover:border-rose-200
               hover:shadow-[0_20px_40px_rgba(244,63,94,0.13)]
               dark:border-rose-500/20
               dark:bg-boxdark">

        <div class="flex items-center justify-between">

          <div
            class="flex h-12 w-12 items-center justify-center
                   rounded-2xl border-2 border-rose-200
                   bg-rose-50 text-lg
                   shadow-sm shadow-rose-100
                   dark:border-rose-500/20
                   dark:bg-rose-500/10">

            📖

          </div>

          <span
            class="rounded-full border border-rose-100
                   bg-rose-50 px-3 py-1
                   text-[9px] font-black uppercase
                   tracking-wider text-rose-500
                   dark:border-rose-500/20
                   dark:bg-rose-500/10">

            Library

          </span>

        </div>

        <div class="mt-5">

          <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">
            Total Articles
          </p>

          <p class="mt-1 text-3xl font-black text-slate-800 dark:text-white">
            <%= @articles.respond_to?(:total_count) ? @articles.total_count : @articles.count %>
          </p>

        </div>

      </div>


      <!-- Search -->

      <div
        class="group rounded-[26px]
               border-2 border-sky-100
               bg-white p-5
               shadow-[0_12px_35px_rgba(14,165,233,0.07)]
               transition-all duration-300
               hover:-translate-y-1
               hover:border-sky-200
               dark:border-sky-500/20
               dark:bg-boxdark">

        <div class="flex items-center justify-between">

          <div
            class="flex h-12 w-12 items-center justify-center
                   rounded-2xl border-2 border-sky-200
                   bg-sky-50 text-lg
                   shadow-sm shadow-sky-100
                   dark:border-sky-500/20
                   dark:bg-sky-500/10">

            🔎

          </div>

          <span
            class="rounded-full border border-sky-100
                   bg-sky-50 px-3 py-1
                   text-[9px] font-black uppercase
                   tracking-wider text-sky-500
                   dark:border-sky-500/20
                   dark:bg-sky-500/10">

            Discovery

          </span>

        </div>

        <div class="mt-5">

          <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">
            Current Quest
          </p>

          <p class="mt-1 truncate text-lg font-black text-slate-800 dark:text-white">
            <%= params[:q].presence || "Explore the library" %>
          </p>

        </div>

      </div>


      <!-- Visibility -->

      <div
        class="group rounded-[26px]
               border-2 border-emerald-100
               bg-white p-5
               shadow-[0_12px_35px_rgba(16,185,129,0.07)]
               transition-all duration-300
               hover:-translate-y-1
               hover:border-emerald-200
               dark:border-emerald-500/20
               dark:bg-boxdark">

        <div class="flex items-center justify-between">

          <div
            class="flex h-12 w-12 items-center justify-center
                   rounded-2xl border-2 border-emerald-200
                   bg-emerald-50 text-lg
                   shadow-sm shadow-emerald-100
                   dark:border-emerald-500/20
                   dark:bg-emerald-500/10">

            🚀

          </div>

          <span
            class="rounded-full border border-emerald-100
                   bg-emerald-50 px-3 py-1
                   text-[9px] font-black uppercase
                   tracking-wider text-emerald-500
                   dark:border-emerald-500/20
                   dark:bg-emerald-500/10">

            Publishing

          </span>

        </div>

        <div class="mt-5">

          <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">
            Visibility
          </p>

          <p class="mt-1 text-lg font-black text-slate-800 dark:text-white">

            <% if params[:visibility_status].present? %>
              <%= params[:visibility_status].to_i == 1 ? "Public Only" : "Draft Only" %>
            <% else %>
              All Articles
            <% end %>

          </p>

        </div>

      </div>


      <!-- Level -->

      <div
        class="group rounded-[26px]
               border-2 border-violet-100
               bg-white p-5
               shadow-[0_12px_35px_rgba(139,92,246,0.07)]
               transition-all duration-300
               hover:-translate-y-1
               hover:border-violet-200
               dark:border-violet-500/20
               dark:bg-boxdark">

        <div class="flex items-center justify-between">

          <div
            class="flex h-12 w-12 items-center justify-center
                   rounded-2xl border-2 border-violet-200
                   bg-violet-50 text-lg
                   shadow-sm shadow-violet-100
                   dark:border-violet-500/20
                   dark:bg-violet-500/10">

            🏆

          </div>

          <span
            class="rounded-full border border-violet-100
                   bg-violet-50 px-3 py-1
                   text-[9px] font-black uppercase
                   tracking-wider text-violet-500
                   dark:border-violet-500/20
                   dark:bg-violet-500/10">

            Level Up

          </span>

        </div>

        <div class="mt-5">

          <div class="flex items-end justify-between">

            <div>

              <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">
                Knowledge XP
              </p>

              <p class="mt-1 text-2xl font-black text-slate-800 dark:text-white">
                +1,850 XP
              </p>

            </div>

            <span class="text-xs font-black text-violet-500">
              68%
            </span>

          </div>

          <div class="mt-3 h-2 overflow-hidden rounded-full bg-violet-50 dark:bg-violet-500/10">

            <div
              class="h-full w-[68%] rounded-full
                     bg-gradient-to-r from-violet-400 to-fuchsia-400
                     transition-all duration-700
                     group-hover:w-[82%]">
            </div>

          </div>

        </div>

      </div>

    </div>


    <!-- ======================================================= -->
    <!-- SEARCH QUEST -->
    <!-- ======================================================= -->

    <div
      class="mb-8 rounded-[28px]
             border-2 border-slate-100
             bg-white p-6
             shadow-[0_12px_35px_rgba(15,23,42,0.05)]
             dark:border-strokedark
             dark:bg-boxdark">

      <div class="mb-6 flex items-center gap-4">

        <div
          class="flex h-11 w-11 items-center justify-center
                 rounded-2xl border-2 border-sky-200
                 bg-sky-50 text-lg
                 dark:border-sky-500/20
                 dark:bg-sky-500/10">

          🧭

        </div>

        <div>

          <h2 class="text-lg font-black text-slate-800 dark:text-white">
            Article Discovery Quest
          </h2>

          <p class="mt-1 text-xs text-slate-400">
            Find the knowledge you are looking for.
          </p>

        </div>

      </div>


      <%= form_with url: admin_article_versions_path,
                    method: :get,
                    local: true do |f| %>

        <div class="grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-5">


          <!-- Search -->

          <div class="xl:col-span-2">

            <label
              class="mb-2 block text-[10px] font-black uppercase
                     tracking-widest text-slate-400">

              Search Quest

            </label>

            <div class="relative">

              <span
                class="absolute left-4 top-1/2
                       -translate-y-1/2 text-sky-400">

                🔎

              </span>

              <%= f.text_field :q,
                               value: params[:q],
                               placeholder: "Search article knowledge...",
                               class: "w-full rounded-2xl border-2 border-slate-100
                                       bg-slate-50 py-3.5 pl-11 pr-4
                                       text-sm text-slate-700 outline-none
                                       transition focus:border-sky-300
                                       focus:bg-white focus:ring-4
                                       focus:ring-sky-50
                                       dark:border-strokedark
                                       dark:bg-form-input
                                       dark:text-white
                                       dark:focus:border-sky-500" %>

            </div>

          </div>


          <!-- Visibility -->

          <div>

            <label
              class="mb-2 block text-[10px] font-black uppercase
                     tracking-widest text-slate-400">

              Visibility

            </label>

            <%= f.select :visibility_status,
                         [
                           ["Public", 1],
                           ["Draft", 0]
                         ],
                         {
                           include_blank: "All Statuses",
                           selected: params[:visibility_status]
                         },
                         class: "w-full rounded-2xl border-2 border-slate-100
                                 bg-slate-50 px-4 py-3.5 text-sm
                                 text-slate-700 outline-none transition
                                 focus:border-emerald-300
                                 focus:bg-white focus:ring-4
                                 focus:ring-emerald-50
                                 dark:border-strokedark
                                 dark:bg-form-input
                                 dark:text-white" %>

          </div>


          <!-- Sort -->

          <div>

            <label
              class="mb-2 block text-[10px] font-black uppercase
                     tracking-widest text-slate-400">

              Sort

            </label>

            <%= f.select :sort,
                         [
                           ["Newest", "created_at"],
                           ["Recently Updated", "updated_at"],
                           ["Title", "title"]
                         ],
                         {
                           selected: params[:sort] || "created_at"
                         },
                         class: "w-full rounded-2xl border-2 border-slate-100
                                 bg-slate-50 px-4 py-3.5 text-sm
                                 text-slate-700 outline-none transition
                                 focus:border-violet-300
                                 focus:bg-white focus:ring-4
                                 focus:ring-violet-50
                                 dark:border-strokedark
                                 dark:bg-form-input
                                 dark:text-white" %>

          </div>


          <!-- Start Date -->

          <div>

            <label
              class="mb-2 block text-[10px] font-black uppercase
                     tracking-widest text-slate-400">

              Start Date

            </label>

            <%= f.date_field :start_date,
                             value: params[:start_date],
                             class: "w-full rounded-2xl border-2 border-slate-100
                                     bg-slate-50 px-4 py-3.5 text-sm
                                     text-slate-700 outline-none transition
                                     focus:border-amber-300
                                     focus:bg-white focus:ring-4
                                     focus:ring-amber-50
                                     dark:border-strokedark
                                     dark:bg-form-input
                                     dark:text-white" %>

          </div>


          <!-- End Date -->

          <div>

            <label
              class="mb-2 block text-[10px] font-black uppercase
                     tracking-widest text-slate-400">

              End Date

            </label>

            <%= f.date_field :end_date,
                             value: params[:end_date],
                             class: "w-full rounded-2xl border-2 border-slate-100
                                     bg-slate-50 px-4 py-3.5 text-sm
                                     text-slate-700 outline-none transition
                                     focus:border-rose-300
                                     focus:bg-white focus:ring-4
                                     focus:ring-rose-50
                                     dark:border-strokedark
                                     dark:bg-form-input
                                     dark:text-white" %>

          </div>

        </div>


        <%= f.hidden_field :direction,
                           value: params[:direction].presence || "desc" %>


        <!-- Quest Actions -->

        <div
          class="mt-6 flex flex-col gap-3 border-t-2
                 border-slate-50 pt-5
                 sm:flex-row sm:justify-end
                 dark:border-strokedark">

          <%= link_to admin_article_versions_path,
                      class: "inline-flex items-center justify-center gap-2
                             rounded-2xl border-2 border-slate-100
                             bg-white px-5 py-3 text-xs font-black
                             text-slate-500 transition hover:border-slate-200
                             hover:bg-slate-50
                             dark:border-strokedark
                             dark:bg-boxdark dark:text-gray-400" do %>

            ↺

            Reset Quest

          <% end %>


          <%= f.submit "🚀 Explore Articles",
                       class: "cursor-pointer rounded-2xl
                               border-2 border-sky-200
                               bg-gradient-to-r from-sky-400 to-cyan-400
                               px-6 py-3 text-xs font-black text-white
                               shadow-md shadow-sky-200/40
                               transition-all duration-300
                               hover:-translate-y-0.5
                               hover:from-sky-500 hover:to-cyan-500" %>

        </div>

      <% end %>

    </div>


    <!-- ======================================================= -->
    <!-- ARTICLES QUEST PATH -->
    <!-- ======================================================= -->

    <div
      class="relative rounded-[30px]
             border-2 border-slate-100
             bg-white
             shadow-[0_15px_45px_rgba(15,23,42,0.06)]
             dark:border-strokedark
             dark:bg-boxdark">


      <!-- ===================================================== -->
      <!-- TABLE HEADER -->
      <!-- ===================================================== -->

      <div
        class="border-b-2 border-slate-50 px-6 py-6
               dark:border-strokedark sm:px-8">

        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">

          <div class="flex items-center gap-4">

            <div
              class="flex h-12 w-12 items-center justify-center
                     rounded-2xl border-2 border-violet-200
                     bg-violet-50 text-lg
                     dark:border-violet-500/20
                     dark:bg-violet-500/10">

              🗺️

            </div>

            <div>

              <h2 class="text-xl font-black text-slate-800 dark:text-white">
                Knowledge Quest
              </h2>

              <p class="mt-1 text-xs text-slate-400">
                Your article progression map.
              </p>

            </div>

          </div>


          <!-- Count -->

          <div
            class="inline-flex w-fit items-center gap-2
                   rounded-full border border-emerald-100
                   bg-emerald-50 px-4 py-2
                   text-[10px] font-black uppercase
                   tracking-wider text-emerald-600
                   dark:border-emerald-500/20
                   dark:bg-emerald-500/10">

            <span class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>

            <%= @articles.respond_to?(:total_count) ? @articles.total_count : @articles.count %>

            Articles Found

          </div>

        </div>


        <!-- Progress line -->

        <div class="mt-6">

          <div class="mb-2 flex items-center justify-between">

            <span
              class="text-[9px] font-black uppercase
                     tracking-widest text-slate-400">

              Knowledge Ecosystem

            </span>

            <span class="text-[10px] font-black text-violet-500">
              Level 04 · 68%
            </span>

          </div>

          <div class="h-2 overflow-hidden rounded-full bg-slate-100 dark:bg-meta-4">

            <div
              class="h-full w-[68%] rounded-full
                     bg-gradient-to-r from-emerald-400
                     via-sky-400 to-violet-400">
            </div>

          </div>

        </div>

      </div>


      <!-- ===================================================== -->
      <!-- DESKTOP TABLE -->
      <!-- ===================================================== -->

      <div class="max-w-full overflow-x-auto">

        <table class="w-full min-w-[900px] table-auto">

          <thead>

          <tr class="bg-slate-50 dark:bg-meta-4">

            <th class="px-6 py-4 text-left">

                <span
                  class="text-[9px] font-black uppercase
                         tracking-widest text-slate-400">

                  Quest

                </span>

            </th>

            <th class="px-6 py-4 text-left">

                <span
                  class="text-[9px] font-black uppercase
                         tracking-widest text-slate-400">

                  Identity

                </span>

            </th>

            <th class="px-6 py-4 text-left">

                <span
                  class="text-[9px] font-black uppercase
                         tracking-widest text-slate-400">

                  Status

                </span>

            </th>

            <th class="px-6 py-4 text-left">

                <span
                  class="text-[9px] font-black uppercase
                         tracking-widest text-slate-400">

                  Created

                </span>

            </th>

            <th class="px-6 py-4 text-right">

                <span
                  class="text-[9px] font-black uppercase
                         tracking-widest text-slate-400">

                  Quest Actions

                </span>

            </th>

          </tr>

          </thead>


          <tbody>

          <% if @articles.any? %>

            <% @articles.each_with_index do |article, index| %>

              <% colors = [
                {
                  border: "border-rose-100 dark:border-rose-500/20",
                  bg: "bg-rose-50 dark:bg-rose-500/10",
                  text: "text-rose-500",
                  gradient: "from-rose-400 to-pink-400"
                },
                {
                  border: "border-sky-100 dark:border-sky-500/20",
                  bg: "bg-sky-50 dark:bg-sky-500/10",
                  text: "text-sky-500",
                  gradient: "from-sky-400 to-cyan-400"
                },
                {
                  border: "border-violet-100 dark:border-violet-500/20",
                  bg: "bg-violet-50 dark:bg-violet-500/10",
                  text: "text-violet-500",
                  gradient: "from-violet-400 to-fuchsia-400"
                },
                {
                  border: "border-amber-100 dark:border-amber-500/20",
                  bg: "bg-amber-50 dark:bg-amber-500/10",
                  text: "text-amber-500",
                  gradient: "from-amber-400 to-yellow-300"
                }
              ] %>

              <% color = colors[index % colors.length] %>


              <tr
                class="group border-b border-slate-100
                         transition-all duration-300
                         hover:bg-slate-50/70
                         dark:border-strokedark
                         dark:hover:bg-meta-4/40">


                <!-- ================================================= -->
                <!-- ARTICLE / QUEST -->
                <!-- ================================================= -->

                <td class="px-6 py-5">

                  <div class="flex items-center gap-4">

                    <!-- Quest number -->

                    <div
                      class="flex h-12 w-12 shrink-0 items-center
                               justify-center rounded-2xl border-2
                               <%= color[:border] %>
                               <%= color[:bg] %>
                               text-xs font-black <%= color[:text] %>
                               shadow-sm
                               transition-transform duration-300
                               group-hover:scale-110">

                      <%= format("%02d", index + 1) %>

                    </div>


                    <div class="min-w-0">

                      <%= link_to admin_article_version_path(article),
                                  class: "block max-w-[350px] truncate
                                           text-sm font-black
                                           text-slate-800
                                           transition hover:text-sky-500
                                           dark:text-white" do %>

                        <%= article.title.presence || "Untitled Article" %>

                      <% end %>


                      <div class="mt-2 flex items-center gap-2">

                          <span
                            class="h-1.5 w-1.5 rounded-full
                                   <%= color[:text].gsub('text-', 'bg-') %>">
                          </span>

                        <span class="text-[10px] font-bold text-slate-400">
                            Knowledge Quest
                          </span>

                      </div>

                    </div>

                  </div>

                </td>


                <!-- ================================================= -->
                <!-- UUID -->
                <!-- ================================================= -->

                <td class="px-6 py-5">

                  <% if article.uuid.present? %>

                    <code
                      class="rounded-xl border border-slate-100
                               bg-slate-50 px-3 py-2
                               text-[10px] font-bold text-slate-500
                               dark:border-strokedark
                               dark:bg-meta-4 dark:text-gray-400">

                      <%= article.uuid %>

                    </code>

                  <% else %>

                      <span class="text-xs text-slate-300">
                        No UUID
                      </span>

                  <% end %>

                </td>


                <!-- ================================================= -->
                <!-- STATUS -->
                <!-- ================================================= -->

                <td class="px-6 py-5">

                  <% if article.visibility_status.to_i == 1 %>

                    <div class="flex flex-col gap-2">

                        <span
                          class="inline-flex w-fit items-center gap-2
                                 rounded-full border border-emerald-100
                                 bg-emerald-50 px-3 py-1.5
                                 text-[9px] font-black uppercase
                                 tracking-wider text-emerald-600
                                 dark:border-emerald-500/20
                                 dark:bg-emerald-500/10">

                          <span
                            class="h-1.5 w-1.5 rounded-full
                                   bg-emerald-400 animate-pulse">
                          </span>

                          Public

                        </span>

                      <div class="h-1.5 w-24 overflow-hidden rounded-full bg-emerald-50 dark:bg-emerald-500/10">

                        <div
                          class="h-full w-full rounded-full
                                   bg-gradient-to-r
                                   from-emerald-400 to-green-400">
                        </div>

                      </div>

                    </div>

                  <% else %>

                    <div class="flex flex-col gap-2">

                        <span
                          class="inline-flex w-fit items-center gap-2
                                 rounded-full border border-amber-100
                                 bg-amber-50 px-3 py-1.5
                                 text-[9px] font-black uppercase
                                 tracking-wider text-amber-600
                                 dark:border-amber-500/20
                                 dark:bg-amber-500/10">

                          <span
                            class="h-1.5 w-1.5 rounded-full
                                   bg-amber-400">
                          </span>

                          Draft

                        </span>

                      <div class="h-1.5 w-24 overflow-hidden rounded-full bg-amber-50 dark:bg-amber-500/10">

                        <div
                          class="h-full w-[45%] rounded-full
                                   bg-gradient-to-r
                                   from-amber-400 to-yellow-300">
                        </div>

                      </div>

                    </div>

                  <% end %>

                </td>


                <!-- ================================================= -->
                <!-- CREATED -->
                <!-- ================================================= -->

                <td class="px-6 py-5">

                  <div>

                    <p class="text-sm font-black text-slate-700 dark:text-white">

                      <%= article.created_at.strftime("%b %d, %Y") %>

                    </p>

                    <p class="mt-1 text-[10px] font-medium text-slate-400">

                      <%= article.created_at.strftime("%H:%M") %>

                    </p>

                  </div>

                </td>


                <!-- ================================================= -->
                <!-- ACTIONS -->
                <!-- ================================================= -->

                <td class="px-6 py-5">

                  <div class="flex items-center justify-end gap-2">


                    <!-- View -->

                    <%= link_to admin_article_version_path(article),
                                title: "View article",
                                class: "group/action flex h-9 w-9
                                          items-center justify-center
                                          rounded-xl border-2
                                          border-sky-100
                                          bg-sky-50 text-sky-500
                                          transition-all duration-200
                                          hover:-translate-y-0.5
                                          hover:border-sky-200
                                          hover:bg-sky-100
                                          dark:border-sky-500/20
                                          dark:bg-sky-500/10" do %>

                      👁

                    <% end %>


                    <!-- Edit -->

                    <%= link_to edit_admin_article_version_path(article),
                                title: "Edit article",
                                class: "flex h-9 w-9
                                          items-center justify-center
                                          rounded-xl border-2
                                          border-violet-100
                                          bg-violet-50 text-violet-500
                                          transition-all duration-200
                                          hover:-translate-y-0.5
                                          hover:border-violet-200
                                          hover:bg-violet-100
                                          dark:border-violet-500/20
                                          dark:bg-violet-500/10" do %>

                      ✏️

                    <% end %>


                    <!-- Delete -->

                    <%= button_to admin_article_version_path(article),
                                  method: :delete,
                                  data: {
                                    turbo_confirm: "Are you sure you want to delete this article?"
                                  },
                                  title: "Delete article",
                                  class: "flex h-9 w-9
                                            items-center justify-center
                                            rounded-xl border-2
                                            border-rose-100
                                            bg-rose-50 text-rose-500
                                            transition-all duration-200
                                            hover:-translate-y-0.5
                                            hover:border-rose-200
                                            hover:bg-rose-100
                                            dark:border-rose-500/20
                                            dark:bg-rose-500/10" do %>

                      🗑️

                    <% end %>

                  </div>

                </td>

              </tr>

            <% end %>


          <% else %>


            <!-- ================================================= -->
            <!-- EMPTY QUEST -->
            <!-- ================================================= -->

            <tr>

              <td colspan="5" class="px-6 py-20 text-center">

                <div class="mx-auto max-w-md">

                  <div
                    class="mx-auto flex h-20 w-20 items-center
                             justify-center rounded-[26px]
                             border-2 border-amber-200
                             bg-amber-50 text-3xl
                             shadow-md shadow-amber-100
                             dark:border-amber-500/20
                             dark:bg-amber-500/10">

                    🗺️

                  </div>


                  <h3
                    class="mt-6 text-xl font-black
                             text-slate-800 dark:text-white">

                    Quest area is empty

                  </h3>


                  <p
                    class="mt-2 text-sm leading-6
                             text-slate-400">

                    No articles were found matching your current quest.
                    Try changing the filters or create a new article.

                  </p>


                  <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:justify-center">

                    <%= link_to admin_article_versions_path,
                                class: "rounded-2xl border-2
                                          border-slate-100 bg-white
                                          px-5 py-3 text-xs font-black
                                          text-slate-500
                                          transition hover:bg-slate-50
                                          dark:border-strokedark
                                          dark:bg-boxdark" do %>

                      ↺ Clear Quest

                    <% end %>


                    <%= link_to new_admin_article_version_path,
                                class: "rounded-2xl
                                          bg-gradient-to-r
                                          from-amber-400 to-orange-400
                                          px-5 py-3 text-xs font-black
                                          text-white shadow-md
                                          transition hover:-translate-y-0.5
                                          hover:from-amber-500
                                          hover:to-orange-500" do %>

                      + Create Article

                    <% end %>

                  </div>

                </div>

              </td>

            </tr>

          <% end %>

          </tbody>

        </table>

      </div>


      <!-- ======================================================= -->
      <!-- PAGINATION / QUEST FOOTER -->
      <!-- ======================================================= -->

      <% if @articles.respond_to?(:total_pages) && @articles.total_pages > 1 %>

        <div
          class="border-t-2 border-slate-50 px-6 py-5
                 dark:border-strokedark sm:px-8">

          <div
            class="flex flex-col gap-4
                   sm:flex-row sm:items-center
                   sm:justify-between">

            <div>

              <div
                class="text-[9px] font-black uppercase
                       tracking-widest text-slate-400">

                Quest Progress

              </div>

              <p class="mt-1 text-xs font-bold text-slate-500 dark:text-gray-400">

                Page

                <span class="font-black text-slate-800 dark:text-white">
                  <%= @articles.current_page %>
                </span>

                of

                <span class="font-black text-slate-800 dark:text-white">
                  <%= @articles.total_pages %>
                </span>

              </p>

            </div>


            <div
              class="rounded-2xl border border-slate-100
                     bg-slate-50 px-4 py-2
                     dark:border-strokedark
                     dark:bg-meta-4">

              <%= paginate @articles %>

            </div>

          </div>

        </div>

      <% end %>


    </div>


    <!-- ======================================================= -->
    <!-- BOTTOM GAMIFICATION STATUS -->
    <!-- ======================================================= -->

    <div
      class="mt-8 rounded-[28px]
             border-2 border-slate-100
             bg-gradient-to-r
             from-white via-slate-50 to-white
             p-6 shadow-sm
             dark:border-strokedark
             dark:from-boxdark
             dark:via-meta-4
             dark:to-boxdark">

      <div
        class="flex flex-col gap-5
               md:flex-row md:items-center
               md:justify-between">


        <div class="flex items-center gap-4">

          <div
            class="flex h-12 w-12 shrink-0
                   items-center justify-center
                   rounded-2xl border-2
                   border-emerald-200
                   bg-emerald-50 text-lg
                   shadow-sm shadow-emerald-100
                   dark:border-emerald-500/20
                   dark:bg-emerald-500/10">

            🏆

          </div>


          <div>

            <div
              class="text-sm font-black text-slate-700 dark:text-white">

              Knowledge ecosystem connected.

            </div>

            <p
              class="mt-1 max-w-2xl text-xs leading-5
                     text-slate-400">

              Every article contributes to the growth of your
              knowledge base. Keep building, publishing and evolving.

            </p>

          </div>

        </div>


        <div
          class="flex shrink-0 items-center gap-2
                 rounded-2xl border-2 border-emerald-100
                 bg-emerald-50 px-4 py-3
                 dark:border-emerald-500/20
                 dark:bg-emerald-500/10">

          <span class="text-lg">
            ⚡
          </span>

          <div>

            <div
              class="text-[9px] font-black uppercase
                     tracking-widest text-emerald-500">

              Current Level

            </div>

            <div class="text-sm font-black text-emerald-600">
              Knowledge Builder · 68%
            </div>

          </div>

        </div>

      </div>


      <!-- Overall progress -->

      <div class="mt-6">

        <div class="mb-2 flex items-center justify-between">

          <span
            class="text-[9px] font-black uppercase
                   tracking-widest text-slate-400">

            Ecosystem Progress

          </span>

          <span
            class="text-[10px] font-black text-emerald-500">

            68%

          </span>

        </div>


        <div
          class="h-2.5 overflow-hidden rounded-full
                 bg-slate-100 dark:bg-meta-4">

          <div
            class="h-full w-[68%] rounded-full
                   bg-gradient-to-r
                   from-emerald-400
                   via-sky-400
                   to-violet-400
                   shadow-sm">
          </div>

        </div>

      </div>

    </div>


  </div>

</div>