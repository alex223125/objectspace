<%# ============================================================ %>
<%# ECOSYSTEMS / LOAD SOURCES / ACTORS %>
<%# Actor Discovery Index %>
<%# ============================================================ %>

<div
  class="max-w-7xl mx-auto my-10 px-4 sm:px-6 lg:px-8"
  data-controller="actor_discovery"
  data-actor_discovery-search-url-value="<%= ecosystems_load_sources_actors_actors_path %>"

>

  <%# ========================================================== %>
  <%# PAGE CONTAINER %>
  <%# ========================================================== %>

  <div
    class="overflow-hidden
           rounded-[38px]
           border-2 border-orange-100
           bg-gradient-to-b
           from-white
           via-orange-50/20
           to-slate-50/60
           shadow-md
           shadow-orange-100/40">


    <%# ======================================================== %>
    <%# BREADCRUMB / LOCATION %>
    <%# ======================================================== %>

    <div
      class="px-6 pt-6 sm:px-8 lg:px-10">

      <div
        class="flex flex-wrap items-center gap-2
               text-[10px]
               font-black
               uppercase
               tracking-widest
               text-slate-400">

        <span
          class="rounded-full
                 border border-slate-200
                 bg-white
                 px-3 py-1.5
                 shadow-sm">

          Encyclopedia

        </span>

        <span class="text-slate-300">
          →
        </span>

        <span
          class="rounded-full
                 border border-orange-200
                 bg-orange-50
                 px-3 py-1.5
                 text-orange-600
                 shadow-sm">

          Ecosystems

        </span>

        <span class="text-slate-300">
          →
        </span>

        <span
          class="rounded-full
                 border border-orange-200
                 bg-orange-50
                 px-3 py-1.5
                 text-orange-600
                 shadow-sm">

          Load Sources

        </span>

        <span class="text-slate-300">
          →
        </span>

        <span
          class="rounded-full
                 border border-sky-200
                 bg-sky-50
                 px-3 py-1.5
                 text-sky-600
                 shadow-sm">

          Actors

        </span>

      </div>

    </div>


    <%# ======================================================== %>
    <%# HEADER %>
    <%# ======================================================== %>

    <div
      class="px-6 py-8
             sm:px-8
             lg:px-10
             lg:py-10">

      <div
        class="flex flex-col gap-8
               lg:flex-row
               lg:items-start
               lg:justify-between">


        <%# LEFT SIDE %>

        <div
          class="flex items-start gap-5">

          <%# Icon %>

          <div
            class="flex h-16 w-16 shrink-0
                   items-center justify-center
                   rounded-[24px]
                   border-[3px] border-sky-300
                   bg-sky-50
                   text-2xl
                   shadow-md
                   shadow-sky-200/60
                   ring-[6px] ring-sky-100/60
                   transition-all duration-300
                   hover:scale-105">

            🎭

          </div>


          <div>

            <div
              class="mb-2
                     text-[10px]
                     font-black
                     uppercase
                     tracking-[0.2em]
                     text-sky-500">

              Load Sources / Actors

            </div>


            <h1
              class="text-2xl
                     font-black
                     tracking-tight
                     text-slate-800
                     sm:text-3xl">

              Actors

            </h1>


            <p
              class="mt-2
                     max-w-2xl
                     text-sm
                     leading-6
                     text-slate-400">

              Discover the organisations, institutions,
              groups and other actors that generate,
              influence or respond to pressure within
              the ecosystem.

            </p>

          </div>

        </div>


        <%# RIGHT SIDE STATUS %>

        <div
          class="flex shrink-0
                 flex-col
                 items-start
                 gap-3
                 sm:flex-row
                 sm:items-center
                 lg:flex-col
                 lg:items-end">

          <span
            class="inline-flex items-center gap-2
                   rounded-full
                   border border-emerald-200
                   bg-emerald-50
                   px-4 py-2
                   text-[11px]
                   font-black
                   text-emerald-600
                   shadow-sm">

            <span
              class="h-2 w-2
                     rounded-full
                     bg-emerald-400
                     shadow-[0_0_8px_rgba(52,211,153,0.7)]">

            </span>

            Layer active

          </span>


          <span
            class="text-[10px]
                   font-bold
                   uppercase
                   tracking-widest
                   text-slate-400">

            Actor Discovery Layer

          </span>

        </div>

      </div>

    </div>


    <%# ======================================================== %>
    <%# ACTOR DISCOVERY CONTROL PANEL %>
    <%# ======================================================== %>

    <div
      class="border-y-2 border-orange-100
             bg-white/70
             px-6 py-5
             sm:px-8
             lg:px-10">

      <div
        class="flex flex-col gap-4
               lg:flex-row
               lg:items-center
               lg:justify-between">


        <%# SEARCH %>

        <div
          class="relative w-full
                 lg:max-w-xl">

          <div
            class="pointer-events-none
                   absolute inset-y-0 left-0
                   flex items-center
                   pl-4
                   text-slate-400">

            🔎

          </div>


          <input
            type="text"
            placeholder="Discover an actor..."
            autocomplete="off"
            data-actor-discovery-target="search"
            data-action="input->actor_discovery#search"
            class="w-full
                   rounded-2xl
                   border-2 border-slate-100
                   bg-white
                   py-3.5 pl-11 pr-12
                   text-sm
                   font-medium
                   text-slate-700
                   placeholder:text-slate-300
                   shadow-sm
                   outline-none
                   transition-all duration-200
                   focus:border-sky-300
                   focus:ring-4
                   focus:ring-sky-100">

          <%# Search loading indicator %>

          <div
            data-actor-discovery-target="searchIndicator"
            class="pointer-events-none
                   absolute inset-y-0 right-0
                   hidden
                   items-center
                   pr-4">

            <div
              class="h-4 w-4
                     animate-spin
                     rounded-full
                     border-2 border-sky-200
                     border-t-sky-500">

            </div>

          </div>

        </div>


        <%# ACTIONS %>

        <div
          class="flex flex-wrap gap-2">

          <button
            type="button"
            data-action="click->actor_discovery#showAll"
            class="rounded-2xl
                   border-2 border-slate-200
                   bg-white
                   px-4 py-2.5
                   text-xs
                   font-black
                   text-slate-600
                   shadow-sm
                   transition-all duration-200
                   hover:-translate-y-0.5
                   hover:border-sky-200
                   hover:text-sky-600">

            All actors

          </button>


          <%= link_to new_ecosystems_load_sources_actors_actor_path,
                      class: "rounded-2xl
                             border-2 border-sky-300
                             bg-gradient-to-r
                             from-sky-400
                             to-cyan-400
                             px-4 py-2.5
                             text-xs
                             font-black
                             text-white
                             shadow-md
                             shadow-sky-200/60
                             transition-all duration-200
                             hover:-translate-y-0.5
                             hover:from-sky-500
                             hover:to-cyan-500" do %>

            + Add actor

          <% end %>

        </div>

      </div>


      <%# FILTERS %>

      <div
        class="mt-4
               flex flex-wrap
               items-center
               gap-2">

        <span
          class="mr-1
                 text-[9px]
                 font-black
                 uppercase
                 tracking-widest
                 text-slate-400">

          Filter:

        </span>


        <button
          type="button"
          data-filter="all"
          data-action="click->actor_discovery#filter"
          class="rounded-full
                 border border-sky-200
                 bg-sky-50
                 px-3 py-1.5
                 text-[10px]
                 font-bold
                 text-sky-600">

          All

        </button>


        <button
          type="button"
          data-filter="organisation"
          data-action="click->actor_discovery#filter"
          class="rounded-full
                 border border-orange-200
                 bg-orange-50
                 px-3 py-1.5
                 text-[10px]
                 font-bold
                 text-orange-600
                 transition-colors
                 hover:bg-orange-100">

          Organisations

        </button>


        <button
          type="button"
          data-filter="institution"
          data-action="click->actor_discovery#filter"
          class="rounded-full
                 border border-violet-200
                 bg-violet-50
                 px-3 py-1.5
                 text-[10px]
                 font-bold
                 text-violet-600
                 transition-colors
                 hover:bg-violet-100">

          Institutions

        </button>


        <button
          type="button"
          data-filter="group"
          data-action="click->actor_discovery#filter"
          class="rounded-full
                 border border-emerald-200
                 bg-emerald-50
                 px-3 py-1.5
                 text-[10px]
                 font-bold
                 text-emerald-600
                 transition-colors
                 hover:bg-emerald-100">

          Groups

        </button>

      </div>

    </div>


    <%# ======================================================== %>
    <%# DISCOVERY STATUS %>
    <%# ======================================================== %>

    <div
      class="px-6 pt-8
             sm:px-8
             lg:px-10">

      <div
        class="grid grid-cols-2 gap-3
               md:grid-cols-4">


        <div
          class="rounded-2xl
                 border border-orange-100
                 bg-orange-50/60
                 p-4">

          <div
            class="text-[9px]
                   font-black
                   uppercase
                   tracking-widest
                   text-orange-400">

            Actors

          </div>

          <div
            data-actor-discovery-target="actorCount"
            class="mt-1
                   text-xl
                   font-black
                   text-orange-700">

            <%= @actors.respond_to?(:count) ? @actors.count : 0 %>

          </div>

        </div>


        <div
          class="rounded-2xl
                 border border-sky-100
                 bg-sky-50/60
                 p-4">

          <div
            class="text-[9px]
                   font-black
                   uppercase
                   tracking-widest
                   text-sky-400">

            Visible

          </div>

          <div
            data-actor-discovery-target="visibleCount"
            class="mt-1
                   text-xl
                   font-black
                   text-sky-700">

            <%= @actors.respond_to?(:count) ? @actors.count : 0 %>

          </div>

        </div>


        <div
          class="rounded-2xl
                 border border-violet-100
                 bg-violet-50/60
                 p-4">

          <div
            class="text-[9px]
                   font-black
                   uppercase
                   tracking-widest
                   text-violet-400">

            Layer

          </div>

          <div
            class="mt-1
                   text-xl
                   font-black
                   text-violet-700">

            Actors

          </div>

        </div>


        <div
          class="rounded-2xl
                 border border-emerald-100
                 bg-emerald-50/60
                 p-4">

          <div
            class="text-[9px]
                   font-black
                   uppercase
                   tracking-widest
                   text-emerald-400">

            Status

          </div>

          <div
            class="mt-1
                   flex items-center gap-2
                   text-sm
                   font-black
                   text-emerald-700">

            <span
              class="h-2 w-2
                     rounded-full
                     bg-emerald-400
                     shadow-[0_0_8px_rgba(52,211,153,0.7)]">

            </span>

            Active

          </div>

        </div>

      </div>

    </div>


    <%# ======================================================== %>
    <%# ACTOR GRID %>
    <%# ======================================================== %>

    <div
      data-actor-discovery-target="grid"
      class="grid grid-cols-1
             gap-5
             px-6 py-8
             sm:grid-cols-2
             sm:px-8
             lg:grid-cols-3
             lg:px-10">


      <% if @actors.present? %>

        <% @actors.each_with_index do |actor, index| %>

          <%= link_to ecosystems_load_sources_actors_actor_path(actor),
                      data: {
                        actor_discovery_target: "actor",
                        actor_type: actor.try(:actor_type).to_s.downcase
                      },
                      class: "actor-card
                              group
                              relative
                              overflow-hidden
                              rounded-[26px]
                              border-2 border-slate-100
                              bg-white
                              p-5
                              shadow-sm
                              transition-all duration-300
                              hover:-translate-y-1
                              hover:border-sky-200
                              hover:shadow-lg
                              hover:shadow-sky-100/60" do %>


            <%# Decorative glow %>

            <div
              class="pointer-events-none
                     absolute -right-10 -top-10
                     h-28 w-28
                     rounded-full
                     bg-sky-100/50
                     blur-2xl
                     transition-all duration-500
                     group-hover:bg-sky-200/70">

            </div>


            <%# Card header %>

            <div
              class="relative
                     flex items-start
                     justify-between
                     gap-4">


              <div
                class="flex h-12 w-12 shrink-0
                       items-center justify-center
                       rounded-2xl
                       border-2 border-sky-200
                       bg-sky-50
                       text-lg
                       shadow-sm
                       transition-transform duration-300
                       group-hover:scale-110">

                🎭

              </div>


              <span
                class="rounded-full
                       border border-slate-200
                       bg-slate-50
                       px-2.5 py-1
                       text-[9px]
                       font-black
                       uppercase
                       tracking-wider
                       text-slate-400">

                <%= actor.try(:status).presence || "draft" %>

              </span>

            </div>


            <%# Actor information %>

            <div class="relative mt-5">

              <h2
                class="line-clamp-2
                       text-base
                       font-black
                       leading-6
                       text-slate-700
                       transition-colors
                       group-hover:text-sky-700">

                <%= actor.name %>

              </h2>


              <% if actor.try(:description).present? %>

                <p
                  class="mt-2
                         line-clamp-3
                         text-xs
                         leading-5
                         text-slate-400">

                  <%= actor.description %>

                </p>

              <% else %>

                <p
                  class="mt-2
                         text-xs
                         italic
                         leading-5
                         text-slate-300">

                  No actor description yet.

                </p>

              <% end %>

            </div>


            <%# Card footer %>

            <div
              class="relative
                     mt-5
                     flex items-center
                     justify-between
                     border-t
                     border-slate-100
                     pt-4">


              <span
                class="text-[9px]
                       font-black
                       uppercase
                       tracking-widest
                       text-slate-300">

                Actor node

              </span>


              <span
                class="flex items-center gap-1
                       text-[10px]
                       font-black
                       text-sky-500
                       transition-transform duration-300
                       group-hover:translate-x-1">

                Explore
                <span>→</span>

              </span>

            </div>


          <% end %>

        <% end %>


      <% else %>

        <%# ==================================================== %>
        <%# EMPTY STATE %>
        <%# ==================================================== %>

        <div
          class="col-span-full
                 rounded-[28px]
                 border-2 border-dashed
                 border-sky-200
                 bg-sky-50/40
                 px-6 py-14
                 text-center">

          <div
            class="mx-auto
                   flex h-16 w-16
                   items-center justify-center
                   rounded-[24px]
                   border-2 border-sky-200
                   bg-white
                   text-2xl
                   shadow-sm">

            🔭

          </div>


          <h2
            class="mt-5
                   text-lg
                   font-black
                   text-slate-700">

            No actors discovered yet

          </h2>


          <p
            class="mx-auto mt-2
                   max-w-md
                   text-xs
                   leading-6
                   text-slate-400">

            The actor layer is ready.
            Add the first actor to begin building
            the load-source ecosystem.

          </p>


          <%= link_to new_ecosystems_load_sources_actors_actor_path,
                      class: "mt-6 inline-flex
                             items-center gap-2
                             rounded-2xl
                             bg-gradient-to-r
                             from-sky-400
                             to-cyan-400
                             px-5 py-3
                             text-xs
                             font-black
                             text-white
                             shadow-md
                             shadow-sky-200/60
                             transition-all duration-300
                             hover:-translate-y-1
                             hover:from-sky-500
                             hover:to-cyan-500" do %>

            <span>+ Create first actor</span>
            <span>→</span>

          <% end %>

        </div>

      <% end %>

    </div>


    <%# ======================================================== %>
    <%# EMPTY SEARCH STATE %>
    <%# ======================================================== %>

    <div
      data-actor-discovery-target="noResults"
      class="hidden
             px-6 pb-10
             sm:px-8
             lg:px-10">

      <div
        class="rounded-[26px]
               border-2 border-dashed
               border-slate-200
               bg-slate-50/60
               px-6 py-10
               text-center">

        <div class="text-2xl">
          🔎
        </div>

        <div
          class="mt-3
                 text-sm
                 font-black
                 text-slate-600">

          No actors found

        </div>

        <p
          class="mt-1
                 text-xs
                 text-slate-400">

          Try another search term or filter.

        </p>

      </div>

    </div>


    <%# ======================================================== %>
    <%# ACTOR DISCOVERY LOOP %>
    <%# ======================================================== %>

    <div
      class="mx-6 mb-6
             rounded-[28px]
             border-2 border-orange-100
             bg-gradient-to-r
             from-orange-50/70
             via-white
             to-sky-50/60
             p-6
             shadow-sm
             sm:mx-8
             lg:mx-10">


      <div
        class="flex flex-col gap-5
               md:flex-row
               md:items-center
               md:justify-between">


        <div
          class="flex items-start gap-4">

          <div
            class="flex h-11 w-11 shrink-0
                   items-center justify-center
                   rounded-2xl
                   border border-orange-200
                   bg-orange-100
                   text-lg
                   shadow-sm">

            🧭

          </div>


          <div>

            <div
              class="text-sm
                     font-black
                     text-slate-700">

              Actor discovery loop

            </div>


            <p
              class="mt-1
                     max-w-3xl
                     text-xs
                     leading-6
                     text-slate-400">

              Discover actors → understand their role →
              connect them to pressures → observe their
              relationships → continuously improve the
              encyclopedia.

            </p>

          </div>

        </div>


        <%= link_to new_ecosystems_load_sources_actors_actor_path,
                    class: "flex shrink-0
                           items-center gap-2
                           rounded-2xl
                           border-2 border-sky-200
                           bg-gradient-to-r
                           from-sky-400
                           to-cyan-400
                           px-5 py-3
                           text-xs
                           font-black
                           text-white
                           shadow-md
                           shadow-sky-200/60
                           transition-all duration-300
                           hover:-translate-y-1" do %>

          <span>
            Discover actor
          </span>

          <span>
            →
          </span>

        <% end %>

      </div>


      <%# Evolution progress %>

      <div class="mt-6">

        <div
          class="mb-2
                 flex items-center
                 justify-between">

          <span
            class="text-[9px]
                   font-black
                   uppercase
                   tracking-widest
                   text-slate-400">

            Actor Layer Evolution

          </span>


          <span
            data-actor-discovery-target="evolutionLabel"
            class="text-[10px]
                   font-black
                   text-sky-500">

            Discovering

          </span>

        </div>


        <div
          class="h-2.5
                 overflow-hidden
                 rounded-full
                 border border-sky-100
                 bg-white">

          <div
            data-actor-discovery-target="evolutionBar"
            class="h-full
                   w-[25%]
                   rounded-full
                   bg-gradient-to-r
                   from-orange-400
                   via-sky-400
                   to-emerald-400
                   shadow-sm
                   transition-all duration-700">

          </div>

        </div>

      </div>

    </div>


  </div>

</div>
